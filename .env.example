# Copy to .env (or set as repository/Actions variables) to override defaults.
# All PUBLIC_* values are embedded in the static build — never put secrets here.

# AdSense publisher ID (defaults to the ID already verified for this site).
# PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX

# Turn ad units on only after AdSense approval and once a certified CMP is set up.
# PUBLIC_ADS_ENABLED=false

# Ad unit IDs from AdSense → Ads → By ad unit (10 digits). Placeholders never render.
# PUBLIC_AD_SLOT_RESULTS=XXXXXXXXXX
# PUBLIC_AD_SLOT_IN_ARTICLE=XXXXXXXXXX
# PUBLIC_AD_SLOT_SIDEBAR=XXXXXXXXXX

# Buy Me a Coffee username (https://buymeacoffee.com/<username>).
# Until set, "Buy me a coffee" buttons use the existing Ko-fi page.
# PUBLIC_BMC_USERNAME=YOUR_USERNAME
