---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
export interface Props {
  type: 'top-leaderboard' | 'sidebar-skyscraper' | 'in-article' | 'bottom-utility';
  id?: string;
  class?: string;
}

const { type, id, class: className = '' } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
// Fallback to "Advertisement" if ad.label is not defined in dictionary
const adLabel = (t as any)('ad.label') || 'Advertisement';

// Determine dimensions and styles based on the ad type
// These explicit min-heights and max-widths prevent Cumulative Layout Shift (CLS)
// by reserving the exact space required for standard AdSense units.

let dimensionClasses = '';

switch (type) {
  case 'top-leaderboard':
    // Top Banner: 728x90 on Desktop, 320x50 on Mobile
    dimensionClasses = 'w-full max-w-[728px] min-h-[50px] md:min-h-[90px] mx-auto';
    break;
  case 'sidebar-skyscraper':
    // Sidebar: 300x600 Desktop only
    dimensionClasses = 'hidden lg:flex w-[300px] min-h-[600px] mx-auto';
    break;
  case 'in-article':
  case 'bottom-utility':
    // In-article or bottom: Responsive rectangular
    dimensionClasses = 'w-full min-h-[250px] mx-auto';
    break;
}
---

<div
  id={id}
  class={`ad-slot relative flex items-center justify-center bg-gray-50/50 border border-gray-200/50 rounded-xl overflow-hidden my-6 ${dimensionClasses} ${className}`}
  aria-hidden="true"
  data-ad-type={type}
>
  <!-- Skeleton Pulse Animation Background -->
  <div class="absolute inset-0 w-full h-full animate-pulse bg-gradient-to-r from-gray-100/20 via-gray-200/30 to-gray-100/20"></div>
  
  <!-- Subtle Placeholder Text -->
  <span class="absolute top-2 start-3 text-[10px] font-medium tracking-wider text-gray-400 z-10 pointer-events-none select-none">
    {adLabel}
  </span>

  <!-- In the future, you will inject the AdSense script and <ins> tag right here -->
</div>
