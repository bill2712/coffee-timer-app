---
import { getLangFromUrl } from '../i18n/utils';

interface Props { lang?: string }
const lang = Astro.props.lang || getLangFromUrl(Astro.url);
const isZh = lang === 'zh-TW';
const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;
const c = isZh ? {
  title: '私隱選擇',
  body: '沖煮紀錄只會儲存在你的裝置。網站載入 Google AdSense 程式碼供審核，目前沒有顯示廣告；日後顯示廣告時，你未作選擇前只會提供非個人化廣告。',
  link: '私隱政策',
  decline: '拒絕廣告 Cookie',
  accept: '接受'
} : {
  title: 'Your privacy choice',
  body: 'Brew records stay on your device. The site loads Google AdSense code for site review and shows no ads today; if ads appear later, only non-personalised ads are requested until you choose.',
  link: 'Privacy policy',
  decline: 'Decline ad cookies',
  accept: 'Accept'
};
---

<div id="cookie-banner" role="region" aria-labelledby="cookie-banner-title" hidden class="fixed bottom-0 start-0 z-[100] flex w-full justify-center border-t border-coffee-sand/20 bg-coffee-dark shadow-[0_-10px_40px_rgba(0,0,0,0.5)]">
  <div class="mx-auto flex w-full max-w-6xl flex-col items-center justify-between gap-4 px-4 py-5 sm:px-6 md:flex-row lg:px-8">
    <div class="flex-1 md:pe-8">
      <p id="cookie-banner-title" class="mb-1 text-sm font-bold text-coffee-light">{c.title}</p>
      <p class="text-xs leading-relaxed text-coffee-muted">{c.body} <a href={`${base}/${lang}/privacy-policy/`} class="text-coffee-gold hover:underline">{c.link}</a></p>
    </div>
    <div class="flex w-full items-center gap-3 md:w-auto">
      <button id="btn-cookie-decline" type="button" class="min-h-[44px] flex-1 rounded-lg border border-coffee-sand/30 px-5 text-xs font-semibold text-coffee-sand transition-colors hover:border-coffee-sand/60 hover:text-coffee-light md:flex-none">{c.decline}</button>
      <button id="btn-cookie-accept" type="button" class="min-h-[44px] flex-1 rounded-lg bg-coffee-gold px-5 text-xs font-bold text-coffee-dark transition-colors hover:bg-coffee-gold-hover md:flex-none">{c.accept}</button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = 'barista_flow_cookie_consent';
    var banner = document.getElementById('cookie-banner');
    if (!banner) return;
    var read = function () { try { return localStorage.getItem(KEY); } catch (error) { return null; } };
    var save = function (value) {
      try { localStorage.setItem(KEY, value); } catch (error) {}
      banner.hidden = true;
      // Apply the choice on this page without reloading (a reload would reset a running brew timer).
      // AdsLoader reads the stored choice on every later page load.
      var ads = window.adsbygoogle = window.adsbygoogle || [];
      if (value === 'accepted') { ads.requestNonPersonalizedAds = 0; ads.pauseAdRequests = 0; }
      if (value === 'declined') { ads.pauseAdRequests = 1; }
    };
    if (!read()) banner.hidden = false;
    document.getElementById('btn-cookie-accept')?.addEventListener('click', function () { save('accepted'); });
    document.getElementById('btn-cookie-decline')?.addEventListener('click', function () { save('declined'); });
    document.querySelectorAll('[data-cookie-settings]').forEach(function (button) {
      button.addEventListener('click', function () { banner.hidden = false; banner.querySelector('button')?.focus(); });
    });
  })();
</script>
