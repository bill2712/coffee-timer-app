---
import { SITE_URL } from '../config.js';
import { languages } from '../i18n/ui';
interface Props {
  title: string;
  description: string;
  image?: string;
  article?: boolean;
  jsonld?: any;
  keywords?: string;
  noindex?: boolean;
}


const {
  title,
  description,
  image = "/images/og-default.jpg",
  article = false,
  jsonld,
  keywords,
  noindex = false
} = Astro.props;

const siteParsed = new URL(SITE_URL);
const siteOrigin = siteParsed.origin;
const basePath = siteParsed.pathname === '/' ? '' : siteParsed.pathname;

let currentPath = Astro.url.pathname;
// Remove base path to get clean path
if (basePath && currentPath.startsWith(basePath)) {
  currentPath = currentPath.slice(basePath.length);
}

// Find and strip the current locale from path
const currentLang = Astro.params.lang || 'zh-TW';
let pathWithoutLang = currentPath;
if (pathWithoutLang.startsWith(`/${currentLang}/`)) {
  pathWithoutLang = pathWithoutLang.slice(currentLang.length + 1);
} else if (pathWithoutLang === `/${currentLang}`) {
  pathWithoutLang = '/';
}

const cleanBasePath = basePath.endsWith('/') ? basePath.slice(0, -1) : basePath;
const cleanPathWithoutLang = pathWithoutLang.startsWith('/') ? pathWithoutLang : '/' + pathWithoutLang;
const canonicalURL = new URL(`${cleanBasePath}/${currentLang}${cleanPathWithoutLang}`.replace(/\/+/g, '/'), siteOrigin).toString();
const isTraditionalChineseOnly = cleanPathWithoutLang === '/data' || cleanPathWithoutLang === '/data/' || cleanPathWithoutLang.startsWith('/recipes');
const alternateLanguages = isTraditionalChineseOnly ? ['zh-TW'] : Object.keys(languages);

const base = cleanBasePath + '/';
const safeImage = image.startsWith('/') ? base + image.slice(1) : base + image;
const ogImageUrl = new URL(safeImage.replace(/\/+/g, '/'), siteOrigin).toString();
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<meta name="robots" content={noindex ? "noindex,follow" : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"} />
<link rel="canonical" href={canonicalURL} />

<!-- International Hreflang Matrix -->
{alternateLanguages.map((l) => (
  <link rel="alternate" hreflang={l} href={new URL(`${cleanBasePath}/${l}${cleanPathWithoutLang}`.replace(/\/+/g, '/'), siteOrigin).toString()} />
))}
{/* zh-TW is written for Hong Kong readers, so also declare it as zh-HK. */}
{alternateLanguages.includes('zh-TW') && (
  <link rel="alternate" hreflang="zh-HK" href={new URL(`${cleanBasePath}/zh-TW${cleanPathWithoutLang}`.replace(/\/+/g, '/'), siteOrigin).toString()} />
)}
<link rel="alternate" hreflang="x-default" href={new URL(`${cleanBasePath}/zh-TW${cleanPathWithoutLang}`.replace(/\/+/g, '/'), siteOrigin).toString()} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={article ? "article" : "website"} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:site_name" content="Barista Flow" />
<meta property="og:locale" content={currentLang === 'zh-TW' ? 'zh_HK' : 'en_US'} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- JSON-LD (Schema.org) for Rich Snippets -->
{jsonld && (
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonld)} />
)}
