---
interface Props {
  title: string;
  description: string;
  image?: string;
  article?: boolean;
  jsonld?: any;
}

const {
  title,
  description,
  image = "/images/og-default.jpg",
  article = false,
  jsonld
} = Astro.props;

// Determine canonical URL dynamically
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://baristaflow.com');

// Ensure image path respects the base URL if it starts with a slash
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const safeImage = image.startsWith('/') ? base + image.slice(1) : image;
const ogImageUrl = new URL(safeImage, Astro.url);
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={article ? "article" : "website"} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImageUrl} />

<!-- JSON-LD (Schema.org) for Rich Snippets -->
{jsonld && (
  <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
)}
