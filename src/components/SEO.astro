---
import { SITE_URL } from '../config.js';
import { languages } from '../i18n/ui';
interface Props {
  title: string;
  description: string;
  image?: string;
  article?: boolean;
  jsonld?: any;
  keywords?: string;
}


const {
  title,
  description,
  image = "/images/og-default.jpg",
  article = false,
  jsonld,
  keywords = "coffee timer, pour over ratio calculator, V60 brewing assistant, coffee weight calculator, 手沖計時器, 精品咖啡, 粉水比計算"
} = Astro.props;

const siteParsed = new URL(SITE_URL);
const siteOrigin = siteParsed.origin;
const basePath = siteParsed.pathname === '/' ? '' : siteParsed.pathname;

let currentPath = Astro.url.pathname;
// Remove base path to get clean path
if (basePath && currentPath.startsWith(basePath)) {
  currentPath = currentPath.slice(basePath.length);
}

// Find and strip the current locale from path
const currentLang = Astro.params.lang || 'zh-TW';
let pathWithoutLang = currentPath;
if (pathWithoutLang.startsWith(`/${currentLang}/`)) {
  pathWithoutLang = pathWithoutLang.slice(currentLang.length + 1);
} else if (pathWithoutLang === `/${currentLang}`) {
  pathWithoutLang = '/';
}

const canonicalURL = new URL(basePath + `/${currentLang}` + (pathWithoutLang === '/' ? '/' : pathWithoutLang), siteOrigin).toString();

const base = basePath.endsWith('/') ? basePath : basePath + '/';
const safeImage = image.startsWith('/') ? base + image.slice(1) : image;
const ogImageUrl = new URL(safeImage, siteOrigin).toString();
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<link rel="canonical" href={canonicalURL} />

<!-- International Hreflang Matrix -->
{Object.keys(languages).map((l) => (
  <link rel="alternate" hreflang={l} href={new URL(basePath + `/${l}` + (pathWithoutLang === '/' ? '/' : pathWithoutLang), siteOrigin).toString()} />
))}
<link rel="alternate" hreflang="x-default" href={new URL(basePath + '/en' + (pathWithoutLang === '/' ? '/' : pathWithoutLang), siteOrigin).toString()} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={article ? "article" : "website"} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImageUrl} />

<!-- JSON-LD (Schema.org) for Rich Snippets -->
{jsonld && (
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonld)} />
)}
