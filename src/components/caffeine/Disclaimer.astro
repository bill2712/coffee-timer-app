---
import { useCaffeineT } from '../../i18n/caffeine';

interface Props {
  lang: string;
  class?: string;
}

const { lang, class: className = '' } = Astro.props;
const t = useCaffeineT(lang);
---

<p class={`cc-disclaimer ${className}`} role="note">
  <span aria-hidden="true">ℹ️</span>
  <span><strong>{t('disclaimer.label')}:</strong> {t('disclaimer')}</span>
</p>

<style>
  .cc-disclaimer { display: flex; gap: .6rem; align-items: flex-start; margin: 0; border: 1px solid color-mix(in srgb, var(--color-coffee-sand) 25%, transparent); border-radius: .9rem; background: color-mix(in srgb, var(--color-coffee-sand) 7%, transparent); padding: .75rem 1rem; color: var(--color-coffee-sand); font-size: .85rem; line-height: 1.55; }
  .cc-disclaimer strong { color: var(--color-coffee-light); }
</style>
