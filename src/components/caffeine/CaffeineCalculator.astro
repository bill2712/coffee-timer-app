---
/**
 * Caffeine calculator UI shell. All behaviour lives in src/lib/caffeine/app.ts;
 * this file renders accessible, server-side markup with stable sizes (no layout
 * shift when the script fills in the numbers).
 */
import { caffeineStrings, caffeineLang, useCaffeineT } from '../../i18n/caffeine';
import { DRINKS, CUSTOM_DRINK_ID } from '../../lib/caffeine/drinks';
import { SUPPORT_URL } from '../../config/monetization';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useCaffeineT(lang);
const dict = caffeineStrings[caffeineLang(lang)];
const i18nJson = JSON.stringify(dict).replace(/</g, '\\u003c');
const quickDrinks = DRINKS.filter((d) => d.quick);
---

<div id="cc-app" class="cc" data-lang={lang} data-support-url={SUPPORT_URL}>
  <script is:inline type="application/json" id="cc-i18n" set:html={i18nJson} />

  <p id="cc-storage-warning" class="cc-alert cc-alert-warn mb-4" role="status" hidden>{t('privacy.storageOff')}</p>
  <noscript><p class="cc-alert cc-alert-warn mb-4">JavaScript is required for the calculator. 計算器需要啟用 JavaScript。</p></noscript>

  <div class="flex flex-col gap-5 lg:grid lg:grid-cols-12 lg:items-start lg:gap-6">
    <!-- Results column (desktop left) -->
    <div class="contents lg:col-span-7 lg:flex lg:flex-col lg:gap-6">
      <section id="cc-dashboard" class="cc-card order-1" aria-labelledby="cc-dash-title">
        <h2 id="cc-dash-title" class="cc-eyebrow">{t('dash.heading')}</h2>
        <div class="mt-3 flex flex-wrap items-end gap-x-3 gap-y-1">
          <p class="m-0 leading-none">
            <span class="sr-only">{t('dash.now.label')}: </span>
            <output id="cc-now" class="cc-big" aria-live="off">0</output>
            <span class="cc-big-unit">{t('dash.unit')}</span>
          </p>
          <p class="mb-2 text-sm text-coffee-muted">{t('dash.now.label')} · {t('dash.now.sub')}</p>
        </div>
        <p id="cc-trend" class="mt-2 min-h-[2.75rem] text-sm font-medium text-coffee-sand sm:min-h-[1.5rem]">{t('dash.trend.none')}</p>

        <dl class="mt-5 grid gap-3 sm:grid-cols-3">
          <div class="cc-stat">
            <dt id="cc-bed-label" class="cc-stat-label">{t('dash.bedtime.label', { time: '23:00' })}</dt>
            <dd class="m-0">
              <span class="cc-stat-value"><span id="cc-bed-mg">0</span> <small>{t('dash.unit')}</small></span>
              <span id="cc-bed-status" class="cc-badge cc-good mt-2">{t('dash.status.good')}</span>
              <span id="cc-bed-note" class="cc-stat-note"></span>
            </dd>
          </div>
          <div class="cc-stat">
            <dt class="cc-stat-label">{t('dash.lastcall.label')}</dt>
            <dd class="m-0">
              <span id="cc-lastcall" class="cc-stat-value">—</span>
              <span id="cc-lastcall-note" class="cc-stat-note">{t('dash.lastcall.note', { mg: 50 })}</span>
            </dd>
          </div>
          <div class="cc-stat">
            <dt class="cc-stat-label">{t('dash.today.label')}</dt>
            <dd class="m-0">
              <span id="cc-today" class="cc-stat-value">{t('dash.today.value', { mg: 0, limit: 400 })}</span>
              <span class="cc-progress mt-2" id="cc-progress" role="progressbar" aria-label={t('dash.progress')} aria-valuemin="0" aria-valuemax="400" aria-valuenow="0">
                <span id="cc-progress-bar" style="width:0%"></span>
              </span>
              <span class="cc-stat-note">{t('dash.today.note')}</span>
            </dd>
          </div>
        </dl>
        <div id="cc-warnings" class="mt-4 space-y-3" aria-live="polite"></div>
      </section>

      <section id="cc-chart-card" class="cc-card order-3" aria-labelledby="cc-chart-title">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h2 id="cc-chart-title" class="cc-h2">{t('chart.heading')}</h2>
        </div>
        <p id="cc-chart-hint" class="mt-1 text-xs text-coffee-muted">{t('chart.desc')}</p>
        <div class="cc-chart-wrap mt-3">
          <div id="cc-chart" class="cc-chart" tabindex="0" role="img" aria-label={t('chart.label')} aria-describedby="cc-chart-summary cc-chart-hint"></div>
          <div id="cc-tooltip" class="cc-tooltip" hidden></div>
        </div>
        <p id="cc-chart-summary" class="sr-only" aria-live="polite">{t('chart.summary.empty')}</p>
        <ul class="cc-legend mt-3" aria-hidden="true">
          <li><span class="cc-key cc-key-curve"></span>{t('chart.legend.curve')}</li>
          <li id="cc-legend-ghost" hidden><span class="cc-key cc-key-ghost"></span>{t('chart.legend.ghost')}</li>
          <li><span class="cc-key cc-key-threshold"></span>{t('chart.legend.threshold')}</li>
          <li><span class="cc-key cc-key-bedtime"></span>{t('chart.legend.bedtime')}</li>
          <li><span class="cc-key cc-key-now"></span>{t('chart.legend.now')}</li>
          <li><span class="cc-key cc-key-dose"></span>{t('chart.legend.dose')}</li>
        </ul>
      </section>

      <section id="cc-whatif" class="cc-card order-4" aria-labelledby="cc-whatif-title">
        <h2 id="cc-whatif-title" class="cc-h2">{t('whatif.heading')}</h2>
        <p class="mt-1 text-sm text-coffee-muted">{t('whatif.intro')}</p>
        <div class="mt-4 grid gap-3 sm:grid-cols-[1.4fr_1fr_1fr]">
          <label class="cc-field">
            <span>{t('whatif.drink')}</span>
            <select id="cc-wi-drink" class="cc-input">
              <option value="">—</option>
              {DRINKS.map((d) => <option value={d.id}>{d.emoji} {t(`drink.${d.id}` as any)}</option>)}
            </select>
          </label>
          <label class="cc-field">
            <span>{t('whatif.mg')}</span>
            <input id="cc-wi-mg" class="cc-input" type="number" inputmode="decimal" min="1" max="3000" step="1" />
          </label>
          <label class="cc-field">
            <span>{t('whatif.time')}</span>
            <input id="cc-wi-time" class="cc-input" type="time" step="300" />
          </label>
        </div>
        <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
          <p id="cc-wi-result" class="m-0 text-sm leading-6 text-coffee-sand" aria-live="polite">{t('whatif.idle')}</p>
          <button id="cc-wi-clear" type="button" class="cc-btn cc-btn-ghost shrink-0" hidden>{t('whatif.clear')}</button>
        </div>
      </section>

      <section id="cc-share" class="cc-card order-6" aria-labelledby="cc-share-title">
        <h2 id="cc-share-title" class="cc-h2">{t('share.heading')}</h2>
        <p class="mt-1 text-sm text-coffee-muted">{t('share.intro')}</p>
        <div class="mt-4 grid grid-cols-2 gap-3">
          <button type="button" class="cc-btn cc-btn-outline" data-share-format="story">📱 {t('share.story')}</button>
          <button type="button" class="cc-btn cc-btn-outline" data-share-format="square">🟫 {t('share.square')}</button>
        </div>
        <div id="cc-share-result" class="mt-4" hidden>
          <img id="cc-share-img" alt={t('share.alt')} class="cc-share-preview" width="1080" height="1920" decoding="async" />
          <div class="mt-3 grid grid-cols-2 gap-3">
            <a id="cc-share-download" class="cc-btn cc-btn-primary" download="my-caffeine-today.png" href="#">⬇️ {t('share.download')}</a>
            <button id="cc-share-native" type="button" class="cc-btn cc-btn-outline" hidden>↗️ {t('share.share')}</button>
          </div>
        </div>
        <p id="cc-share-error" class="cc-error mt-3" role="alert" hidden>{t('share.error')}</p>
      </section>
    </div>

    <!-- Input column (desktop right) -->
    <div class="contents lg:col-span-5 lg:flex lg:flex-col lg:gap-6">
      <section id="cc-log" class="cc-card order-2" aria-labelledby="cc-log-title">
        <h2 id="cc-log-title" class="cc-h2">{t('log.heading')}</h2>
        <p class="mt-1 text-xs font-semibold uppercase tracking-wider text-coffee-muted">{t('log.quick')}</p>
        <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-2 xl:grid-cols-3" id="cc-quick">
          {quickDrinks.map((d) => (
            <button type="button" class="cc-quick" data-drink={d.id} aria-label={t('log.quickAria', { drink: t(`drink.${d.id}` as any), mg: d.mg })}>
              <span class="text-xl" aria-hidden="true">{d.emoji}</span>
              <span class="cc-quick-name">{t(`drink.${d.id}` as any)}</span>
              <span class="cc-quick-mg">~{d.mg} {t('dash.unit')}</span>
            </button>
          ))}
          <a href="#cc-form" class="cc-quick cc-quick-more" id="cc-more">
            <span class="text-xl" aria-hidden="true">➕</span>
            <span class="cc-quick-name">{t('log.details')}</span>
          </a>
        </div>

        <details id="cc-details" class="cc-details mt-4">
          <summary>{t('log.details')}</summary>
          <form id="cc-form" class="mt-4 grid gap-3" novalidate>
            <p id="cc-editing" class="cc-alert cc-alert-info m-0" hidden></p>
            <label class="cc-field">
              <span>{t('log.drink')}</span>
              <select id="cc-drink" class="cc-input">
                {DRINKS.map((d) => <option value={d.id} data-mg={d.mg}>{d.emoji} {t(`drink.${d.id}` as any)} · {t(`drink.${d.id}.size` as any)}</option>)}
                <option value={CUSTOM_DRINK_ID}>✏️ {t('drink.custom')}</option>
              </select>
            </label>
            <label class="cc-field" id="cc-name-field" hidden>
              <span>{t('log.name')}</span>
              <input id="cc-name" class="cc-input" type="text" maxlength="60" autocomplete="off" placeholder={t('log.name.placeholder')} />
            </label>
            <label class="cc-field">
              <span>{t('log.mg')}</span>
              <input id="cc-mg" class="cc-input" type="number" inputmode="decimal" min="1" max="3000" step="1" required aria-describedby="cc-mg-hint cc-mg-error" />
              <small id="cc-mg-hint" class="cc-hint"></small>
              <small id="cc-mg-error" class="cc-error" hidden></small>
            </label>
            <div class="grid grid-cols-2 gap-3">
              <label class="cc-field">
                <span>{t('log.time')}</span>
                <input id="cc-time" class="cc-input" type="time" required aria-describedby="cc-time-error" />
              </label>
              <label class="cc-field">
                <span>{t('log.day')}</span>
                <select id="cc-day" class="cc-input">
                  <option value="0">{t('log.day.today')}</option>
                  <option value="-1">{t('log.day.yesterday')}</option>
                </select>
              </label>
            </div>
            <small id="cc-time-error" class="cc-error" hidden></small>
            <div class="flex flex-wrap gap-3">
              <button id="cc-submit" type="submit" class="cc-btn cc-btn-primary flex-1">{t('log.submit')}</button>
              <button id="cc-cancel" type="button" class="cc-btn cc-btn-ghost" hidden>{t('log.cancel')}</button>
            </div>
          </form>
        </details>

        <h3 class="mt-6 text-sm font-bold uppercase tracking-wider text-coffee-sand">{t('log.list.heading')}</h3>
        <div id="cc-empty" class="cc-empty mt-3">
          <p class="text-3xl" aria-hidden="true">☕️</p>
          <p class="mt-2 font-semibold text-coffee-light">{t('log.empty.title')}</p>
          <p class="mt-1 text-sm leading-6 text-coffee-muted">{t('log.empty.body')}</p>
        </div>
        <div id="cc-list" class="mt-3"></div>

        <aside id="cc-support" class="cc-support mt-5" hidden aria-label={t('support.cta')}>
          <p class="m-0 text-sm leading-6 text-coffee-light">{t('support.text')}</p>
          <div class="mt-3 flex items-center gap-3">
            <a id="cc-support-link" class="cc-btn cc-btn-primary" href={SUPPORT_URL} target="_blank" rel="noopener noreferrer">☕ {t('support.cta')}</a>
            <button id="cc-support-dismiss" type="button" class="cc-btn cc-btn-ghost" aria-label={t('support.dismiss')}>✕ {t('support.dismiss')}</button>
          </div>
        </aside>
      </section>

      <section id="cc-settings" class="cc-card order-5" aria-labelledby="cc-settings-title">
        <h2 id="cc-settings-title" class="cc-h2">{t('settings.heading')}</h2>
        <form id="cc-settings-form" class="mt-4 grid gap-5" novalidate>
          <label class="cc-field">
            <span>{t('settings.bedtime')}</span>
            <input id="cc-set-bedtime" class="cc-input" type="time" value="23:00" />
          </label>

          <fieldset class="cc-field">
            <legend class="flex w-full items-baseline justify-between gap-2">
              <span>{t('settings.halflife')}</span>
              <output id="cc-set-halflife-value" for="cc-set-halflife" class="font-bold text-coffee-gold">{t('settings.halflife.value', { h: 5 })}</output>
            </legend>
            <div class="mt-2 grid gap-2 sm:grid-cols-3 lg:grid-cols-1 xl:grid-cols-3" role="group" aria-label={t('settings.halflife')}>
              <button type="button" class="cc-chip" data-halflife="3" aria-pressed="false">{t('settings.preset.fast')}</button>
              <button type="button" class="cc-chip" data-halflife="5" aria-pressed="true">{t('settings.preset.avg')}</button>
              <button type="button" class="cc-chip" data-halflife="7" aria-pressed="false">{t('settings.preset.slow')}</button>
            </div>
            <input id="cc-set-halflife" class="cc-range mt-3" type="range" min="2" max="10" step="0.5" value="5" aria-label={t('settings.halflife')} aria-describedby="cc-halflife-help" />
            <div class="flex justify-between text-[11px] text-coffee-muted" aria-hidden="true"><span>2 h</span><span>10 h</span></div>
            <small id="cc-halflife-help" class="cc-hint">{t('settings.halflife.help')}</small>
          </fieldset>

          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
            <label class="cc-field">
              <span>{t('settings.threshold')}</span>
              <input id="cc-set-threshold" class="cc-input" type="number" inputmode="numeric" min="5" max="400" step="5" value="50" aria-describedby="cc-threshold-help cc-threshold-error" />
              <small id="cc-threshold-help" class="cc-hint">{t('settings.threshold.help')}</small>
              <small id="cc-threshold-error" class="cc-error" hidden></small>
            </label>
            <label class="cc-field">
              <span>{t('settings.limit')}</span>
              <input id="cc-set-limit" class="cc-input" type="number" inputmode="numeric" min="50" max="2000" step="10" value="400" aria-describedby="cc-limit-help cc-limit-error" />
              <small id="cc-limit-help" class="cc-hint">{t('settings.limit.help')}</small>
              <small id="cc-limit-error" class="cc-error" hidden></small>
            </label>
          </div>

          <fieldset class="cc-field">
            <legend>{t('settings.timeformat')}</legend>
            <div class="mt-2 grid grid-cols-3 gap-2" role="radiogroup" aria-label={t('settings.timeformat')}>
              <label class="cc-chip"><input type="radio" name="cc-timeformat" value="auto" class="sr-only" checked />{t('settings.timeformat.auto')}</label>
              <label class="cc-chip"><input type="radio" name="cc-timeformat" value="12" class="sr-only" />{t('settings.timeformat.12')}</label>
              <label class="cc-chip"><input type="radio" name="cc-timeformat" value="24" class="sr-only" />{t('settings.timeformat.24')}</label>
            </div>
          </fieldset>
        </form>

        <div class="cc-privacy mt-6">
          <h3 class="text-sm font-bold text-coffee-light">🔒 {t('privacy.heading')}</h3>
          <p class="mt-1 text-xs leading-5 text-coffee-muted">{t('privacy.body')}</p>
          <button id="cc-clear" type="button" class="cc-btn cc-btn-danger mt-3">{t('privacy.clear')}</button>
        </div>
      </section>
    </div>
  </div>

  <dialog id="cc-confirm" class="cc-dialog" aria-labelledby="cc-confirm-title" aria-describedby="cc-confirm-body">
    <form method="dialog">
      <h2 id="cc-confirm-title" class="cc-h2">{t('privacy.confirm.title')}</h2>
      <p id="cc-confirm-body" class="mt-2 text-sm leading-6 text-coffee-sand">{t('privacy.confirm.body')}</p>
      <div class="mt-5 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
        <button value="cancel" class="cc-btn cc-btn-ghost" autofocus>{t('privacy.confirm.no')}</button>
        <button value="confirm" class="cc-btn cc-btn-danger-solid">{t('privacy.confirm.yes')}</button>
      </div>
    </form>
  </dialog>

  <div id="cc-toast" class="cc-toast" role="status" aria-live="polite" hidden>
    <span id="cc-toast-text"></span>
    <button id="cc-toast-undo" type="button" class="cc-toast-btn" hidden>{t('log.undo')}</button>
  </div>
</div>

<script>
  import { initCaffeineApp } from '../../lib/caffeine/app';
  initCaffeineApp();
</script>

<style is:global>
  .cc {
    --cc-good: #86d49c;
    --cc-warn: #f2c94c;
    --cc-bad: #f19a90;
    --cc-ghost: #a9bcff;
    --cc-card-bg: rgb(28 24 21 / 0.62);
    --cc-card-border: rgb(197 168 128 / 0.16);
    --cc-input-bg: rgb(10 8 7 / 0.6);
  }
  @media (prefers-color-scheme: light) {
    html.theme-auto .cc {
      --cc-good: #1c6e38;
      --cc-warn: #7a5000;
      --cc-bad: #a8251a;
      --cc-ghost: #2f4fb8;
      --cc-card-bg: rgb(255 255 255 / 0.8);
      --cc-card-border: rgb(106 74 42 / 0.16);
      --cc-input-bg: #fffdf9;
    }
  }
  .cc { hyphens: manual; }
  .cc-card { border: 1px solid var(--cc-card-border); border-radius: 1.25rem; background: var(--cc-card-bg); padding: 1.25rem; box-shadow: 0 10px 30px rgb(0 0 0 / 0.08); }
  @media (min-width: 640px) { .cc-card { padding: 1.5rem; } }
  .cc-eyebrow { margin: 0; color: var(--color-coffee-gold); font-size: .75rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
  .cc-h2 { margin: 0; color: var(--color-coffee-light); font-family: var(--font-display); font-size: 1.35rem; font-weight: 700; line-height: 1.25; }
  .cc-big { display: inline-block; color: var(--color-coffee-light); font-size: clamp(3.5rem, 15vw, 5.25rem); font-weight: 700; font-variant-numeric: tabular-nums; letter-spacing: -0.03em; line-height: 1; }
  .cc-big-unit { margin-inline-start: .35rem; color: var(--color-coffee-sand); font-size: 1.5rem; font-weight: 600; }
  .cc-stat { display: grid; align-content: start; gap: .35rem; min-height: 8.5rem; border: 1px solid var(--cc-card-border); border-radius: 1rem; background: color-mix(in srgb, var(--color-coffee-darker) 55%, transparent); padding: .9rem 1rem; }
  .cc-stat-label { color: var(--color-coffee-muted); font-size: .75rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .cc-stat-value { display: block; color: var(--color-coffee-light); font-size: 1.6rem; font-weight: 700; font-variant-numeric: tabular-nums; line-height: 1.15; }
  .cc-stat-value small { color: var(--color-coffee-sand); font-size: .9rem; font-weight: 600; }
  .cc-stat-note { display: block; margin-top: .35rem; color: var(--color-coffee-muted); font-size: .75rem; line-height: 1.45; }
  .cc-badge { display: inline-flex; align-items: center; border-radius: 999px; padding: .2rem .6rem; font-size: .8rem; font-weight: 700; }
  .cc-good { background: color-mix(in srgb, var(--cc-good) 16%, transparent); color: var(--cc-good); }
  .cc-borderline { background: color-mix(in srgb, var(--cc-warn) 18%, transparent); color: var(--cc-warn); }
  .cc-high { background: color-mix(in srgb, var(--cc-bad) 16%, transparent); color: var(--cc-bad); }
  .cc-progress { display: block; height: .55rem; overflow: hidden; border-radius: 999px; background: color-mix(in srgb, var(--color-coffee-sand) 20%, transparent); }
  .cc-progress > span { display: block; height: 100%; border-radius: inherit; background: var(--color-coffee-gold); transition: width .4s ease; }
  .cc-progress.is-over > span { background: var(--cc-bad); }
  .cc-alert { border-radius: .85rem; border: 1px solid; padding: .8rem 1rem; font-size: .875rem; line-height: 1.55; }
  .cc-alert-warn { border-color: color-mix(in srgb, var(--cc-warn) 45%, transparent); background: color-mix(in srgb, var(--cc-warn) 10%, transparent); color: var(--color-coffee-light); }
  .cc-alert-danger { border-color: color-mix(in srgb, var(--cc-bad) 55%, transparent); background: color-mix(in srgb, var(--cc-bad) 12%, transparent); color: var(--color-coffee-light); }
  .cc-alert-info { border-color: var(--cc-card-border); background: color-mix(in srgb, var(--color-coffee-gold) 8%, transparent); color: var(--color-coffee-light); }
  .cc-field { display: grid; gap: .35rem; min-width: 0; border: 0; margin: 0; padding: 0; color: var(--color-coffee-sand); font-size: .85rem; font-weight: 600; }
  .cc-input { min-height: 48px; width: 100%; border: 1px solid var(--cc-card-border); border-radius: .75rem; background: var(--cc-input-bg); padding: .6rem .8rem; color: var(--color-coffee-light); font-size: 1rem; font-weight: 500; color-scheme: inherit; }
  .cc-input:focus-visible, .cc-range:focus-visible { outline: 2px solid var(--color-coffee-gold); outline-offset: 2px; }
  .cc-input[aria-invalid="true"] { border-color: var(--cc-bad); }
  .cc-hint { color: var(--color-coffee-muted); font-size: .75rem; font-weight: 400; line-height: 1.45; }
  .cc-error { color: var(--cc-bad); font-size: .8rem; font-weight: 600; }
  .cc-range { width: 100%; min-height: 44px; accent-color: var(--color-coffee-gold); }
