---
export interface Props {
  defaultRecipe?: {
    beanName?: string;
    roastLevel?: string;
    grindSize?: string;
    waterTemp?: number;
    coffeeWeight?: number;
    waterRatio?: number;
  };
  ignoreLocalStorage?: boolean;
}

const { defaultRecipe, ignoreLocalStorage = false } = Astro.props;
---

<div class="backdrop-blur-xl bg-coffee-dark/50 border border-coffee-sand/10 shadow-xl shadow-coffee-darker/50 rounded-3xl p-5 sm:p-8 flex flex-col gap-7 transition-all duration-500">
  <div>
    <h2 class="font-display text-2xl font-bold tracking-wide text-coffee-gold flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
      </svg>
      設定沖煮參數
    </h2>
    <p class="text-xs text-coffee-muted mt-1">調整您的咖啡豆與沖煮細節，計時器將會自動調整比例。</p>
  </div>

  <form id="recipe-form" class="space-y-5" onsubmit="return false;" data-default-recipe={JSON.stringify(defaultRecipe || null)} data-ignore-local={ignoreLocalStorage ? "true" : "false"}>
    <!-- Coffee Beans & Roast -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="relative bg-coffee-darker border border-coffee-sand/15 rounded-2xl transition-all duration-300 focus-within:ring-2 focus-within:ring-coffee-gold/50 focus-within:border-coffee-gold h-16 flex items-end pb-2 px-3 hover:shadow-md">
        <input
          type="text"
          id="bean-name"
          class="peer w-full bg-transparent font-display text-base text-coffee-light focus:outline-none placeholder-transparent"
          placeholder="咖啡豆名稱"
          aria-label="咖啡豆名稱"
        />
        <label
          for="bean-name"
          class="absolute left-3 top-2 text-[10px] sm:text-xs font-semibold uppercase tracking-wider text-coffee-sand transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:top-5 peer-placeholder-shown:text-coffee-muted peer-focus:top-2 peer-focus:text-[10px] peer-focus:text-coffee-gold cursor-text"
        >
          咖啡豆 (Beans)
        </label>
      </div>

      <div class="relative bg-coffee-darker border border-coffee-sand/15 rounded-2xl transition-all duration-300 focus-within:ring-2 focus-within:ring-coffee-gold/50 focus-within:border-coffee-gold h-16 flex items-end pb-2 px-3 hover:shadow-md">
        <select id="roast-level" class="peer w-full bg-transparent font-display text-base text-coffee-light focus:outline-none appearance-none" aria-label="烘焙度">
          <option value="light">淺度烘焙 (Roast: Light)</option>
          <option value="medium" selected>中度烘焙 (Roast: Medium)</option>
          <option value="dark">深度烘焙 (Roast: Dark)</option>
        </select>
        <label for="roast-level" class="absolute left-3 top-2 text-[10px] sm:text-xs font-semibold uppercase tracking-wider text-coffee-gold pointer-events-none">
          烘焙度 (Roast)
        </label>
      </div>
    </div>

    <!-- Numbers Grid -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="relative bg-coffee-darker border border-coffee-sand/15 rounded-2xl transition-all duration-300 focus-within:ring-2 focus-within:ring-coffee-gold/50 focus-within:border-coffee-gold h-16 flex items-end pb-2 px-3 hover:shadow-md">
        <input
          type="number"
          id="coffee-weight"
          step="0.1"
          min="1"
          class="peer w-full bg-transparent font-mono text-lg text-coffee-light focus:outline-none text-right"
          value="15"
          aria-label="粉重 (g)"
        />
        <label class="absolute left-3 top-2 text-[10px] font-semibold uppercase tracking-wider text-coffee-sand">粉重 (g)</label>
        <span class="absolute right-3 top-2 text-[10px] text-coffee-muted">Weight</span>
      </div>

      <div class="relative bg-coffee-darker border border-coffee-sand/15 rounded-2xl transition-all duration-300 focus-within:ring-2 focus-within:ring-coffee-gold/50 focus-within:border-coffee-gold h-16 flex items-end pb-2 px-3 hover:shadow-md">
        <input
          type="number"
          id="water-ratio"
          step="0.5"
          min="5"
          class="peer w-full bg-transparent font-mono text-lg text-coffee-light focus:outline-none text-right"
          value="15"
          aria-label="粉水比 (1:X)"
        />
        <label class="absolute left-3 top-2 text-[10px] font-semibold uppercase tracking-wider text-coffee-sand">粉水比 (1:X)</label>
        <span class="absolute right-3 top-2 text-[10px] text-coffee-muted">Ratio</span>
      </div>

      <div class="relative bg-coffee-darker border border-coffee-sand/15 rounded-2xl transition-all duration-300 focus-within:ring-2 focus-within:ring-coffee-gold/50 focus-within:border-coffee-gold h-16 flex items-end pb-2 px-3 hover:shadow-md">
        <input
          type="number"
          id="water-temp"
          min="80" max="100" value="92"
          class="peer w-full bg-transparent font-display text-base text-coffee-light focus:outline-none placeholder-transparent"
          placeholder="92"
        />
        <label for="water-temp" class="absolute left-3 top-2 text-[10px] font-semibold uppercase tracking-wider text-coffee-sand">
          熱水溫度 (°C)
        </label>
        <span class="absolute right-4 bottom-2 text-coffee-muted text-sm font-medium">°C</span>
      </div>
    </div>

    <!-- Coffee Ratio & Water Amount Calc -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
      <!-- Coffee Weight Stepper -->
      <div>
        <div class="relative bg-coffee-darker border border-coffee-sand/15 rounded-2xl transition-all duration-300 focus-within:ring-2 focus-within:ring-coffee-gold/50 focus-within:border-coffee-gold h-16 flex items-center px-1 hover:shadow-md">
          <button type="button" id="btn-weight-minus" aria-label="減少咖啡粉量" class="w-12 h-12 flex-shrink-0 flex items-center justify-center rounded-xl text-coffee-sand hover:text-coffee-gold hover:bg-coffee-sand/10 active:scale-95 transition-all duration-150 ease-[cubic-bezier(0.34,1.56,0.64,1)] cursor-pointer outline-none">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20 12H4" /></svg>
          </button>
          
          <div class="relative flex-1 h-full flex flex-col justify-end pb-2">
            <input
              type="number"
              id="coffee-weight"
              min="5" max="100" step="0.5" value="20"
              class="peer w-full bg-transparent text-center font-display text-xl font-bold text-coffee-light focus:outline-none placeholder-transparent"
              placeholder="20"
            />
            <label for="coffee-weight" class="absolute left-1/2 -translate-x-1/2 top-2 text-[10px] font-semibold uppercase tracking-wider text-coffee-sand transition-all duration-300 pointer-events-none whitespace-nowrap">
              咖啡粉量 (g)
            </label>
          </div>

          <button type="button" id="btn-weight-plus" aria-label="增加咖啡粉量" class="w-12 h-12 flex-shrink-0 flex items-center justify-center rounded-xl text-coffee-sand hover:text-coffee-gold hover:bg-coffee-sand/10 active:scale-95 transition-all duration-150 ease-[cubic-bezier(0.34,1.56,0.64,1)] cursor-pointer outline-none">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
          </button>
        </div>
        <span id="weight-error" class="text-red-400 text-xs hidden ml-2 mt-1">請輸入有效的正數</span>
      </div>

      <!-- Water Ratio Stepper -->
      <div>
        <div class="relative bg-coffee-darker border border-coffee-sand/15 rounded-2xl transition-all duration-300 focus-within:ring-2 focus-within:ring-coffee-gold/50 focus-within:border-coffee-gold h-16 flex items-center px-1 hover:shadow-md">
          <button type="button" id="btn-ratio-minus" aria-label="減少粉水比例" class="w-12 h-12 flex-shrink-0 flex items-center justify-center rounded-xl text-coffee-sand hover:text-coffee-gold hover:bg-coffee-sand/10 active:scale-95 transition-all duration-150 ease-[cubic-bezier(0.34,1.56,0.64,1)] cursor-pointer outline-none">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20 12H4" /></svg>
          </button>
          
          <div class="relative flex-1 h-full flex flex-col justify-end pb-2">
            <input
              type="number"
              id="water-ratio"
              min="10" max="25" step="0.5" value="15"
              class="peer w-full bg-transparent text-center font-display text-xl font-bold text-coffee-light focus:outline-none placeholder-transparent"
              placeholder="15"
            />
            <label for="water-ratio" class="absolute left-1/2 -translate-x-1/2 top-2 text-[10px] font-semibold uppercase tracking-wider text-coffee-sand transition-all duration-300 pointer-events-none whitespace-nowrap">
              粉水比例 (1:X)
            </label>
          </div>

          <button type="button" id="btn-ratio-plus" aria-label="增加粉水比例" class="w-12 h-12 flex-shrink-0 flex items-center justify-center rounded-xl text-coffee-sand hover:text-coffee-gold hover:bg-coffee-sand/10 active:scale-95 transition-all duration-150 ease-[cubic-bezier(0.34,1.56,0.64,1)] cursor-pointer outline-none">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
          </button>
        </div>
        <span id="ratio-error" class="text-red-400 text-xs hidden ml-2 mt-1">請輸入有效的比例</span>
      </div>
    </div>

    <!-- Summary Box -->
    <div class="bg-coffee-darker/60 border border-coffee-sand/10 rounded-xl p-4 flex justify-between items-center mt-6">
      <div>
        <p class="text-xs text-coffee-muted uppercase tracking-wider">預估總注水量</p>
        <h3 class="text-3xl font-display font-bold text-coffee-gold mt-1">
          <span id="total-water">300</span> <span class="text-sm font-sans font-medium text-coffee-light/80">ml (g)</span>
        </h3>
      </div>
      <div class="text-right">
        <p class="text-xs text-coffee-muted uppercase tracking-wider">金杯萃取區間</p>
        <p class="text-sm text-coffee-sand font-medium mt-1">1:15 經典黃金比</p>
      </div>
    </div>

    <!-- Actions -->
    <div class="flex flex-col gap-3">
      <button
        type="button"
        id="btn-apply-recipe"
        class="w-full bg-gradient-to-r from-coffee-gold to-coffee-sand hover:from-coffee-gold-hover hover:to-coffee-gold text-coffee-dark font-semibold tracking-wide rounded-2xl py-4 shadow-lg shadow-coffee-gold/20 hover:shadow-xl hover:shadow-coffee-gold/40 hover:-translate-y-1 transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-coffee-gold cursor-pointer text-center text-sm disabled:opacity-50 disabled:cursor-not-allowed"
      >
        套用設定並同步計時器
      </button>

      <div class="grid grid-cols-2 gap-3">
        <button
          type="button"
          id="btn-save-history"
          class="bg-coffee-darker border border-coffee-sand/20 hover:border-coffee-gold text-coffee-sand hover:text-coffee-light rounded-lg py-3 min-h-[48px] text-xs font-medium transition-all duration-200 ease-out flex items-center justify-center gap-1.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-coffee-dark focus-visible:ring-coffee-gold active:scale-[0.98]"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
          </svg>
          存入我的最愛
        </button>
        <button
          type="button"
          id="btn-share-url"
          class="bg-coffee-darker border border-coffee-sand/20 hover:border-coffee-gold text-coffee-sand hover:text-coffee-light rounded-lg py-3 min-h-[48px] text-xs font-medium transition-all duration-200 ease-out flex items-center justify-center gap-1.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-coffee-dark focus-visible:ring-coffee-gold active:scale-[0.98]"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
          </svg>
          分享此配方
        </button>
      </div>
    </div>

    <!-- History Panel -->
    <div id="history-panel" class="hidden mt-6 pt-6 border-t border-coffee-sand/10">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-coffee-gold">我的配方庫</h3>
        <button type="button" id="btn-toggle-history" class="text-xs text-coffee-muted hover:text-coffee-light transition-colors">隱藏</button>
      </div>
      <div id="history-list" class="flex flex-col gap-3 max-h-[220px] overflow-y-auto pr-2 custom-scrollbar">
        <!-- History items generated by JS -->
      </div>
    </div>

    <!-- Toast Notification -->
    <div id="toast" class="fixed bottom-4 right-4 bg-coffee-dark text-coffee-light border border-coffee-gold/50 px-4 py-3 rounded-xl shadow-2xl transform translate-y-20 opacity-0 transition-all duration-200 ease-out z-50 flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-coffee-gold" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
      </svg>
      <span id="toast-msg" class="text-sm font-medium">通知訊息</span>
    </div>

  </form>
</div>

<style>
  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: rgba(42, 36, 32, 0.5);
    border-radius: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(197, 168, 128, 0.3);
    border-radius: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: rgba(197, 168, 128, 0.6);
  }
</style>

<script>
  // --- UI Elements ---
  const weightInput = document.getElementById('coffee-weight') as HTMLInputElement;
  const ratioInput = document.getElementById('water-ratio') as HTMLInputElement;
  const beanNameInput = document.getElementById('bean-name') as HTMLInputElement;
  const roastLevelInput = document.getElementById('roast-level') as HTMLSelectElement;
  const grindSizeInput = document.getElementById('grind-size') as HTMLInputElement;
  const waterTempInput = document.getElementById('water-temp') as HTMLInputElement;
  
  const btnWeightMinus = document.getElementById('btn-weight-minus');
  const btnWeightPlus = document.getElementById('btn-weight-plus');
  const btnRatioMinus = document.getElementById('btn-ratio-minus');
  const btnRatioPlus = document.getElementById('btn-ratio-plus');
  
  const totalWaterEl = document.getElementById('total-water');
  const btnApply = document.getElementById('btn-apply-recipe');
  const btnSaveHistory = document.getElementById('btn-save-history');
  const btnShareUrl = document.getElementById('btn-share-url');
  
  const historyPanel = document.getElementById('history-panel');
  const historyList = document.getElementById('history-list');
  const btnToggleHistory = document.getElementById('btn-toggle-history');
  
  const toast = document.getElementById('toast');
  const toastMsg = document.getElementById('toast-msg');

  // --- Core Functions ---
  function updateCalculations() {
    let isValid = true;
    if (weightInput && ratioInput && totalWaterEl) {
      // Force sanitize input strings: handle multiple decimals, empty strings
      let weightRaw = weightInput.value;
      let ratioRaw = ratioInput.value;
      
      let weight = parseFloat(weightRaw);
      let ratio = parseFloat(ratioRaw);
      
      // Validation Logic & Fail-safes
      const weightError = document.getElementById('weight-error');
      const ratioError = document.getElementById('ratio-error');

      // Check if input is empty or invalid mid-typing
      if (weightRaw === '' || isNaN(weight) || weight <= 0) {
        if (weightError && weightRaw !== '' && weightRaw !== '-') { // Only show error if they typed something invalid
          weightError.textContent = "咖啡粉量必須為正數，已重置";
          weightError.classList.remove('hidden');
          weightInput.classList.add('text-red-500');
          setTimeout(() => {
            weightInput.value = "15";
            weightInput.classList.remove('text-red-500');
            weightError?.classList.add('hidden');
            updateCalculations();
          }, 1500);
        }
        weight = 0; // Temporary state for calc so it doesn't output NaN
      } else {
        weightError?.classList.add('hidden');
        weightInput.classList.remove('text-red-500');
      }

      if (ratioRaw === '' || isNaN(ratio) || ratio <= 0) {
        if (ratioError && ratioRaw !== '' && ratioRaw !== '-') {
          ratioError.textContent = "粉水比例必須為正數，已重置";
          ratioError.classList.remove('hidden');
          ratioInput.classList.add('text-red-500');
          setTimeout(() => {
            ratioInput.value = "15";
            ratioInput.classList.remove('text-red-500');
            ratioError?.classList.add('hidden');
            updateCalculations();
          }, 1500);
        }
        ratio = 0;
      } else {
        ratioError?.classList.add('hidden');
        ratioInput.classList.remove('text-red-500');
      }

      if (isValid) {
        const totalWater = Math.round(weight * ratio);
        totalWaterEl.textContent = totalWater.toString();
        if (btnApply) btnApply.disabled = false;
      } else {
        totalWaterEl.textContent = '0';
        if (btnApply) btnApply.disabled = true;
      }
    }
    return isValid;
  }

  function getRecipeData() {
    return {
      id: Date.now().toString(), // unique id for history
      beanName: beanNameInput?.value || '自訂精品咖啡豆',
      roastLevel: roastLevelInput?.value || 'medium',
      grindSize: grindSizeInput?.value || '中等',
      waterTemp: parseInt(waterTempInput?.value) || 92,
      coffeeWeight: parseFloat(weightInput?.value) || 20,
      waterRatio: parseFloat(ratioInput?.value) || 15,
      totalWater: Math.round((parseFloat(weightInput?.value) || 20) * (parseFloat(ratioInput?.value) || 15))
    };
  }

  function applyRecipeData(recipe: any) {
    if (beanNameInput) beanNameInput.value = recipe.beanName || '';
    if (roastLevelInput) roastLevelInput.value = recipe.roastLevel || 'medium';
    if (grindSizeInput) grindSizeInput.value = recipe.grindSize || '';
    if (waterTempInput) waterTempInput.value = recipe.waterTemp || 92;
    if (weightInput) weightInput.value = recipe.coffeeWeight || 20;
    if (ratioInput) ratioInput.value = recipe.waterRatio || 15;
    updateCalculations();
  }

  function syncWithTimer(recipe: any) {
    localStorage.setItem('barista_flow_recipe', JSON.stringify(recipe));
    const event = new CustomEvent('coffee-recipe-changed', { detail: recipe });
    window.dispatchEvent(event);
  }

  function showToast(msg: string) {
    if (!toast || !toastMsg) return;
    toastMsg.textContent = msg;
    toast.classList.remove('translate-y-20', 'opacity-0');
    
    setTimeout(() => {
      toast.classList.add('translate-y-20', 'opacity-0');
    }, 3000);
  }

  // --- Share URL / Deep Linking ---
  function generateShareUrl() {
    const r = getRecipeData();
    const params = new URLSearchParams();
    params.set('bean', r.beanName);
    params.set('roast', r.roastLevel);
    params.set('grind', r.grindSize);
    params.set('t', r.waterTemp.toString());
    params.set('w', r.coffeeWeight.toString());
    params.set('r', r.waterRatio.toString());
    
    const url = `${window.location.origin}${window.location.pathname}?${params.toString()}`;
    
    navigator.clipboard.writeText(url).then(() => {
      showToast('網址已複製！快分享給朋友吧 ☕');
    }).catch(err => {
      console.error('Could not copy text: ', err);
      showToast('複製失敗，請手動複製網址。');
    });
  }

  function loadFromUrlQuery() {
    const params = new URLSearchParams(window.location.search);
    if (!params.has('w') && !params.has('bean')) return false;

    const queryRecipe = {
      beanName: params.get('bean') || '分享的配方',
      roastLevel: params.get('roast') || 'medium',
      grindSize: params.get('grind') || '',
      waterTemp: parseInt(params.get('t') as string) || 92,
      coffeeWeight: parseFloat(params.get('w') as string) || 20,
      waterRatio: parseFloat(params.get('r') as string) || 15,
      totalWater: 0
    };
    queryRecipe.totalWater = Math.round(queryRecipe.coffeeWeight * queryRecipe.waterRatio);
    
    applyRecipeData(queryRecipe);
    syncWithTimer(queryRecipe);
    
    // Clear URL to prevent reloading the same state
    window.history.replaceState({}, document.title, window.location.pathname);
    
    setTimeout(() => {
      showToast('已載入朋友分享的配方！');
    }, 500);
    return true;
  }

  // --- History Management ---
  function loadHistory(): any[] {
    const str = localStorage.getItem('barista_flow_history');
    return str ? JSON.parse(str) : [];
  }

  function saveToHistory() {
    const r = getRecipeData();
    const history = loadHistory();
    // Prepend new recipe
    history.unshift(r);
    // Keep only last 10
    if (history.length > 10) history.pop();
    localStorage.setItem('barista_flow_history', JSON.stringify(history));
    renderHistory();
    historyPanel?.classList.remove('hidden');
    showToast('配方已儲存至我的最愛！');
  }

  function deleteHistory(id: string) {
    let history = loadHistory();
    history = history.filter(h => h.id !== id);
    localStorage.setItem('barista_flow_history', JSON.stringify(history));
    renderHistory();
  }

  function renderHistory() {
    const history = loadHistory();
    if (!historyList) return;
    
    if (history.length === 0) {
      historyList.innerHTML = `
        <div class="flex flex-col items-center justify-center py-6 text-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-coffee-sand/30 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
          <p class="text-xs text-coffee-muted font-medium">目前沒有儲存的配方</p>
          <p class="text-[10px] text-coffee-muted/70 mt-1">調整參數並點擊「存入我的最愛」即可儲存！</p>
        </div>
      `;
      return;
    }

    historyList.innerHTML = '';
    history.forEach(item => {
      const div = document.createElement('div');
      div.className = 'flex items-center justify-between bg-coffee-dark border border-coffee-sand/10 p-3 rounded-lg hover:border-coffee-gold/40 transition-colors group cursor-pointer';
      
      let roastText = '中焙';
      if (item.roastLevel === 'light') roastText = '淺焙';
      if (item.roastLevel === 'dark') roastText = '深焙';

      div.innerHTML = `
        <div class="flex-1 min-w-0" onclick="window.loadHistoryItem('${item.id}')">
          <h4 class="text-sm font-semibold text-coffee-light truncate">${item.beanName}</h4>
          <p class="text-[10px] sm:text-xs text-coffee-muted mt-0.5">
            ${item.coffeeWeight}g 粉 | 1:${item.waterRatio} | ${item.waterTemp}°C | ${roastText}
          </p>
        </div>
        <button onclick="window.deleteHistoryItem('${item.id}')" class="p-2 text-coffee-muted hover:text-red-400 opacity-0 group-hover:opacity-100 transition-all" title="刪除" aria-label="刪除歷史紀錄">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
        </button>
      `;
      historyList.appendChild(div);
    });
  }

  // Expose to window for inline onclick handlers
  (window as any).loadHistoryItem = (id: string) => {
    const history = loadHistory();
    const item = history.find(h => h.id === id);
    if (item) {
      applyRecipeData(item);
      syncWithTimer(item);
      showToast('配方已載入！');
    }
  };

  (window as any).deleteHistoryItem = (id: string) => {
    deleteHistory(id);
  };

  // --- Initialization ---
  document.addEventListener('DOMContentLoaded', () => {
    // Bind base listeners
    if (weightInput) weightInput.addEventListener('input', updateCalculations);
    if (ratioInput) ratioInput.addEventListener('input', updateCalculations);
    
    // Stepper logic
    if (btnWeightMinus && weightInput) {
      btnWeightMinus.addEventListener('click', () => {
        let val = parseFloat(weightInput.value) || 20;
        if (val > parseFloat(weightInput.min)) {
          weightInput.value = (val - 0.5).toString();
          updateCalculations();
        }
      });
    }
    if (btnWeightPlus && weightInput) {
      btnWeightPlus.addEventListener('click', () => {
        let val = parseFloat(weightInput.value) || 20;
        if (val < parseFloat(weightInput.max)) {
          weightInput.value = (val + 0.5).toString();
          updateCalculations();
        }
      });
    }
    if (btnRatioMinus && ratioInput) {
      btnRatioMinus.addEventListener('click', () => {
        let val = parseFloat(ratioInput.value) || 15;
        if (val > parseFloat(ratioInput.min)) {
          ratioInput.value = (val - 0.5).toString();
          updateCalculations();
        }
      });
    }
    if (btnRatioPlus && ratioInput) {
      btnRatioPlus.addEventListener('click', () => {
        let val = parseFloat(ratioInput.value) || 15;
        if (val < parseFloat(ratioInput.max)) {
          ratioInput.value = (val + 0.5).toString();
          updateCalculations();
        }
      });
    }
    
    if (btnApply) {
      btnApply.addEventListener('click', () => {
        if (!updateCalculations()) return;
        syncWithTimer(getRecipeData());
        btnApply.textContent = '✓ 已同步設定！';
        btnApply.classList.add('bg-green-600');
        setTimeout(() => {
          btnApply.textContent = '套用設定並同步計時器';
          btnApply.classList.remove('bg-green-600');
        }, 1500);
      });
    }

    if (btnShareUrl) btnShareUrl.addEventListener('click', generateShareUrl);
    if (btnSaveHistory) btnSaveHistory.addEventListener('click', saveToHistory);
    
    if (btnToggleHistory && historyPanel) {
      btnToggleHistory.addEventListener('click', () => {
        historyPanel.classList.toggle('hidden');
      });
    }

    // 1. Try Load from URL Query first
    const loadedFromUrl = loadFromUrlQuery();
    
    // 2. If no URL query, check data attributes
    if (!loadedFromUrl) {
      const formEl = document.getElementById('recipe-form');
      const ignoreLocal = formEl?.getAttribute('data-ignore-local') === 'true';
      const defaultRecipeRaw = formEl?.getAttribute('data-default-recipe');
      let defaultRecipeObj = null;
      if (defaultRecipeRaw && defaultRecipeRaw !== 'null') {
        try { defaultRecipeObj = JSON.parse(defaultRecipeRaw); } catch(e){}
      }

      if (ignoreLocal && defaultRecipeObj) {
        // SEO Landing Page logic: forcefully load default recipe
        applyRecipeData(defaultRecipeObj);
        syncWithTimer(getRecipeData());
      } else {
        // Normal behavior: load from localStorage
        const savedRecipeStr = localStorage.getItem('barista_flow_recipe');
        if (savedRecipeStr) {
          try {
            applyRecipeData(JSON.parse(savedRecipeStr));
          } catch (e) {}
        } else if (defaultRecipeObj) {
          // If no local storage but we have defaults (e.g. first visit)
          applyRecipeData(defaultRecipeObj);
          syncWithTimer(getRecipeData());
        }
      }
    }

    // Prepare History Panel
    const history = loadHistory();
    if (history.length > 0 && historyPanel) {
      historyPanel.classList.remove('hidden');
      renderHistory();
    }

    // --- Timer State Lock (Mid-Brew Protection) ---
    window.addEventListener('timer-state', (e: any) => {
      const isRunning = e.detail?.running || false;
      const inputs = [weightInput, ratioInput, beanNameInput, roastLevelInput, grindSizeInput, waterTempInput];
      
      inputs.forEach(input => {
        if (input) {
          input.disabled = isRunning;
          if (isRunning) {
            input.classList.add('opacity-50', 'cursor-not-allowed');
          } else {
            input.classList.remove('opacity-50', 'cursor-not-allowed');
          }
        }
      });
      
      if (btnApply) {
        btnApply.disabled = isRunning;
        if (isRunning) {
          btnApply.textContent = '沖煮中：參數已鎖定';
          btnApply.classList.add('opacity-50', 'cursor-not-allowed');
        } else {
          btnApply.textContent = '套用設定並同步計時器';
          btnApply.classList.remove('opacity-50', 'cursor-not-allowed');
        }
      }
    });
  });
</script>
