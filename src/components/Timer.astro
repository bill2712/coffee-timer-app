---
---

<div class="glass-card rounded-2xl p-6 sm:p-8 flex flex-col items-center justify-between min-h-[480px]">
  <!-- Timer Header -->
  <div class="w-full flex justify-between items-center border-b border-coffee-sand/10 pb-4 mb-4">
    <div>
      <span class="text-xs font-semibold uppercase tracking-wider text-coffee-sand" id="bean-display">經典手沖咖啡</span>
      <h3 class="font-display text-lg font-bold text-coffee-light mt-0.5" id="roast-display">中度烘焙咖啡豆</h3>
    </div>
    <!-- Sound Toggle -->
    <button
      id="btn-sound-toggle"
      class="p-2.5 rounded-lg bg-coffee-darker border border-coffee-sand/10 text-coffee-sand hover:text-coffee-gold hover:border-coffee-gold/40 transition-all active:scale-95 cursor-pointer"
      title="切換聲音提示"
    >
      <svg id="icon-sound-on" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
      </svg>
      <svg id="icon-sound-off" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15zm10.914-6.5l4.5 4.5m0-4.5l-4.5 4.5" />
      </svg>
    </button>
  </div>

  <!-- Stage Indicators -->
  <div class="flex justify-between w-full max-w-sm px-2 mb-6">
    <div id="step-0" class="flex flex-col items-center gap-1.5 opacity-40 transition-all duration-300">
      <span class="w-7 h-7 rounded-full bg-coffee-gray border border-coffee-sand/30 flex items-center justify-center text-xs font-bold text-coffee-light">1</span>
      <span class="text-[10px] sm:text-xs font-medium text-coffee-sand">悶蒸 (40s)</span>
    </div>
    <div id="step-1" class="flex flex-col items-center gap-1.5 opacity-40 transition-all duration-300">
      <span class="w-7 h-7 rounded-full bg-coffee-gray border border-coffee-sand/30 flex items-center justify-center text-xs font-bold text-coffee-light">2</span>
      <span class="text-[10px] sm:text-xs font-medium text-coffee-sand">一注 (50s)</span>
    </div>
    <div id="step-2" class="flex flex-col items-center gap-1.5 opacity-40 transition-all duration-300">
      <span class="w-7 h-7 rounded-full bg-coffee-gray border border-coffee-sand/30 flex items-center justify-center text-xs font-bold text-coffee-light">3</span>
      <span class="text-[10px] sm:text-xs font-medium text-coffee-sand">二注 (60s)</span>
    </div>
  </div>

  <!-- Circle Progress Timer -->
  <div class="relative w-64 h-64 sm:w-72 sm:h-72 flex items-center justify-center my-4">
    <!-- Outer Glow -->
    <div class="absolute inset-0 rounded-full border border-coffee-sand/10 scale-102 pointer-events-none"></div>
    
    <!-- SVG Circular Progress -->
    <svg class="absolute w-full h-full transform -rotate-90">
      <circle
        cx="50%"
        cy="50%"
        r="44%"
        stroke="var(--color-coffee-gray)"
        stroke-width="6"
        fill="transparent"
      />
      <circle
        id="timer-progress"
        cx="50%"
        cy="50%"
        r="44%"
        stroke="var(--color-coffee-gold)"
        stroke-width="7"
        fill="transparent"
        stroke-dasharray="800"
        stroke-dashoffset="800"
        stroke-linecap="round"
        class="transition-all duration-100 ease-linear"
      />
    </svg>

    <!-- Inside Content -->
    <div class="text-center flex flex-col items-center z-10">
      <span id="timer-stage-title" class="text-xs uppercase font-semibold tracking-widest text-coffee-sand">點擊開始</span>
      <span id="timer-time" class="font-display text-5xl sm:text-6xl font-bold tracking-tight text-coffee-light my-2">02:30</span>
      
      <!-- Target Weight Tracker -->
      <div class="bg-coffee-darker/60 border border-coffee-sand/10 rounded-full px-4 py-1.5 mt-1 flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-coffee-gold animate-pulse" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd" />
        </svg>
        <span class="text-xs font-semibold text-coffee-sand/90" id="timer-weight-hint">目標水重: 0 g</span>
      </div>
    </div>
  </div>

  <!-- Instruction Box -->
  <div class="w-full max-w-sm text-center bg-coffee-darker/40 border border-coffee-sand/5 rounded-xl py-3 px-4 mb-6 min-h-[80px] flex items-center justify-center">
    <p id="timer-instruction" class="text-sm font-medium text-coffee-light/80 italic">準備就緒，點擊下方「開始沖煮」進入咖啡極致風味的世界。</p>
  </div>

  <!-- Control Buttons -->
  <div class="w-full flex items-center justify-center gap-4 max-w-sm">
    <!-- Reset -->
    <button
      id="btn-reset"
      class="flex-1 py-3 px-4 rounded-xl bg-coffee-darker border border-coffee-sand/20 hover:border-coffee-accent text-sm font-semibold tracking-wide text-coffee-sand hover:text-coffee-light transition-all active:scale-95 cursor-pointer text-center"
    >
      重設
    </button>
    <!-- Start / Pause -->
    <button
      id="btn-start"
      class="flex-2 py-3 px-6 rounded-xl bg-gradient-to-r from-coffee-accent to-coffee-gold text-coffee-dark hover:from-coffee-gold hover:to-coffee-gold-hover text-sm font-bold tracking-wide transition-all active:scale-[0.97] cursor-pointer text-center gold-glow"
    >
      開始沖煮
    </button>
  </div>
</div>

<script>
  // Timing parameters (in seconds)
  const STAGES = [
    { name: '悶蒸階段 (Blooming)', duration: 40, weightMultiplier: 2.5, desc: '均勻注入粉量 2.5 倍的水量，等待排氣，喚醒咖啡豆風味。' },
    { name: '第一次注水 (Sweetness)', duration: 50, weightMultiplier: 0.60, desc: '繞圈注水，帶出咖啡明亮的酸甜感與優雅的香氣。' },
    { name: '第二次注水 (Strength)', duration: 60, weightMultiplier: 1.00, desc: '中心注水或溫和繞圈，調整整體厚實度，控制在金杯萃取區間。' }
  ];

  const TOTAL_DURATION = STAGES.reduce((acc, stage) => acc + stage.duration, 0);

  // Audio synthesis helper
  class CoffeeSynth {
    ctx: AudioContext | null = null;
    isMuted: boolean = false;

    init() {
      if (!this.ctx) {
        this.ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
      }
    }

    beep(freq: number, duration: number, type: OscillatorType = 'sine') {
      if (this.isMuted) return;
      this.init();
      if (!this.ctx) return;

      const osc = this.ctx.createOscillator();
      const gain = this.ctx.createGain();

      osc.type = type;
      osc.frequency.setValueAtTime(freq, this.ctx.currentTime);

      gain.gain.setValueAtTime(0.15, this.ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + duration);

      osc.connect(gain);
      gain.connect(this.ctx.destination);

      osc.start();
      osc.stop(this.ctx.currentTime + duration);
    }

    playChord() {
      if (this.isMuted) return;
      this.init();
      if (!this.ctx) return;

      // Play C major triad chord (A440 + C#554 + E659)
      const now = this.ctx.currentTime;
      [440, 554, 659].forEach((freq) => {
        const osc = this.ctx!.createOscillator();
        const gain = this.ctx!.createGain();

        osc.type = 'triangle';
        osc.frequency.setValueAtTime(freq, now);

        gain.gain.setValueAtTime(0.1, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.8);

        osc.connect(gain);
        gain.connect(this.ctx!.destination);

        osc.start();
        osc.stop(now + 0.8);
      });
    }
  }

  const synth = new CoffeeSynth();

  // Recipe parameters state
  let recipe = {
    coffeeWeight: 20,
    totalWater: 300,
    beanName: '經典手沖咖啡',
    roastLevel: 'medium'
  };

  // Timer run state
  let timerId: number | null = null;
  let remainingTime = TOTAL_DURATION;
  let isRunning = false;
  let lastTimestamp = 0;

  // DOM Elements
  let timerProgress: SVGCircleElement | null = null;
  let timerTime: HTMLSpanElement | null = null;
  let timerStageTitle: HTMLSpanElement | null = null;
  let timerWeightHint: HTMLSpanElement | null = null;
  let timerInstruction: HTMLParagraphElement | null = null;
  let btnStart: HTMLButtonElement | null = null;
  let btnReset: HTMLButtonElement | null = null;
  let btnSoundToggle: HTMLButtonElement | null = null;
  let beanDisplay: HTMLSpanElement | null = null;
  let roastDisplay: HTMLHeadingElement | null = null;

  // Circle stroke offset helper
  const strokeDashArray = 800; // Match SVG r="44%" stroke-dasharray

  function setProgress(percent: number) {
    if (timerProgress) {
      const offset = strokeDashArray - (percent / 100) * strokeDashArray;
      timerProgress.style.strokeDashoffset = offset.toString();
    }
  }

  function formatTime(seconds: number): string {
    const min = Math.floor(seconds / 60);
    const sec = Math.floor(seconds % 60);
    return `${min.toString().padStart(2, '0')}:${sec.toString().padStart(2, '0')}`;
  }

  function getRoastText(level: string): string {
    switch (level) {
      case 'light': return '淺度烘焙 (Roast: Light)';
      case 'dark': return '深度烘焙 (Roast: Dark)';
      default: return '中度烘焙 (Roast: Medium)';
    }
  }

  function updateDisplay() {
    // Current Elapsed
    const elapsed = TOTAL_DURATION - remainingTime;
    
    // Find current stage
    let currentStageIndex = 0;
    let stageStartAccumulator = 0;

    for (let i = 0; i < STAGES.length; i++) {
      const stage = STAGES[i];
      if (elapsed >= stageStartAccumulator && elapsed < stageStartAccumulator + stage.duration) {
        currentStageIndex = i;
        break;
      }
      stageStartAccumulator += stage.duration;
      // If elapsed equals total duration, keep last stage active
      if (elapsed >= TOTAL_DURATION) {
        currentStageIndex = STAGES.length - 1;
      }
    }

    const currentStage = STAGES[currentStageIndex];
    const stageElapsed = elapsed - stageStartAccumulator;
    const stageRemaining = currentStage.duration - stageElapsed;

    // Highlights step headers
    for (let i = 0; i < STAGES.length; i++) {
      const el = document.getElementById(`step-${i}`);
      if (el) {
        if (i === currentStageIndex && isRunning) {
          el.classList.remove('opacity-40');
          el.classList.add('opacity-100', 'scale-105');
          const circle = el.querySelector('span');
          if (circle) circle.style.borderColor = 'var(--color-coffee-gold)';
        } else if (i < currentStageIndex) {
          el.classList.remove('opacity-40', 'scale-105');
          el.classList.add('opacity-60');
          const circle = el.querySelector('span');
          if (circle) circle.style.borderColor = 'var(--color-coffee-accent)';
        } else {
          el.classList.remove('opacity-100', 'scale-105', 'opacity-60');
          el.classList.add('opacity-40');
          const circle = el.querySelector('span');
          if (circle) circle.style.borderColor = 'rgba(197, 168, 128, 0.3)';
        }
      }
    }

    // Update digital clocks
    if (timerTime) {
      timerTime.textContent = formatTime(remainingTime);
    }

    // Calculate dynamic weights
    let targetWeight = 0;
    if (currentStageIndex === 0) {
      // Blooming: 2.5x coffee weight
      targetWeight = Math.round(recipe.coffeeWeight * STAGES[0].weightMultiplier);
    } else if (currentStageIndex === 1) {
      // 1st Pour: 60% of total water
      targetWeight = Math.round(recipe.totalWater * STAGES[1].weightMultiplier);
    } else {
      // 2nd Pour: 100% of total water
      targetWeight = recipe.totalWater;
    }

    if (timerStageTitle) {
      timerStageTitle.textContent = isRunning ? currentStage.name : '咖啡計時已暫停';
    }

    if (timerWeightHint) {
      timerWeightHint.textContent = `目標水量: ${targetWeight} g`;
    }

    if (timerInstruction) {
      timerInstruction.textContent = isRunning ? currentStage.desc : '準備就緒，點擊下方「開始沖煮」';
    }

    // Set Circle Progress
    const totalPercent = (remainingTime / TOTAL_DURATION) * 100;
    setProgress(totalPercent);

    // Audio alerts (countdown + chord)
    if (isRunning) {
      // If exactly at stage boundary (stageElapsed == 0 and not at the very beginning)
      if (stageElapsed === 0 && elapsed > 0) {
        synth.playChord();
      }
      
      // Beep in last 3 seconds of a stage
      if (stageRemaining > 0 && stageRemaining <= 3 && Math.floor(stageElapsed * 10) % 10 === 0) {
        // Only beep once at the beginning of the second (3, 2, 1)
        const secFraction = stageRemaining % 1;
        if (secFraction >= 0.9 || secFraction <= 0.1) {
          synth.beep(880, 0.05, 'sine');
        }
      }

      // Complete beep
      if (remainingTime <= 0) {
        synth.playChord();
        setTimeout(() => synth.playChord(), 400);
        stopTimer(true);
      }
    }
  }

  function startTimer() {
    if (isRunning) return;
    isRunning = true;
    lastTimestamp = performance.now();

    if (btnStart) {
      btnStart.textContent = '暫停';
      btnStart.classList.remove('from-coffee-accent', 'to-coffee-gold');
      btnStart.classList.add('bg-coffee-gray', 'border', 'border-coffee-sand/20', 'text-coffee-light');
    }

    synth.init(); // Warm up Audio Context

    function tick(now: number) {
      if (!isRunning) return;
      
      const delta = (now - lastTimestamp) / 1000;
      lastTimestamp = now;
      
      remainingTime = Math.max(0, remainingTime - delta);
      updateDisplay();

      if (remainingTime > 0) {
        timerId = requestAnimationFrame(tick);
      }
    }

    timerId = requestAnimationFrame(tick);
  }

  function stopTimer(completed = false) {
    isRunning = false;
    if (timerId) {
      cancelAnimationFrame(timerId);
      timerId = null;
    }

    if (btnStart) {
      if (completed) {
        btnStart.textContent = '沖煮完成！';
        btnStart.disabled = true;
        btnStart.classList.add('opacity-50');
      } else {
        btnStart.textContent = '繼續沖煮';
        btnStart.classList.remove('bg-coffee-gray', 'border', 'border-coffee-sand/20', 'text-coffee-light');
        btnStart.classList.add('from-coffee-accent', 'to-coffee-gold');
      }
    }

    if (timerStageTitle && completed) {
      timerStageTitle.textContent = '享用時間 ✨';
    }
    if (timerInstruction && completed) {
      timerInstruction.textContent = '恭喜！萃取已順利完成。讓咖啡稍降溫至 60°C - 65°C，能享受最層次分明的極致甜感與果酸！';
    }
  }

  function resetTimer() {
    stopTimer();
    remainingTime = TOTAL_DURATION;
    if (btnStart) {
      btnStart.textContent = '開始沖煮';
      btnStart.disabled = false;
      btnStart.classList.remove('opacity-50', 'bg-coffee-gray', 'border', 'border-coffee-sand/20', 'text-coffee-light');
      btnStart.classList.add('from-coffee-accent', 'to-coffee-gold');
    }
    updateDisplay();
    if (timerStageTitle) timerStageTitle.textContent = '點擊開始';
  }

  function handleRecipeUpdate(newRecipe: typeof recipe) {
    recipe = { ...recipe, ...newRecipe };
    
    if (beanDisplay) beanDisplay.textContent = recipe.beanName;
    if (roastDisplay) roastDisplay.textContent = getRoastText(recipe.roastLevel);

    resetTimer();
  }

  // Bind Listeners
  document.addEventListener('DOMContentLoaded', () => {
    timerProgress = document.getElementById('timer-progress') as unknown as SVGCircleElement;
    timerTime = document.getElementById('timer-time');
    timerStageTitle = document.getElementById('timer-stage-title');
    timerWeightHint = document.getElementById('timer-weight-hint');
    timerInstruction = document.getElementById('timer-instruction');
    btnStart = document.getElementById('btn-start') as HTMLButtonElement;
    btnReset = document.getElementById('btn-reset') as HTMLButtonElement;
    btnSoundToggle = document.getElementById('btn-sound-toggle') as HTMLButtonElement;
    beanDisplay = document.getElementById('bean-display');
    roastDisplay = document.getElementById('roast-display') as HTMLHeadingElement;

    // Start / Pause toggle
    if (btnStart) {
      btnStart.addEventListener('click', () => {
        if (isRunning) {
          stopTimer();
        } else {
          startTimer();
        }
      });
    }

    // Reset
    if (btnReset) {
      btnReset.addEventListener('click', resetTimer);
    }

    // Sound toggle
    if (btnSoundToggle) {
      btnSoundToggle.addEventListener('click', () => {
        synth.isMuted = !synth.isMuted;
        const iconOn = document.getElementById('icon-sound-on');
        const iconOff = document.getElementById('icon-sound-off');
        if (iconOn && iconOff) {
          if (synth.isMuted) {
            iconOn.classList.add('hidden');
            iconOff.classList.remove('hidden');
            btnSoundToggle!.classList.add('border-red-500/30', 'text-red-400');
          } else {
            iconOn.classList.remove('hidden');
            iconOff.classList.add('hidden');
            btnSoundToggle!.classList.remove('border-red-500/30', 'text-red-400');
          }
        }
      });
    }

    // Listen to custom recipe event
    window.addEventListener('coffee-recipe-changed', ((e: CustomEvent) => {
      handleRecipeUpdate(e.detail);
    }) as EventListener);

    // Initial load from LocalStorage if exists
    const savedRecipeStr = localStorage.getItem('barista_flow_recipe');
    if (savedRecipeStr) {
      try {
        const loadedRecipe = JSON.parse(savedRecipeStr);
        handleRecipeUpdate(loadedRecipe);
      } catch (e) {
        console.error('Failed to parse saved recipe in timer init', e);
        updateDisplay();
      }
    } else {
      updateDisplay();
    }
  });
</script>
