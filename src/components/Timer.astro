<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
  const timerRoot = document.getElementById('timer-root');
  const dict = timerRoot ? JSON.parse(timerRoot.dataset.dict || '{}') : {};
  interface TimerStage {
    name: string;
    duration: number;
    weightMultiplier: number;
    desc: string;
    speech: string;
  }
  // Timing parameters (in seconds)
  const STAGES: TimerStage[] = Array.isArray(dict.stages) && dict.stages.length === 3 ? dict.stages : [
    { name: dict.bloomName, duration: 40, weightMultiplier: 2.5, desc: dict.descBloom, speech: dict.speechBloom },
    { name: dict.pour1Name, duration: 50, weightMultiplier: 0.60, desc: dict.descPour1, speech: dict.speechPour1 },
    { name: dict.pour2Name, duration: 60, weightMultiplier: 1.00, desc: dict.descPour2, speech: dict.speechPour2 }
  ];

  const TOTAL_DURATION = STAGES.reduce((acc: number, stage: TimerStage) => acc + stage.duration, 0);

  // Audio & Speech synthesis helper
  class CoffeeSynth {
    ctx: AudioContext | null = null;
    isMuted: boolean = false;
    speechSynth = window.speechSynthesis;

    constructor() {
      try {
        const savedMute = localStorage.getItem('barista_flow_muted');
        if (savedMute === 'true') this.isMuted = true;
      } catch (e) {
        console.warn('localStorage read error:', e);
      }
    }

    init() {
      if (!this.ctx) {
        this.ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
      }
    }

    beep(freq: number, duration: number, type: OscillatorType = 'sine') {
      if (this.isMuted) return;
      this.init();
      if (!this.ctx) return;

      const osc = this.ctx.createOscillator();
      const gain = this.ctx.createGain();

      osc.type = type;
      osc.frequency.setValueAtTime(freq, this.ctx.currentTime);

      gain.gain.setValueAtTime(0.15, this.ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + duration);

      osc.connect(gain);
      gain.connect(this.ctx.destination);

      osc.start();
      osc.stop(this.ctx.currentTime + duration);
    }

    playChord() {
      if (this.isMuted) return;
      this.init();
      if (!this.ctx) return;

      // Play C major triad chord (A440 + C#554 + E659)
      const now = this.ctx.currentTime;
      [440, 554, 659].forEach((freq) => {
        const osc = this.ctx!.createOscillator();
        const gain = this.ctx!.createGain();

        osc.type = 'triangle';
        osc.frequency.setValueAtTime(freq, now);

        gain.gain.setValueAtTime(0.1, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.8);

        osc.connect(gain);
        gain.connect(this.ctx!.destination);

        osc.start();
        osc.stop(now + 0.8);
      });
    }

    speak(text: string) {
      if (this.isMuted) return;
      if (!this.speechSynth) return;
      
      this.speechSynth.cancel(); // Interrupt any playing speech
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.lang = dict.lang;
      utterance.rate = 1.05; // Slightly faster to sound pro
      utterance.pitch = 1.0;
      this.speechSynth.speak(utterance);
    }
  }

  const synth = new CoffeeSynth();

  // Recipe parameters state
  let recipe = {
    coffeeWeight: 20,
    totalWater: 300,
    waterRatio: 15,
    waterTemp: 92,
    grindSize: '',
    beanName: document.getElementById('bean-display')?.textContent || 'Classic Pour Over',
    roastLevel: 'medium',
    standardRecipeId: ''
  };

  // Timer run state
  let timerId: number | null = null;
  let remainingTime = TOTAL_DURATION;
  let isRunning = false;
  let lastTimestamp = 0;
  let lastSpokenStageIndex = -1; // Prevent repeating voice
  let lastCompletedBeep = false;
  let lastPersistedSecond = -1;
  let isFocusMode = false;
  let wakeLock: any = null;
  let activeDiagnosis: any = null;
  let activeLogId = '';
  let pendingPhotoData = '';
  let adaptiveOffset = 0;
  let adaptiveTotalDuration = TOTAL_DURATION;
  let actualStageMarks: Array<{ stageIndex: number; targetWeight: number; expectedElapsed: number; actualElapsed: number; deviation: number }> = [];

  // DOM Elements
  let timerProgress: SVGCircleElement | null = null;
  let timerBreathBg: HTMLDivElement | null = null;
  let timerTime: HTMLSpanElement | null = null;
  let timerStageTitle: HTMLSpanElement | null = null;
  let timerWeightHint: HTMLSpanElement | null = null;
  let timerInstruction: HTMLParagraphElement | null = null;
  let btnStart: HTMLButtonElement | null = null;
  let btnReset: HTMLButtonElement | null = null;
  let btnSoundToggle: HTMLButtonElement | null = null;
  let btnFocusMode: HTMLButtonElement | null = null;
  let focusStatus: HTMLSpanElement | null = null;
  let beanDisplay: HTMLSpanElement | null = null;
  let roastDisplay: HTMLHeadingElement | null = null;
  let preflightPanel: HTMLElement | null = null;
  let btnPreflightReady: HTMLButtonElement | null = null;
  let preflightChecks: HTMLInputElement[] = [];
  let btnMarkPourTarget: HTMLButtonElement | null = null;
  let pourTrackingStatus: HTMLElement | null = null;
  let pourTrackingMarks: HTMLOListElement | null = null;
  
  // Modal Elements
  let tastingModal: HTMLDivElement | null = null;
  let modalBackdrop: HTMLDivElement | null = null;
  let modalContent: HTMLDivElement | null = null;
  let tastingForm: HTMLFormElement | null = null;
  let btnSkipLog: HTMLButtonElement | null = null;
  let diagnosisResult: HTMLElement | null = null;
  let btnCloseDiagnosis: HTMLButtonElement | null = null;
  let btnApplyDiagnosis: HTMLButtonElement | null = null;

  // Circle stroke offset helper
  const strokeDashArray = 800; // Match SVG r="44%" stroke-dasharray

  function setProgress(percent: number) {
    if (timerProgress) {
      const offset = strokeDashArray - (percent / 100) * strokeDashArray;
      timerProgress.style.strokeDashoffset = offset.toString();
    }
  }

  function getTargetWeights(sourceRecipe: any = recipe) {
    return STAGES.map((stage: any, index: number) => {
      if (dict.timerMode === 'pour-over' && index === 0) return Math.round(sourceRecipe.coffeeWeight * stage.weightMultiplier);
      return Math.round(sourceRecipe.totalWater * stage.weightMultiplier);
    });
  }

  function formatTime(seconds: number): string {
    const min = Math.floor(seconds / 60);
    const sec = Math.floor(seconds % 60);
    return `${min.toString().padStart(2, '0')}:${sec.toString().padStart(2, '0')}`;
  }

  function getRoastDisplay(level: string): string {
    switch(level) {
      case 'light': return dict.roastLight;
      case 'dark': return dict.roastDark;
      default: return dict.roastMedium;
    }
  }

  const TIMER_SESSION_KEY = 'barista_flow_timer_session_v1';
  const PREFLIGHT_KEY = 'barista_flow_preflight_seen_v1';

  function getBaseStageEnds() {
    let elapsed = 0;
    return STAGES.map((stage) => (elapsed += stage.duration));
  }

  function getAdaptiveStageEnds() {
    const baseEnds = getBaseStageEnds();
    let offset = 0;
    return baseEnds.map((baseEnd, index) => {
      const mark = actualStageMarks.find((item) => item.stageIndex === index);
      if (mark) {
        offset = mark.actualElapsed - baseEnd;
        return mark.actualElapsed;
      }
      return baseEnd + offset;
    });
  }

  function getElapsedTime() {
    return Math.max(0, adaptiveTotalDuration - remainingTime);
  }

  function getRecordedBrewDuration() {
    const finalMark = actualStageMarks.find((mark) => mark.stageIndex === STAGES.length - 1);
    return finalMark ? Math.max(0, finalMark.actualElapsed) : getElapsedTime();
  }

  function formatDeviation(seconds: number) {
    const rounded = Math.abs(Math.round(seconds));
    if (rounded <= 1) return dict.trackingOnTime;
    return (seconds < 0 ? dict.trackingAhead : dict.trackingBehind).replace('{seconds}', String(rounded));
  }

  function renderPourTracking() {
    const nextIndex = actualStageMarks.length;
    const targets = getTargetWeights(recipe);
    if (btnMarkPourTarget) {
      btnMarkPourTarget.disabled = !isRunning || nextIndex >= STAGES.length;
      btnMarkPourTarget.textContent = nextIndex >= STAGES.length
        ? dict.trackingDone
        : dict.reachedTarget.replace('{weight}', String(targets[nextIndex]));
    }
    if (pourTrackingStatus) {
      pourTrackingStatus.textContent = nextIndex >= STAGES.length
        ? dict.trackingDone
        : isRunning
          ? `${nextIndex + 1} / ${STAGES.length} · ${dict.reachedTarget.replace('{weight}', String(targets[nextIndex]))}`
          : dict.trackingWaiting;
    }
    const marksList = pourTrackingMarks;
    if (!marksList) return;
    marksList.replaceChildren();
    marksList.classList.toggle('hidden', actualStageMarks.length === 0);
    marksList.classList.toggle('grid', actualStageMarks.length > 0);
    actualStageMarks.forEach((mark) => {
      const item = document.createElement('li');
      item.className = 'flex min-h-[36px] items-center justify-between rounded-lg border border-coffee-sand/10 bg-coffee-dark/50 px-3 text-[11px]';
      const label = document.createElement('span');
      label.className = 'text-coffee-sand';
      label.textContent = `${mark.targetWeight}g · ${formatTime(mark.actualElapsed)}`;
      const deviation = document.createElement('span');
      deviation.className = Math.abs(mark.deviation) <= 1 ? 'font-bold text-green-300' : 'font-bold text-coffee-gold';
      deviation.textContent = formatDeviation(mark.deviation);
      item.append(label, deviation);
      marksList.appendChild(item);
    });
  }

  function markNextPourTarget() {
    if (!isRunning || actualStageMarks.length >= STAGES.length) return;
    const stageIndex = actualStageMarks.length;
    const baseEnd = getBaseStageEnds()[stageIndex];
    const expectedElapsed = baseEnd + adaptiveOffset;
    const actualElapsed = getElapsedTime();
    const deviation = actualElapsed - expectedElapsed;
    const nextOffset = Math.max(-30, Math.min(60, actualElapsed - baseEnd));
    const offsetDelta = nextOffset - adaptiveOffset;
    actualStageMarks.push({ stageIndex, targetWeight: getTargetWeights(recipe)[stageIndex], expectedElapsed, actualElapsed, deviation });
    adaptiveOffset = nextOffset;
    adaptiveTotalDuration = TOTAL_DURATION + adaptiveOffset;
    remainingTime = Math.max(0, remainingTime + offsetDelta);
    vibrate(60);
    synth.beep(740, 0.08, 'sine');
    if (stageIndex === STAGES.length - 1) remainingTime = 0;
    updateDisplay();
    persistTimerSession();
  }

  function setupPreflight(hasRestoredSession: boolean) {
    let alreadySeen = false;
    try { alreadySeen = localStorage.getItem(PREFLIGHT_KEY) === 'true'; } catch (error) {}
    if (!preflightPanel || !btnStart || alreadySeen || hasRestoredSession) {
      preflightPanel?.classList.add('hidden');
      if (btnStart && remainingTime > 0) btnStart.disabled = false;
      return;
    }

    preflightPanel.classList.remove('hidden');
    btnStart.disabled = true;
    const refreshReadyState = () => {
      if (btnPreflightReady) btnPreflightReady.disabled = !preflightChecks.every((input) => input.checked);
    };
    preflightChecks.forEach((input) => input.addEventListener('change', refreshReadyState));
    btnPreflightReady?.addEventListener('click', () => {
      if (!preflightChecks.every((input) => input.checked)) return;
      try { localStorage.setItem(PREFLIGHT_KEY, 'true'); } catch (error) {}
      preflightPanel?.classList.add('hidden');
      if (btnStart) {
        btnStart.disabled = false;
        btnStart.focus();
      }
    });
    refreshReadyState();
  }

  function vibrate(pattern: number | number[]) {
    try {
      if ('vibrate' in navigator) navigator.vibrate(pattern);
    } catch (error) {
      console.warn('Haptic feedback unavailable:', error);
    }
  }

  function persistTimerSession() {
    try {
      localStorage.setItem(TIMER_SESSION_KEY, JSON.stringify({
        version: 1,
        totalDuration: TOTAL_DURATION,
        remainingTime,
        adaptiveOffset,
        actualStageMarks,
        running: isRunning,
        updatedAt: Date.now(),
        recipe
      }));
    } catch (error) {
      console.warn('Timer session could not be saved:', error);
    }
  }

  function clearTimerSession() {
    try { localStorage.removeItem(TIMER_SESSION_KEY); } catch (error) {}
  }

  function restoreTimerSession() {
    try {
      const raw = localStorage.getItem(TIMER_SESSION_KEY);
      if (!raw) return false;
      const saved = JSON.parse(raw);
      const age = Date.now() - Number(saved.updatedAt);
      if (saved.version !== 1 || saved.totalDuration !== TOTAL_DURATION || !Number.isFinite(age) || age < 0 || age > 21600000) {
        clearTimerSession();
        return false;
      }
      let restored = Number(saved.remainingTime);
      if (!Number.isFinite(restored)) return false;
      if (saved.running) restored -= age / 1000;
      const restoredOffset = Number(saved.adaptiveOffset);
      adaptiveOffset = Number.isFinite(restoredOffset) ? Math.max(-30, Math.min(60, restoredOffset)) : 0;
      adaptiveTotalDuration = TOTAL_DURATION + adaptiveOffset;
      const rawMarks = Array.isArray(saved.actualStageMarks) ? saved.actualStageMarks : [];
      actualStageMarks = rawMarks.slice(0, STAGES.length).map((mark: any, index: number) => ({
        stageIndex: index,
        targetWeight: Math.max(0, Number(mark.targetWeight) || 0),
        expectedElapsed: Math.max(0, Number(mark.expectedElapsed) || 0),
        actualElapsed: Math.max(0, Number(mark.actualElapsed) || 0),
        deviation: Math.max(-120, Math.min(120, Number(mark.deviation) || 0))
      }));
      remainingTime = Math.min(adaptiveTotalDuration, Math.max(0, restored));
      if (remainingTime <= 0) {
        clearTimerSession();
        return false;
      }
      return remainingTime < adaptiveTotalDuration;
    } catch (error) {
      clearTimerSession();
      return false;
    }
  }

  async function requestWakeLock() {
    if (!isFocusMode || !isRunning || wakeLock) return;
    focusStatus?.setAttribute('title', dict.wakeOff);
    try {
      if ('wakeLock' in navigator && (navigator as any).wakeLock?.request) {
        wakeLock = await (navigator as any).wakeLock.request('screen');
        focusStatus?.setAttribute('title', dict.wakeOn);
        wakeLock.addEventListener?.('release', () => { wakeLock = null; });
      }
    } catch (error) {
      wakeLock = null;
      console.warn('Screen wake lock unavailable:', error);
    }
  }

  async function releaseWakeLock() {
    try { await wakeLock?.release?.(); } catch (error) {}
    wakeLock = null;
  }

  async function enterFocusMode() {
    if (!timerRoot || isFocusMode) return;
    isFocusMode = true;
    document.body.classList.add('brew-focus-active');
    timerRoot.classList.add('brew-focus-mode');
    focusStatus?.classList.remove('hidden');
    btnFocusMode?.setAttribute('aria-pressed', 'true');
    btnFocusMode?.setAttribute('aria-label', dict.focusExit);
    btnFocusMode?.setAttribute('title', dict.focusExit);
    document.getElementById('icon-focus-enter')?.classList.add('hidden');
    document.getElementById('icon-focus-exit')?.classList.remove('hidden');
    try {
      if (!document.fullscreenElement && timerRoot.requestFullscreen) await timerRoot.requestFullscreen();
    } catch (error) {
      console.info('Fullscreen was not available; using in-page focus mode.');
    }
    await requestWakeLock();
  }

  async function exitFocusMode(exitFullscreen = true) {
    if (!timerRoot || !isFocusMode) return;
    isFocusMode = false;
    document.body.classList.remove('brew-focus-active');
    timerRoot.classList.remove('brew-focus-mode');
    focusStatus?.classList.add('hidden');
    btnFocusMode?.setAttribute('aria-pressed', 'false');
    btnFocusMode?.setAttribute('aria-label', dict.focusEnter);
    btnFocusMode?.setAttribute('title', dict.focusEnter);
    document.getElementById('icon-focus-enter')?.classList.remove('hidden');
    document.getElementById('icon-focus-exit')?.classList.add('hidden');
    await releaseWakeLock();
    if (exitFullscreen && document.fullscreenElement) {
      try { await document.exitFullscreen(); } catch (error) {}
    }
  }

  function getCalibratedGrindAdjustment(kind: 'finer' | 'coarser') {
    try {
      const profile = JSON.parse(localStorage.getItem('barista_flow_grinder_profile_v1') || 'null');
      const current = Number(profile?.currentSetting);
      const increment = Number(profile?.increment);
      const min = Number(profile?.minSetting);
      const max = Number(profile?.maxSetting);
      if (!profile || !Number.isFinite(current) || !Number.isFinite(increment) || increment <= 0 || !Number.isFinite(min) || !Number.isFinite(max) || min >= max) return null;
      const finerSign = profile.finerDirection === 'higher' ? 1 : -1;
      const delta = kind === 'finer' ? finerSign * increment : -finerSign * increment;
      const nextSetting = Math.round(Math.min(max, Math.max(min, current + delta)) * 100) / 100;
      return {
        model: String(profile.model || 'Grinder').slice(0, 60),
        currentSetting: current,
        nextSetting,
        label: `${String(profile.model || 'Grinder').slice(0, 40)} · ${nextSetting}`
      };
    } catch (error) {
      return null;
    }
  }

  function buildDiagnosis(issue: string) {
    const zh = dict.lang === 'zh-TW';
    const currentRatio = Number.isFinite(Number(recipe.waterRatio))
      ? Number(recipe.waterRatio)
      : Math.round((recipe.totalWater / recipe.coffeeWeight) * 10) / 10;
    const nextRecipe = { ...recipe, waterRatio: currentRatio };
    let title = dict.keepTitle;
    let body = dict.keepBody;
    let variable = 'none';
    let ratioChange = '';

    const grind = String(recipe.grindSize || (zh ? '未記錄研磨刻度' : 'grind setting not recorded'));
    const brewSeconds = Math.max(0, Math.round(getRecordedBrewDuration()));
    const timeLabel = `${Math.floor(brewSeconds / 60)}:${String(brewSeconds % 60).padStart(2, '0')}`;
    const context = zh
      ? `本杯：${grind}、${recipe.waterTemp}°C、1:${currentRatio}、${timeLabel}。`
      : `This brew: ${grind}, ${recipe.waterTemp}°C, 1:${currentRatio}, ${timeLabel}. `;

    if (issue === 'fast') {
      title = dict.finerTitle;
      body = context + dict.finerBody;
      variable = 'grind-finer';
      const calibrated = getCalibratedGrindAdjustment('finer');
      nextRecipe.grindSize = calibrated?.label || (zh ? `${grind}（稍細一格）` : `${grind} (one small step finer)`);
      if (calibrated) {
        title = zh ? `下一杯使用 ${calibrated.nextSetting} 刻度` : `Use setting ${calibrated.nextSetting} next`;
        body = `${context}${zh ? `依照你的 ${calibrated.model} 校準檔案，由 ${calibrated.currentSetting} 調至 ${calibrated.nextSetting}；其他變數保持不變。` : `Using your ${calibrated.model} profile, move from ${calibrated.currentSetting} to ${calibrated.nextSetting} and keep every other variable unchanged.`}`;
      }
    } else if (issue === 'slow') {
      title = dict.coarserTitle;
      body = context + dict.coarserBody;
      variable = 'grind-coarser';
      const calibrated = getCalibratedGrindAdjustment('coarser');
      nextRecipe.grindSize = calibrated?.label || (zh ? `${grind}（稍粗一格）` : `${grind} (one small step coarser)`);
      if (calibrated) {
        title = zh ? `下一杯使用 ${calibrated.nextSetting} 刻度` : `Use setting ${calibrated.nextSetting} next`;
        body = `${context}${zh ? `依照你的 ${calibrated.model} 校準檔案，由 ${calibrated.currentSetting} 調至 ${calibrated.nextSetting}；其他變數保持不變。` : `Using your ${calibrated.model} profile, move from ${calibrated.currentSetting} to ${calibrated.nextSetting} and keep every other variable unchanged.`}`;
      }
    } else if (issue === 'sour' && recipe.waterTemp <= 88) {
      const nextTemp = Math.min(100, recipe.waterTemp + 2);
      title = zh ? `水溫提高至 ${nextTemp}°C` : `Raise water temperature to ${nextTemp}°C`;
      body = context + (zh ? '目前水溫偏低；下一杯只提高 2°C，研磨、粉水比與注水節奏保持不變，測試尖酸及空洞感會否改善。' : 'The current temperature is low; raise only the water temperature by 2°C and keep grind, ratio, and pouring unchanged to test whether sharp acidity and hollowness improve.');
      variable = 'water-temperature';
      nextRecipe.waterTemp = nextTemp;
    } else if (issue === 'bitter' && recipe.waterTemp >= 94) {
      const nextTemp = Math.max(80, recipe.waterTemp - 2);
      title = zh ? `水溫降低至 ${nextTemp}°C` : `Lower water temperature to ${nextTemp}°C`;
      body = context + (zh ? '目前水溫偏高；下一杯只降低 2°C，研磨、粉水比與注水節奏保持不變，測試苦澀及乾口會否減少。' : 'The current temperature is high; lower only the water temperature by 2°C and keep grind, ratio, and pouring unchanged to test whether bitterness and dryness decrease.');
      variable = 'water-temperature';
      nextRecipe.waterTemp = nextTemp;
    } else if (issue === 'sour') {
      title = dict.finerTitle;
      body = context + dict.finerBody;
      variable = 'grind-finer';
      const calibrated = getCalibratedGrindAdjustment('finer');
      nextRecipe.grindSize = calibrated?.label || (zh ? `${grind}（稍細一格）` : `${grind} (one small step finer)`);
      if (calibrated) {
        title = zh ? `下一杯使用 ${calibrated.nextSetting} 刻度` : `Use setting ${calibrated.nextSetting} next`;
        body = `${context}${zh ? `依照你的 ${calibrated.model} 校準檔案，由 ${calibrated.currentSetting} 調至 ${calibrated.nextSetting}；其他變數保持不變。` : `Using your ${calibrated.model} profile, move from ${calibrated.currentSetting} to ${calibrated.nextSetting} and keep every other variable unchanged.`}`;
      }
    } else if (issue === 'bitter') {
      title = dict.coarserTitle;
      body = context + dict.coarserBody;
      variable = 'grind-coarser';
      const calibrated = getCalibratedGrindAdjustment('coarser');
      nextRecipe.grindSize = calibrated?.label || (zh ? `${grind}（稍粗一格）` : `${grind} (one small step coarser)`);
      if (calibrated) {
        title = zh ? `下一杯使用 ${calibrated.nextSetting} 刻度` : `Use setting ${calibrated.nextSetting} next`;
        body = `${context}${zh ? `依照你的 ${calibrated.model} 校準檔案，由 ${calibrated.currentSetting} 調至 ${calibrated.nextSetting}；其他變數保持不變。` : `Using your ${calibrated.model} profile, move from ${calibrated.currentSetting} to ${calibrated.nextSetting} and keep every other variable unchanged.`}`;
      }
    } else if (issue === 'weak') {
      const newRatio = Math.max(10, currentRatio - 1);
      nextRecipe.waterRatio = newRatio;
      nextRecipe.totalWater = Math.round(nextRecipe.coffeeWeight * newRatio);
      title = dict.lessWaterTitle;
      body = context + dict.lessWaterBody;
      variable = 'water-ratio';
      ratioChange = `1:${currentRatio} → 1:${newRatio}`;
    } else if (issue === 'strong') {
      const newRatio = Math.min(25, currentRatio + 1);
      nextRecipe.waterRatio = newRatio;
      nextRecipe.totalWater = Math.round(nextRecipe.coffeeWeight * newRatio);
      title = dict.moreWaterTitle;
      body = context + dict.moreWaterBody;
      variable = 'water-ratio';
      ratioChange = `1:${currentRatio} → 1:${newRatio}`;
    }

    if (issue === 'balanced') body = context + dict.keepBody;
    const calibrated = variable === 'grind-finer' ? getCalibratedGrindAdjustment('finer') : variable === 'grind-coarser' ? getCalibratedGrindAdjustment('coarser') : null;
    return { issue, title, body, variable, ratioChange, nextRecipe, grinderSetting: calibrated?.nextSetting };
  }

  function updateDisplay() {
    // Current Elapsed
    const elapsed = getElapsedTime();
    
    // Find current stage
    let currentStageIndex = 0;
    let stageStartAccumulator = 0;
    const adaptiveStageEnds = getAdaptiveStageEnds();

    for (let i = 0; i < STAGES.length; i++) {
      const stageEnd = adaptiveStageEnds[i];
      if (elapsed >= stageStartAccumulator && elapsed < stageEnd) {
        currentStageIndex = i;
        break;
      }
      stageStartAccumulator = stageEnd;
      // If elapsed equals total duration, keep last stage active
      if (elapsed >= adaptiveTotalDuration) {
        currentStageIndex = STAGES.length - 1;
      }
    }

    const currentStage = STAGES[currentStageIndex];
    const stageElapsed = elapsed - stageStartAccumulator;
    const stageRemaining = Math.max(0, adaptiveStageEnds[currentStageIndex] - elapsed);
    
    const targets = getTargetWeights(recipe);

    // Update Step Indicators (Stepper)
    for (let i = 0; i < STAGES.length; i++) {
      const el = document.getElementById(`step-${i}`);
      const targetEl = document.getElementById(`step-target-${i}`);
      
      if (targetEl) targetEl.textContent = `${targets[i]}g`;

      if (el) {
        const circle = el.querySelector('span');
        if (i === currentStageIndex && isRunning) {
          el.classList.remove('opacity-40', 'opacity-60');
          el.classList.add('opacity-100', 'scale-110');
          if (circle) {
            circle.classList.remove('bg-coffee-dark', 'border-coffee-sand/30', 'text-coffee-light', 'bg-coffee-darker', 'text-coffee-sand');
            circle.classList.add('bg-coffee-gold', 'border-coffee-gold', 'text-coffee-dark', 'shadow-lg', 'shadow-coffee-gold/30');
          }
        } else if (i < currentStageIndex || (i === currentStageIndex && !isRunning && elapsed > 0)) {
          // Completed steps
          el.classList.remove('opacity-40', 'scale-110');
          el.classList.add('opacity-100');
          if (circle) {
            circle.classList.remove('bg-coffee-gold', 'border-coffee-gold', 'text-coffee-dark', 'shadow-lg', 'shadow-coffee-gold/30', 'bg-coffee-dark', 'border-coffee-sand/30', 'text-coffee-light');
            circle.classList.add('bg-coffee-darker', 'border-coffee-sand/10', 'text-coffee-sand');
          }
        } else {
          // Upcoming steps
          el.classList.remove('opacity-100', 'scale-110', 'opacity-60', 'opacity-100');
          el.classList.add('opacity-40');
          if (circle) {
            circle.classList.remove('bg-coffee-gold', 'border-coffee-gold', 'text-coffee-dark', 'shadow-lg', 'shadow-coffee-gold/30', 'bg-coffee-darker', 'text-coffee-sand');
            circle.classList.add('bg-coffee-dark', 'border-coffee-sand/30', 'text-coffee-light');
          }
        }
      }
    }

    // Update digital clocks
    if (timerTime) {
      timerTime.textContent = formatTime(remainingTime);
    }

    // Calculate dynamic weights
    const targetWeight = targets[currentStageIndex];

    if (timerStageTitle) {
      timerStageTitle.textContent = isRunning ? currentStage.name : (elapsed > 0 ? dict.paused : dict.clickStart);
    }

    if (timerWeightHint) {
      timerWeightHint.textContent = `${dict.targetWeightPrefix} ${targetWeight} g`;
    }

    if (timerInstruction) {
      timerInstruction.textContent = isRunning ? currentStage.desc : (elapsed > 0 ? dict.paused : dict.readyText);
    }

    // Set Circle Progress
    const totalPercent = (remainingTime / Math.max(1, adaptiveTotalDuration)) * 100;
    setProgress(totalPercent);
    renderPourTracking();

    // Audio alerts (countdown + chord + speech)
    if (isRunning) {
      // Speak on stage change
      if (currentStageIndex !== lastSpokenStageIndex) {
        synth.speak(`${currentStage.speech}. ${dict.speechTarget.replace('{weight}', targetWeight)}`);
        vibrate(90);
        lastSpokenStageIndex = currentStageIndex;
      }

      // If exactly at stage boundary (stageElapsed == 0 and not at the very beginning)
      if (stageElapsed === 0 && elapsed > 0) {
        synth.playChord();
      }
      
      // Beep in last 3 seconds of a stage
      if (stageRemaining > 0 && stageRemaining <= 3 && Math.floor(stageElapsed * 10) % 10 === 0) {
        // Only beep once at the beginning of the second (3, 2, 1)
        const secFraction = stageRemaining % 1;
        if (secFraction >= 0.9 || secFraction <= 0.1) {
          synth.beep(880, 0.05, 'sine');
        }
      }

      // Complete beep and speech
      if (remainingTime <= 0 && !lastCompletedBeep) {
        lastCompletedBeep = true;
        synth.playChord();
        synth.speak(dict.speechComplete);
        vibrate([160, 80, 160]);
        setTimeout(() => synth.playChord(), 400);
        stopTimer(true);
        if (isFocusMode) exitFocusMode();
        setTimeout(showTastingModal, 1500); // Trigger modal slightly after completion
      }

      const elapsedSecond = Math.floor(elapsed);
      if (elapsedSecond !== lastPersistedSecond) {
        lastPersistedSecond = elapsedSecond;
        persistTimerSession();
      }
    }
  }

  function startTimer() {
    if (isRunning || (preflightPanel && !preflightPanel.classList.contains('hidden'))) return;
    if (timerId !== null) {
      window.clearInterval(timerId);
      timerId = null;
    }
    isRunning = true;
    lastTimestamp = Date.now();
    window.dispatchEvent(new CustomEvent('timer-state', { detail: { running: true } }));

    if (btnStart) {
      btnStart.textContent = dict.btnPause;
      btnStart.classList.remove('from-[#D9A05B]', 'to-[#B47B4B]');
      btnStart.classList.add('bg-coffee-darker', 'text-coffee-muted');
    }
    
    if (timerBreathBg) {
      timerBreathBg.classList.add('animate-breath', 'bg-[#D9A05B]/10');
    }

    synth.init(); // Warm up Audio Context
    persistTimerSession();
    requestWakeLock();

    function tick() {
      if (!isRunning) return;
      
      const now = Date.now();
      const delta = (now - lastTimestamp) / 1000;
      lastTimestamp = now;
      
      remainingTime = Math.max(0, remainingTime - delta);
      updateDisplay();
    }

    timerId = window.setInterval(tick, 100);
  }

  function handleVisibilityChange() {
    if (document.hidden || !isRunning) return;
    requestWakeLock();
    // When tab becomes visible again, instantly process the time delta that occurred while asleep/backgrounded
    const now = Date.now();
    const delta = (now - lastTimestamp) / 1000;
    lastTimestamp = now;
    
    if (delta > 0) {
      remainingTime = Math.max(0, remainingTime - delta);
      updateDisplay();
    }
  }

  document.addEventListener("visibilitychange", handleVisibilityChange);

  // Lifecycle memory sanitization for Astro View Transitions / SPA
  document.addEventListener('astro:before-swap', () => {
    if (timerId !== null) {
      window.clearInterval(timerId);
      timerId = null;
    }
    releaseWakeLock();
    document.body.classList.remove('brew-focus-active');
  });
  window.addEventListener('unload', () => {
    if (timerId !== null) {
      window.clearInterval(timerId);
      timerId = null;
    }
  });

  function stopTimer(completed = false) {
    isRunning = false;
    window.dispatchEvent(new CustomEvent('timer-state', { detail: { running: false } }));
    if (timerId !== null) {
      window.clearInterval(timerId);
      timerId = null;
    }
    releaseWakeLock();
    if (completed) clearTimerSession();
    else persistTimerSession();

    if (btnStart) {
      if (completed) {
        btnStart.textContent = dict.enjoy;
        btnStart.disabled = true;
        btnStart.classList.add('opacity-50');
      } else {
        btnStart.textContent = dict.btnResume;
        btnStart.classList.remove('bg-coffee-darker', 'text-coffee-muted');
        btnStart.classList.add('from-[#D9A05B]', 'to-[#B47B4B]');
      }
    }
    
    if (timerBreathBg) {
      timerBreathBg.classList.remove('animate-breath', 'bg-[#D9A05B]/10');
    }
    
    if (btnReset) {
      btnReset.disabled = false;
      btnReset.classList.remove('opacity-50', 'cursor-not-allowed');
    }

    if (timerStageTitle && completed) {
      timerStageTitle.textContent = dict.enjoy;
    }
    if (timerInstruction && completed) {
      timerInstruction.textContent = dict.completeMessage;
    }
  }

  function resetTimer() {
    stopTimer();
    adaptiveOffset = 0;
    adaptiveTotalDuration = TOTAL_DURATION;
    actualStageMarks = [];
    remainingTime = TOTAL_DURATION;
    clearTimerSession();
    lastPersistedSecond = -1;
    lastSpokenStageIndex = -1;
    lastCompletedBeep = false;
    if (btnStart) {
      btnStart.textContent = dict.btnStart;
      btnStart.disabled = Boolean(preflightPanel && !preflightPanel.classList.contains('hidden'));
      btnStart.classList.remove('opacity-50', 'bg-coffee-darker', 'text-coffee-muted');
      btnStart.classList.add('from-[#D9A05B]', 'to-[#B47B4B]');
    }
    if (timerBreathBg) {
      timerBreathBg.classList.remove('animate-breath', 'bg-[#D9A05B]/10');
    }
    if (btnReset) {
      btnReset.disabled = false;
      btnReset.classList.remove('opacity-50', 'cursor-not-allowed');
    }
    updateDisplay();
    if (timerStageTitle) timerStageTitle.textContent = dict.clickStart;
  }

  function handleRecipeUpdate(newRecipe: any, shouldReset = true) {
    const weight = Number(newRecipe?.coffeeWeight);
    const water = Number(newRecipe?.totalWater);
    const ratio = Number(newRecipe?.waterRatio);
    const temp = Number(newRecipe?.waterTemp);
    const roast = String(newRecipe?.roastLevel || '');
    recipe = {
      coffeeWeight: Number.isFinite(weight) ? Math.min(100, Math.max(5, weight)) : 20,
      totalWater: Number.isFinite(water) ? Math.min(2500, Math.max(50, water)) : 300,
      waterRatio: Number.isFinite(ratio) ? Math.min(25, Math.max(10, ratio)) : 15,
      waterTemp: Number.isFinite(temp) ? Math.min(100, Math.max(80, temp)) : 92,
      grindSize: String(newRecipe?.grindSize || '').slice(0, 80),
      beanName: String(newRecipe?.beanName || recipe.beanName).trim().slice(0, 80),
      roastLevel: ['light', 'medium', 'dark'].includes(roast) ? roast : 'medium',
      standardRecipeId: /^[a-z0-9-]{1,80}$/.test(String(newRecipe?.standardRecipeId || '')) ? String(newRecipe.standardRecipeId) : ''
    };
    
    if (beanDisplay) beanDisplay.textContent = recipe.beanName;
    if (roastDisplay) roastDisplay.textContent = getRoastDisplay(recipe.roastLevel);

    if (shouldReset) resetTimer();
    else updateDisplay();
  }

  // --- Modal & Logging Logic ---
  function showTastingModal() {
    if (!tastingModal || !modalBackdrop || !modalContent) return;
    tastingForm?.classList.remove('hidden');
    diagnosisResult?.classList.add('hidden');
    modalContent.scrollTop = 0;
    tastingModal.classList.remove('hidden');
    tastingModal.classList.add('flex');
    document.body.classList.add('brew-modal-active');
    renderPourDeviationReport();
    
    // Animate in
    setTimeout(() => {
      modalBackdrop!.classList.remove('opacity-0');
      modalContent!.classList.remove('opacity-0', 'scale-95');
      modalContent!.classList.add('scale-100');
      (document.querySelector('input[name="brew-issue"]') as HTMLInputElement | null)?.focus();
    }, 10);
  }

  function renderPourDeviationReport() {
    const report = document.getElementById('pour-deviation-report');
    const title = document.getElementById('pour-deviation-title');
    const list = document.getElementById('pour-deviation-list');
    if (!report || !title || !list || actualStageMarks.length === 0) {
      report?.classList.add('hidden');
      return;
    }
    report.classList.remove('hidden');
    title.textContent = dict.lang === 'zh-TW'
      ? `已記錄 ${actualStageMarks.length}/${STAGES.length} 段 · 總節奏 ${formatDeviation(adaptiveOffset)}`
      : `${actualStageMarks.length}/${STAGES.length} targets · overall pace ${formatDeviation(adaptiveOffset)}`;
    list.replaceChildren();
    actualStageMarks.forEach((mark) => {
      const row = document.createElement('div');
      row.className = 'flex items-center justify-between rounded-lg border border-blue-400/10 bg-coffee-dark/40 px-3 py-2 text-xs';
      const stage = document.createElement('span');
      stage.className = 'text-coffee-sand';
      stage.textContent = `${STAGES[mark.stageIndex]?.name || ''} · ${mark.targetWeight}g`;
      const value = document.createElement('strong');
      value.className = Math.abs(mark.deviation) <= 1 ? 'text-green-300' : 'text-blue-300';
      value.textContent = `${formatTime(mark.actualElapsed)} · ${formatDeviation(mark.deviation)}`;
      row.append(stage, value);
      list.appendChild(row);
    });
  }

  function hideTastingModal() {
    if (!tastingModal || !modalBackdrop || !modalContent) return;
    
    // Animate out
    modalBackdrop.classList.add('opacity-0');
    modalContent.classList.remove('scale-100');
    modalContent.classList.add('opacity-0', 'scale-95');
    
    setTimeout(() => {
      tastingModal!.classList.add('hidden');
      tastingModal!.classList.remove('flex');
      document.body.classList.remove('brew-modal-active');
      if(tastingForm) tastingForm.reset();
      tastingForm?.classList.remove('hidden');
      diagnosisResult?.classList.add('hidden');
      activeDiagnosis = null;
      activeLogId = '';
      resetPhotoInput();
      updateSliderValues();
    }, 300);
  }

  function updateSliderValues() {
    ['acidity', 'bitterness', 'body', 'overall'].forEach(id => {
      const input = document.getElementById(`rating-${id}`) as HTMLInputElement;
      const display = document.getElementById(`val-${id}`);
      if (input && display) display.textContent = input.value;
    });
  }

  function blobToDataUrl(blob: Blob): Promise<string> {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(String(reader.result || ''));
      reader.onerror = () => reject(new Error('Photo could not be read.'));
      reader.readAsDataURL(blob);
    });
  }

  async function loadPhotoSource(file: File): Promise<{ source: CanvasImageSource; width: number; height: number; close: () => void }> {
    if ('createImageBitmap' in window) {
      const bitmap = await createImageBitmap(file);
      return {
        source: bitmap,
        width: bitmap.width,
        height: bitmap.height,
        close: () => bitmap.close?.()
      };
    }

    const objectUrl = URL.createObjectURL(file);
    const image = new Image();
    image.decoding = 'async';
    image.src = objectUrl;
    await image.decode();
    return {
      source: image,
      width: image.naturalWidth,
      height: image.naturalHeight,
      close: () => URL.revokeObjectURL(objectUrl)
    };
  }

  async function compressPhoto(file: File): Promise<string> {
    if (!['image/jpeg', 'image/png', 'image/webp'].includes(file.type) || file.size > 12 * 1024 * 1024) {
      throw new Error(dict.lang === 'zh-TW' ? '請選擇 12 MB 以下的 JPG、PNG 或 WebP。' : 'Choose a JPG, PNG, or WebP under 12 MB.');
    }
    const photo = await loadPhotoSource(file);
    const render = async (maxEdge: number, quality: number) => {
      const scale = Math.min(1, maxEdge / Math.max(photo.width, photo.height));
      const canvas = document.createElement('canvas');
      canvas.width = Math.max(1, Math.round(photo.width * scale));
      canvas.height = Math.max(1, Math.round(photo.height * scale));
      canvas.getContext('2d')?.drawImage(photo.source, 0, 0, canvas.width, canvas.height);
      return new Promise<Blob>((resolve, reject) => canvas.toBlob((blob) => blob ? resolve(blob) : reject(new Error('Photo compression failed.')), 'image/jpeg', quality));
    };
    let blob: Blob;
    try {
      blob = await render(1000, 0.76);
      if (blob.size > 120000) blob = await render(760, 0.64);
      if (blob.size > 120000) blob = await render(560, 0.52);
    } finally {
      photo.close();
    }
    if (blob.size > 160000) throw new Error(dict.lang === 'zh-TW' ? '照片內容太複雜，壓縮後仍然過大；請換一張較小照片。' : 'The compressed photo is still too large. Choose a smaller image.');
    return blobToDataUrl(blob);
  }

  function resetPhotoInput() {
    pendingPhotoData = '';
    const input = document.getElementById('tasting-photo') as HTMLInputElement | null;
    const preview = document.getElementById('tasting-photo-preview') as HTMLImageElement | null;
    const wrap = document.getElementById('tasting-photo-preview-wrap');
    const status = document.getElementById('tasting-photo-status');
    if (input) input.value = '';
    if (preview) preview.removeAttribute('src');
    wrap?.classList.add('hidden');
    wrap?.classList.remove('flex');
    if (status) status.textContent = '';
  }

  async function handlePhotoInput(event: Event) {
    const input = event.currentTarget as HTMLInputElement;
    const file = input.files?.[0];
    if (!file) return;
    const status = document.getElementById('tasting-photo-status');
    const wrap = document.getElementById('tasting-photo-preview-wrap');
    const preview = document.getElementById('tasting-photo-preview') as HTMLImageElement | null;
    wrap?.classList.remove('hidden');
    wrap?.classList.add('flex');
    if (status) status.textContent = dict.lang === 'zh-TW' ? '正在壓縮照片…' : 'Compressing photo…';
    try {
      pendingPhotoData = await compressPhoto(file);
      if (preview) preview.src = pendingPhotoData;
      if (status) status.textContent = dict.lang === 'zh-TW' ? '照片已準備，只會儲存在本裝置。' : 'Photo ready. It will stay on this device.';
    } catch (error) {
      resetPhotoInput();
      wrap?.classList.remove('hidden');
      wrap?.classList.add('flex');
      if (status) status.textContent = error instanceof Error ? error.message : (dict.lang === 'zh-TW' ? '照片無法處理。' : 'The photo could not be processed.');
    }
  }

  function completeTrainingLesson(lesson: number) {
    if (lesson < 1 || lesson > 5) return;
    let storedProgress: any = {};
    try {
      const parsed = JSON.parse(localStorage.getItem('barista_flow_training_v1') || '{}');
      if (parsed && typeof parsed === 'object') storedProgress = parsed;
    } catch (error) {
      storedProgress = {};
    }
    const completed = Array.from(new Set([
      ...(Array.isArray(storedProgress.completed) ? storedProgress.completed : []),
      lesson
    ])).map(Number).filter((value) => value >= 1 && value <= 5);
    try {
      localStorage.setItem('barista_flow_training_v1', JSON.stringify({
        version: 1,
        completed,
        activeCup: Math.min(5, lesson + 1),
        startedAt: storedProgress.startedAt || new Date().toISOString(),
        updatedAt: new Date().toISOString()
      }));
      localStorage.removeItem('barista_flow_active_lesson_v1');
    } catch (error) {
      console.warn('Training progress could not be saved:', error);
    }
  }

  async function saveTastingLog(e: Event) {
    e.preventDefault();
    
    const acidity = (document.getElementById('rating-acidity') as HTMLInputElement)?.value || '3';
    const bitterness = (document.getElementById('rating-bitterness') as HTMLInputElement)?.value || '3';
    const body = (document.getElementById('rating-body') as HTMLInputElement)?.value || '3';
    const overall = (document.getElementById('rating-overall') as HTMLInputElement)?.value || '3';
    const notes = ((document.getElementById('tasting-notes') as HTMLTextAreaElement)?.value || '').slice(0, 500);
    const issue = (document.querySelector('input[name="brew-issue"]:checked') as HTMLInputElement)?.value || 'balanced';
    activeDiagnosis = buildDiagnosis(issue);

    let logs: any[] = [];
    try {
      const existingLogsStr = localStorage.getItem('barista_flow_logs');
      const parsed = existingLogsStr ? JSON.parse(existingLogsStr) : [];
      logs = Array.isArray(parsed) ? parsed : [];
    } catch (error) {
      console.warn('Logs were unreadable; a new clean log list will be created:', error);
    }

    const beanKey = recipe.beanName.trim().toLocaleLowerCase();
    const versions = logs
      .filter(log => String(log?.recipe?.beanName || '').trim().toLocaleLowerCase() === beanKey)
      .map(log => Number(log?.recipeVersion) || 1);
    let parentLogId = '';
    try { parentLogId = localStorage.getItem('barista_flow_pending_parent') || ''; } catch (error) {}
    const parentLog = logs.find(log => String(log?.id) === parentLogId);
    const recipeVersion = parentLog
      ? (Number(parentLog.recipeVersion) || 1) + 1
      : (versions.length ? Math.max(...versions) + 1 : 1);

    let activeLesson = 0;
    try {
      const lesson = JSON.parse(localStorage.getItem('barista_flow_active_lesson_v1') || 'null');
      const parsedLesson = Number(lesson?.lesson);
      if (parsedLesson >= 1 && parsedLesson <= 5) activeLesson = parsedLesson;
    } catch (error) {}

    activeLogId = Date.now().toString();
    const newLog = {
      id: activeLogId,
      date: new Date().toISOString(),
      recipe: { ...recipe },
      brewTimeSeconds: Math.max(1, Math.round(getRecordedBrewDuration())),
      trainingLesson: activeLesson || undefined,
      pourTracking: actualStageMarks.length ? {
        marks: actualStageMarks.map((mark) => ({ ...mark })),
        scheduleOffsetSeconds: Math.round(adaptiveOffset),
        plannedDurationSeconds: TOTAL_DURATION,
        actualDurationSeconds: Math.max(1, Math.round(getRecordedBrewDuration()))
      } : undefined,
      recipeVersion,
      parentLogId: parentLog ? parentLogId : undefined,
      evaluation: {
        acidity: parseInt(acidity),
        bitterness: parseInt(bitterness),
        body: parseInt(body),
        overall: parseInt(overall),
        issue,
        notes,
        photoData: pendingPhotoData || undefined
      },
      recommendation: {
        issue,
        title: activeDiagnosis.title,
        body: activeDiagnosis.body,
        variable: activeDiagnosis.variable,
        suggestedRecipe: activeDiagnosis.nextRecipe
      }
    };

    let logSaved = false;
    try {
      logs.unshift(newLog);
      let retainedPhotos = 0;
      logs.forEach((log) => {
        if (!log?.evaluation?.photoData) return;
        retainedPhotos += 1;
        if (retainedPhotos > 6) delete log.evaluation.photoData;
      });
      localStorage.setItem('barista_flow_logs', JSON.stringify(logs.slice(0, 200)));
      localStorage.removeItem('barista_flow_pending_parent');
      localStorage.removeItem('barista_flow_pending_adjustment');
      logSaved = true;
    } catch (error) {
      console.warn('Photo storage was full; retrying the brew log without photos:', error);
      logs.forEach((log) => {
        if (log?.evaluation) delete log.evaluation.photoData;
      });
      try {
        localStorage.setItem('barista_flow_logs', JSON.stringify(logs.slice(0, 200)));
        localStorage.removeItem('barista_flow_pending_parent');
        localStorage.removeItem('barista_flow_pending_adjustment');
        pendingPhotoData = '';
        logSaved = true;
      } catch (fallbackError) {
        console.error('Failed to save the tasting log:', fallbackError);
      }
    }

    if (!logSaved) {
      window.alert(dict.lang === 'zh-TW'
        ? '這部裝置的瀏覽器儲存空間不足，今次紀錄尚未儲存。請先到「資料備份」下載備份，再刪除部分舊紀錄。'
        : 'This browser is out of local storage, so this brew was not saved. Download a backup first, then remove some older records.');
      return;
    }
    completeTrainingLesson(activeLesson);

    const resultTitle = document.getElementById('diagnosis-result-title');
    const resultBody = document.getElementById('diagnosis-result-body');
    const ratioChange = document.getElementById('diagnosis-ratio-change');
    if (resultTitle) resultTitle.textContent = activeDiagnosis.title;
    if (resultBody) resultBody.textContent = activeDiagnosis.body;
    if (ratioChange) {
      ratioChange.textContent = activeDiagnosis.ratioChange;
      ratioChange.classList.toggle('hidden', !activeDiagnosis.ratioChange);
    }
    const trainingResult = document.getElementById('training-result');
    const trainingCopy = document.getElementById('training-result-copy');
    const trainingLink = document.getElementById('training-result-link') as HTMLAnchorElement | null;
    if (activeLesson && trainingResult && trainingCopy) {
      trainingResult.classList.remove('hidden');
      trainingCopy.textContent = dict.lang === 'zh-TW'
        ? `第 ${activeLesson} 杯已完成並儲存。${activeLesson < 5 ? '下一杯訓練已解鎖。' : '五杯訓練已完成，可以到紀錄頁做 A/B 比較。'}`
        : `Brew ${activeLesson} is saved. ${activeLesson < 5 ? 'The next training brew is unlocked.' : 'The five-brew course is complete. Compare versions in your records.'}`;
      if (trainingLink) {
        trainingLink.href = activeLesson === 5 ? dict.historyUrl : dict.trainingUrl;
        trainingLink.textContent = activeLesson === 5
          ? (dict.lang === 'zh-TW' ? '比較兩杯並儲存個人配方' : 'Compare two brews and save a personal recipe')
          : (dict.lang === 'zh-TW' ? '查看下一杯訓練' : 'View the next training brew');
      }
    } else {
      trainingResult?.classList.add('hidden');
    }
    tastingForm?.classList.add('hidden');
    diagnosisResult?.classList.remove('hidden');
    modalContent?.scrollTo({ top: 0, behavior: 'smooth' });
    btnApplyDiagnosis?.focus();
  }

  function applyDiagnosis() {
    if (!activeDiagnosis) return;
    try {
      localStorage.setItem('barista_flow_recipe', JSON.stringify(activeDiagnosis.nextRecipe));
      localStorage.setItem('barista_flow_pending_parent', activeLogId);
      localStorage.setItem('barista_flow_pending_adjustment', JSON.stringify({
        title: activeDiagnosis.title,
        body: activeDiagnosis.body,
        parentLogId: activeLogId
      }));
      if (Number.isFinite(Number(activeDiagnosis.grinderSetting))) {
        const profile = JSON.parse(localStorage.getItem('barista_flow_grinder_profile_v1') || 'null');
        if (profile && typeof profile === 'object') {
          profile.currentSetting = Number(activeDiagnosis.grinderSetting);
          profile.recommendedSetting = Number(activeDiagnosis.grinderSetting);
          profile.updatedAt = new Date().toISOString();
          localStorage.setItem('barista_flow_grinder_profile_v1', JSON.stringify(profile));
        }
      }
    } catch (error) {
      console.warn('Next-brew recommendation could not be stored:', error);
    }
    window.dispatchEvent(new CustomEvent('coffee-recipe-changed', { detail: activeDiagnosis.nextRecipe }));
    window.dispatchEvent(new CustomEvent('coffee-coach-recommendation', { detail: activeDiagnosis }));
    hideTastingModal();
  }

  // --- Chart.js Integration ---
  let extractionChart: any = null;

  function initOrUpdateChart(recipe: any) {
    const ctx = document.getElementById('extraction-chart') as HTMLCanvasElement;
    if (!ctx) return;

    // Calculate Y values based on recipe
    const targets = getTargetWeights(recipe);
    let elapsed = 0;
    const dataPoints = [{ x: 0, y: 0 }];
    STAGES.forEach((stage: any, index: number) => {
      elapsed += stage.duration;
      dataPoints.push({ x: elapsed, y: targets[index] });
    });

    if (extractionChart) {
      extractionChart.data.datasets[0].data = dataPoints;
      extractionChart.update();
    } else {
      // First initialization
      extractionChart = new (window as any).Chart(ctx, {
        type: 'line',
        data: {
          datasets: [{
            label: dict.expectedWater,
            data: dataPoints,
            borderColor: '#C5A880', // coffee-gold
            backgroundColor: 'rgba(197, 168, 128, 0.1)',
            borderWidth: 2,
            tension: 0.4, // Smooth curve
            fill: true,
            pointBackgroundColor: '#2A2420',
            pointBorderColor: '#C5A880',
            pointRadius: 3,
            pointHoverRadius: 5
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: {
                label: function(context: any) {
                  return context.parsed.y + ' g';
                }
              }
            }
          },
          scales: {
            x: {
              type: 'linear',
              min: 0,
              max: TOTAL_DURATION,
              ticks: {
                stepSize: 50,
                color: 'rgba(245, 242, 235, 0.4)', // text-coffee-muted
                font: { size: 10 }
              },
              grid: { color: 'rgba(197, 168, 128, 0.05)' }
            },
            y: {
              beginAtZero: true,
              suggestedMax: 300,
              ticks: {
                color: 'rgba(245, 242, 235, 0.4)',
                font: { size: 10 }
              },
              grid: { color: 'rgba(197, 168, 128, 0.05)' }
            }
          }
        }
      });
    }
  }

  // --- Initialization ---
  document.addEventListener('DOMContentLoaded', () => {
    timerProgress = document.getElementById('timer-progress') as unknown as SVGCircleElement;
    timerBreathBg = document.getElementById('timer-breath-bg') as HTMLDivElement;
    timerTime = document.getElementById('timer-time');
    timerStageTitle = document.getElementById('timer-stage-title');
    timerWeightHint = document.getElementById('timer-weight-hint');
    timerInstruction = document.getElementById('timer-instruction') as HTMLParagraphElement | null;
    btnStart = document.getElementById('btn-start') as HTMLButtonElement;
    btnReset = document.getElementById('btn-reset') as HTMLButtonElement;
    btnSoundToggle = document.getElementById('btn-sound-toggle') as HTMLButtonElement;
    btnFocusMode = document.getElementById('btn-focus-mode') as HTMLButtonElement;
    focusStatus = document.getElementById('focus-status') as HTMLSpanElement;
    beanDisplay = document.getElementById('bean-display');
    roastDisplay = document.getElementById('roast-display') as HTMLHeadingElement;
    preflightPanel = document.getElementById('brew-preflight');
    btnPreflightReady = document.getElementById('btn-preflight-ready') as HTMLButtonElement;
    preflightChecks = Array.from(document.querySelectorAll<HTMLInputElement>('.brew-preflight-check'));
    btnMarkPourTarget = document.getElementById('btn-mark-pour-target') as HTMLButtonElement;
    pourTrackingStatus = document.getElementById('pour-tracking-status');
    pourTrackingMarks = document.getElementById('pour-tracking-marks') as HTMLOListElement;
    
    tastingModal = document.getElementById('tasting-log-modal') as HTMLDivElement;
    modalBackdrop = document.getElementById('tasting-modal-backdrop') as HTMLDivElement;
    modalContent = document.getElementById('tasting-modal-content') as HTMLDivElement;
    tastingForm = document.getElementById('tasting-form') as HTMLFormElement;
    btnSkipLog = document.getElementById('btn-skip-log') as HTMLButtonElement;
    diagnosisResult = document.getElementById('diagnosis-result');
    btnCloseDiagnosis = document.getElementById('btn-close-diagnosis') as HTMLButtonElement;
    btnApplyDiagnosis = document.getElementById('btn-apply-diagnosis') as HTMLButtonElement;
    if (tastingModal?.parentElement !== document.body) document.body.appendChild(tastingModal);

    btnFocusMode?.addEventListener('click', () => {
      if (isFocusMode) exitFocusMode();
      else enterFocusMode();
    });
    btnMarkPourTarget?.addEventListener('click', markNextPourTarget);
    try {
      const activeLesson = JSON.parse(localStorage.getItem('barista_flow_active_lesson_v1') || 'null');
      if (Number(activeLesson?.lesson) === 3) {
        const trackingDetails = document.getElementById('pour-tracking-details') as HTMLDetailsElement | null;
        if (trackingDetails) trackingDetails.open = true;
      }
    } catch (error) {}
    document.addEventListener('fullscreenchange', () => {
      if (isFocusMode && !document.fullscreenElement) exitFocusMode(false);
    });

    // Start / Pause toggle
    if (btnStart) {
      btnStart.addEventListener('click', () => {
        if (isRunning) {
          stopTimer();
        } else {
          startTimer();
        }
      });
    }

    // Reset
    if (btnReset) {
      btnReset.addEventListener('click', resetTimer);
    }

    // Sound toggle
    if (btnSoundToggle) {
      const iconOn = document.getElementById('icon-sound-on');
      const iconOff = document.getElementById('icon-sound-off');
      
      // Init UI state from constructor
      if (synth.isMuted) {
        iconOn?.classList.add('hidden');
        iconOff?.classList.remove('hidden');
        btnSoundToggle.classList.add('border-red-500/30', 'text-red-400');
      }

      btnSoundToggle.addEventListener('click', () => {
        synth.isMuted = !synth.isMuted;
        localStorage.setItem('barista_flow_muted', synth.isMuted.toString());
        
        if (iconOn && iconOff) {
          if (synth.isMuted) {
            iconOn.classList.add('hidden');
            iconOff.classList.remove('hidden');
            btnSoundToggle!.classList.add('border-red-500/30', 'text-red-400');
            synth.speechSynth?.cancel();
          } else {
            iconOn.classList.remove('hidden');
            iconOff.classList.add('hidden');
            btnSoundToggle!.classList.remove('border-red-500/30', 'text-red-400');
            synth.speak(dict.voiceEnabled);
          }
        }
      });
    }

    // Modal bindings
    if (tastingForm) {
      tastingForm.addEventListener('submit', saveTastingLog);
    }
    if (btnSkipLog) {
      btnSkipLog.addEventListener('click', hideTastingModal);
    }
    btnCloseDiagnosis?.addEventListener('click', hideTastingModal);
    btnApplyDiagnosis?.addEventListener('click', applyDiagnosis);
    document.getElementById('tasting-photo')?.addEventListener('change', handlePhotoInput);
    document.getElementById('btn-remove-photo')?.addEventListener('click', resetPhotoInput);
    document.getElementById('extraction-chart-details')?.addEventListener('toggle', (event) => {
      if ((event.currentTarget as HTMLDetailsElement).open) window.setTimeout(() => extractionChart?.resize?.(), 0);
    });
    modalBackdrop?.addEventListener('click', hideTastingModal);
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && tastingModal && !tastingModal.classList.contains('hidden')) hideTastingModal();
    });
    
    // Live update slider values
    ['acidity', 'bitterness', 'body', 'overall'].forEach(id => {
      const input = document.getElementById(`rating-${id}`);
      if (input) {
        input.addEventListener('input', updateSliderValues);
      }
    });

    // Listen to custom recipe event
    window.addEventListener('coffee-recipe-changed', ((e: CustomEvent) => {
      handleRecipeUpdate(e.detail);
      initOrUpdateChart(recipe);
    }) as EventListener);

    // Initial load from LocalStorage if exists
    let savedRecipeStr = null;
    try { savedRecipeStr = localStorage.getItem('barista_flow_recipe'); } catch (error) {}
    if (savedRecipeStr) {
      try {
        const loadedRecipe = JSON.parse(savedRecipeStr);
        handleRecipeUpdate(loadedRecipe, false);
        initOrUpdateChart(recipe);
      } catch (e) {
        console.error('Failed to parse saved recipe in timer init', e);
        updateDisplay();
        initOrUpdateChart(recipe);
      }
    } else {
      updateDisplay();
      initOrUpdateChart(recipe);
    }

    const restoredSession = restoreTimerSession();
    if (restoredSession) {
      updateDisplay();
      if (btnStart) btnStart.textContent = dict.btnResume;
    }
    setupPreflight(restoredSession);
    renderPourTracking();
  });
</script>
