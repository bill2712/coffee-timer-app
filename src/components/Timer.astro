---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const timerDict = {
  bloomName: t('timer.stage.blooming'),
  pour1Name: t('timer.stage.pour1'),
  pour2Name: t('timer.stage.pour2'),
  descBloom: t('timer.desc.blooming'),
  descPour1: t('timer.desc.pour1'),
  descPour2: t('timer.desc.pour2'),
  speechBloom: t('timer.speech.blooming'),
  speechPour1: t('timer.speech.pour1'),
  speechPour2: t('timer.speech.pour2'),
  speechTarget: t('timer.speech.target'),
  speechComplete: t('timer.speech.complete'),
  paused: t('timer.paused'),
  clickStart: t('timer.clickToStart'),
  readyText: t('timer.readyText'),
  completeMessage: t('timer.completeMessage'),
  enjoy: t('timer.enjoy'),
  btnStart: t('timer.start'),
  btnPause: t('timer.pause'),
  btnResume: t('timer.resume'),
  btnReset: t('timer.reset'),
  targetWeightPrefix: t('timer.targetWeightPrefix'),
  lang: lang,
  roastLight: t('timer.roastLight'),
  roastMedium: t('timer.roastMedium'),
  roastDark: t('timer.roastDark'),
  expectedWater: t('timer.expectedWater'),
  voiceEnabled: t('timer.voiceEnabled'),
  focusEnter: t('timer.focus.enter'),
  focusExit: t('timer.focus.exit'),
  focusActive: t('timer.focus.active'),
  wakeOn: t('timer.focus.wakeOn'),
  wakeOff: t('timer.focus.wakeOff'),
  diagnosisTitle: t('timer.diagnosis.title'),
  diagnosisDisclaimer: t('timer.diagnosis.disclaimer'),
  diagnosisSaved: t('timer.diagnosis.saved'),
  keepTitle: t('timer.diagnosis.keep.title'),
  keepBody: t('timer.diagnosis.keep.body'),
  finerTitle: t('timer.diagnosis.finer.title'),
  finerBody: t('timer.diagnosis.finer.body'),
  coarserTitle: t('timer.diagnosis.coarser.title'),
  coarserBody: t('timer.diagnosis.coarser.body'),
  lessWaterTitle: t('timer.diagnosis.lessWater.title'),
  lessWaterBody: t('timer.diagnosis.lessWater.body'),
  moreWaterTitle: t('timer.diagnosis.moreWater.title'),
  moreWaterBody: t('timer.diagnosis.moreWater.body')
};
---

<div id="timer-root" data-dict={JSON.stringify(timerDict)} class="backdrop-blur-xl bg-coffee-dark/50 border border-coffee-sand/10 shadow-xl shadow-coffee-darker/50 rounded-3xl p-5 sm:p-8 flex flex-col items-center justify-between min-h-[480px] transition-all duration-500 relative overflow-hidden group">
  <!-- Timer Header -->
  <div class="w-full flex justify-between items-center border-b border-coffee-sand/10 pb-4 mb-4">
    <div>
      <span class="text-xs font-semibold uppercase tracking-wider text-coffee-sand" id="bean-display">{t('timer.default.method')}</span>
      <h3 class="font-display text-lg font-bold text-coffee-light mt-0.5" id="roast-display">{t('timer.default.bean')}</h3>
    </div>
    <div class="flex items-center gap-2">
      <span id="focus-status" class="hidden rounded-full border border-coffee-gold/30 bg-coffee-gold/10 px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-coffee-gold" aria-live="polite">
        {t('timer.focus.active')}
      </span>
      <button
        id="btn-focus-mode"
        class="p-2.5 min-w-[44px] min-h-[44px] rounded-xl bg-coffee-darker border border-coffee-sand/10 text-coffee-sand hover:text-coffee-gold hover:border-coffee-gold/40 active:scale-95 transition-all duration-200 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-coffee-gold flex items-center justify-center"
        title={t('timer.focus.enter')}
        aria-label={t('timer.focus.enter')}
        aria-pressed="false"
      >
        <svg id="icon-focus-enter" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 3H5a2 2 0 00-2 2v3m18 0V5a2 2 0 00-2-2h-3M3 16v3a2 2 0 002 2h3m8 0h3a2 2 0 002-2v-3" />
        </svg>
        <svg id="icon-focus-exit" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 3v4a2 2 0 01-2 2H3m18 0h-4a2 2 0 01-2-2V3M3 15h4a2 2 0 012 2v4m6 0v-4a2 2 0 012-2h4" />
        </svg>
      </button>
      <button
        id="btn-sound-toggle"
        class="p-2.5 min-w-[44px] min-h-[44px] rounded-xl bg-coffee-darker border border-coffee-sand/10 text-coffee-sand hover:text-coffee-gold hover:border-coffee-gold/40 active:scale-95 transition-all duration-200 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-coffee-gold flex items-center justify-center"
        title={t('timer.soundToggle')}
        aria-label={t('timer.soundToggle')}
      >
        <svg id="icon-sound-on" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
        </svg>
        <svg id="icon-sound-off" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15zm10.914-6.5l4.5 4.5m0-4.5l-4.5 4.5" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Stage Indicators (Stepper Wizard) -->
  <div class="relative flex justify-between w-full max-w-sm px-2 mb-6 z-0">
    <!-- Connecting Line -->
    <div class="absolute top-3.5 start-6 end-6 h-[2px] bg-coffee-sand/10 -z-10"></div>
    
    <div id="step-0" class="flex flex-col items-center gap-1.5 opacity-40 transition-all duration-300 w-16">
      <span class="w-7 h-7 rounded-full bg-coffee-dark border-2 border-coffee-sand/30 flex items-center justify-center text-xs font-bold text-coffee-light transition-colors duration-300">1</span>
      <div class="flex flex-col items-center text-center">
        <span class="text-[10px] font-medium text-coffee-sand whitespace-nowrap">{t('timer.stage.blooming')} (40s)</span>
        <span id="step-target-0" class="text-[10px] text-coffee-gold font-bold mt-0.5">0g</span>
      </div>
    </div>
    <div id="step-1" class="flex flex-col items-center gap-1.5 opacity-40 transition-all duration-300 w-16">
      <span class="w-7 h-7 rounded-full bg-coffee-dark border-2 border-coffee-sand/30 flex items-center justify-center text-xs font-bold text-coffee-light transition-colors duration-300">2</span>
      <div class="flex flex-col items-center text-center">
        <span class="text-[10px] font-medium text-coffee-sand whitespace-nowrap">{t('timer.stage.pour1')} (50s)</span>
        <span id="step-target-1" class="text-[10px] text-coffee-gold font-bold mt-0.5">0g</span>
      </div>
    </div>
    <div id="step-2" class="flex flex-col items-center gap-1.5 opacity-40 transition-all duration-300 w-16">
      <span class="w-7 h-7 rounded-full bg-coffee-dark border-2 border-coffee-sand/30 flex items-center justify-center text-xs font-bold text-coffee-light transition-colors duration-300">3</span>
      <div class="flex flex-col items-center text-center">
        <span class="text-[10px] font-medium text-coffee-sand whitespace-nowrap">{t('timer.stage.pour2')} (60s)</span>
        <span id="step-target-2" class="text-[10px] text-coffee-gold font-bold mt-0.5">0g</span>
      </div>
    </div>
  </div>

  <!-- Circle Progress Timer -->
  <div class="timer-dial relative w-64 h-64 sm:w-72 sm:h-72 flex items-center justify-center my-4">
    <!-- Breath Glow Background -->
    <div id="timer-breath-bg" class="absolute inset-0 rounded-full border border-coffee-sand/20 bg-[#D9A05B]/0 scale-100 transition-all duration-1000 ease-in-out pointer-events-none"></div>
    
    <!-- SVG Circular Progress -->
    <svg class="absolute w-full h-full transform -rotate-90">
      <circle
        cx="50%"
        cy="50%"
        r="44%"
        stroke="var(--color-coffee-gray)"
        stroke-width="6"
        fill="transparent"
      />
      <circle
        id="timer-progress"
        cx="50%"
        cy="50%"
        r="44%"
        stroke="var(--color-coffee-gold)"
        stroke-width="7"
        fill="transparent"
        stroke-dasharray="800"
        stroke-dashoffset="800"
        stroke-linecap="round"
        class="transition-all duration-100 ease-linear"
      />
    </svg>

    <!-- Inside Content -->
    <div class="text-center flex flex-col items-center z-10 w-full px-2">
      <span id="timer-stage-title" class="text-xs uppercase font-semibold tracking-widest text-[#B47B4B] w-full break-words whitespace-normal leading-tight h-8 flex items-end justify-center">{t('timer.clickToStart')}</span>
      <span id="timer-time" class="font-display tabular-nums whitespace-nowrap w-full max-w-[240px] text-center text-5xl sm:text-6xl font-light font-mono tracking-tight text-coffee-light my-2">02:30</span>
      
      <!-- Target Weight Tracker -->
      <div class="bg-coffee-darker/60 border border-coffee-sand/10 rounded-full px-4 py-1.5 mt-1 flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-coffee-gold animate-pulse" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd" />
        </svg>
        <span class="text-xs font-semibold text-coffee-sand/90 break-words whitespace-normal text-center" id="timer-weight-hint">{t('timer.targetWeightPrefix')} 0 g</span>
      </div>
    </div>
  </div>

  <!-- Instruction Box -->
  <div class="w-full max-w-sm text-center bg-coffee-darker/40 border border-coffee-sand/5 rounded-xl py-3 px-4 mb-4 min-h-[80px] flex items-center justify-center">
    <p id="timer-instruction" class="text-sm font-medium text-coffee-light/80 italic break-words whitespace-normal">{t('timer.readyText')}</p>
  </div>

  <!-- Dynamic Extraction Chart -->
  <div class="w-full max-w-sm mb-6 h-[120px] relative">
    <canvas id="extraction-chart"></canvas>
  </div>

  <!-- Control Buttons -->
  <div class="w-full flex items-center justify-center gap-4 max-w-sm z-10">
    <!-- Reset -->
    <button
      id="btn-reset"
      class="flex-1 py-4 px-4 min-h-[56px] rounded-2xl bg-coffee-darker border border-coffee-sand/10 text-sm font-semibold tracking-wide text-coffee-sand hover:text-coffee-light hover:bg-coffee-sand/10 shadow-sm hover:shadow-md hover:-translate-y-1 active:scale-95 transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] cursor-pointer text-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-coffee-gold"
    >
      {t('timer.reset')}
    </button>
    <!-- Start / Pause -->
    <button
      id="btn-start"
      class="flex-2 py-4 px-6 min-h-[56px] rounded-2xl bg-gradient-to-r from-coffee-gold to-coffee-sand text-coffee-dark hover:from-coffee-gold-hover hover:to-coffee-gold text-sm font-bold tracking-wide shadow-lg shadow-coffee-gold/20 hover:shadow-xl hover:shadow-coffee-gold/40 hover:-translate-y-1 active:scale-95 transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] cursor-pointer text-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-coffee-gold disabled:opacity-50 disabled:cursor-not-allowed"
    >
      {t('timer.start')}
    </button>
  </div>
</div>

<!-- Post-Brew Tasting Log Modal -->
<div id="tasting-log-modal" class="fixed inset-0 z-[100] hidden items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="tasting-modal-title">
  <!-- Backdrop -->
  <div class="absolute inset-0 bg-coffee-dark/80 backdrop-blur-md transition-opacity duration-300 opacity-0" id="tasting-modal-backdrop"></div>
  
  <!-- Modal Content -->
  <div class="relative w-full max-w-xl max-h-[92vh] overflow-y-auto bg-coffee-darker/95 backdrop-blur-xl border border-coffee-gold/20 shadow-2xl rounded-3xl p-6 sm:p-8 transform scale-95 opacity-0 transition-all duration-300" id="tasting-modal-content">
    <div class="text-center mb-6">
      <h3 id="tasting-modal-title" class="font-display text-2xl font-bold text-coffee-light mb-2">{t('timer.modal.title')}</h3>
      <p class="text-sm text-coffee-sand/80">{t('timer.modal.subtitle')}</p>
    </div>

    <form id="tasting-form" class="space-y-5">
      <!-- Acidity -->
      <div>
        <label class="flex justify-between text-xs font-semibold uppercase tracking-wider text-coffee-sand mb-2">
          <span>{t('timer.modal.acidity')}</span>
          <span id="val-acidity" class="text-coffee-gold">3</span>
        </label>
        <input type="range" id="rating-acidity" min="1" max="5" value="3" class="w-full h-1.5 bg-coffee-dark border border-coffee-sand/10 rounded-lg appearance-none cursor-pointer accent-coffee-gold" />
        <div class="flex justify-between text-[10px] text-coffee-muted mt-2 font-medium px-1">
          <span>{t('timer.taste1')}</span><span>{t('timer.taste2')}</span>
        </div>
      </div>

      <!-- Bitterness -->
      <div>
        <label class="flex justify-between text-xs font-semibold uppercase tracking-wider text-coffee-sand mb-2">
          <span>{t('timer.modal.bitterness')}</span>
          <span id="val-bitterness" class="text-coffee-gold">3</span>
        </label>
        <input type="range" id="rating-bitterness" min="1" max="5" value="3" class="w-full h-1.5 bg-coffee-dark border border-coffee-sand/10 rounded-lg appearance-none cursor-pointer accent-coffee-gold" />
        <div class="flex justify-between text-[10px] text-coffee-muted mt-2 font-medium px-1">
          <span>{t('timer.taste3')}</span><span>{t('timer.taste4')}</span>
        </div>
      </div>

      <!-- Body -->
      <div>
        <label class="flex justify-between text-xs font-semibold uppercase tracking-wider text-coffee-sand mb-2">
          <span>{t('timer.modal.body')}</span>
          <span id="val-body" class="text-coffee-gold">3</span>
        </label>
        <input type="range" id="rating-body" min="1" max="5" value="3" class="w-full h-1.5 bg-coffee-dark border border-coffee-sand/10 rounded-lg appearance-none cursor-pointer accent-coffee-gold" />
        <div class="flex justify-between text-[10px] text-coffee-muted mt-2 font-medium px-1">
          <span>{t('timer.taste5')}</span><span>{t('timer.taste6')}</span>
        </div>
      </div>

      <!-- Overall rating -->
      <div>
        <label class="flex justify-between text-xs font-semibold uppercase tracking-wider text-coffee-sand mb-2">
          <span>{t('timer.modal.overall')}</span>
          <span id="val-overall" class="text-coffee-gold">3</span>
        </label>
        <input type="range" id="rating-overall" min="1" max="5" value="3" class="w-full h-1.5 bg-coffee-dark border border-coffee-sand/10 rounded-lg appearance-none cursor-pointer accent-coffee-gold" />
        <div class="flex justify-between text-[10px] text-coffee-muted mt-2 font-medium px-1">
          <span>1</span><span>5</span>
        </div>
      </div>

      <!-- One-problem diagnosis -->
      <fieldset class="rounded-2xl border border-coffee-sand/15 bg-coffee-dark/50 p-4">
        <legend class="px-1 text-sm font-bold text-coffee-light">{t('timer.modal.issueTitle')}</legend>
        <p class="mb-3 text-xs leading-relaxed text-coffee-muted">{t('timer.modal.issueHint')}</p>
        <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
          {[
            ['balanced', t('timer.issue.balanced')],
            ['sour', t('timer.issue.sour')],
            ['bitter', t('timer.issue.bitter')],
            ['weak', t('timer.issue.weak')],
            ['strong', t('timer.issue.strong')],
            ['slow', t('timer.issue.slow')],
            ['fast', t('timer.issue.fast')]
          ].map(([value, label], index) => (
            <label class="diagnosis-choice relative flex min-h-[48px] cursor-pointer items-center justify-center rounded-xl border border-coffee-sand/15 bg-coffee-darker px-3 py-2 text-center text-xs font-semibold text-coffee-sand transition-colors hover:border-coffee-gold/50">
              <input class="peer absolute inset-0 h-full w-full cursor-pointer opacity-0" type="radio" name="brew-issue" value={value} checked={index === 0} />
              <span class="pointer-events-none peer-checked:text-coffee-dark">{label}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <!-- Quick Notes -->
      <div>
        <label for="tasting-notes" class="block text-xs font-semibold uppercase tracking-wider text-coffee-sand mb-2">{t('timer.modal.notes')}</label>
        <textarea 
          id="tasting-notes" 
          rows="2" 
          maxlength="500"
          placeholder={t('timer.modal.notesPlaceholder')}
          class="w-full bg-coffee-dark border border-coffee-sand/20 rounded-xl p-3 text-sm focus:outline-none focus:ring-2 focus:ring-coffee-gold/50 focus:border-coffee-gold transition-colors duration-200 ease-out text-coffee-light resize-none placeholder-coffee-sand/40"
        ></textarea>
      </div>

      <div class="pt-4 flex gap-3">
        <button type="button" id="btn-skip-log" class="flex-1 py-3 rounded-xl bg-coffee-dark border border-coffee-sand/10 text-coffee-sand hover:text-coffee-light hover:bg-coffee-sand/10 text-sm font-semibold transition-all duration-300">
          {t('timer.modal.skip')}
        </button>
        <button type="submit" class="flex-2 py-3 rounded-xl bg-gradient-to-r from-coffee-gold to-coffee-sand text-coffee-dark hover:from-coffee-gold-hover hover:to-coffee-gold shadow-lg shadow-coffee-gold/20 hover:shadow-xl hover:shadow-coffee-gold/40 hover:-translate-y-0.5 active:scale-95 text-sm font-bold tracking-wide transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)]">
          {t('timer.modal.save')}
        </button>
      </div>
    </form>

    <section id="diagnosis-result" class="hidden" aria-live="polite">
      <div class="mb-5 flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-green-400">
        <span class="flex h-6 w-6 items-center justify-center rounded-full bg-green-500/15">✓</span>
        {t('timer.diagnosis.saved')}
      </div>
      <p class="text-xs font-bold uppercase tracking-widest text-coffee-gold">{t('timer.diagnosis.title')}</p>
      <h4 id="diagnosis-result-title" class="mt-2 font-display text-2xl font-bold text-coffee-light"></h4>
      <p id="diagnosis-result-body" class="mt-3 text-sm leading-relaxed text-coffee-sand"></p>
      <div id="diagnosis-ratio-change" class="mt-4 hidden rounded-xl border border-coffee-gold/20 bg-coffee-gold/10 px-4 py-3 text-center text-sm font-bold text-coffee-gold"></div>
      <p class="mt-5 rounded-xl border border-coffee-sand/10 bg-coffee-dark/60 p-4 text-xs leading-relaxed text-coffee-muted">{t('timer.diagnosis.disclaimer')}</p>
      <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
        <button type="button" id="btn-close-diagnosis" class="min-h-[48px] rounded-xl border border-coffee-sand/20 bg-coffee-dark text-sm font-semibold text-coffee-sand hover:text-coffee-light">
          {t('timer.diagnosis.close')}
        </button>
        <button type="button" id="btn-apply-diagnosis" class="min-h-[48px] rounded-xl bg-gradient-to-r from-coffee-gold to-coffee-sand text-sm font-bold text-coffee-dark shadow-lg shadow-coffee-gold/20">
          {t('timer.diagnosis.apply')}
        </button>
      </div>
    </section>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
  const timerRoot = document.getElementById('timer-root');
  const dict = timerRoot ? JSON.parse(timerRoot.dataset.dict || '{}') : {};
  // Timing parameters (in seconds)
  const STAGES = [
    { name: dict.bloomName, duration: 40, weightMultiplier: 2.5, desc: dict.descBloom, speech: dict.speechBloom },
    { name: dict.pour1Name, duration: 50, weightMultiplier: 0.60, desc: dict.descPour1, speech: dict.speechPour1 },
    { name: dict.pour2Name, duration: 60, weightMultiplier: 1.00, desc: dict.descPour2, speech: dict.speechPour2 }
  ];

  const TOTAL_DURATION = STAGES.reduce((acc, stage) => acc + stage.duration, 0);

  // Audio & Speech synthesis helper
  class CoffeeSynth {
    ctx: AudioContext | null = null;
    isMuted: boolean = false;
    speechSynth = window.speechSynthesis;

    constructor() {
      try {
        const savedMute = localStorage.getItem('barista_flow_muted');
        if (savedMute === 'true') this.isMuted = true;
      } catch (e) {
        console.warn('localStorage read error:', e);
      }
    }

    init() {
      if (!this.ctx) {
        this.ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
      }
    }

    beep(freq: number, duration: number, type: OscillatorType = 'sine') {
      if (this.isMuted) return;
      this.init();
      if (!this.ctx) return;

      const osc = this.ctx.createOscillator();
      const gain = this.ctx.createGain();

      osc.type = type;
      osc.frequency.setValueAtTime(freq, this.ctx.currentTime);

      gain.gain.setValueAtTime(0.15, this.ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + duration);

      osc.connect(gain);
      gain.connect(this.ctx.destination);

      osc.start();
      osc.stop(this.ctx.currentTime + duration);
    }

    playChord() {
      if (this.isMuted) return;
      this.init();
      if (!this.ctx) return;

      // Play C major triad chord (A440 + C#554 + E659)
      const now = this.ctx.currentTime;
      [440, 554, 659].forEach((freq) => {
        const osc = this.ctx!.createOscillator();
        const gain = this.ctx!.createGain();

        osc.type = 'triangle';
        osc.frequency.setValueAtTime(freq, now);

        gain.gain.setValueAtTime(0.1, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.8);

        osc.connect(gain);
        gain.connect(this.ctx!.destination);

        osc.start();
        osc.stop(now + 0.8);
      });
    }

    speak(text: string) {
      if (this.isMuted) return;
      if (!this.speechSynth) return;
      
      this.speechSynth.cancel(); // Interrupt any playing speech
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.lang = dict.lang;
      utterance.rate = 1.05; // Slightly faster to sound pro
      utterance.pitch = 1.0;
      this.speechSynth.speak(utterance);
    }
  }

  const synth = new CoffeeSynth();

  // Recipe parameters state
  let recipe = {
    coffeeWeight: 20,
    totalWater: 300,
    waterRatio: 15,
    waterTemp: 92,
    grindSize: '',
    beanName: document.getElementById('bean-display')?.textContent || 'Classic Pour Over',
    roastLevel: 'medium'
  };

  // Timer run state
  let timerId: number | null = null;
  let remainingTime = TOTAL_DURATION;
  let isRunning = false;
  let lastTimestamp = 0;
  let lastSpokenStageIndex = -1; // Prevent repeating voice
  let lastCompletedBeep = false;
  let lastPersistedSecond = -1;
  let isFocusMode = false;
  let wakeLock: any = null;
  let activeDiagnosis: any = null;
  let activeLogId = '';

  // DOM Elements
  let timerProgress: SVGCircleElement | null = null;
  let timerBreathBg: HTMLDivElement | null = null;
  let timerTime: HTMLSpanElement | null = null;
  let timerStageTitle: HTMLSpanElement | null = null;
  let timerWeightHint: HTMLSpanElement | null = null;
  let timerInstruction: HTMLParagraphElement | null = null;
  let btnStart: HTMLButtonElement | null = null;
  let btnReset: HTMLButtonElement | null = null;
  let btnSoundToggle: HTMLButtonElement | null = null;
  let btnFocusMode: HTMLButtonElement | null = null;
  let focusStatus: HTMLSpanElement | null = null;
  let beanDisplay: HTMLSpanElement | null = null;
  let roastDisplay: HTMLHeadingElement | null = null;
  
  // Modal Elements
  let tastingModal: HTMLDivElement | null = null;
  let modalBackdrop: HTMLDivElement | null = null;
  let modalContent: HTMLDivElement | null = null;
  let tastingForm: HTMLFormElement | null = null;
  let btnSkipLog: HTMLButtonElement | null = null;
  let diagnosisResult: HTMLElement | null = null;
  let btnCloseDiagnosis: HTMLButtonElement | null = null;
  let btnApplyDiagnosis: HTMLButtonElement | null = null;

  // Circle stroke offset helper
  const strokeDashArray = 800; // Match SVG r="44%" stroke-dasharray

  function setProgress(percent: number) {
    if (timerProgress) {
      const offset = strokeDashArray - (percent / 100) * strokeDashArray;
      timerProgress.style.strokeDashoffset = offset.toString();
    }
  }

  function getTargetWeights() {
    return [
      Math.round(recipe.coffeeWeight * STAGES[0].weightMultiplier),
      Math.round(recipe.totalWater * STAGES[1].weightMultiplier),
      recipe.totalWater
    ];
  }

  function formatTime(seconds: number): string {
    const min = Math.floor(seconds / 60);
    const sec = Math.floor(seconds % 60);
    return `${min.toString().padStart(2, '0')}:${sec.toString().padStart(2, '0')}`;
  }

  function getRoastDisplay(level: string): string {
    switch(level) {
      case 'light': return dict.roastLight;
      case 'dark': return dict.roastDark;
      default: return dict.roastMedium;
    }
  }

  const TIMER_SESSION_KEY = 'barista_flow_timer_session_v1';

  function vibrate(pattern: number | number[]) {
    try {
      if ('vibrate' in navigator) navigator.vibrate(pattern);
    } catch (error) {
      console.warn('Haptic feedback unavailable:', error);
    }
  }

  function persistTimerSession() {
    try {
      localStorage.setItem(TIMER_SESSION_KEY, JSON.stringify({
        version: 1,
        totalDuration: TOTAL_DURATION,
        remainingTime,
        running: isRunning,
        updatedAt: Date.now(),
        recipe
      }));
    } catch (error) {
      console.warn('Timer session could not be saved:', error);
    }
  }

  function clearTimerSession() {
    try { localStorage.removeItem(TIMER_SESSION_KEY); } catch (error) {}
  }

  function restoreTimerSession() {
    try {
      const raw = localStorage.getItem(TIMER_SESSION_KEY);
      if (!raw) return false;
      const saved = JSON.parse(raw);
      const age = Date.now() - Number(saved.updatedAt);
      if (saved.version !== 1 || saved.totalDuration !== TOTAL_DURATION || !Number.isFinite(age) || age < 0 || age > 21600000) {
        clearTimerSession();
        return false;
      }
      let restored = Number(saved.remainingTime);
      if (!Number.isFinite(restored)) return false;
      if (saved.running) restored -= age / 1000;
      remainingTime = Math.min(TOTAL_DURATION, Math.max(0, restored));
      if (remainingTime <= 0) {
        clearTimerSession();
        return false;
      }
      return remainingTime < TOTAL_DURATION;
    } catch (error) {
      clearTimerSession();
      return false;
    }
  }

  async function requestWakeLock() {
    if (!isFocusMode || !isRunning || wakeLock) return;
    focusStatus?.setAttribute('title', dict.wakeOff);
    try {
      if ('wakeLock' in navigator && (navigator as any).wakeLock?.request) {
        wakeLock = await (navigator as any).wakeLock.request('screen');
        focusStatus?.setAttribute('title', dict.wakeOn);
        wakeLock.addEventListener?.('release', () => { wakeLock = null; });
      }
    } catch (error) {
      wakeLock = null;
      console.warn('Screen wake lock unavailable:', error);
    }
  }

  async function releaseWakeLock() {
    try { await wakeLock?.release?.(); } catch (error) {}
    wakeLock = null;
  }

  async function enterFocusMode() {
    if (!timerRoot || isFocusMode) return;
    isFocusMode = true;
    document.body.classList.add('brew-focus-active');
    timerRoot.classList.add('brew-focus-mode');
    focusStatus?.classList.remove('hidden');
    btnFocusMode?.setAttribute('aria-pressed', 'true');
    btnFocusMode?.setAttribute('aria-label', dict.focusExit);
    btnFocusMode?.setAttribute('title', dict.focusExit);
    document.getElementById('icon-focus-enter')?.classList.add('hidden');
    document.getElementById('icon-focus-exit')?.classList.remove('hidden');
    try {
      if (!document.fullscreenElement && timerRoot.requestFullscreen) await timerRoot.requestFullscreen();
    } catch (error) {
      console.info('Fullscreen was not available; using in-page focus mode.');
    }
    await requestWakeLock();
  }

  async function exitFocusMode(exitFullscreen = true) {
    if (!timerRoot || !isFocusMode) return;
    isFocusMode = false;
    document.body.classList.remove('brew-focus-active');
    timerRoot.classList.remove('brew-focus-mode');
    focusStatus?.classList.add('hidden');
    btnFocusMode?.setAttribute('aria-pressed', 'false');
    btnFocusMode?.setAttribute('aria-label', dict.focusEnter);
    btnFocusMode?.setAttribute('title', dict.focusEnter);
    document.getElementById('icon-focus-enter')?.classList.remove('hidden');
    document.getElementById('icon-focus-exit')?.classList.add('hidden');
    await releaseWakeLock();
    if (exitFullscreen && document.fullscreenElement) {
      try { await document.exitFullscreen(); } catch (error) {}
    }
  }

  function buildDiagnosis(issue: string) {
    const currentRatio = Number.isFinite(Number(recipe.waterRatio))
      ? Number(recipe.waterRatio)
      : Math.round((recipe.totalWater / recipe.coffeeWeight) * 10) / 10;
    const nextRecipe = { ...recipe, waterRatio: currentRatio };
    let title = dict.keepTitle;
    let body = dict.keepBody;
    let variable = 'none';
    let ratioChange = '';

    if (issue === 'sour' || issue === 'fast') {
      title = dict.finerTitle;
      body = dict.finerBody;
      variable = 'grind-finer';
    } else if (issue === 'bitter' || issue === 'slow') {
      title = dict.coarserTitle;
      body = dict.coarserBody;
      variable = 'grind-coarser';
    } else if (issue === 'weak') {
      const newRatio = Math.max(10, currentRatio - 1);
      nextRecipe.waterRatio = newRatio;
      nextRecipe.totalWater = Math.round(nextRecipe.coffeeWeight * newRatio);
      title = dict.lessWaterTitle;
      body = dict.lessWaterBody;
      variable = 'water-ratio';
      ratioChange = `1:${currentRatio} → 1:${newRatio}`;
    } else if (issue === 'strong') {
      const newRatio = Math.min(25, currentRatio + 1);
      nextRecipe.waterRatio = newRatio;
      nextRecipe.totalWater = Math.round(nextRecipe.coffeeWeight * newRatio);
      title = dict.moreWaterTitle;
      body = dict.moreWaterBody;
      variable = 'water-ratio';
      ratioChange = `1:${currentRatio} → 1:${newRatio}`;
    }

    return { issue, title, body, variable, ratioChange, nextRecipe };
  }

  function updateDisplay() {
    // Current Elapsed
    const elapsed = TOTAL_DURATION - remainingTime;
    
    // Find current stage
    let currentStageIndex = 0;
    let stageStartAccumulator = 0;

    for (let i = 0; i < STAGES.length; i++) {
      const stage = STAGES[i];
      if (elapsed >= stageStartAccumulator && elapsed < stageStartAccumulator + stage.duration) {
        currentStageIndex = i;
        break;
      }
      stageStartAccumulator += stage.duration;
      // If elapsed equals total duration, keep last stage active
      if (elapsed >= TOTAL_DURATION) {
        currentStageIndex = STAGES.length - 1;
      }
    }

    const currentStage = STAGES[currentStageIndex];
    const stageElapsed = elapsed - stageStartAccumulator;
    const stageRemaining = currentStage.duration - stageElapsed;
    
    const targets = getTargetWeights();

    // Update Step Indicators (Stepper)
    for (let i = 0; i < STAGES.length; i++) {
      const el = document.getElementById(`step-${i}`);
      const targetEl = document.getElementById(`step-target-${i}`);
      
      if (targetEl) targetEl.textContent = `${targets[i]}g`;

      if (el) {
        const circle = el.querySelector('span');
        if (i === currentStageIndex && isRunning) {
          el.classList.remove('opacity-40', 'opacity-60');
          el.classList.add('opacity-100', 'scale-110');
          if (circle) {
            circle.classList.remove('bg-coffee-dark', 'border-coffee-sand/30', 'text-coffee-light', 'bg-coffee-darker', 'text-coffee-sand');
            circle.classList.add('bg-coffee-gold', 'border-coffee-gold', 'text-coffee-dark', 'shadow-lg', 'shadow-coffee-gold/30');
          }
        } else if (i < currentStageIndex || (i === currentStageIndex && !isRunning && elapsed > 0)) {
          // Completed steps
          el.classList.remove('opacity-40', 'scale-110');
          el.classList.add('opacity-100');
          if (circle) {
            circle.classList.remove('bg-coffee-gold', 'border-coffee-gold', 'text-coffee-dark', 'shadow-lg', 'shadow-coffee-gold/30', 'bg-coffee-dark', 'border-coffee-sand/30', 'text-coffee-light');
            circle.classList.add('bg-coffee-darker', 'border-coffee-sand/10', 'text-coffee-sand');
          }
        } else {
          // Upcoming steps
          el.classList.remove('opacity-100', 'scale-110', 'opacity-60', 'opacity-100');
          el.classList.add('opacity-40');
          if (circle) {
            circle.classList.remove('bg-coffee-gold', 'border-coffee-gold', 'text-coffee-dark', 'shadow-lg', 'shadow-coffee-gold/30', 'bg-coffee-darker', 'text-coffee-sand');
            circle.classList.add('bg-coffee-dark', 'border-coffee-sand/30', 'text-coffee-light');
          }
        }
      }
    }

    // Update digital clocks
    if (timerTime) {
      timerTime.textContent = formatTime(remainingTime);
    }

    // Calculate dynamic weights
    const targetWeight = targets[currentStageIndex];

    if (timerStageTitle) {
      timerStageTitle.textContent = isRunning ? currentStage.name : (elapsed > 0 ? dict.paused : dict.clickStart);
    }

    if (timerWeightHint) {
      timerWeightHint.textContent = `${dict.targetWeightPrefix} ${targetWeight} g`;
    }

    if (timerInstruction) {
      timerInstruction.textContent = isRunning ? currentStage.desc : (elapsed > 0 ? dict.paused : dict.readyText);
    }

    // Set Circle Progress
    const totalPercent = (remainingTime / TOTAL_DURATION) * 100;
    setProgress(totalPercent);

    // Audio alerts (countdown + chord + speech)
    if (isRunning) {
      // Speak on stage change
      if (currentStageIndex !== lastSpokenStageIndex) {
        synth.speak(`${currentStage.speech}. ${dict.speechTarget.replace('{weight}', targetWeight)}`);
        vibrate(90);
        lastSpokenStageIndex = currentStageIndex;
      }

      // If exactly at stage boundary (stageElapsed == 0 and not at the very beginning)
      if (stageElapsed === 0 && elapsed > 0) {
        synth.playChord();
      }
      
      // Beep in last 3 seconds of a stage
      if (stageRemaining > 0 && stageRemaining <= 3 && Math.floor(stageElapsed * 10) % 10 === 0) {
        // Only beep once at the beginning of the second (3, 2, 1)
        const secFraction = stageRemaining % 1;
        if (secFraction >= 0.9 || secFraction <= 0.1) {
          synth.beep(880, 0.05, 'sine');
        }
      }

      // Complete beep and speech
      if (remainingTime <= 0 && !lastCompletedBeep) {
        lastCompletedBeep = true;
        synth.playChord();
        synth.speak(dict.speechComplete);
        vibrate([160, 80, 160]);
        setTimeout(() => synth.playChord(), 400);
        stopTimer(true);
        if (isFocusMode) exitFocusMode();
        setTimeout(showTastingModal, 1500); // Trigger modal slightly after completion
      }

      const elapsedSecond = Math.floor(elapsed);
      if (elapsedSecond !== lastPersistedSecond) {
        lastPersistedSecond = elapsedSecond;
        persistTimerSession();
      }
    }
  }

  function startTimer() {
    if (isRunning) return;
    if (timerId !== null) {
      window.clearInterval(timerId);
      timerId = null;
    }
    isRunning = true;
    lastTimestamp = Date.now();
    window.dispatchEvent(new CustomEvent('timer-state', { detail: { running: true } }));

    if (btnStart) {
      btnStart.textContent = dict.btnPause;
      btnStart.classList.remove('from-[#D9A05B]', 'to-[#B47B4B]');
      btnStart.classList.add('bg-coffee-darker', 'text-coffee-muted');
    }
    
    if (timerBreathBg) {
      timerBreathBg.classList.add('animate-breath', 'bg-[#D9A05B]/10');
    }

    synth.init(); // Warm up Audio Context
    persistTimerSession();
    requestWakeLock();

    function tick() {
      if (!isRunning) return;
      
      const now = Date.now();
      const delta = (now - lastTimestamp) / 1000;
      lastTimestamp = now;
      
      remainingTime = Math.max(0, remainingTime - delta);
      updateDisplay();
    }

    timerId = window.setInterval(tick, 100);
  }

  function handleVisibilityChange() {
    if (document.hidden || !isRunning) return;
    requestWakeLock();
    // When tab becomes visible again, instantly process the time delta that occurred while asleep/backgrounded
    const now = Date.now();
    const delta = (now - lastTimestamp) / 1000;
    lastTimestamp = now;
    
    if (delta > 0) {
      remainingTime = Math.max(0, remainingTime - delta);
      updateDisplay();
    }
  }

  document.addEventListener("visibilitychange", handleVisibilityChange);

  // Lifecycle memory sanitization for Astro View Transitions / SPA
  document.addEventListener('astro:before-swap', () => {
    if (timerId !== null) {
      window.clearInterval(timerId);
      timerId = null;
    }
    releaseWakeLock();
    document.body.classList.remove('brew-focus-active');
  });
  window.addEventListener('unload', () => {
    if (timerId !== null) {
      window.clearInterval(timerId);
      timerId = null;
    }
  });

  function stopTimer(completed = false) {
    isRunning = false;
    window.dispatchEvent(new CustomEvent('timer-state', { detail: { running: false } }));
    if (timerId !== null) {
      window.clearInterval(timerId);
      timerId = null;
    }
    releaseWakeLock();
    if (completed) clearTimerSession();
    else persistTimerSession();

    if (btnStart) {
      if (completed) {
        btnStart.textContent = dict.enjoy;
        btnStart.disabled = true;
        btnStart.classList.add('opacity-50');
      } else {
        btnStart.textContent = dict.btnResume;
        btnStart.classList.remove('bg-coffee-darker', 'text-coffee-muted');
        btnStart.classList.add('from-[#D9A05B]', 'to-[#B47B4B]');
      }
    }
    
    if (timerBreathBg) {
      timerBreathBg.classList.remove('animate-breath', 'bg-[#D9A05B]/10');
    }
    
    if (btnReset) {
      btnReset.disabled = false;
      btnReset.classList.remove('opacity-50', 'cursor-not-allowed');
    }

    if (timerStageTitle && completed) {
      timerStageTitle.textContent = dict.enjoy;
    }
    if (timerInstruction && completed) {
      timerInstruction.textContent = dict.completeMessage;
    }
  }

  function resetTimer() {
    stopTimer();
    remainingTime = TOTAL_DURATION;
    clearTimerSession();
    lastPersistedSecond = -1;
    lastSpokenStageIndex = -1;
    lastCompletedBeep = false;
    if (btnStart) {
      btnStart.textContent = dict.btnStart;
      btnStart.disabled = false;
      btnStart.classList.remove('opacity-50', 'bg-coffee-darker', 'text-coffee-muted');
      btnStart.classList.add('from-[#D9A05B]', 'to-[#B47B4B]');
    }
    if (timerBreathBg) {
      timerBreathBg.classList.remove('animate-breath', 'bg-[#D9A05B]/10');
    }
    if (btnReset) {
      btnReset.disabled = false;
      btnReset.classList.remove('opacity-50', 'cursor-not-allowed');
    }
    updateDisplay();
    if (timerStageTitle) timerStageTitle.textContent = dict.clickStart;
  }

  function handleRecipeUpdate(newRecipe: any, shouldReset = true) {
    const weight = Number(newRecipe?.coffeeWeight);
    const water = Number(newRecipe?.totalWater);
    const ratio = Number(newRecipe?.waterRatio);
    const temp = Number(newRecipe?.waterTemp);
    const roast = String(newRecipe?.roastLevel || '');
    recipe = {
      coffeeWeight: Number.isFinite(weight) ? Math.min(100, Math.max(5, weight)) : 20,
      totalWater: Number.isFinite(water) ? Math.min(2500, Math.max(50, water)) : 300,
      waterRatio: Number.isFinite(ratio) ? Math.min(25, Math.max(10, ratio)) : 15,
      waterTemp: Number.isFinite(temp) ? Math.min(100, Math.max(80, temp)) : 92,
      grindSize: String(newRecipe?.grindSize || '').slice(0, 80),
      beanName: String(newRecipe?.beanName || recipe.beanName).trim().slice(0, 80),
      roastLevel: ['light', 'medium', 'dark'].includes(roast) ? roast : 'medium'
    };
    
    if (beanDisplay) beanDisplay.textContent = recipe.beanName;
    if (roastDisplay) roastDisplay.textContent = getRoastDisplay(recipe.roastLevel);

    if (shouldReset) resetTimer();
    else updateDisplay();
  }

  // --- Modal & Logging Logic ---
  function showTastingModal() {
    if (!tastingModal || !modalBackdrop || !modalContent) return;
    tastingForm?.classList.remove('hidden');
    diagnosisResult?.classList.add('hidden');
    modalContent.scrollTop = 0;
    tastingModal.classList.remove('hidden');
    tastingModal.classList.add('flex');
    document.body.classList.add('brew-modal-active');
    
    // Animate in
    setTimeout(() => {
      modalBackdrop!.classList.remove('opacity-0');
      modalContent!.classList.remove('opacity-0', 'scale-95');
      modalContent!.classList.add('scale-100');
      (document.querySelector('input[name="brew-issue"]') as HTMLInputElement | null)?.focus();
    }, 10);
  }

  function hideTastingModal() {
    if (!tastingModal || !modalBackdrop || !modalContent) return;
    
    // Animate out
    modalBackdrop.classList.add('opacity-0');
    modalContent.classList.remove('scale-100');
    modalContent.classList.add('opacity-0', 'scale-95');
    
    setTimeout(() => {
      tastingModal!.classList.add('hidden');
      tastingModal!.classList.remove('flex');
      document.body.classList.remove('brew-modal-active');
      if(tastingForm) tastingForm.reset();
      tastingForm?.classList.remove('hidden');
      diagnosisResult?.classList.add('hidden');
      activeDiagnosis = null;
      activeLogId = '';
      updateSliderValues();
    }, 300);
  }

  function updateSliderValues() {
    ['acidity', 'bitterness', 'body', 'overall'].forEach(id => {
      const input = document.getElementById(`rating-${id}`) as HTMLInputElement;
      const display = document.getElementById(`val-${id}`);
      if (input && display) display.textContent = input.value;
    });
  }

  function saveTastingLog(e: Event) {
    e.preventDefault();
    
    const acidity = (document.getElementById('rating-acidity') as HTMLInputElement)?.value || '3';
    const bitterness = (document.getElementById('rating-bitterness') as HTMLInputElement)?.value || '3';
    const body = (document.getElementById('rating-body') as HTMLInputElement)?.value || '3';
    const overall = (document.getElementById('rating-overall') as HTMLInputElement)?.value || '3';
    const notes = ((document.getElementById('tasting-notes') as HTMLTextAreaElement)?.value || '').slice(0, 500);
    const issue = (document.querySelector('input[name="brew-issue"]:checked') as HTMLInputElement)?.value || 'balanced';
    activeDiagnosis = buildDiagnosis(issue);

    let logs: any[] = [];
    try {
      const existingLogsStr = localStorage.getItem('barista_flow_logs');
      const parsed = existingLogsStr ? JSON.parse(existingLogsStr) : [];
      logs = Array.isArray(parsed) ? parsed : [];
    } catch (error) {
      console.warn('Logs were unreadable; a new clean log list will be created:', error);
    }

    const beanKey = recipe.beanName.trim().toLocaleLowerCase();
    const versions = logs
      .filter(log => String(log?.recipe?.beanName || '').trim().toLocaleLowerCase() === beanKey)
      .map(log => Number(log?.recipeVersion) || 1);
    let parentLogId = '';
    try { parentLogId = localStorage.getItem('barista_flow_pending_parent') || ''; } catch (error) {}
    const parentLog = logs.find(log => String(log?.id) === parentLogId);
    const recipeVersion = parentLog
      ? (Number(parentLog.recipeVersion) || 1) + 1
      : (versions.length ? Math.max(...versions) + 1 : 1);

    activeLogId = Date.now().toString();
    const newLog = {
      id: activeLogId,
      date: new Date().toISOString(),
      recipe: { ...recipe },
      recipeVersion,
      parentLogId: parentLog ? parentLogId : undefined,
      evaluation: {
        acidity: parseInt(acidity),
        bitterness: parseInt(bitterness),
        body: parseInt(body),
        overall: parseInt(overall),
        issue,
        notes
      },
      recommendation: {
        issue,
        title: activeDiagnosis.title,
        body: activeDiagnosis.body,
        variable: activeDiagnosis.variable,
        suggestedRecipe: activeDiagnosis.nextRecipe
      }
    };

    try {
      logs.unshift(newLog);
      localStorage.setItem('barista_flow_logs', JSON.stringify(logs.slice(0, 200)));
      localStorage.removeItem('barista_flow_pending_parent');
      localStorage.removeItem('barista_flow_pending_adjustment');
    } catch (error) {
      console.error('Failed to save tasting log without changing existing records:', error);
    }

    const resultTitle = document.getElementById('diagnosis-result-title');
    const resultBody = document.getElementById('diagnosis-result-body');
    const ratioChange = document.getElementById('diagnosis-ratio-change');
    if (resultTitle) resultTitle.textContent = activeDiagnosis.title;
    if (resultBody) resultBody.textContent = activeDiagnosis.body;
    if (ratioChange) {
      ratioChange.textContent = activeDiagnosis.ratioChange;
      ratioChange.classList.toggle('hidden', !activeDiagnosis.ratioChange);
    }
    tastingForm?.classList.add('hidden');
    diagnosisResult?.classList.remove('hidden');
    modalContent?.scrollTo({ top: 0, behavior: 'smooth' });
    btnApplyDiagnosis?.focus();
  }

  function applyDiagnosis() {
    if (!activeDiagnosis) return;
    try {
      localStorage.setItem('barista_flow_recipe', JSON.stringify(activeDiagnosis.nextRecipe));
      localStorage.setItem('barista_flow_pending_parent', activeLogId);
      localStorage.setItem('barista_flow_pending_adjustment', JSON.stringify({
        title: activeDiagnosis.title,
        body: activeDiagnosis.body,
        parentLogId: activeLogId
      }));
    } catch (error) {
      console.warn('Next-brew recommendation could not be stored:', error);
    }
    window.dispatchEvent(new CustomEvent('coffee-recipe-changed', { detail: activeDiagnosis.nextRecipe }));
    window.dispatchEvent(new CustomEvent('coffee-coach-recommendation', { detail: activeDiagnosis }));
    hideTastingModal();
  }

  // --- Chart.js Integration ---
  let extractionChart: any = null;

  function initOrUpdateChart(recipe: any) {
    const ctx = document.getElementById('extraction-chart') as HTMLCanvasElement;
    if (!ctx) return;

    // Calculate Y values based on recipe
    const bloomW = Math.round(recipe.coffeeWeight * STAGES[0].weightMultiplier);
    const pour1W = Math.round(recipe.totalWater * STAGES[1].weightMultiplier);
    const pour2W = recipe.totalWater;

    // Time points (X axis)
    const dataPoints = [
      { x: 0, y: 0 },
      { x: 40, y: bloomW },
      { x: 90, y: pour1W },
      { x: 150, y: pour2W }
    ];

    if (extractionChart) {
      extractionChart.data.datasets[0].data = dataPoints;
      extractionChart.update();
    } else {
      // First initialization
      extractionChart = new (window as any).Chart(ctx, {
        type: 'line',
        data: {
          datasets: [{
            label: dict.expectedWater,
            data: dataPoints,
            borderColor: '#C5A880', // coffee-gold
            backgroundColor: 'rgba(197, 168, 128, 0.1)',
            borderWidth: 2,
            tension: 0.4, // Smooth curve
            fill: true,
            pointBackgroundColor: '#2A2420',
            pointBorderColor: '#C5A880',
            pointRadius: 3,
            pointHoverRadius: 5
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: {
                label: function(context: any) {
                  return context.parsed.y + ' g';
                }
              }
            }
          },
          scales: {
            x: {
              type: 'linear',
              min: 0,
              max: 150,
              ticks: {
                stepSize: 50,
                color: 'rgba(245, 242, 235, 0.4)', // text-coffee-muted
                font: { size: 10 }
              },
              grid: { color: 'rgba(197, 168, 128, 0.05)' }
            },
            y: {
              beginAtZero: true,
              suggestedMax: 300,
              ticks: {
                color: 'rgba(245, 242, 235, 0.4)',
                font: { size: 10 }
              },
              grid: { color: 'rgba(197, 168, 128, 0.05)' }
            }
          }
        }
      });
    }
  }

  // --- Initialization ---
  document.addEventListener('DOMContentLoaded', () => {
    timerProgress = document.getElementById('timer-progress') as unknown as SVGCircleElement;
    timerBreathBg = document.getElementById('timer-breath-bg') as HTMLDivElement;
    timerTime = document.getElementById('timer-time');
    timerStageTitle = document.getElementById('timer-stage-title');
    timerWeightHint = document.getElementById('timer-weight-hint');
    timerInstruction = document.getElementById('timer-instruction') as HTMLParagraphElement | null;
    btnStart = document.getElementById('btn-start') as HTMLButtonElement;
    btnReset = document.getElementById('btn-reset') as HTMLButtonElement;
    btnSoundToggle = document.getElementById('btn-sound-toggle') as HTMLButtonElement;
    btnFocusMode = document.getElementById('btn-focus-mode') as HTMLButtonElement;
    focusStatus = document.getElementById('focus-status') as HTMLSpanElement;
    beanDisplay = document.getElementById('bean-display');
    roastDisplay = document.getElementById('roast-display') as HTMLHeadingElement;
    
    tastingModal = document.getElementById('tasting-log-modal') as HTMLDivElement;
    modalBackdrop = document.getElementById('tasting-modal-backdrop') as HTMLDivElement;
    modalContent = document.getElementById('tasting-modal-content') as HTMLDivElement;
    tastingForm = document.getElementById('tasting-form') as HTMLFormElement;
    btnSkipLog = document.getElementById('btn-skip-log') as HTMLButtonElement;
    diagnosisResult = document.getElementById('diagnosis-result');
    btnCloseDiagnosis = document.getElementById('btn-close-diagnosis') as HTMLButtonElement;
    btnApplyDiagnosis = document.getElementById('btn-apply-diagnosis') as HTMLButtonElement;
    if (tastingModal?.parentElement !== document.body) document.body.appendChild(tastingModal);

    btnFocusMode?.addEventListener('click', () => {
      if (isFocusMode) exitFocusMode();
      else enterFocusMode();
    });
    document.addEventListener('fullscreenchange', () => {
      if (isFocusMode && !document.fullscreenElement) exitFocusMode(false);
    });

    // Start / Pause toggle
    if (btnStart) {
      btnStart.addEventListener('click', () => {
        if (isRunning) {
          stopTimer();
        } else {
          startTimer();
        }
      });
    }

    // Reset
    if (btnReset) {
      btnReset.addEventListener('click', resetTimer);
    }

    // Sound toggle
    if (btnSoundToggle) {
      const iconOn = document.getElementById('icon-sound-on');
      const iconOff = document.getElementById('icon-sound-off');
      
      // Init UI state from constructor
      if (synth.isMuted) {
        iconOn?.classList.add('hidden');
        iconOff?.classList.remove('hidden');
        btnSoundToggle.classList.add('border-red-500/30', 'text-red-400');
      }

      btnSoundToggle.addEventListener('click', () => {
        synth.isMuted = !synth.isMuted;
        localStorage.setItem('barista_flow_muted', synth.isMuted.toString());
        
        if (iconOn && iconOff) {
          if (synth.isMuted) {
            iconOn.classList.add('hidden');
            iconOff.classList.remove('hidden');
            btnSoundToggle!.classList.add('border-red-500/30', 'text-red-400');
            synth.speechSynth?.cancel();
          } else {
            iconOn.classList.remove('hidden');
            iconOff.classList.add('hidden');
            btnSoundToggle!.classList.remove('border-red-500/30', 'text-red-400');
            synth.speak(dict.voiceEnabled);
          }
        }
      });
    }

    // Modal bindings
    if (tastingForm) {
      tastingForm.addEventListener('submit', saveTastingLog);
    }
    if (btnSkipLog) {
      btnSkipLog.addEventListener('click', hideTastingModal);
    }
    btnCloseDiagnosis?.addEventListener('click', hideTastingModal);
    btnApplyDiagnosis?.addEventListener('click', applyDiagnosis);
    modalBackdrop?.addEventListener('click', hideTastingModal);
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && tastingModal && !tastingModal.classList.contains('hidden')) hideTastingModal();
    });
    
    // Live update slider values
    ['acidity', 'bitterness', 'body', 'overall'].forEach(id => {
      const input = document.getElementById(`rating-${id}`);
      if (input) {
        input.addEventListener('input', updateSliderValues);
      }
    });

    // Listen to custom recipe event
    window.addEventListener('coffee-recipe-changed', ((e: CustomEvent) => {
      handleRecipeUpdate(e.detail);
      initOrUpdateChart(recipe);
    }) as EventListener);

    // Initial load from LocalStorage if exists
    let savedRecipeStr = null;
    try { savedRecipeStr = localStorage.getItem('barista_flow_recipe'); } catch (error) {}
    if (savedRecipeStr) {
      try {
        const loadedRecipe = JSON.parse(savedRecipeStr);
        handleRecipeUpdate(loadedRecipe, false);
        initOrUpdateChart(recipe);
      } catch (e) {
        console.error('Failed to parse saved recipe in timer init', e);
        updateDisplay();
        initOrUpdateChart(recipe);
      }
    } else {
      updateDisplay();
      initOrUpdateChart(recipe);
    }

    if (restoreTimerSession()) {
      updateDisplay();
      if (btnStart) btnStart.textContent = dict.btnResume;
    }
  });
</script>
