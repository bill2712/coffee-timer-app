---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!-- Install PWA Prompt Container -->
<div id="pwa-install-banner" class="fixed bottom-4 left-4 right-4 z-50 block lg:hidden transform translate-y-24 opacity-0 transition-all duration-500 ease-out" style="display: none;">
  <div class="bg-gray-900/80 backdrop-blur-md border border-white/10 rounded-2xl p-4 shadow-2xl flex flex-col gap-3 relative overflow-hidden">
    <!-- Close button -->
    <button id="pwa-close-btn" class="absolute top-2 right-2 p-1.5 text-gray-400 hover:text-white bg-gray-800/50 hover:bg-gray-700/50 rounded-full transition-colors" aria-label="Close">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
      </svg>
    </button>
    
    <div class="flex items-center gap-3">
      <div class="flex-shrink-0 w-12 h-12 bg-black/50 rounded-xl border border-white/5 flex items-center justify-center shadow-inner">
        <img src="/favicon.svg" alt="App Icon" class="w-8 h-8 drop-shadow-md" />
      </div>
      <div class="flex-1 pr-6">
        <h3 class="font-display font-bold text-white text-[15px] leading-tight drop-shadow-sm">{t('pwa_install.title')}</h3>
        <p class="text-[11px] text-gray-300 mt-1 leading-snug line-clamp-2">{t('pwa_install.desc')}</p>
      </div>
    </div>
    
    <!-- Dynamic action area based on OS -->
    <div id="pwa-action-container" class="w-full">
      <!-- Android / Native install button -->
      <button id="pwa-install-btn" class="hidden w-full bg-white text-black font-bold text-[13px] py-2 rounded-lg hover:bg-gray-100 active:scale-95 transition-all shadow-[0_0_15px_rgba(255,255,255,0.2)]">
        {t('pwa_install.btn_android')}
      </button>

      <!-- iOS Reveal Button -->
      <button id="pwa-ios-reveal-btn" class="hidden w-full bg-white/10 text-white border border-white/20 font-medium text-[13px] py-2 rounded-lg hover:bg-white/20 active:scale-95 transition-all">
        {t('pwa_install.btn_ios')}
      </button>
      
      <!-- iOS Instruction (Hidden by default) -->
      <div id="pwa-ios-instruction" class="hidden mt-2 text-[11px] text-gray-300 bg-black/40 p-3 rounded-lg border border-white/5 leading-relaxed">
        {t('pwa_install.ios_step')}
      </div>
    </div>
  </div>
</div>

<script>
  let deferredPrompt: any = null;
  const pwaBanner = document.getElementById('pwa-install-banner');
  const closeBtn = document.getElementById('pwa-close-btn');
  const installBtn = document.getElementById('pwa-install-btn');
  const iosRevealBtn = document.getElementById('pwa-ios-reveal-btn');
  const iosInstruction = document.getElementById('pwa-ios-instruction');

  // Detect iOS Safari
  const isIos = () => {
    const userAgent = window.navigator.userAgent.toLowerCase();
    return /iphone|ipad|ipod/.test(userAgent) && !window.MSStream;
  };

  // Detect if app is already installed/standalone
  const isStandalone = () => {
    return ('standalone' in window.navigator && (window.navigator as any).standalone) || window.matchMedia('(display-mode: standalone)').matches;
  };

  // Check 7-day dismissal
  const checkDismissed = () => {
    const expiry = localStorage.getItem('pwa_dismissed_until');
    if (!expiry) return false;
    if (new Date().getTime() > parseInt(expiry, 10)) {
      localStorage.removeItem('pwa_dismissed_until');
      return false;
    }
    return true;
  };

  // Show banner utility with animation
  const showBanner = () => {
    if (checkDismissed() || isStandalone() || !pwaBanner) return;
    
    // Display block first, then trigger animation
    pwaBanner.style.display = 'block';
    
    // Slight delay to ensure CSS transition works after display:block
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        pwaBanner.classList.remove('translate-y-24', 'opacity-0');
      });
    });
  };

  const dismissBanner = () => {
    if (!pwaBanner) return;
    
    pwaBanner.classList.add('translate-y-24', 'opacity-0');
    
    // Set expiry to 7 days from now
    const expiry = new Date().getTime() + 7 * 24 * 60 * 60 * 1000;
    localStorage.setItem('pwa_dismissed_until', expiry.toString());
    
    // Hide completely after animation
    setTimeout(() => {
      pwaBanner.style.display = 'none';
    }, 500);
  };

  // Close button logic
  if (closeBtn) {
    closeBtn.addEventListener('click', dismissBanner);
  }

  // Handle iOS specific logic first, since it doesn't wait for events
  if (isIos() && !isStandalone() && !checkDismissed() && iosRevealBtn) {
    iosRevealBtn.classList.remove('hidden');
    
    // Add click event to reveal instructions
    iosRevealBtn.addEventListener('click', () => {
      iosRevealBtn.classList.add('hidden');
      if (iosInstruction) {
        iosInstruction.classList.remove('hidden');
        // Let them read it for a bit, don't dismiss immediately
      }
    });
    
    // Delay showing to not interrupt immediate page load experience
    setTimeout(showBanner, 2000);
  }

  // Handle native install prompt (Android/Desktop)
  window.addEventListener('beforeinstallprompt', (e) => {
    // Prevent the mini-infobar from appearing on mobile
    e.preventDefault();
    deferredPrompt = e;
    
    // Only show Android logic if not iOS
    if (!isIos() && installBtn && !isStandalone() && !checkDismissed()) {
      installBtn.classList.remove('hidden');
      if (iosRevealBtn) iosRevealBtn.classList.add('hidden'); // Ensure iOS button is hidden
      
      // Delay showing to not interrupt immediate page load experience
      setTimeout(showBanner, 2000);
    }
  });

  // Handle Install Button Click
  if (installBtn) {
    installBtn.addEventListener('click', async () => {
      if (!deferredPrompt) return;
      
      // Show the install prompt
      deferredPrompt.prompt();
      
      // Wait for the user to respond to the prompt
      const { outcome } = await deferredPrompt.userChoice;
      if (outcome === 'accepted') {
        dismissBanner();
      }
      deferredPrompt = null;
    });
  }

  // Hide if successfully installed during session
  window.addEventListener('appinstalled', () => {
    dismissBanner();
    deferredPrompt = null;
  });
</script>
