---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import AdSlot from '../components/AdSlot.astro';
import PWAInstallPrompt from '../components/PWAInstallPrompt.astro';
import LanguagePicker from '../components/LanguagePicker.astro';
import PageFeedback from '../components/PageFeedback.astro';
import { getLangFromUrl, useTranslations, rtlLanguages } from '../i18n/utils';
import { languages } from '../i18n/ui';


interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  article?: boolean;
  jsonld?: any;
  hideTopAd?: boolean;
}

const {
  title,
  description,
  keywords,
  ogImage = "/images/og-default.jpg",
  article = false,
  jsonld,
  hideTopAd = false
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const lang = getLangFromUrl(Astro.url);
const localeHome = `${base}${lang}/`.replace(/\/+/g, '/');
const t = useTranslations(lang);
const isRTL = rtlLanguages.includes(lang);
const hasMultipleLanguages = Object.keys(languages).length > 1;

const finalTitle = title || t('seo.title');
const finalDescription = description || t('seo.description');
const finalKeywords = keywords || t('seo.keywords');
---

<!doctype html>
<html lang={lang} dir={isRTL ? "rtl" : "ltr"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={base + "favicon.svg"} />
    <link rel="manifest" href={base + "manifest.json"} />
    
    <!-- Google Fonts Preconnect and Links -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet" />
    
    <SEO title={finalTitle} description={finalDescription} keywords={finalKeywords} image={ogImage} article={article} jsonld={jsonld} />

    <meta name="generator" content={Astro.generator} />
    <meta name="google-adsense-account" content="ca-pub-7189047900748105" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <!-- The AdSense loader remains for site review; ad units stay disabled until approval. -->
    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7189047900748105" crossorigin="anonymous"></script>
  </head>
  <body class="bg-coffee-dark text-coffee-light min-h-screen flex flex-col selection:bg-coffee-gold selection:text-coffee-dark overflow-x-hidden transition-colors duration-500 break-words hyphens-auto">
    <!-- Navbar -->
    <header class="sticky top-0 z-50 w-full backdrop-blur-md bg-coffee-dark/80 border-b border-coffee-sand/10 shadow-sm transition-all duration-300">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16 sm:h-20">
          <div class="flex-shrink-0 flex items-center relative z-[60]">
            <a href={localeHome} class="flex items-center gap-2 group">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-coffee-gold transition-transform group-hover:rotate-12 duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 8h1a4 4 0 1 1 0 8h-1" />
                <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z" />
                <line x1="6" y1="2" x2="6" y2="4" />
                <line x1="10" y1="2" x2="10" y2="4" />
                <line x1="14" y1="2" x2="14" y2="4" />
              </svg>
              <span class="font-display text-xl sm:text-2xl font-bold tracking-wider bg-gradient-to-r from-coffee-gold to-coffee-accent bg-clip-text text-transparent">
                BARISTA FLOW
              </span>
            </a>
          </div>
          
          <nav class="hidden lg:flex items-center gap-5 ms-auto min-w-0" aria-label={lang === 'zh-TW' ? '主要導航' : 'Primary navigation'}>
            <a href={`${base}${lang}/`} class="text-sm font-medium tracking-wide text-coffee-light/80 hover:text-coffee-gold transition-colors duration-200">{lang === 'zh-TW' ? '開始沖煮' : 'Start brewing'}</a>
            <a href={`${base}${lang}/history`} class="text-sm font-medium tracking-wide text-coffee-gold hover:text-coffee-light transition-colors duration-200">{lang === 'zh-TW' ? '我的紀錄' : 'My records'}</a>
            <a href={`${base}${lang}/blog`} class="text-sm font-medium tracking-wide text-coffee-light/80 hover:text-coffee-gold transition-colors duration-200">{lang === 'zh-TW' ? '學習' : 'Learn'}</a>
            <details class="group relative">
              <summary class="flex min-h-[44px] cursor-pointer list-none items-center gap-1 rounded-lg px-2 text-sm font-medium tracking-wide text-coffee-light/80 hover:text-coffee-gold focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-coffee-gold">{lang === 'zh-TW' ? '更多' : 'More'} <span class="text-xs transition-transform group-open:rotate-180" aria-hidden="true">⌄</span></summary>
              <div class="absolute end-0 top-full z-[70] mt-2 grid w-64 gap-1 rounded-xl border border-coffee-sand/15 bg-coffee-darker p-2 shadow-2xl">
                <a href={`${base}${lang}/training`} class="nav-more-link">{lang === 'zh-TW' ? '首五杯新手訓練' : 'First Five Brews'}</a>
                <a href={`${base}${lang}/beans`} class="nav-more-link">{lang === 'zh-TW' ? '咖啡豆護照' : 'Bean passports'}</a>
                <a href={`${base}${lang}/insights`} class="nav-more-link">{lang === 'zh-TW' ? '個人數據洞察' : 'Personal insights'}</a>
                <a href={`${base}${lang}/tools/grinder-calibration`} class="nav-more-link">{lang === 'zh-TW' ? '個人磨豆機校準' : 'Grinder calibration'}</a>
                <a href={`${base}${lang}/recipes`} class="nav-more-link">{lang === 'zh-TW' ? '有來源配方庫' : 'Source-backed recipes'}</a>
                <a href={`${base}${lang}/tools/grind-converter`} class="nav-more-link">{lang === 'zh-TW' ? '沖煮工具與計算器' : 'Brewing tools & calculators'}</a>
                <a href={`${base}${lang}/faq`} class="nav-more-link">{t('nav.faq')}</a>
                <a href={`${base}${lang}/data`} class="nav-more-link">{lang === 'zh-TW' ? '資料備份／搬機' : 'Backup / transfer'}</a>
              </div>
            </details>
            <div class="border-s border-coffee-sand/20 h-6 mx-2 hidden lg:block"></div>
            {hasMultipleLanguages && <LanguagePicker idSuffix="desktop" />}
          </nav>

          <!-- Mobile Menu Toggle Button (Hamburger-to-X) -->
          <button id="mobile-menu-toggle" class="lg:hidden relative z-[60] w-12 h-12 flex flex-col justify-center items-end gap-[6px] outline-none group" aria-label={lang === 'zh-TW' ? '切換選單' : 'Toggle menu'} aria-controls="mobile-menu-drawer" aria-expanded="false">
            <span class="line-1 block h-[2px] bg-coffee-gold rounded-full w-7 transition-all duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)] group-hover:w-8"></span>
            <span class="line-2 block h-[2px] bg-coffee-gold rounded-full w-5 transition-all duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)] group-hover:w-8"></span>
          </button>
        </div>
      </div>
    </header>

    <!-- Mobile Glassmorphic Overlay Drawer -->
    <div id="mobile-menu-drawer" role="dialog" aria-modal="true" aria-hidden="true" inert aria-label={lang === 'zh-TW' ? '主選單' : 'Main menu'} class="fixed inset-0 z-[55] overflow-y-auto backdrop-blur-xl bg-coffee-dark/95 flex flex-col opacity-0 -translate-y-full pointer-events-none transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]">
      <nav class="flex min-h-full flex-col items-center justify-center space-y-4 px-6 py-24">
        <a href={`${base}${lang}/`} class="mobile-link text-2xl sm:text-3xl font-light tracking-wide text-coffee-light opacity-0 translate-y-12 transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] hover:text-coffee-gold active:scale-95">{lang === 'zh-TW' ? '開始沖煮' : 'Start brewing'}</a>
        <a href={`${base}${lang}/history`} class="mobile-link text-2xl sm:text-3xl font-light tracking-wide text-coffee-gold opacity-0 translate-y-12 transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] hover:text-coffee-light active:scale-95">{lang === 'zh-TW' ? '我的紀錄' : 'My records'}</a>
        <a href={`${base}${lang}/blog`} class="mobile-link text-2xl sm:text-3xl font-light tracking-wide text-coffee-light opacity-0 translate-y-12 transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] hover:text-coffee-gold active:scale-95">{lang === 'zh-TW' ? '學習' : 'Learn'}</a>
        <details class="mobile-link group w-full max-w-sm opacity-0 translate-y-12 transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)]">
          <summary class="flex min-h-[52px] cursor-pointer list-none items-center justify-center gap-2 text-2xl font-light tracking-wide text-coffee-light">{lang === 'zh-TW' ? '更多' : 'More'} <span class="text-base transition-transform group-open:rotate-180">⌄</span></summary>
          <div class="mt-3 grid grid-cols-2 gap-2 rounded-xl border border-coffee-sand/10 bg-coffee-darker/60 p-3 text-center text-sm text-coffee-sand">
            <a href={`${base}${lang}/training`} class="rounded-lg p-3 hover:bg-coffee-gold/10">{lang === 'zh-TW' ? '首五杯' : 'Five brews'}</a>
            <a href={`${base}${lang}/beans`} class="rounded-lg p-3 hover:bg-coffee-gold/10">{lang === 'zh-TW' ? '咖啡豆護照' : 'Bean passports'}</a>
            <a href={`${base}${lang}/insights`} class="rounded-lg p-3 hover:bg-coffee-gold/10">{lang === 'zh-TW' ? '個人洞察' : 'Insights'}</a>
            <a href={`${base}${lang}/tools/grinder-calibration`} class="rounded-lg p-3 hover:bg-coffee-gold/10">{lang === 'zh-TW' ? '磨豆機校準' : 'Grinder'}</a>
            <a href={`${base}${lang}/recipes`} class="rounded-lg p-3 hover:bg-coffee-gold/10">{lang === 'zh-TW' ? '配方庫' : 'Recipes'}</a>
            <a href={`${base}${lang}/tools/grind-converter`} class="rounded-lg p-3 hover:bg-coffee-gold/10">{lang === 'zh-TW' ? '工具' : 'Tools'}</a>
            <a href={`${base}${lang}/faq`} class="rounded-lg p-3 hover:bg-coffee-gold/10">{t('nav.faq')}</a>
            <a href={`${base}${lang}/data`} class="rounded-lg p-3 hover:bg-coffee-gold/10">{lang === 'zh-TW' ? '備份' : 'Backup'}</a>
          </div>
        </details>
        
        <div class="mobile-link opacity-0 translate-y-12 transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] pt-4">
          {hasMultipleLanguages && <LanguagePicker idSuffix="mobile" />}
        </div>
      </nav>
    </div>

    <!-- Main Content -->
    <main class="flex-grow max-w-6xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 relative z-10">
      <!-- Ambient Glow for Desktop -->
      <div class="fixed top-[-10%] start-[-5%] w-[500px] h-[500px] bg-coffee-gold/10 blur-[120px] rounded-full -z-10 pointer-events-none hidden lg:block"></div>
      <div class="fixed bottom-[-10%] end-[-5%] w-[600px] h-[600px] bg-coffee-accent/10 blur-[150px] rounded-full -z-10 pointer-events-none hidden lg:block"></div>

      <!-- Top Leaderboard Ad Slot (Global) -->
      {!hideTopAd && <AdSlot type="top-leaderboard" id="adsense-top-banner" class="my-6" />}

      <slot />
      <PageFeedback />
    </main>

    <!-- Footer -->
    <footer class="w-full bg-coffee-darker border-t border-coffee-sand/10 py-8 sm:py-12 mt-auto transition-colors duration-500">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row items-center justify-between gap-6">
          <div class="flex flex-col items-center md:items-start gap-2">
            <div class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-coffee-gold/60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M17 8h1a4 4 0 1 1 0 8h-1" />
                <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z" />
              </svg>
              <span class="font-display font-semibold tracking-widest text-coffee-sand/80 text-sm">BARISTA FLOW</span>
            </div>
            <p class="text-xs text-coffee-muted italic text-center md:text-start mt-1">
              {lang === 'zh-TW' ? '可調整、可重現、以味道驗證的沖煮起點。' : 'Adjustable, reproducible starting points—validated by taste.'}
            </p>
          </div>
          
          <div class="flex flex-wrap justify-center gap-x-4 sm:gap-x-8 gap-y-3 text-xs text-coffee-muted">
            <a href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/${lang}/about`} class="hover:text-coffee-gold transition-colors">{t('nav.about')}</a>
            <a href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/${lang}/methodology`} class="hover:text-coffee-gold transition-colors">{lang === 'zh-TW' ? '計算方法與來源' : 'Methodology & sources'}</a>
            <a href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/${lang}/recipes`} class="hover:text-coffee-gold transition-colors">{lang === 'zh-TW' ? '標準配方庫' : 'Standard recipes'}</a>
            <a href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/${lang}/beans`} class="hover:text-coffee-gold transition-colors">{lang === 'zh-TW' ? '咖啡豆護照' : 'Bean passports'}</a>
            <a href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/${lang}/insights`} class="hover:text-coffee-gold transition-colors">{lang === 'zh-TW' ? '個人數據洞察' : 'Personal insights'}</a>
            <a href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/${lang}/data`} class="hover:text-coffee-gold transition-colors">{lang === 'zh-TW' ? '資料備份' : 'Data backup'}</a>
            <a href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/${lang}/faq`} class="hover:text-coffee-gold transition-colors">{t('nav.faq')}</a>
            <a href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/${lang}/contact`} class="hover:text-coffee-gold transition-colors">{t('nav.contact')}</a>
            <a href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/${lang}/terms-of-service`} class="hover:text-coffee-gold transition-colors">{t('nav.terms')}</a>
            <a href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/${lang}/privacy-policy`} class="hover:text-coffee-gold transition-colors">{t('nav.privacy')}</a>
          </div>
        </div>
        
        <div class="border-t border-coffee-gray/40 mt-8 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
          <p class="text-xs text-coffee-muted">
            &copy; {new Date().getFullYear()} Barista Flow. {t('footer.rights')}
          </p>
          <p class="text-xs text-coffee-muted flex items-center gap-1">
            {t('layout.footer.madeFor')}
          </p>
        </div>
      </div>
    </footer>

    <!-- Service Worker Registration -->
    <script is:inline define:vars={{ base }}>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register(`${base}sw.js`).catch((error) => {
            console.error('ServiceWorker registration failed: ', error);
          });
        });
      }
    </script>

    <!-- Mobile Navigation Logic -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const toggleBtn = document.getElementById('mobile-menu-toggle');
        const drawer = document.getElementById('mobile-menu-drawer');
        const line1 = toggleBtn?.querySelector('.line-1');
        const line2 = toggleBtn?.querySelector('.line-2');
        const menuItems = document.querySelectorAll('.mobile-link');
        const menuLinks = drawer?.querySelectorAll('a') || [];
        
        let isOpen = false;

        function toggleMenu() {
          isOpen = !isOpen;
          toggleBtn?.setAttribute('aria-expanded', String(isOpen));
          
          if (isOpen) {
            // Morph Hamburger to X
            line1?.classList.add('w-6', 'rotate-45', 'translate-y-[8px]');
            line1?.classList.remove('w-7', 'group-hover:w-8');
            
            line2?.classList.add('w-6', '-rotate-45', '-translate-y-[8px]');
            line2?.classList.remove('w-5', 'group-hover:w-8');

            // Show Drawer
            drawer?.classList.remove('opacity-0', '-translate-y-full', 'pointer-events-none');
            drawer?.classList.add('opacity-100', 'translate-y-0');
            drawer?.setAttribute('aria-hidden', 'false');
            drawer?.removeAttribute('inert');
            
            // Lock body scroll
            document.body.style.overflow = 'hidden';

            // Animate links in staggered
            menuItems.forEach((link, index) => {
              setTimeout(() => {
                link.classList.remove('opacity-0', 'translate-y-12');
                link.classList.add('opacity-100', 'translate-y-0');
              }, 100 + (index * 75));
            });
          } else {
            // Morph X to Hamburger
            line1?.classList.remove('w-6', 'rotate-45', 'translate-y-[8px]');
            line1?.classList.add('w-7', 'group-hover:w-8');
            
            line2?.classList.remove('w-6', '-rotate-45', '-translate-y-[8px]');
            line2?.classList.add('w-5', 'group-hover:w-8');

            // Hide Drawer
            drawer?.classList.remove('opacity-100', 'translate-y-0');
            drawer?.classList.add('opacity-0', '-translate-y-full', 'pointer-events-none');
            drawer?.setAttribute('aria-hidden', 'true');
            drawer?.setAttribute('inert', '');
            
            // Unlock body scroll
            document.body.style.overflow = '';

            // Reset links
            menuItems.forEach((link) => {
              link.classList.add('opacity-0', 'translate-y-12');
              link.classList.remove('opacity-100', 'translate-y-0');
            });
          }
        }

        toggleBtn?.addEventListener('click', toggleMenu);

        // Close menu when clicking a link
        menuLinks.forEach(link => {
          link.addEventListener('click', () => {
            if (isOpen) toggleMenu();
          });
        });

        const desktopMore = document.querySelector('header details') as HTMLDetailsElement | null;
        document.addEventListener('click', (event) => {
          if (desktopMore?.open && event.target instanceof Node && !desktopMore.contains(event.target)) desktopMore.open = false;
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            if (desktopMore?.open) desktopMore.open = false;
            if (isOpen) toggleMenu();
          }
        });
      });
    </script>
    <PWAInstallPrompt />
  </body>
</html>
