---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import AdSlot from '../components/AdSlot.astro';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  article?: boolean;
  jsonld?: any;
}

const {
  title = "Barista Flow | 專業精品咖啡三階段注水計時器",
  description = "Barista Flow 提供精品咖啡沖煮參數計算與互動式三階段注水計時器，助您精準控制悶蒸、主要萃取與後段強度，沖煮出極致風味的咖啡。",
  ogImage = "/images/og-default.jpg",
  article = false,
  jsonld
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={base + "favicon.svg"} />
    
    <!-- Google Fonts Preconnect and Links -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet" />
    
    <SEO title={title} description={description} image={ogImage} article={article} jsonld={jsonld} />

    <meta name="generator" content={Astro.generator} />
    
    <!-- Google AdSense Placeholder (Required for approval) -->
    <!-- <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXXXXXXXX" crossorigin="anonymous"></script> -->
  </head>
  <body class="coffee-bg-gradient min-h-screen flex flex-col selection:bg-coffee-gold selection:text-coffee-dark overflow-x-hidden">
    <!-- Navbar -->
    <header class="sticky top-0 z-50 w-full glass-card border-b border-coffee-sand/10">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16 sm:h-20">
          <div class="flex-shrink-0 flex items-center">
            <a href={base} class="flex items-center gap-2 group">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-coffee-gold transition-transform group-hover:rotate-12 duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 8h1a4 4 0 1 1 0 8h-1" />
                <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z" />
                <line x1="6" y1="2" x2="6" y2="4" />
                <line x1="10" y1="2" x2="10" y2="4" />
                <line x1="14" y1="2" x2="14" y2="4" />
              </svg>
              <span class="font-display text-xl sm:text-2xl font-bold tracking-wider bg-gradient-to-r from-coffee-gold to-coffee-sand bg-clip-text text-transparent">
                BARISTA FLOW
              </span>
            </a>
          </div>
          
          <nav class="flex items-center gap-4 sm:gap-8 overflow-x-auto whitespace-nowrap hide-scrollbar ml-4 min-w-0">
            <a href={base} class="text-sm font-medium tracking-wide text-coffee-light/80 hover:text-coffee-gold transition-colors duration-200">
              首頁
            </a>
            <a href={base + "blog"} class="text-sm font-medium tracking-wide text-coffee-light/80 hover:text-coffee-gold transition-colors duration-200">
              知識庫
            </a>
            <a href={base + "about"} class="text-sm font-medium tracking-wide text-coffee-light/80 hover:text-coffee-gold transition-colors duration-200">
              關於我們
            </a>
            <a href={base + "tools/grind-converter"} class="text-sm font-medium tracking-wide text-coffee-gold hover:text-coffee-light transition-colors duration-200 flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd" />
              </svg>
              研磨度轉換
            </a>
            <a href={base + "tools/water-temperature"} class="text-sm font-medium tracking-wide text-orange-400 hover:text-orange-300 transition-colors duration-200 flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd" />
              </svg>
              水溫預測
            </a>
            <a href={base + "tools/bean-freshness"} class="text-sm font-medium tracking-wide text-green-400 hover:text-green-300 transition-colors duration-200 flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5 2a2 2 0 00-2 2v14l3.5-2 3.5 2 3.5-2 3.5 2V4a2 2 0 00-2-2H5zm4.707 3.707a1 1 0 00-1.414-1.414l-3 3a1 1 0 000 1.414l3 3a1 1 0 001.414-1.414L8.414 9H10a3 3 0 013 3v1a1 1 0 102 0v-1a5 5 0 00-5-5H8.414l1.293-1.293z" clip-rule="evenodd" />
              </svg>
              養豆計算
            </a>
            <a href={base + "history"} class="text-sm font-medium tracking-wide text-coffee-gold hover:text-coffee-light transition-colors duration-200">
              沖煮紀錄
            </a>
            <a href={base + "faq"} class="text-sm font-medium tracking-wide text-coffee-light/80 hover:text-coffee-gold transition-colors duration-200">
              常見問題
            </a>
          </nav>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow max-w-6xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 relative z-10">
      <!-- Top Leaderboard Ad Slot (Global) -->
      <AdSlot type="top-leaderboard" id="adsense-top-banner" class="my-6" />

      <slot />
    </main>

    <!-- Footer -->
    <footer class="w-full bg-coffee-darker border-t border-coffee-sand/5 py-8 sm:py-12 mt-auto">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row items-center justify-between gap-6">
          <div class="flex flex-col items-center md:items-start gap-2">
            <div class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-coffee-gold/60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M17 8h1a4 4 0 1 1 0 8h-1" />
                <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z" />
              </svg>
              <span class="font-display font-semibold tracking-widest text-coffee-sand/80 text-sm">BARISTA FLOW</span>
            </div>
            <p class="text-xs text-coffee-muted italic text-center md:text-left mt-1">
              "Coffee is a language in itself." — Jackie Chan
            </p>
          </div>
          
          <div class="flex flex-wrap justify-center gap-x-4 sm:gap-x-8 gap-y-3 text-xs text-coffee-muted">
            <a href={base + "about"} class="hover:text-coffee-gold transition-colors">關於我們</a>
            <a href={base + "faq"} class="hover:text-coffee-gold transition-colors">常見問題</a>
            <a href={base + "contact"} class="hover:text-coffee-gold transition-colors">聯絡我們</a>
            <a href={base + "terms-of-service"} class="hover:text-coffee-gold transition-colors">服務條款</a>
            <a href={base + "privacy-policy"} class="hover:text-coffee-gold transition-colors">隱私權政策</a>
          </div>
        </div>
        
        <div class="border-t border-coffee-gray/40 mt-8 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
          <p class="text-xs text-coffee-muted">
            &copy; {new Date().getFullYear()} Barista Flow. 保留所有權利。
          </p>
          <p class="text-xs text-coffee-muted flex items-center gap-1">
            Made for Specialty Coffee Lovers ☕
          </p>
        </div>
      </div>
    </footer>

    <!-- Global Cookie Consent Banner -->
    <CookieBanner />
  </body>
</html>
