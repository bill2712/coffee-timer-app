---
import Layout from '../../layouts/Layout.astro';
import AdSlot from '../../components/AdSlot.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const faqs = [
  {
    question: "為什麼我的手沖咖啡喝起來很苦澀？",
    answer: "咖啡苦澀通常是因為「過度萃取」。這可能肇因於水溫過高、研磨刻度太細導致細粉過多，或者是萃取時間過長。建議您嘗試將研磨度調粗一到兩格，或是使用我們的 <a href=\"/\" class=\"text-coffee-gold underline underline-offset-4 hover:text-coffee-light transition-colors font-medium\">專業沖煮計時器</a> 來精準控制各階段的注水時間，避免後段的焦苦物質溶出。"
  },
  {
    question: "咖啡豆應該要怎麼保存才能維持新鮮？",
    answer: "咖啡豆最大的敵人是氧氣、光線、濕氣與高溫。最理想的保存方式是將咖啡豆放在單向排氣閥的不透明密封罐或密封袋中，並置於陰涼乾燥的櫥櫃內。切勿將日常使用的咖啡豆放進冰箱冷藏，以免溫差產生結露現象加速咖啡豆變質。"
  },
  {
    question: "淺焙和深焙咖啡在沖煮上有什麼不同？",
    answer: "淺焙咖啡豆質地較硬，風味偏向花果酸香，需要較高的水溫（約 91°C-94°C）與較細的研磨來充分萃取；深焙咖啡豆結構較鬆散，焦糖化深，容易釋放苦味，因此建議使用較低的水溫（約 85°C-88°C）與較粗的研磨。如果您不確定如何調整，可以試試我們的 <a href=\"/\" class=\"text-coffee-gold underline underline-offset-4 hover:text-coffee-light transition-colors font-medium\">沖煮配方計算機</a> 為不同烘焙度量身打造參數。"
  },
  {
    question: "什麼是「通道效應 (Channeling)」，該如何避免？",
    answer: "通道效應是指水流在粉床中尋找阻力最小的捷徑流出，導致部分粉末過度萃取而部分未萃取，造成咖啡同時又酸又苦。要避免通道效應，請確保佈粉平整、使用品質較佳的磨豆機減少細粉，並在注水時保持水流穩定柔和，不要大力沖刷粉床。"
  },
  {
    question: "粉水比（Brew Ratio）到底該怎麼抓？",
    answer: "標準的精品手沖咖啡粉水比通常落在 1:15 到 1:17 之間（即 1 克咖啡粉對應 15 到 17 克的水）。1:15 口感較為濃郁醇厚，1:17 則清爽明亮。您可以根據個人口味微調。利用我們的 <a href=\"/\" class=\"text-coffee-gold underline underline-offset-4 hover:text-coffee-light transition-colors font-medium\">咖啡比例助理</a>，只要輸入您手邊的咖啡豆克數，系統就會自動幫您計算出完美的水量。"
  },
  {
    question: "為什麼悶蒸（Blooming）時咖啡粉沒有膨脹？",
    answer: "悶蒸時咖啡粉床會膨脹，是因為豆子排出烘焙時產生的二氧化碳。如果完全沒有膨脹，最常見的原因是咖啡豆已經放置過久，排氣完畢（不新鮮了）；另外，如果是極度淺焙的咖啡，排氣反應本來就會比較微弱。只要確保豆子在烘焙後的一個月內飲用完畢，通常都能保有良好的風味。"
  }
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      // Strip HTML tags for clean JSON-LD text using a simple regex
      "text": faq.answer.replace(/<[^>]*>?/gm, '')
    }
  }))
};
---

<Layout 
  title="常見問題 FAQ | 咖啡沖煮疑難排解"
  description="為什麼咖啡會苦？粉水比怎麼算？在此找到最專業的手沖咖啡常見問題解答，並學習如何提升您的萃取技術。"
  jsonld={jsonLd}
>
  <div class="max-w-3xl mx-auto py-12">
    <!-- Breadcrumb -->
    <div class="flex justify-center">
      <Breadcrumbs items={[
        { label: '首頁', url: '/' },
        { label: '常見問題 FAQ' }
      ]} />
    </div>

    <!-- Header -->
    <header class="text-center mb-16 relative">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 w-32 h-32 bg-coffee-gold/10 blur-[50px] rounded-full -z-10"></div>
      <h1 class="font-display text-4xl sm:text-5xl font-bold tracking-tight text-coffee-light mb-6">
        咖啡沖煮 <span class="text-transparent bg-clip-text bg-gradient-to-r from-coffee-gold to-coffee-accent">疑難排解</span>
      </h1>
      <p class="text-lg text-coffee-sand/80 max-w-2xl mx-auto font-light leading-relaxed">
        從苦澀的原因到完美的粉水比例，為您的每一個沖煮疑惑提供科學化的權威解答。
      </p>
    </header>

    <!-- Top Ad Placeholder -->
    <div class="mb-12">
      <AdSlot type="leaderboard" id="faq-top-ad" />
    </div>

    <!-- FAQ Accordion List -->
    <div class="space-y-4" id="faq-accordion">
      {faqs.map((faq, index) => (
        <div class="glass-card rounded-2xl border border-coffee-sand/10 overflow-hidden transition-colors hover:border-coffee-gold/30 faq-item">
          <button 
            class="faq-button w-full flex items-center justify-between p-6 text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-coffee-gold/50"
            aria-expanded="false"
            aria-controls={`faq-answer-${index}`}
            id={`faq-question-${index}`}
          >
            <h3 class="font-display text-lg sm:text-xl font-bold text-coffee-light pr-8">
              {faq.question}
            </h3>
            <span class="faq-icon flex-shrink-0 ml-4 flex items-center justify-center w-8 h-8 rounded-full bg-coffee-darker border border-coffee-sand/20 text-coffee-gold transition-transform duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </button>
          
          <div 
            id={`faq-answer-${index}`}
            class="faq-answer grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-in-out"
            role="region"
            aria-labelledby={`faq-question-${index}`}
          >
            <div class="overflow-hidden">
              <div class="p-6 pt-0 text-coffee-sand/85 leading-relaxed font-light border-t border-coffee-sand/5 mt-2">
                <p set:html={faq.answer}></p>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Contact CTA -->
    <div class="mt-16 text-center glass-card-interactive p-8 rounded-2xl">
      <h3 class="font-display text-2xl font-bold text-coffee-light mb-3">
        找不到您的問題？
      </h3>
      <p class="text-coffee-muted mb-6 text-sm">
        歡迎隨時與我們的專業團隊聯繫，我們將樂意為您解答任何關於咖啡沖煮的疑問。
      </p>
      <a href={`${import.meta.env.BASE_URL}/contact`} class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl border border-coffee-gold/50 text-coffee-gold hover:bg-coffee-gold/10 transition-colors text-sm font-semibold tracking-wide">
        聯絡我們
      </a>
    </div>

    <!-- Bottom Ad Placeholder -->
    <div class="mt-16 pt-12 border-t border-coffee-sand/10">
      <AdSlot type="responsive" id="faq-bottom-ad" />
    </div>
  </div>
</Layout>

<script>
  // Simple vanilla JS logic for the accordion with smooth grid-template-rows animation
  document.addEventListener('DOMContentLoaded', () => {
    const faqButtons = document.querySelectorAll('.faq-button');
    
    faqButtons.forEach(button => {
      button.addEventListener('click', () => {
        const isExpanded = button.getAttribute('aria-expanded') === 'true';
        const answerDiv = button.nextElementSibling;
        const icon = button.querySelector('.faq-icon');
        
        // Close all other accordions (optional, but good UX for FAQs)
        faqButtons.forEach(btn => {
          if (btn !== button) {
            btn.setAttribute('aria-expanded', 'false');
            const otherAnswerDiv = btn.nextElementSibling;
            const otherIcon = btn.querySelector('.faq-icon');
            if (otherAnswerDiv) otherAnswerDiv.classList.replace('grid-rows-[1fr]', 'grid-rows-[0fr]');
            if (otherIcon) otherIcon.classList.remove('rotate-180');
          }
        });

        // Toggle current accordion
        if (isExpanded) {
          button.setAttribute('aria-expanded', 'false');
          answerDiv?.classList.replace('grid-rows-[1fr]', 'grid-rows-[0fr]');
          icon?.classList.remove('rotate-180');
        } else {
          button.setAttribute('aria-expanded', 'true');
          answerDiv?.classList.replace('grid-rows-[0fr]', 'grid-rows-[1fr]');
          icon?.classList.add('rotate-180');
        }
      });
    });
  });
</script>
