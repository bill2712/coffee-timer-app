---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import AdSlot from '../../components/AdSlot.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

export async function getStaticPaths() {
  const glossaryEntries = await getCollection('blog', (entry) => entry.data.tags?.includes('Glossary'));
  return glossaryEntries.map(entry => ({
    params: { slug: entry.id || entry.slug }, // Handle both Astro legacy and new API
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  "name": entry.data.term,
  "description": entry.data.description,
  "inDefinedTermSet": `${import.meta.env.SITE || 'https://bill2712.github.io'}${import.meta.env.BASE_URL}/glossary`
};
---

<Layout 
  title={`${entry.data.title} | 咖啡百科全書`}
  description={entry.data.description}
  jsonld={jsonLd}
>
  <div class="max-w-6xl mx-auto py-12">
    <!-- Breadcrumb -->
    <Breadcrumbs items={[
      { label: '百科', url: 'glossary' },
      { label: entry.data.term || entry.data.title }
    ]} />

    <!-- Header -->
    <header class="mb-12 border-b border-coffee-sand/10 pb-8 relative mt-8">
      <div class="absolute -top-12 -right-4 text-8xl font-display font-black text-coffee-gold/5 select-none -z-10">
        {entry.data.term?.charAt(0).toUpperCase()}
      </div>
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-coffee-darker border border-coffee-sand/20 text-coffee-sand text-xs font-semibold uppercase tracking-widest mb-4">
        {entry.data.term}
      </div>
      <h1 class="font-display text-4xl sm:text-5xl font-bold tracking-tight text-coffee-light mb-4">
        {entry.data.title}
      </h1>
      <p class="text-lg text-coffee-muted leading-relaxed font-light">
        {entry.data.description}
      </p>
    </header>

    <!-- Main Content Container -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      <div class="lg:col-span-3">
        <!-- Main Definition Card -->
        <article class="glass-card p-8 sm:p-12 rounded-3xl border border-coffee-sand/10 relative overflow-hidden mb-12">
          <!-- Decorative Background -->
          <div class="absolute top-0 right-0 w-64 h-64 bg-coffee-gold/5 blur-[100px] rounded-full -z-10 pointer-events-none"></div>

          <div class="prose prose-invert prose-coffee max-w-none">
             <Content components={{ AdSlot }} />
             
             <AdSlot type="in-article" id={`glossary-side-ad-${entry.id || entry.slug}`} />
          </div>
        </article>

        <!-- Google AdSense Bottom Article Banner Placeholder -->
        <AdSlot type="top-leaderboard" id={`glossary-btm-ad-${entry.id || entry.slug}`} />
      </div>

      <!-- Sidebar -->
      <aside class="lg:col-span-1">
        <AdSlot type="sidebar-skyscraper" id="adsense-glossary-sidebar" class="sticky top-28" />
      </aside>
    </div>
  </div>
</Layout>

<style is:global>
  /* Reuse blog prose styles */
  .blog-content h2 { font-family: var(--font-display); font-size: 1.5rem; font-weight: 700; color: var(--color-coffee-gold); margin-top: 2rem; margin-bottom: 1rem; }
  .blog-content h3 { font-family: var(--font-display); font-size: 1.25rem; font-weight: 600; color: var(--color-coffee-sand); margin-top: 1.5rem; margin-bottom: 0.75rem; }
  .blog-content p { margin-bottom: 1.5rem; color: rgba(245, 242, 235, 0.85); line-height: 1.8; font-weight: 300; }
  .blog-content ul, .blog-content ol { margin-bottom: 1.5rem; padding-left: 1.5rem; color: rgba(245, 242, 235, 0.85); }
  .blog-content li { margin-bottom: 0.5rem; }
  .blog-content strong { color: var(--color-coffee-light); font-weight: 600; }
  
  /* The custom glossary link injected by remark plugin */
  .glossary-link {
    color: var(--color-coffee-gold);
    text-decoration: underline;
    text-decoration-color: rgba(197, 168, 128, 0.3);
    text-underline-offset: 4px;
    transition: all 0.2s ease;
    font-weight: 500;
  }
  .glossary-link:hover {
    color: var(--color-coffee-light);
    text-decoration-color: var(--color-coffee-gold);
    background-color: rgba(197, 168, 128, 0.1);
    border-radius: 2px;
  }
</style>
