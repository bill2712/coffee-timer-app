---
import { defaultLang, languages } from '../i18n/ui';
// This is the root index, responsible for auto-detecting browser language and redirecting.

// We do NOT use Astro.redirect here because this is a statically generated site.
// A static redirect requires a meta refresh or client-side JavaScript.
const rawBase = import.meta.env.BASE_URL || '/';
const baseUrl = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---

<!DOCTYPE html>
<html lang={defaultLang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Redirecting... | Barista Flow</title>
  
  <script is:inline define:vars={{ supportedLanguages: Object.keys(languages), defaultLang, baseUrl }}>
    (function() {
      // Check localStorage first
      const savedLang = localStorage.getItem('barista-flow-lang');
      if (savedLang && supportedLanguages.includes(savedLang)) {
        window.location.replace(baseUrl + savedLang + '/');
        return;
      }
      
      // Auto-detect browser language
      const browserLang = navigator.language.split('-')[0];
      const exactLang = navigator.language; // e.g. "zh-TW"
      
      let targetLang = defaultLang;
      if (supportedLanguages.includes(exactLang)) {
        targetLang = exactLang;
      } else if (supportedLanguages.includes(browserLang)) {
        targetLang = browserLang;
      }
      
      // Save and redirect
      localStorage.setItem('barista-flow-lang', targetLang);
      window.location.replace(baseUrl + targetLang + '/');
    })();
  </script>
  
  <!-- Fallback meta refresh for non-JS browsers -->
  <noscript>
    <meta http-equiv="refresh" content={`0;url=${baseUrl}${defaultLang}/`} />
  </noscript>
</head>
<body class="bg-[#1C120C] flex items-center justify-center min-h-screen">
  <div class="text-[#D9A05B] font-sans">
    Loading your perfect brew...
  </div>
</body>
</html>
