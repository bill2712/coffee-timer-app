---
import Layout from '../layouts/Layout.astro';
import ParameterForm from '../components/ParameterForm.astro';
import Timer from '../components/Timer.astro';
import AdSlot from '../components/AdSlot.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<Layout>
  <!-- Hero Section -->
  <section class="text-center max-w-3xl mx-auto mb-12 sm:mb-16 animate-float">
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-coffee-gold/10 border border-coffee-gold/20 text-coffee-gold text-xs font-semibold uppercase tracking-widest mb-6">
      <span class="w-1.5 h-1.5 rounded-full bg-coffee-gold animate-pulse"></span>
      Specialty Coffee Brewing Guide
    </div>
    
    <h1 class="font-display text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-coffee-light leading-tight">
      點滴之間，<br class="sm:hidden" />
      <span class="bg-gradient-to-r from-coffee-gold via-coffee-sand to-coffee-gold bg-clip-text text-transparent">
        淬煉極致風味
      </span>
    </h1>
    
    <p class="text-sm sm:text-base text-coffee-muted max-w-xl mx-auto mt-6 leading-relaxed">
      精品手沖的靈魂在於精準的節奏與比例。Barista Flow 透過專業的「三階段注水法」，引導您精準掌控悶蒸、主要萃取與後段強度，讓您的咖啡豆綻放出它原本被賦予的產地花香與甘甜。
    </p>
  </section>

  <!-- Interactive Grid Area -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Parameters Input Panel -->
    <div class="lg:col-span-5 order-2 lg:order-1">
      <ParameterForm />
      <div class="mt-8">
        <AdSlot type="bottom-utility" class="my-8" />
      </div>
    </div>

    <!-- Live Timer Panel -->
    <div class="lg:col-span-7 order-1 lg:order-2 lg:sticky lg:top-24">
      <Timer />
    </div>
  </div>

  <!-- Educational Info Cards -->
  <section class="mt-20 border-t border-coffee-sand/10 pt-16">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <h2 class="font-display text-3xl font-bold tracking-wide text-coffee-light">三階段注水黃金比例的科學</h2>
      <p class="text-xs text-coffee-muted mt-2">如何透過精細的時間與水量調配，掌握咖啡的酸、甜、甘、醇。</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
      <div class="glass-card-interactive rounded-2xl p-6 sm:p-8 flex flex-col gap-4">
        <div class="w-12 h-12 rounded-xl bg-coffee-accent/20 border border-coffee-sand/20 flex items-center justify-center text-coffee-gold">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m0-11.314l.707.707m11.314 11.314l.707-.707M4 12a8 8 0 1116 0 8 8 0 01-16 0z" />
          </svg>
        </div>
        <h3 class="font-display text-lg font-bold text-coffee-light">1. 悶蒸階段 (Blooming)</h3>
        <p class="text-xs text-coffee-muted leading-relaxed">
          注入少量熱水 (約為粉量的 2 到 2.5 倍) 潤濕全粉，持續約 40 秒。此時熱水會逼出咖啡粉內殘留的二氧化碳，讓咖啡顆粒充分舒展，為接下來的完整萃取打下完美基底。
        </p>
      </div>

      <div class="glass-card-interactive rounded-2xl p-6 sm:p-8 flex flex-col gap-4">
        <div class="w-12 h-12 rounded-xl bg-coffee-accent/20 border border-coffee-sand/20 flex items-center justify-center text-coffee-gold">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
          </svg>
        </div>
        <h3 class="font-display text-lg font-bold text-coffee-light">2. 主要萃取 (Sweetness)</h3>
        <p class="text-xs text-coffee-muted leading-relaxed">
          首要萃取約佔總水量的 60%。這個階段主要帶出咖啡豆中的果酸與甘甜物質，高水溫與穩定的細水流繞圈，能將最優質的可溶性物質完整萃取，是影響整杯咖啡酸甜平衡的關鍵。
        </p>
      </div>

      <div class="glass-card-interactive rounded-2xl p-6 sm:p-8 flex flex-col gap-4">
        <div class="w-12 h-12 rounded-xl bg-coffee-accent/20 border border-coffee-sand/20 flex items-center justify-center text-coffee-gold">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <h3 class="font-display text-lg font-bold text-coffee-light">3. 後段控制 (Strength)</h3>
        <p class="text-xs text-coffee-muted leading-relaxed">
          第三階段注入最後 40% 的水量以達到預設濃度。此時因水溫略降且咖啡粉內的精華已被萃取大半，改以溫和的中心注水或直接以較弱水流沖煮，避免過度萃取導致後段的木質苦澀感。
        </p>
      </div>
    </div>
  </section>

  <!-- Explore Other Brewers (Internal Linking for SEO) -->
  <section class="mt-20 border-t border-coffee-sand/10 pt-16 mb-8">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <h2 class="font-display text-3xl font-bold tracking-wide text-coffee-light">探索專屬沖煮工具</h2>
      <p class="text-xs text-coffee-muted mt-2">尋找專為您手邊的咖啡器具量身打造的配方計算機與進階教學。</p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto mb-16">
      <a href={base + "tools/v60-pour-over"} class="glass-card-interactive rounded-xl p-6 text-center group flex flex-col items-center gap-3">
        <span class="text-3xl group-hover:scale-110 transition-transform duration-300">☕</span>
        <span class="font-display font-semibold text-coffee-light">V60 濾杯</span>
      </a>
      <a href={base + "tools/french-press"} class="glass-card-interactive rounded-xl p-6 text-center group flex flex-col items-center gap-3">
        <span class="text-3xl group-hover:scale-110 transition-transform duration-300">🫖</span>
        <span class="font-display font-semibold text-coffee-light">法式濾壓壺</span>
      </a>
      <a href={base + "tools/aeropress"} class="glass-card-interactive rounded-xl p-6 text-center group flex flex-col items-center gap-3">
        <span class="text-3xl group-hover:scale-110 transition-transform duration-300">🪄</span>
        <span class="font-display font-semibold text-coffee-light">愛樂壓</span>
      </a>
      <a href={base + "tools/cold-brew"} class="glass-card-interactive rounded-xl p-6 text-center group flex flex-col items-center gap-3">
        <span class="text-3xl group-hover:scale-110 transition-transform duration-300">🧊</span>
        <span class="font-display font-semibold text-coffee-light">冷萃咖啡</span>
      </a>
    </div>
  </section>
</Layout>
