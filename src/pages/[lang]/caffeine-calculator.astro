---
import { getCollection } from 'astro:content';
import { SITE_URL } from '../../config';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdSlot from '../../components/AdSlot.astro';
import CaffeineCalculator from '../../components/caffeine/CaffeineCalculator.astro';
import Disclaimer from '../../components/caffeine/Disclaimer.astro';
import { getLanguagePaths } from '../../i18n/routes';
import { getLangFromUrl } from '../../i18n/utils';
import { caffeineFaq, caffeineLang, useCaffeineT } from '../../i18n/caffeine';
import ExplainerEn, { getHeadings as getHeadingsEn } from '../../content/caffeine-tool/en.mdx';
import ExplainerZh, { getHeadings as getHeadingsZh } from '../../content/caffeine-tool/zh-TW.mdx';

export function getStaticPaths() {
  return getLanguagePaths();
}

const lang = getLangFromUrl(Astro.url);
const t = useCaffeineT(lang);
const faq = caffeineFaq[caffeineLang(lang)];
const Explainer = lang === 'zh-TW' ? ExplainerZh : ExplainerEn;
const pageUrl = `${SITE_URL}/${lang}/caffeine-calculator/`;

const guides = (await getCollection('guides', (entry) => entry.id.toLowerCase().startsWith(`${lang.toLowerCase()}/`) && entry.data.tool === 'caffeine'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({ slug: entry.id.split('/').slice(1).join('/'), title: entry.data.title, description: entry.data.description }));

const headings = (lang === 'zh-TW' ? getHeadingsZh() : getHeadingsEn()).filter((h) => h.depth === 2);
const toc: [string, string][] = [...headings.map((h): [string, string] => [h.slug, h.text]), ['faq', t('faq.heading')]];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': `${pageUrl}#app`,
      name: t('hero.title'),
      url: pageUrl,
      description: t('meta.desc'),
      inLanguage: lang,
      applicationCategory: 'HealthApplication',
      operatingSystem: 'All',
      browserRequirements: 'Requires JavaScript. Requires HTML5.',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      featureList: [
        t('dash.now.label'),
        t('dash.lastcall.label'),
        t('chart.heading'),
        t('whatif.heading'),
        t('share.heading')
      ],
      publisher: { '@type': 'Organization', name: 'Barista Flow', url: SITE_URL }
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      inLanguage: lang,
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a }
      }))
    }
  ]
};
---

<Layout title={t('meta.title')} description={t('meta.desc')} jsonld={jsonLd} ogImage="/images/og-caffeine.jpg" themeAware hideTopAd>
  <div class="mx-auto max-w-6xl">
    <div class="flex justify-center"><Breadcrumbs items={[{ label: t('breadcrumb') }]} /></div>

    <header class="mx-auto mb-8 max-w-3xl text-center sm:mb-10">
      <p class="inline-flex items-center gap-2 rounded-full border border-coffee-gold/25 bg-coffee-gold/10 px-4 py-1.5 text-xs font-bold uppercase tracking-[0.16em] text-coffee-gold">☕ {t('hero.eyebrow')}</p>
      <h1 class="mt-4 text-balance font-display text-4xl font-bold tracking-tight text-coffee-light sm:text-5xl">{t('hero.title')}</h1>
      <p class="mx-auto mt-4 max-w-2xl text-pretty text-base leading-7 text-coffee-sand sm:text-lg">{t('hero.subtitle')}</p>
      <a href="#how" class="mt-3 inline-flex min-h-[44px] items-center text-sm font-semibold text-coffee-gold underline underline-offset-4 hover:text-coffee-light">{t('hero.jump')} ↓</a>
    </header>

    <CaffeineCalculator lang={lang} />

    <Disclaimer lang={lang} class="mt-8" />

    <AdSlot type="results" id="caffeine-results-ad" class="mt-10" />

    <div class="mt-12 grid gap-10 lg:grid-cols-[minmax(0,1fr)_300px]">
      <article id="how" class="cc-prose scroll-mt-24" lang={lang}>
        <Explainer />
      </article>

      <aside class="hidden lg:block" aria-label={t('toc.heading')}>
        <div class="sticky top-28 space-y-6">
          <nav class="cc-toc" aria-label={t('toc.heading')}>
            <p class="cc-toc-title">{t('toc.heading')}</p>
            <ol>{toc.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}</ol>
          </nav>
          <AdSlot type="sidebar" id="caffeine-sidebar-ad" />
        </div>
      </aside>
    </div>

    <section id="faq" class="mt-14 scroll-mt-24" aria-labelledby="faq-title">
      <h2 id="faq-title" class="font-display text-3xl font-bold text-coffee-light">{t('faq.heading')}</h2>
      <div class="mt-6 grid gap-3">
        {faq.map((item) => (
          <details class="cc-faq">
            <summary><h3>{item.q}</h3></summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mt-14" aria-labelledby="guides-title">
      <h2 id="guides-title" class="font-display text-3xl font-bold text-coffee-light">{t('guides.heading')}</h2>
      <ul class="mt-6 grid gap-4 md:grid-cols-3">
        {guides.map((guide) => (
          <li>
            <a href={`/${lang}/guides/${guide.slug}/`} class="cc-guide-card">
              <strong>{guide.title}</strong>
              <span>{guide.description}</span>
              <span class="cc-guide-more">{lang === 'zh-TW' ? '閱讀指南 →' : 'Read the guide →'}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <Disclaimer lang={lang} class="mt-12" />
  </div>
</Layout>
