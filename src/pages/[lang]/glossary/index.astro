---
import { getCollection, render } from 'astro:content';
import { SITE_URL } from '../../../config';
import Layout from '../../../layouts/Layout.astro';
import SearchBar from '../../../components/SearchBar.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { getLanguagePaths } from '../../../i18n/routes';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allGlossary = await getCollection('blog', (entry) => entry.data.tags?.includes("Glossary") && entry.id.toLowerCase().startsWith(`${lang.toLowerCase()}/`)) || [];

// Sort by term (A-Z)
const sortedGlossary = [...allGlossary].sort((a, b) => {
  const termA = (a.data as any).term || a.data.title;
  const termB = (b.data as any).term || b.data.title;
  return termA.localeCompare(termB);
});



const isZh = lang === 'zh-TW';
const entries = await Promise.all(sortedGlossary.map(async (entry) => ({
  entry,
  slug: entry.id.split('/').pop()?.replace(/\.mdx?$/, '') || '',
  term: (entry.data as any).term || entry.data.title,
  Content: (await render(entry)).Content
})));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  "name": isZh ? "Barista Flow 咖啡沖煮詞彙表" : "Barista Flow coffee brewing glossary",
  "description": t('glossary.meta.desc'),
  "inLanguage": lang,
  "hasDefinedTerm": entries.map(({ entry, slug, term }) => ({
    "@type": "DefinedTerm",
    "name": entry.data.title,
    "alternateName": term,
    "description": entry.data.description,
    "url": `${SITE_URL}/${lang}/glossary/#${slug}`
  }))
};

export function getStaticPaths() {
  return getLanguagePaths();
}
---

<Layout
  title={t('glossary.meta.title')}
  description={t('glossary.meta.desc')}
  jsonld={jsonLd}
>
  <div class="max-w-4xl mx-auto mb-16 text-center">
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-coffee-gold/10 border border-coffee-gold/20 text-coffee-gold text-xs font-semibold uppercase tracking-widest mb-4">
      {t('glossary.tag')}
    </div>
    <h1 class="font-display text-4xl sm:text-6xl font-bold tracking-tight text-coffee-light">
      {t('glossary.title')}
    </h1>
    <p class="text-coffee-muted mt-6 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
      {t('glossary.subtitle')}
    </p>
  </div>

  <SearchBar />

  <div class="max-w-4xl mx-auto">
    <nav class="mb-12 flex flex-wrap justify-center gap-2 rounded-2xl p-5 glass-card" aria-label={isZh ? '詞彙索引' : 'Term index'}>
      {entries.map(({ slug, term }) => (
        <a href={`#${slug}`} class="rounded-full border border-coffee-sand/20 bg-coffee-darker px-3 py-1.5 text-sm font-semibold text-coffee-gold transition-colors hover:bg-coffee-gold hover:text-coffee-dark">{term}</a>
      ))}
    </nav>

    <div class="space-y-8">
      {entries.map(({ entry, slug, term, Content }) => (
        <article id={slug} class="glossary-entry scroll-mt-28 rounded-2xl border border-coffee-sand/10 bg-coffee-darker/60 p-6 sm:p-8">
          <p class="text-xs font-bold uppercase tracking-wider text-coffee-gold">{term}</p>
          <h2 class="mt-1 font-display text-2xl font-bold text-coffee-light sm:text-3xl">{entry.data.title}</h2>
          <p class="mt-3 border-s-2 border-coffee-gold/60 ps-4 text-base leading-7 text-coffee-sand">{entry.data.description}</p>
          <div class="glossary-body mt-4"><Content /></div>
          <a href={`#${slug}`} class="mt-4 inline-block text-xs text-coffee-muted hover:text-coffee-gold">{isZh ? '連結到此詞彙' : 'Link to this term'} #</a>
        </article>
      ))}
    </div>

    <div class="mt-16 pt-8 border-t border-coffee-sand/10 max-w-3xl mx-auto">
      <AdSlot type="top-leaderboard" id="glossary-index-ad" />
    </div>
  </div>
</Layout>

<style>
  html { scroll-behavior: smooth; }
  .glossary-body :global(h2) { margin-top: 1.5rem; color: var(--color-coffee-gold); font-family: var(--font-display); font-size: 1.15rem; font-weight: 700; }
  .glossary-body :global(h3) { margin-top: 1.25rem; color: var(--color-coffee-sand); font-size: 1rem; font-weight: 650; }
  .glossary-body :global(p), .glossary-body :global(li) { margin-top: .6rem; color: rgb(245 242 235 / .82); font-size: .925rem; line-height: 1.8; }
  .glossary-body :global(ul) { padding-left: 1.25rem; list-style: disc; }
  .glossary-body :global(ol) { padding-left: 1.25rem; list-style: decimal; }
  .glossary-body :global(strong) { color: var(--color-coffee-light); }
  .glossary-body :global(a) { color: var(--color-coffee-gold); text-decoration: underline; }
</style>
