---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import SearchBar from '../../../components/SearchBar.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { getLanguagePaths } from '../../../i18n/routes';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allGlossary = await getCollection('blog', (entry) => entry.data.tags?.includes('Glossary')) || [];

// Sort by term (A-Z)
const sortedGlossary = [...allGlossary].sort((a, b) => {
  const termA = (a.data as any).term || a.data.title;
  const termB = (b.data as any).term || b.data.title;
  return termA.localeCompare(termB);
});

// Group by first letter
const groupedGlossary = sortedGlossary.reduce((acc, entry) => {
  const term = (entry.data as any).term || entry.data.title;
  const firstLetter = term.charAt(0).toUpperCase();
  if (!acc[firstLetter]) {
    acc[firstLetter] = [];
  }
  acc[firstLetter].push(entry);
  return acc;
}, {} as Record<string, typeof allGlossary>);

const letters = Object.keys(groupedGlossary).sort();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  "name": "Barista Flow Coffee Glossary",
  "description": "Comprehensive encyclopedia of specialty coffee terms, techniques, and chemistry.",
};

export function getStaticPaths() {
  return getLanguagePaths();
}
---

<Layout
  title={t('glossary.meta.title')}
  description={t('glossary.meta.desc')}
  jsonld={jsonLd}
>
  <div class="max-w-4xl mx-auto mb-16 text-center">
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-coffee-gold/10 border border-coffee-gold/20 text-coffee-gold text-xs font-semibold uppercase tracking-widest mb-4">
      {t('glossary.tag')}
    </div>
    <h1 class="font-display text-4xl sm:text-6xl font-bold tracking-tight text-coffee-light">
      {t('glossary.title')}
    </h1>
    <p class="text-coffee-muted mt-6 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
      {t('glossary.subtitle')}
    </p>
  </div>

  <SearchBar />

  <div class="max-w-4xl mx-auto">
    <!-- A-Z Index Navigation -->
    <div class="flex flex-wrap justify-center gap-2 mb-16 p-6 glass-card rounded-2xl">
      {letters.map((letter) => (
        <a href={`#letter-${letter}`} class="w-10 h-10 flex items-center justify-center rounded-lg bg-coffee-darker border border-coffee-sand/20 text-coffee-gold font-display font-bold hover:bg-coffee-gold hover:text-coffee-dark transition-all duration-300">
          {letter}
        </a>
      ))}
    </div>

    <!-- Glossary List -->
    <div class="space-y-16">
      {letters.map((letter) => (
        <section id={`letter-${letter}`} class="scroll-mt-32 relative">
          <div class="absolute -start-4 sm:-start-12 top-0 text-5xl sm:text-7xl font-display font-black text-coffee-sand/10 select-none -z-10">
            {letter}
          </div>
          <h2 class="text-3xl font-display font-bold text-coffee-gold border-b border-coffee-sand/10 pb-4 mb-8">
            {letter}
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {groupedGlossary[letter].map((entry) => (
              <a href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/${lang}/glossary/${entry.id}`} class="glass-card-interactive p-6 rounded-xl group flex flex-col justify-between h-full">
                <div>
                  <h3 class="text-xl font-bold text-coffee-light mb-1 group-hover:text-coffee-gold transition-colors">
                    {(entry.data as any).term || entry.data.title}
                  </h3>
                  <p class="text-xs text-coffee-muted uppercase tracking-wider mb-3">{entry.data.title}</p>
                  <p class="text-sm text-coffee-sand/80 leading-relaxed line-clamp-3">
                    {entry.data.description}
                  </p>
                </div>
                <div class="mt-4 flex items-center text-xs text-coffee-gold font-medium opacity-0 group-hover:opacity-100 transition-opacity">
                  {t('glossary.readMore')} <span class="ms-1">→</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
    
    <div class="mt-16 pt-8 border-t border-coffee-sand/10 max-w-3xl mx-auto">
      <AdSlot type="top-leaderboard" id="glossary-index-ad" />
    </div>
  </div>
</Layout>

<style>
  html {
    scroll-behavior: smooth;
  }
</style>
