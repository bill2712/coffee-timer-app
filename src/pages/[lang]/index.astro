---
import { SITE_URL } from '../../config';
import Layout from '../../layouts/Layout.astro';
import ParameterForm from '../../components/ParameterForm.astro';
import Timer from '../../components/Timer.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { getLanguagePaths } from '../../i18n/routes';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isZh = lang === 'zh-TW';
const basePath = `${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/${lang}`;

const c = isZh ? {
  eyebrow: '第一次沖也不怕', title: '30 秒設定，跟住提示沖第一杯', intro: '選器材、輸入咖啡粉重量，其餘先交給推薦設定。完成後再按味道逐杯微調。', start: '開始設定第一杯', guide: '開始「首五杯」新手訓練',
  step1: '選器材', step1Body: '先選你手上的沖煮工具。', step2: '輸入粉量', step2Body: '我們會自動計算水量、比例與溫度起點。', step3: '跟提示沖', step3Body: '畫面只突出現在要做的事。',
  welcomeBack: '歡迎回來', returnTitle: '繼續改善上一杯', returnBody: '可直接載入上次參數，或查看已累積的味道紀錄。', repeat: '再次使用上次配方', records: '查看沖煮紀錄', compare: '比較最近兩杯',
  brewerEyebrow: '步驟 1', brewerTitle: '你今日用甚麼器材？', brewerBody: '不知道選甚麼？V60 是清晰易學的起點；其他器材會帶你到專用流程。', recommended: '新手推薦',
  v60: 'V60 手沖', v60Body: '清楚的三階段視覺提示', aero: 'AeroPress', aeroBody: '快速、容易清理', french: '法式濾壓壺', frenchBody: '浸泡式、操作直接', cold: '冷萃', coldBody: '低溫長時間浸泡',
  setupEyebrow: '步驟 2–3', setupTitle: '輸入粉量，然後跟著計時器', setupBody: '新手只需處理必要選項；豆名、研磨刻度、水溫及比例收在「進階設定」內。',
  helpEyebrow: '遇到問題時才看', helpTitle: '按杯中問題找答案', helpBody: '不用先讀完整個知識庫。沖完後選擇最接近的問題，再深入了解。',
  first: '第一次手沖，由哪裡開始？', sour: '咖啡太酸／尖銳', bitter: '咖啡太苦／乾口', grind: '不知道研磨度怎樣選', flow: '注水太快或太慢', ratio: '不知道要用多少粉和水',
  moreTitle: '進階工具與完整內容', moreBody: '標準配方、磨豆機校準、轉換器及完整文章都保留在這裡。', recipes: '有來源配方庫', tools: '個人磨豆機校準', knowledge: '完整知識庫', backup: '資料備份／搬機', latestFallback: '上一杯已儲存', trainingActive: '正在進行首五杯訓練', trainingContinue: '返回本杯設定', trainingView: '查看五杯進度'
} : {
  eyebrow: 'Your first brew, made simple', title: 'Set up in 30 seconds, then follow the prompts', intro: 'Choose your brewer and coffee dose. We will supply a sensible starting point, then help you adjust from what you taste.', start: 'Set up my first brew', guide: 'Start the First Five Brews course',
  step1: 'Choose a brewer', step1Body: 'Start with the equipment in front of you.', step2: 'Enter your dose', step2Body: 'Water, ratio, and temperature get a recommended starting point.', step3: 'Follow the prompts', step3Body: 'The timer highlights only what matters now.',
  welcomeBack: 'Welcome back', returnTitle: 'Improve your last brew', returnBody: 'Load the previous settings or review the taste records you have built up.', repeat: 'Brew the last recipe again', records: 'View brew records', compare: 'Compare the latest two',
  brewerEyebrow: 'Step 1', brewerTitle: 'What are you brewing with today?', brewerBody: 'Not sure? V60 is a clear starting point. Other choices open their dedicated workflow.', recommended: 'Beginner pick',
  v60: 'V60 pour-over', v60Body: 'Clear three-stage visual prompts', aero: 'AeroPress', aeroBody: 'Fast and easy to clean', french: 'French press', frenchBody: 'Direct immersion brewing', cold: 'Cold brew', coldBody: 'Long, low-temperature steep',
  setupEyebrow: 'Steps 2–3', setupTitle: 'Enter the dose, then follow the timer', setupBody: 'Beginners see only essential choices. Bean name, grinder setting, temperature, and ratio stay under Advanced settings.',
  helpEyebrow: 'Open only when needed', helpTitle: 'Find help by the problem in your cup', helpBody: 'You do not need to read the whole library first. Finish a brew, choose the closest problem, then learn more.',
  first: 'My first pour-over: where do I start?', sour: 'Coffee tastes sharp or too sour', bitter: 'Coffee tastes bitter or drying', grind: 'I do not know which grind to use', flow: 'The drawdown is too fast or slow', ratio: 'How much coffee and water?',
  moreTitle: 'Advanced tools and full library', moreBody: 'Source-backed recipes, grinder calibration, converters, and every article remain available here.', recipes: 'Source-backed recipes', tools: 'Personal grinder calibration', knowledge: 'Full knowledge library', backup: 'Backup / device transfer', latestFallback: 'Your last brew is saved', trainingActive: 'First Five Brews in progress', trainingContinue: 'Return to this brew', trainingView: 'View five-brew progress'
};

const starterRecipe = { beanName: isZh ? '我的咖啡豆' : 'My coffee beans', roastLevel: 'medium', grindSize: isZh ? '中細研磨（像砂糖）' : 'Medium-fine (like table salt)', waterTemp: 92, coffeeWeight: 15, waterRatio: 15 };
const webAppJsonLd = {
  '@context': 'https://schema.org', '@type': 'WebApplication', name: t('seo.title'), description: t('seo.description'), keywords: t('seo.keywords'), operatingSystem: 'All', applicationCategory: 'UtilityApplication', browserRequirements: 'Requires JavaScript. Requires HTML5.', url: `${SITE_URL}/${lang}/`,
  featureList: [t('schema.app.feature1'), t('schema.app.feature2'), t('schema.app.feature3'), t('schema.app.feature4'), t('schema.app.feature5')], offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }
};

export function getStaticPaths() { return getLanguagePaths(); }
---

<Layout jsonld={webAppJsonLd} hideTopAd>
  <section id="returning-brewer" class="mb-8 hidden rounded-2xl border border-green-400/20 bg-green-400/5 p-5 sm:p-6" aria-live="polite">
    <div class="flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
      <div><p class="text-xs font-bold uppercase tracking-[0.18em] text-green-300">{c.welcomeBack}</p><h2 class="mt-1 font-display text-2xl font-bold text-coffee-light">{c.returnTitle}</h2><p id="returning-summary" class="mt-2 text-sm leading-6 text-coffee-sand/75">{c.returnBody}</p></div>
      <div class="flex flex-col gap-2 sm:flex-row">
        <button id="btn-repeat-last" type="button" class="min-h-[48px] rounded-xl bg-green-300 px-5 text-sm font-bold text-coffee-dark hover:bg-green-200">{c.repeat}</button>
        <a href={`${basePath}/history`} class="inline-flex min-h-[48px] items-center justify-center rounded-xl border border-coffee-sand/20 px-5 text-sm font-semibold text-coffee-sand hover:text-coffee-light">{c.records}</a>
        <a id="compare-latest-link" href={`${basePath}/history`} class="hidden min-h-[48px] items-center justify-center rounded-xl border border-coffee-gold/30 px-5 text-sm font-semibold text-coffee-gold hover:bg-coffee-gold/10">{c.compare}</a>
      </div>
    </div>
  </section>

  <header class="mx-auto max-w-4xl pb-10 pt-3 text-center sm:pb-14 sm:pt-6">
    <p class="inline-flex items-center gap-2 rounded-full border border-coffee-gold/25 bg-coffee-gold/10 px-4 py-2 text-xs font-bold uppercase tracking-[0.18em] text-coffee-gold"><span class="h-2 w-2 rounded-full bg-green-400" aria-hidden="true"></span>{c.eyebrow}</p>
    <h1 class="mx-auto mt-5 max-w-3xl text-balance font-display text-4xl font-bold leading-[1.12] tracking-tight text-coffee-light sm:text-5xl lg:text-6xl">{c.title}</h1>
    <p class="mx-auto mt-5 max-w-2xl text-pretty text-base leading-7 text-coffee-sand/80 sm:text-lg">{c.intro}</p>
    <div class="mt-7 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center">
      <a href="#brewer-picker" class="inline-flex min-h-[54px] items-center justify-center rounded-xl bg-coffee-gold px-7 text-base font-bold text-coffee-dark shadow-lg shadow-coffee-gold/15 transition hover:bg-coffee-gold-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-coffee-gold focus-visible:ring-offset-2 focus-visible:ring-offset-coffee-dark">{c.start}</a>
      <a href={`${basePath}/training`} class="inline-flex min-h-[54px] items-center justify-center rounded-xl border border-coffee-sand/20 px-7 text-sm font-semibold text-coffee-sand transition hover:border-coffee-gold/50 hover:text-coffee-light focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-coffee-gold">{c.guide}</a>
    </div>
    <ol class="mx-auto mt-8 grid max-w-3xl gap-3 text-start sm:grid-cols-3" aria-label={isZh ? '開始沖煮三步' : 'Three steps to start brewing'}>
      {[[c.step1, c.step1Body], [c.step2, c.step2Body], [c.step3, c.step3Body]].map(([title, body], index) => (
        <li class="flex gap-3 rounded-xl border border-coffee-sand/10 bg-coffee-darker/55 p-4"><span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-coffee-gold text-xs font-bold text-coffee-dark">{index + 1}</span><span><strong class="block text-sm text-coffee-light">{title}</strong><span class="mt-1 block text-xs leading-5 text-coffee-muted">{body}</span></span></li>
      ))}
    </ol>
  </header>

  <section id="active-training" class="mb-8 hidden rounded-2xl border border-blue-400/20 bg-blue-400/5 p-5" aria-live="polite">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"><div><p class="text-[10px] font-bold uppercase tracking-wider text-blue-300">{c.trainingActive}</p><p id="active-training-copy" class="mt-1 font-display text-xl font-bold text-coffee-light"></p></div><div class="flex flex-col gap-2 sm:flex-row"><a href="#brew-start" class="inline-flex min-h-[46px] items-center justify-center rounded-xl bg-blue-300 px-4 text-sm font-bold text-coffee-dark">{c.trainingContinue}</a><a href={`${basePath}/training`} class="inline-flex min-h-[46px] items-center justify-center rounded-xl border border-blue-300/30 px-4 text-sm font-semibold text-blue-200">{c.trainingView}</a></div></div>
  </section>

  <section id="brewer-picker" class="scroll-mt-24 rounded-2xl border border-coffee-sand/10 bg-coffee-darker/55 p-5 sm:p-7" aria-labelledby="brewer-title">
    <p class="text-xs font-bold uppercase tracking-[0.18em] text-coffee-gold">{c.brewerEyebrow}</p><h2 id="brewer-title" class="mt-1 font-display text-3xl font-bold text-coffee-light">{c.brewerTitle}</h2><p class="mt-2 max-w-2xl text-sm leading-6 text-coffee-muted">{c.brewerBody}</p>
    <div class="mt-6 grid grid-cols-2 gap-3 lg:grid-cols-4">
      <a href="#brew-start" class="relative flex min-h-[124px] flex-col justify-between rounded-xl border-2 border-coffee-gold bg-coffee-gold/10 p-4 text-start transition hover:bg-coffee-gold/15 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-coffee-gold"><span class="absolute end-3 top-3 rounded-full bg-coffee-gold px-2 py-1 text-[9px] font-bold uppercase tracking-wider text-coffee-dark">{c.recommended}</span><span class="text-2xl" aria-hidden="true">☕</span><span><strong class="block text-base text-coffee-light">{c.v60}</strong><span class="mt-1 block text-xs leading-5 text-coffee-muted">{c.v60Body}</span></span></a>
      <a href={`${basePath}/tools/aeropress`} class="brewer-choice"><span class="text-2xl" aria-hidden="true">🪄</span><span><strong>{c.aero}</strong><small>{c.aeroBody}</small></span></a>
      <a href={`${basePath}/tools/french-press`} class="brewer-choice"><span class="text-2xl" aria-hidden="true">🫖</span><span><strong>{c.french}</strong><small>{c.frenchBody}</small></span></a>
      <a href={`${basePath}/tools/cold-brew`} class="brewer-choice"><span class="text-2xl" aria-hidden="true">🧊</span><span><strong>{c.cold}</strong><small>{c.coldBody}</small></span></a>
    </div>
  </section>

  <section id="brew-start" class="scroll-mt-24 pt-12 sm:pt-16" aria-labelledby="setup-title">
    <div class="mb-6"><p class="text-xs font-bold uppercase tracking-[0.18em] text-coffee-gold">{c.setupEyebrow}</p><h2 id="setup-title" class="mt-1 font-display text-3xl font-bold text-coffee-light sm:text-4xl">{c.setupTitle}</h2><p class="mt-2 max-w-3xl text-sm leading-6 text-coffee-muted">{c.setupBody}</p></div>
    <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-12">
      <div id="parameter-form" class="scroll-mt-24 lg:col-span-5"><ParameterForm defaultRecipe={starterRecipe} /></div>
      <div id="timer-interface" class="scroll-mt-24 lg:sticky lg:top-24 lg:col-span-7"><Timer /></div>
    </div>
  </section>

  <section class="mt-14 border-t border-coffee-sand/10 pt-12 sm:mt-20 sm:pt-16" aria-labelledby="help-title">
    <p class="text-xs font-bold uppercase tracking-[0.18em] text-coffee-gold">{c.helpEyebrow}</p><h2 id="help-title" class="mt-1 font-display text-3xl font-bold text-coffee-light">{c.helpTitle}</h2><p class="mt-2 max-w-2xl text-sm leading-6 text-coffee-muted">{c.helpBody}</p>
    <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      <a href={`${basePath}/guide`} class="problem-link">👋 <span>{c.first}</span></a><a href={`${basePath}/blog/dial-in-one-variable-at-a-time`} class="problem-link">🍋 <span>{c.sour}</span></a><a href={`${basePath}/blog/brew-temperature-and-extraction`} class="problem-link">🌰 <span>{c.bitter}</span></a><a href={`${basePath}/blog/grind-distribution-analysis`} class="problem-link">⚙️ <span>{c.grind}</span></a><a href={`${basePath}/glossary/channeling`} class="problem-link">💧 <span>{c.flow}</span></a><a href={`${basePath}/tools/v60-pour-over`} class="problem-link">⚖️ <span>{c.ratio}</span></a>
    </div>
  </section>

  <details class="group mt-10 rounded-2xl border border-coffee-sand/10 bg-coffee-dark/35">
    <summary class="flex min-h-[64px] cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-coffee-gold sm:px-6"><span><strong class="block font-display text-lg text-coffee-light">{c.moreTitle}</strong><span class="mt-1 block text-xs leading-5 text-coffee-muted">{c.moreBody}</span></span><span class="text-xl text-coffee-gold transition-transform group-open:rotate-45" aria-hidden="true">＋</span></summary>
    <div class="grid gap-3 border-t border-coffee-sand/10 p-5 sm:grid-cols-2 sm:p-6 lg:grid-cols-4"><a href={`${basePath}/recipes`} class="secondary-resource">{c.recipes}</a><a href={`${basePath}/tools/grinder-calibration`} class="secondary-resource">{c.tools}</a><a href={`${basePath}/blog`} class="secondary-resource">{c.knowledge}</a><a href={`${basePath}/data`} class="secondary-resource">{c.backup}</a></div>
  </details>

  <AdSlot type="bottom-utility" class="my-12" />
</Layout>

<style>
  .brewer-choice { display: flex; min-height: 124px; flex-direction: column; justify-content: space-between; border: 1px solid rgb(197 168 128 / .15); border-radius: .75rem; background: rgb(28 24 21 / .5); padding: 1rem; text-align: start; transition: border-color 160ms ease, background-color 160ms ease; }
  .brewer-choice:hover { border-color: rgb(197 168 128 / .5); background: rgb(197 168 128 / .05); }
  .brewer-choice strong { display: block; color: #f5f2eb; font-size: 1rem; }
  .brewer-choice small { display: block; margin-top: .25rem; color: rgb(197 168 128 / .58); font-size: .75rem; line-height: 1.25rem; }
  .problem-link { display: flex; min-height: 58px; align-items: center; gap: .75rem; border: 1px solid rgb(197 168 128 / .14); border-radius: .75rem; background: rgb(28 24 21 / .55); padding: .875rem 1rem; color: rgb(245 242 235 / .88); font-size: .875rem; font-weight: 600; transition: border-color 160ms ease, background-color 160ms ease, color 160ms ease; }
  .problem-link:hover { border-color: rgb(197 168 128 / .5); background: rgb(197 168 128 / .07); color: #fff; }
  .secondary-resource { display: flex; min-height: 48px; align-items: center; justify-content: center; border: 1px solid rgb(197 168 128 / .16); border-radius: .75rem; padding: .75rem; color: #c5a880; font-size: .875rem; font-weight: 700; text-align: center; }
  .secondary-resource:hover { background: rgb(197 168 128 / .08); }
  :is(.brewer-choice, .problem-link, .secondary-resource):focus-visible { outline: 2px solid #c5a880; outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { .brewer-choice, .problem-link, .secondary-resource, details summary span { transition: none; } }
</style>

<script is:inline define:vars={{ returnBody: c.returnBody, latestFallback: c.latestFallback }}>
  document.addEventListener('DOMContentLoaded', () => {
    let logs = [];
    try { const parsed = JSON.parse(localStorage.getItem('barista_flow_logs') || '[]'); logs = Array.isArray(parsed) ? parsed : []; } catch (error) {}
    const returnPanel = document.getElementById('returning-brewer');
    const returnSummary = document.getElementById('returning-summary');
    const compareLink = document.getElementById('compare-latest-link');
    const repeatButton = document.getElementById('btn-repeat-last');
    const latest = logs[0];
    try {
      const activeLesson = JSON.parse(localStorage.getItem('barista_flow_active_lesson_v1') || 'null');
      const lessonNumber = Number(activeLesson?.lesson);
      if (lessonNumber >= 1 && lessonNumber <= 5) {
        const panel = document.getElementById('active-training');
        const copy = document.getElementById('active-training-copy');
        panel?.classList.remove('hidden');
        if (copy) copy.textContent = document.documentElement.lang === 'zh-TW' ? `第 ${lessonNumber} 杯：完成沖煮並儲存味道記錄` : `Brew ${lessonNumber}: finish the brew and save the taste result`;
      }
    } catch (error) {}
    if (returnPanel && latest?.recipe) {
      returnPanel.classList.remove('hidden');
      const bean = String(latest.recipe.beanName || latestFallback);
      const recommendation = String(latest.recommendation?.title || '');
      if (returnSummary) returnSummary.textContent = recommendation ? `${bean} · ${recommendation}` : `${bean} · ${returnBody}`;
      if (logs.length >= 2) { compareLink?.classList.remove('hidden'); compareLink?.classList.add('inline-flex'); }
      repeatButton?.addEventListener('click', () => {
        try { localStorage.setItem('barista_flow_recipe', JSON.stringify(latest.recipe)); } catch (error) {}
        window.dispatchEvent(new CustomEvent('coffee-recipe-changed', { detail: latest.recipe }));
        document.getElementById('brew-start')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    }
    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener('click', (event) => {
        const selector = anchor.getAttribute('href');
        const target = selector ? document.querySelector(selector) : null;
        if (!target) return;
        event.preventDefault(); target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
  });
</script>
