---
import { SITE_URL } from '../../config';
import Layout from '../../layouts/Layout.astro';
import ParameterForm from '../../components/ParameterForm.astro';
import Timer from '../../components/Timer.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { getLanguagePaths } from '../../i18n/routes';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);



const webAppJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": t('seo.title'),
  "description": t('seo.description'),
  "keywords": t('seo.keywords'),
  "operatingSystem": "All",
  "applicationCategory": "UtilityApplication",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "url": `${SITE_URL}/${lang}/`,
  "featureList": [
    t('schema.app.feature1'),
    t('schema.app.feature2'),
    t('schema.app.feature3'),
    t('schema.app.feature4'),
    t('schema.app.feature5')
  ],
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};

export function getStaticPaths() {
  return getLanguagePaths();
}
---

<Layout jsonld={webAppJsonLd}>
  <section class="text-center max-w-4xl mx-auto mb-10 sm:mb-14 animate-float px-4">
    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-coffee-gold/10 border border-coffee-gold/20 text-coffee-gold text-xs font-semibold uppercase tracking-widest mb-6">
      <span class="w-2 h-2 rounded-full bg-coffee-gold animate-pulse"></span>
      {t('index.hero.tagline')}
    </div>
    
    <h1 class="font-display break-keep text-4xl md:text-5xl lg:text-7xl font-extrabold tracking-tight text-coffee-light leading-tight">
      {t('index.hero.title1')}<br class="sm:hidden" />
      <span class="bg-gradient-to-r from-coffee-gold via-coffee-sand to-coffee-gold bg-clip-text text-transparent">
        {t('index.hero.title2')}
      </span>
    </h1>
    
    <div class="mt-8 relative h-20 sm:h-14 min-h-[5rem] sm:min-h-[3.5rem] overflow-hidden flex justify-center items-center" style="contain: layout paint; contain-intrinsic-size: 80px;">
      <div id="motivation-banner" aria-live="polite" class="absolute w-full text-lg md:text-xl font-medium italic text-coffee-gold/90 drop-shadow-md transition-opacity duration-1000 opacity-0 px-2 leading-relaxed"></div>
    </div>

    <!-- Massive Guide CTA Button -->
    <div class="mt-8 md:mt-12 flex justify-center animate-pulse-slow">
      <a href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/${lang}/guide`} class="relative inline-flex items-center justify-center px-8 py-5 md:px-12 md:py-6 text-xl md:text-2xl font-display font-bold text-coffee-darker bg-gradient-to-r from-coffee-gold via-[#F2C94C] to-coffee-gold bg-[length:200%_auto] rounded-full hover:bg-right transition-all duration-500 shadow-[0_0_40px_rgba(217,160,91,0.4)] hover:shadow-[0_0_60px_rgba(217,160,91,0.6)] hover:scale-[1.02] ring-4 ring-coffee-gold/20 overflow-hidden group">
        <span class="absolute inset-0 w-full h-full bg-white/20 -skew-x-12 -translate-x-full group-hover:animate-shine"></span>
        <span class="relative z-10 flex items-center gap-3">
          {t('index.guide.cta')}
        </span>
      </a>
    </div>
  </section>

  <!-- Quick-Start User Guide (Beginner Crash Course) -->
  <section class="mb-20 relative">
    <!-- Premium background tint -->
    <div class="absolute inset-0 bg-amber-500/5 blur-3xl rounded-[100px] pointer-events-none -z-10"></div>
    
    <div class="text-center max-w-3xl mx-auto mb-10 px-4">
      <h2 class="font-display text-3xl md:text-4xl font-bold tracking-wide text-coffee-light mb-4">
        {t('beginner_guide.headline.title')}
      </h2>
      <p class="text-sm md:text-base text-coffee-muted leading-relaxed">
        {t('beginner_guide.headline.subtitle')}
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <a href="#tool-selector" class="backdrop-blur-xl bg-coffee-dark/60 border border-coffee-sand/10 shadow-xl shadow-coffee-darker/30 rounded-3xl p-8 flex flex-col gap-4 group hover:-translate-y-2 hover:border-[#D9A05B]/40 transition-all duration-500 cursor-pointer">
        <div class="w-14 h-14 rounded-2xl bg-[#D9A05B]/10 border border-[#D9A05B]/20 flex items-center justify-center text-[#D9A05B] group-hover:scale-110 group-hover:bg-[#D9A05B]/20 transition-all duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v1a2 2 0 01-2 2H5a2 2 0 01-2-2v-1a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
        </div>
        <h3 class="font-display text-xl font-bold text-coffee-light">{t('beginner_guide.step1.title')}</h3>
        <p class="text-sm text-coffee-muted leading-relaxed">{t('beginner_guide.step1.desc')}</p>
      </a>

      <a href="#parameter-form" class="backdrop-blur-xl bg-coffee-dark/60 border border-coffee-sand/10 shadow-xl shadow-coffee-darker/30 rounded-3xl p-8 flex flex-col gap-4 group hover:-translate-y-2 hover:border-[#D9A05B]/40 transition-all duration-500 cursor-pointer">
        <div class="w-14 h-14 rounded-2xl bg-[#D9A05B]/10 border border-[#D9A05B]/20 flex items-center justify-center text-[#D9A05B] group-hover:scale-110 group-hover:bg-[#D9A05B]/20 transition-all duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
        </div>
        <h3 class="font-display text-xl font-bold text-coffee-light">{t('beginner_guide.step2.title')}</h3>
        <p class="text-sm text-coffee-muted leading-relaxed">{t('beginner_guide.step2.desc')}</p>
      </a>

      <a href="#timer-interface" class="backdrop-blur-xl bg-coffee-dark/60 border border-coffee-sand/10 shadow-xl shadow-coffee-darker/30 rounded-3xl p-8 flex flex-col gap-4 group hover:-translate-y-2 hover:border-[#D9A05B]/40 transition-all duration-500 cursor-pointer">
        <div class="w-14 h-14 rounded-2xl bg-[#D9A05B]/10 border border-[#D9A05B]/20 flex items-center justify-center text-[#D9A05B] group-hover:scale-110 group-hover:bg-[#D9A05B]/20 transition-all duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        </div>
        <h3 class="font-display text-xl font-bold text-coffee-light">{t('beginner_guide.step3.title')}</h3>
        <p class="text-sm text-coffee-muted leading-relaxed">{t('beginner_guide.step3.desc')}</p>
      </a>
    </div>
  </section>

  <!-- Interactive Grid Area -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start scroll-mt-24">
    <!-- Parameters Input Panel -->
    <div id="parameter-form" class="lg:col-span-5 order-2 lg:order-1 scroll-mt-24">
      <ParameterForm />
      <div class="mt-8">
        <AdSlot type="bottom-utility" class="my-8" />
      </div>
    </div>

    <!-- Live Timer Panel -->
    <div id="timer-interface" class="lg:col-span-7 order-1 lg:order-2 lg:sticky lg:top-24 scroll-mt-24">
      <Timer />
    </div>
  </div>

  <!-- Educational Info Cards -->
  <section class="mt-20 border-t border-coffee-sand/10 pt-16">
    <div class="text-center max-w-2xl mx-auto mb-12 px-4">
      <h2 class="font-display text-3xl font-bold tracking-wide text-coffee-light">{t('index.edu.title')}</h2>
      <p class="text-xs sm:text-sm text-coffee-muted mt-2">{t('index.edu.subtitle')}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
      <div class="backdrop-blur-xl bg-coffee-dark/50 border border-coffee-sand/10 shadow-xl shadow-coffee-darker/50 shadow-sm hover:shadow-xl hover:-translate-y-2 transition-all duration-500 rounded-3xl p-6 sm:p-8 flex flex-col gap-4 group">
        <div class="w-14 h-14 rounded-2xl bg-[#D9A05B]/10 border border-[#D9A05B]/20 flex items-center justify-center text-[#D9A05B] group-hover:scale-110 group-hover:bg-[#D9A05B]/20 transition-all duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m0-11.314l.707.707m11.314 11.314l.707-.707M4 12a8 8 0 1116 0 8 8 0 01-16 0z" />
          </svg>
        </div>
        <h3 class="font-display text-xl font-bold text-coffee-light">{t('index.edu.step1.title')}</h3>
        <p class="text-sm text-coffee-muted leading-relaxed">
          {t('index.edu.step1.desc')}
        </p>
      </div>

      <div class="backdrop-blur-xl bg-coffee-dark/50 border border-coffee-sand/10 shadow-xl shadow-coffee-darker/50 shadow-sm hover:shadow-xl hover:-translate-y-2 transition-all duration-500 rounded-3xl p-6 sm:p-8 flex flex-col gap-4 group">
        <div class="w-14 h-14 rounded-2xl bg-[#D9A05B]/10 border border-[#D9A05B]/20 flex items-center justify-center text-[#D9A05B] group-hover:scale-110 group-hover:bg-[#D9A05B]/20 transition-all duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
          </svg>
        </div>
        <h3 class="font-display text-xl font-bold text-coffee-light">{t('index.edu.step2.title')}</h3>
        <p class="text-sm text-coffee-muted leading-relaxed">
          {t('index.edu.step2.desc')}
        </p>
      </div>

      <div class="backdrop-blur-xl bg-coffee-dark/50 border border-coffee-sand/10 shadow-xl shadow-coffee-darker/50 shadow-sm hover:shadow-xl hover:-translate-y-2 transition-all duration-500 rounded-3xl p-6 sm:p-8 flex flex-col gap-4 group">
        <div class="w-14 h-14 rounded-2xl bg-[#D9A05B]/10 border border-[#D9A05B]/20 flex items-center justify-center text-[#D9A05B] group-hover:scale-110 group-hover:bg-[#D9A05B]/20 transition-all duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <h3 class="font-display text-xl font-bold text-coffee-light">{t('index.edu.step3.title')}</h3>
        <p class="text-sm text-coffee-muted leading-relaxed">
          {t('index.edu.step3.desc')}
        </p>
      </div>
    </div>
  </section>

  <!-- Explore Other Brewers (Internal Linking for SEO) -->
  <section id="tool-selector" class="mt-20 border-t border-coffee-sand/10 pt-16 mb-8 scroll-mt-24">
    <div class="text-center max-w-2xl mx-auto mb-12 px-4">
      <h2 class="font-display text-3xl font-bold tracking-wide text-coffee-light">{t('index.tools.title')}</h2>
      <p class="text-xs sm:text-sm text-coffee-muted mt-2">{t('index.tools.subtitle')}</p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-5 gap-4 max-w-5xl mx-auto mb-16">
      <a href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/${lang}/tools/v60-pour-over`} class="backdrop-blur-xl bg-coffee-dark/50 border border-coffee-sand/10 shadow-xl shadow-coffee-darker/50 rounded-2xl p-6 text-center group flex flex-col items-center gap-3 hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
        <span class="text-3xl group-hover:scale-110 transition-transform duration-300">☕</span>
        <span class="font-display font-semibold text-coffee-light">{t('index.tools.v60')}</span>
      </a>
      <a href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/${lang}/tools/french-press`} class="backdrop-blur-xl bg-coffee-dark/50 border border-coffee-sand/10 shadow-xl shadow-coffee-darker/50 rounded-2xl p-6 text-center group flex flex-col items-center gap-3 hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
        <span class="text-3xl group-hover:scale-110 transition-transform duration-300">🫖</span>
        <span class="font-display font-semibold text-coffee-light">{t('index.tools.frenchPress')}</span>
      </a>
      <a href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/${lang}/tools/aeropress`} class="backdrop-blur-xl bg-coffee-dark/50 border border-coffee-sand/10 shadow-xl shadow-coffee-darker/50 rounded-2xl p-6 text-center group flex flex-col items-center gap-3 hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
        <span class="text-3xl group-hover:scale-110 transition-transform duration-300">🪄</span>
        <span class="font-display font-semibold text-coffee-light">{t('index.tools.aeropress')}</span>
      </a>
      <a href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/${lang}/tools/cold-brew`} class="backdrop-blur-xl bg-coffee-dark/50 border border-coffee-sand/10 shadow-xl shadow-coffee-darker/50 rounded-2xl p-6 text-center group flex flex-col items-center gap-3 hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
        <span class="text-3xl group-hover:scale-110 transition-transform duration-300">🧊</span>
        <span class="font-display font-semibold text-coffee-light">{t('index.tools.coldBrew')}</span>
      </a>
      <a href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/${lang}/tools/grind-converter`} class="backdrop-blur-xl bg-coffee-dark/50 border border-coffee-sand/10 shadow-xl shadow-coffee-darker/50 rounded-2xl p-6 text-center group flex flex-col items-center gap-3 md:col-span-1 col-span-2 relative overflow-hidden hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
        <div class="absolute inset-0 bg-gradient-to-br from-[#D9A05B]/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
        <span class="text-3xl group-hover:scale-110 transition-transform duration-300">⚙️</span>
        <span class="font-display font-semibold text-coffee-light">{t('index.tools.grind')}</span>
      </a>
      <a href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/${lang}/tools/water-temperature`} class="backdrop-blur-xl bg-coffee-dark/50 border border-coffee-sand/10 shadow-xl shadow-coffee-darker/50 rounded-2xl p-6 text-center group flex flex-col items-center gap-3 md:col-span-1 col-span-2 relative overflow-hidden hover:border-[#D9A05B]/50 hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
        <div class="absolute inset-0 bg-gradient-to-br from-red-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
        <span class="text-3xl group-hover:scale-110 transition-transform duration-300">🌡️</span>
        <span class="font-display font-semibold text-coffee-light">{t('index.tools.temp')}</span>
      </a>
      <a href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/${lang}/tools/bean-freshness`} class="backdrop-blur-xl bg-coffee-dark/50 border border-coffee-sand/10 shadow-xl shadow-coffee-darker/50 rounded-2xl p-6 text-center group flex flex-col items-center gap-3 md:col-span-1 col-span-2 relative overflow-hidden hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
        <div class="absolute inset-0 bg-gradient-to-br from-green-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
        <span class="text-3xl group-hover:scale-110 transition-transform duration-300">🌱</span>
        <span class="font-display font-semibold text-coffee-light">{t('index.tools.freshness')}</span>
      </a>
    </div>
  </section>
</Layout>

<script is:inline define:vars={{
  m1: t('motivation.1'), m2: t('motivation.2'), m3: t('motivation.3'),
  m4: t('motivation.4'), m5: t('motivation.5'), m6: t('motivation.6'),
  m7: t('motivation.7'), m8: t('motivation.8'), m9: t('motivation.9')
}}>
  document.addEventListener('DOMContentLoaded', () => {
    const slogans = [m1, m2, m3, m4, m5, m6, m7, m8, m9];
    const banner = document.getElementById('motivation-banner');
    if (!banner) return;
    
    let currentIndex = Math.floor(Math.random() * slogans.length);
    let isPaused = false;
    
    const showSlogan = () => {
      if (isPaused) return;
      banner.style.opacity = '0';
      setTimeout(() => {
        if (isPaused) return;
        banner.textContent = `"${slogans[currentIndex]}"`;
        banner.style.opacity = '1';
        currentIndex = (currentIndex + 1) % slogans.length;
      }, 1000); // Wait for fade out to complete before changing text
    };
    
    // Hover-to-Pause Logic
    const pauseRotation = () => isPaused = true;
    const resumeRotation = () => isPaused = false;
    
    banner.addEventListener('mouseenter', pauseRotation);
    banner.addEventListener('mouseleave', resumeRotation);
    banner.addEventListener('touchstart', pauseRotation, {passive: true});
    banner.addEventListener('touchend', resumeRotation, {passive: true});
    banner.addEventListener('pointerdown', pauseRotation, {passive: true});
    
    // Initial display
    setTimeout(showSlogan, 100);
    autoRotateInterval = setInterval(showSlogan, 6000); // Change slogan every 6 seconds

    // Smooth Scrolling for Hash Links
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const targetId = this.getAttribute('href').substring(1);
        const targetElem = document.getElementById(targetId);
        if (targetElem) {
          targetElem.scrollIntoView({ behavior: 'smooth' });
          // Optional focus for accessibility
          targetElem.setAttribute('tabindex', '-1');
          targetElem.focus({ preventScroll: true });
        }
      });
    });
  });
</script>
