---
import Layout from '../../layouts/Layout.astro';
import { getLanguagePaths } from '../../i18n/routes';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

export function getStaticPaths() {
  return getLanguagePaths();
}
---

<Layout
  title={t('terms.meta.title')}
  description={t('terms.meta.desc')}
>
  <div class="max-w-3xl mx-auto py-8 sm:py-12">
    <div class="mb-10 text-center">
      <h1 class="font-display text-3xl sm:text-4xl font-bold tracking-tight text-coffee-light mb-4">{t('terms.title')}</h1>
      <p class="text-sm text-coffee-muted">{t('terms.date')}</p>
    </div>

    <p class="text-coffee-light/90 leading-relaxed mb-10 text-center max-w-2xl mx-auto">
      {t('terms.intro')}
    </p>

    <div class="space-y-6">
      <section class="bg-coffee-dark border border-coffee-sand/10 p-6 sm:p-8 rounded-3xl hover:border-coffee-gold/30 transition-colors shadow-sm relative overflow-hidden group">
        <div class="absolute top-0 start-0 w-1 h-full bg-coffee-gold/50 group-hover:bg-coffee-gold transition-colors"></div>
        <h2 class="text-xl font-display font-bold text-coffee-light mb-3 flex items-center gap-3">
          <span class="w-8 h-8 rounded-full bg-coffee-gold/10 flex items-center justify-center text-coffee-gold text-sm">1</span>
          {t('terms.s1.title')}
        </h2>
        <div class="text-coffee-sand/80 leading-relaxed text-sm ms-11">
          <p>{t('terms.s1.p1')}</p>
        </div>
      </section>

      <section class="bg-coffee-dark border border-coffee-sand/10 p-6 sm:p-8 rounded-3xl hover:border-coffee-gold/30 transition-colors shadow-sm relative overflow-hidden group">
        <div class="absolute top-0 start-0 w-1 h-full bg-coffee-gold/50 group-hover:bg-coffee-gold transition-colors"></div>
        <h2 class="text-xl font-display font-bold text-coffee-light mb-3 flex items-center gap-3">
          <span class="w-8 h-8 rounded-full bg-coffee-gold/10 flex items-center justify-center text-coffee-gold text-sm">2</span>
          {t('terms.s2.title')}
        </h2>
        <div class="text-coffee-sand/80 leading-relaxed text-sm ms-11 space-y-4">
          <p>{t('terms.s2.p1')}</p>
          <ul class="list-disc list-outside ms-4 space-y-1">
            <li>{t('terms.s2.l1')}</li>
            <li>{t('terms.s2.l2')}</li>
          </ul>
        </div>
      </section>

      <section class="bg-coffee-dark border border-coffee-sand/10 p-6 sm:p-8 rounded-3xl hover:border-coffee-gold/30 transition-colors shadow-sm relative overflow-hidden group">
        <div class="absolute top-0 start-0 w-1 h-full bg-coffee-gold/50 group-hover:bg-coffee-gold transition-colors"></div>
        <h2 class="text-xl font-display font-bold text-coffee-light mb-3 flex items-center gap-3">
          <span class="w-8 h-8 rounded-full bg-coffee-gold/10 flex items-center justify-center text-coffee-gold text-sm">3</span>
          {t('terms.s3.title')}
        </h2>
        <div class="text-coffee-sand/80 leading-relaxed text-sm ms-11 space-y-4">
          <p>{t('terms.s3.p1')}</p>
          <ul class="list-disc list-outside ms-4 space-y-1">
            <li>{t('terms.s3.l1')}</li>
            <li>{t('terms.s3.l2')}</li>
          </ul>
        </div>
      </section>

      <section class="bg-coffee-dark border border-coffee-sand/10 p-6 sm:p-8 rounded-3xl hover:border-coffee-gold/30 transition-colors shadow-sm relative overflow-hidden group">
        <div class="absolute top-0 start-0 w-1 h-full bg-coffee-gold/50 group-hover:bg-coffee-gold transition-colors"></div>
        <h2 class="text-xl font-display font-bold text-coffee-light mb-3 flex items-center gap-3">
          <span class="w-8 h-8 rounded-full bg-coffee-gold/10 flex items-center justify-center text-coffee-gold text-sm">4</span>
          {t('terms.s4.title')}
        </h2>
        <div class="text-coffee-sand/80 leading-relaxed text-sm ms-11 space-y-4">
          <p>{t('terms.s4.p1')}</p>
          <ul class="list-disc list-outside ms-4 space-y-1">
            <li>{t('terms.s4.l1')}</li>
            <li>{t('terms.s4.l2')}</li>
            <li>{t('terms.s4.l3')}</li>
          </ul>
        </div>
      </section>

      <section class="bg-coffee-dark border border-coffee-sand/10 p-6 sm:p-8 rounded-3xl hover:border-coffee-gold/30 transition-colors shadow-sm relative overflow-hidden group">
        <div class="absolute top-0 start-0 w-1 h-full bg-coffee-gold/50 group-hover:bg-coffee-gold transition-colors"></div>
        <h2 class="text-xl font-display font-bold text-coffee-light mb-3 flex items-center gap-3">
          <span class="w-8 h-8 rounded-full bg-coffee-gold/10 flex items-center justify-center text-coffee-gold text-sm">5</span>
          {t('terms.s5.title')}
        </h2>
        <div class="text-coffee-sand/80 leading-relaxed text-sm ms-11">
          <p>{t('terms.s5.p1')}</p>
        </div>
      </section>

      <section class="bg-coffee-dark border border-coffee-sand/10 p-6 sm:p-8 rounded-3xl hover:border-coffee-gold/30 transition-colors shadow-sm relative overflow-hidden group">
        <div class="absolute top-0 start-0 w-1 h-full bg-coffee-gold/50 group-hover:bg-coffee-gold transition-colors"></div>
        <h2 class="text-xl font-display font-bold text-coffee-light mb-3 flex items-center gap-3">
          <span class="w-8 h-8 rounded-full bg-coffee-gold/10 flex items-center justify-center text-coffee-gold text-sm">6</span>
          {t('terms.s6.title')}
        </h2>
        <div class="text-coffee-sand/80 leading-relaxed text-sm ms-11">
          <p>{t('terms.s6.p1')}</p>
        </div>
      </section>
    </div>
  </div>
</Layout>
