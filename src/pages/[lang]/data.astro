---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

export function getStaticPaths() {
  return [{ params: { lang: 'zh-TW' } }];
}
---

<Layout title="Coffee Timer 資料備份與搬機" description="毋須註冊帳戶，一鍵匯出及匯入咖啡配方、收藏、沖煮紀錄、計時狀態與頁面回饋。資料只在你的瀏覽器與下載檔案內。">
  <div class="mx-auto max-w-4xl py-6 sm:py-10">
    <div class="flex justify-center"><Breadcrumbs items={[{ label: '資料備份與搬機' }]} /></div>
    <header class="mx-auto mt-4 max-w-2xl text-center">
      <p class="text-xs font-bold uppercase tracking-[0.22em] text-coffee-gold">Local-first backup</p>
      <h1 class="mt-3 font-display text-4xl font-bold text-coffee-light sm:text-5xl">你的紀錄，隨時可以帶走</h1>
      <p class="mt-5 text-sm leading-7 text-coffee-sand/80 sm:text-base">毋須帳戶。備份檔包含本裝置的配方、收藏、沖煮評分及設定；檔案只會下載到你的裝置，不會上傳到 Coffee Timer 伺服器。</p>
    </header>

    <section class="mt-9 grid gap-6 md:grid-cols-2">
      <article class="rounded-3xl border border-coffee-sand/10 bg-coffee-darker/75 p-6 sm:p-8">
        <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-coffee-gold/10 text-xl text-coffee-gold" aria-hidden="true">↓</span>
        <h2 class="mt-4 font-display text-2xl font-bold text-coffee-light">1. 匯出完整備份</h2>
        <p class="mt-3 text-sm leading-7 text-coffee-muted">產生可在另一部裝置匯入的 JSON 備份檔。Cookie 同意不會搬移，讓每部裝置自行保留私隱選擇。</p>
        <dl id="backup-summary" class="mt-5 grid grid-cols-2 gap-3 text-center">
          <div class="rounded-xl bg-coffee-dark/60 p-3"><dt class="text-[10px] text-coffee-muted">沖煮紀錄</dt><dd data-count="logs" class="mt-1 text-xl font-bold text-coffee-gold">0</dd></div>
          <div class="rounded-xl bg-coffee-dark/60 p-3"><dt class="text-[10px] text-coffee-muted">收藏配方</dt><dd data-count="favorites" class="mt-1 text-xl font-bold text-coffee-gold">0</dd></div>
        </dl>
        <button id="btn-export-backup" type="button" class="mt-6 min-h-[50px] w-full rounded-xl bg-coffee-gold px-5 text-sm font-bold text-coffee-dark transition hover:bg-coffee-gold-hover">下載備份檔</button>
      </article>

      <article class="rounded-3xl border border-coffee-sand/10 bg-coffee-darker/75 p-6 sm:p-8">
        <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-coffee-gold/10 text-xl text-coffee-gold" aria-hidden="true">↑</span>
        <h2 class="mt-4 font-display text-2xl font-bold text-coffee-light">2. 在新裝置匯入</h2>
        <p class="mt-3 text-sm leading-7 text-coffee-muted">先選擇由本網站匯出的檔案。系統會先檢查格式並顯示內容摘要，不會一選檔便覆蓋資料。</p>
        <label for="backup-file" class="mt-5 flex min-h-[50px] cursor-pointer items-center justify-center rounded-xl border border-dashed border-coffee-gold/50 px-4 text-center text-sm font-semibold text-coffee-gold hover:bg-coffee-gold/10">選擇 .json 備份檔</label>
        <input id="backup-file" type="file" accept="application/json,.json" class="sr-only" />
        <div id="import-preview" class="mt-4 hidden rounded-xl border border-coffee-sand/10 bg-coffee-dark/55 p-4 text-sm leading-7 text-coffee-sand" aria-live="polite"></div>
        <label class="mt-4 hidden items-start gap-3 text-xs leading-6 text-coffee-sand" id="replace-confirm-wrap">
          <input id="replace-confirm" type="checkbox" class="mt-1 h-4 w-4 accent-coffee-gold" />
          <span>我明白匯入會取代這部裝置現有的 Coffee Timer 資料，並已先下載備份。</span>
        </label>
        <button id="btn-import-backup" type="button" disabled class="mt-4 min-h-[50px] w-full rounded-xl bg-coffee-gold px-5 text-sm font-bold text-coffee-dark transition hover:bg-coffee-gold-hover disabled:cursor-not-allowed disabled:opacity-40">確認匯入並重新載入</button>
      </article>
    </section>

    <section class="mt-7 rounded-3xl border border-coffee-sand/10 bg-coffee-dark/45 p-6">
      <h2 class="font-display text-xl font-bold text-coffee-light">安全設計</h2>
      <ul class="mt-4 grid gap-3 text-sm leading-7 text-coffee-muted sm:grid-cols-2">
        <li>✓ 只接受 JSON，檔案上限 2 MB</li>
        <li>✓ 只匯入 Coffee Timer 已知欄位</li>
        <li>✓ 選檔後先預覽，確認後才取代</li>
        <li>✓ 不包含密碼、帳戶或廣告識別資料</li>
      </ul>
      <p id="backup-status" class="mt-5 text-sm font-semibold text-coffee-gold" aria-live="polite"></p>
    </section>
  </div>
</Layout>

<script>
  interface BackupFile {
    format: string;
    version: number;
    exportedAt: string;
    origin?: string;
    data: Record<string, unknown>;
  }

  const STORAGE_KEYS = [
    'barista_flow_recipe',
    'barista_flow_recipes',
    'barista_flow_history',
    'barista_flow_logs',
    'barista_flow_pending_parent',
    'barista_flow_pending_adjustment',
    'barista_flow_timer_session_v1',
    'barista_flow_muted',
    'barista_flow_article_feedback'
  ];
  const MAX_FILE_SIZE = 2 * 1024 * 1024;
  const fileInput = document.getElementById('backup-file');
  const importPreview = document.getElementById('import-preview');
  const confirmWrap = document.getElementById('replace-confirm-wrap');
  const confirmInput = document.getElementById('replace-confirm');
  const importButton = document.getElementById('btn-import-backup');
  const status = document.getElementById('backup-status');
  let validatedBackup: BackupFile | null = null;

  function parseStored(key: string): unknown {
    const raw = localStorage.getItem(key);
    if (raw === null) return undefined;
    try { return JSON.parse(raw); } catch (error) { return raw; }
  }

  function refreshCounts() {
    const logs = parseStored('barista_flow_logs');
    const favorites = parseStored('barista_flow_history');
    const logCount = document.querySelector('[data-count="logs"]');
    const favoriteCount = document.querySelector('[data-count="favorites"]');
    if (logCount) logCount.textContent = String(Array.isArray(logs) ? logs.length : 0);
    if (favoriteCount) favoriteCount.textContent = String(Array.isArray(favorites) ? favorites.length : 0);
  }

  function collectBackup() {
    const data: Record<string, unknown> = {};
    STORAGE_KEYS.forEach((key) => {
      const value = parseStored(key);
      if (value !== undefined) data[key] = value;
    });
    return {
      format: 'barista-flow-backup',
      version: 1,
      exportedAt: new Date().toISOString(),
      origin: window.location.origin,
      data
    };
  }

  document.getElementById('btn-export-backup')?.addEventListener('click', () => {
    const backup = collectBackup();
    const blob = new Blob([JSON.stringify(backup, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = `coffee-timer-backup-${new Date().toISOString().slice(0, 10)}.json`;
    document.body.appendChild(link);
    link.click();
    link.remove();
    URL.revokeObjectURL(url);
    if (status) status.textContent = '備份已下載。請把檔案存放在你信任的位置。';
  });

  function validateBackup(value: unknown): BackupFile {
    if (!value || typeof value !== 'object' || Array.isArray(value)) throw new Error('檔案內容不是有效的備份物件。');
    const candidate = value as Partial<BackupFile>;
    if (candidate.format !== 'barista-flow-backup' || candidate.version !== 1) throw new Error('這不是 Coffee Timer v1 備份檔。');
    if (!candidate.data || typeof candidate.data !== 'object' || Array.isArray(candidate.data)) throw new Error('備份資料結構不完整。');
    const safeData: Record<string, unknown> = {};
    STORAGE_KEYS.forEach((key) => {
      if (Object.prototype.hasOwnProperty.call(candidate.data, key)) safeData[key] = candidate.data![key];
    });
    if (!Object.keys(safeData).length) throw new Error('備份內沒有可匯入的 Coffee Timer 資料。');
    const logs = safeData.barista_flow_logs;
    const favorites = safeData.barista_flow_history;
    if (logs !== undefined && (!Array.isArray(logs) || logs.length > 200)) throw new Error('沖煮紀錄格式或數量不正確。');
    if (favorites !== undefined && (!Array.isArray(favorites) || favorites.length > 10)) throw new Error('收藏配方格式或數量不正確。');
    return {
      format: candidate.format,
      version: candidate.version,
      exportedAt: typeof candidate.exportedAt === 'string' && !Number.isNaN(Date.parse(candidate.exportedAt)) ? candidate.exportedAt : new Date(0).toISOString(),
      origin: typeof candidate.origin === 'string' ? candidate.origin : undefined,
      data: safeData
    };
  }

  if (fileInput instanceof HTMLInputElement) {
    fileInput.addEventListener('change', async () => {
      validatedBackup = null;
      if (confirmInput instanceof HTMLInputElement) confirmInput.checked = false;
      if (importButton instanceof HTMLButtonElement) importButton.disabled = true;
      const file = fileInput.files?.[0];
      if (!file) return;
      try {
        if (file.size > MAX_FILE_SIZE) throw new Error('檔案超過 2 MB 上限。');
        const parsed = JSON.parse(await file.text());
        validatedBackup = validateBackup(parsed);
        const logs = validatedBackup.data.barista_flow_logs;
        const favorites = validatedBackup.data.barista_flow_history;
        if (importPreview) {
          importPreview.textContent = `已驗證：${Array.isArray(logs) ? logs.length : 0} 項沖煮紀錄、${Array.isArray(favorites) ? favorites.length : 0} 項收藏。備份日期：${new Date(validatedBackup.exportedAt).toLocaleString('zh-HK')}`;
          importPreview.classList.remove('hidden');
        }
        confirmWrap?.classList.remove('hidden');
        confirmWrap?.classList.add('flex');
        if (status) status.textContent = '檔案格式正確。勾選確認後才會匯入。';
      } catch (error) {
        if (importPreview) {
          importPreview.textContent = `無法匯入：${error instanceof Error ? error.message : '檔案無效'}`;
          importPreview.classList.remove('hidden');
        }
        confirmWrap?.classList.add('hidden');
        if (status) status.textContent = '資料沒有被更改。';
      }
    });
  }

  confirmInput?.addEventListener('change', () => {
    if (importButton instanceof HTMLButtonElement && confirmInput instanceof HTMLInputElement) {
      importButton.disabled = !validatedBackup || !confirmInput.checked;
    }
  });

  importButton?.addEventListener('click', () => {
    if (!validatedBackup || !(confirmInput instanceof HTMLInputElement) || !confirmInput.checked) return;
    const previousData: Record<string, string> = {};
    STORAGE_KEYS.forEach((key) => {
      const raw = localStorage.getItem(key);
      if (raw !== null) previousData[key] = raw;
    });
    try {
      STORAGE_KEYS.forEach((key) => localStorage.removeItem(key));
      Object.entries(validatedBackup.data).forEach(([key, value]) => localStorage.setItem(key, JSON.stringify(value)));
      if (status) status.textContent = '匯入完成，正在重新載入…';
      window.setTimeout(() => window.location.reload(), 600);
    } catch (error) {
      try {
        STORAGE_KEYS.forEach((key) => localStorage.removeItem(key));
        Object.entries(previousData).forEach(([key, raw]) => localStorage.setItem(key, raw));
      } catch (rollbackError) {}
      if (status) status.textContent = '儲存空間不足或瀏覽器拒絕寫入；已嘗試還原匯入前的資料，請重新載入確認。';
    }
  });

  refreshCounts();
</script>
