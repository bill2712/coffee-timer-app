---
import Layout from '../../../layouts/Layout.astro';
import AdSlot from '../../../components/AdSlot.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { getLanguagePaths } from '../../../i18n/routes';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const rawBase = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;
const baseUrl = `${rawBase}/${lang}/`;

const faqs = [
  {
    question: t('faq.q1'),
    answer: t('faq.a1') + ` <a href="${baseUrl}" class="text-coffee-gold underline underline-offset-4 hover:text-coffee-light transition-colors font-medium">` + t('index.tools.title') + `</a>`
  },
  {
    question: t('faq.q2'),
    answer: t('faq.a2')
  },
  {
    question: t('faq.q3'),
    answer: t('faq.a3') + ` <a href="${baseUrl}" class="text-coffee-gold underline underline-offset-4 hover:text-coffee-light transition-colors font-medium">` + t('index.tools.subtitle') + `</a>`
  },
  {
    question: t('faq.q4'),
    answer: t('faq.a4')
  },
  {
    question: t('faq.q5'),
    answer: t('faq.a5') + ` <a href="${baseUrl}" class="text-coffee-gold underline underline-offset-4 hover:text-coffee-light transition-colors font-medium">` + t('index.tools.title') + `</a>`
  },
  {
    question: t('faq.q6'),
    answer: t('faq.a6')
  }
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      // Strip HTML tags for clean JSON-LD text using a simple regex
      "text": (faq.answer || "").replace(/<[^>]+>/g, '')
    }
  }))
};

export function getStaticPaths() {
  return getLanguagePaths();
}
---

<Layout 
  title="{t('faq.meta.title')}"
  description="{t('faq.meta.desc')}"
  jsonld={jsonLd}
>
  <div class="max-w-3xl mx-auto py-12">
    <!-- Breadcrumb -->
    <div class="flex justify-center">
      <Breadcrumbs items={[{ label: t('nav.home'), url: baseUrl }, { label: t('faq.breadcrumb') }]} />
    </div>

    <!-- Header -->
    <header class="text-center mb-16 relative">
      <div class="absolute top-0 start-1/2 -translate-x-1/2 rtl:translate-x-1/2 -translate-y-1/2 w-32 h-32 bg-coffee-gold/10 blur-[50px] rounded-full -z-10"></div>
      <h1 class="font-display text-4xl sm:text-5xl font-bold tracking-tight text-coffee-light mb-6">
        {t('faq.title.prefix')} <span class="text-transparent bg-clip-text bg-gradient-to-r from-coffee-gold to-coffee-accent">{t('faq.title.highlight')}</span>
      </h1>
      <p class="text-lg text-coffee-sand/80 max-w-2xl mx-auto font-light leading-relaxed">
        {t('faq.subtitle')}
      </p>
    </header>

    <!-- Top Ad Placeholder -->
    <div class="mb-12">
      <AdSlot type="top-leaderboard" id="faq-top-ad" />
    </div>

    <!-- FAQ Accordion List -->
    <div class="space-y-4" id="faq-accordion">
      {faqs.map((faq, index) => (
        <div class="glass-card rounded-2xl border border-coffee-sand/10 overflow-hidden transition-colors hover:border-coffee-gold/30 faq-item">
          <button 
            class="faq-button w-full flex items-center justify-between p-6 text-start focus:outline-none focus-visible:ring-2 focus-visible:ring-coffee-gold/50"
            aria-expanded="false"
            aria-controls={`faq-answer-${index}`}
            id={`faq-question-${index}`}
          >
            <h3 class="font-display text-lg sm:text-xl font-bold text-coffee-light pe-8">
              {faq.question}
            </h3>
            <span class="faq-icon flex-shrink-0 ms-4 flex items-center justify-center w-8 h-8 rounded-full bg-coffee-darker border border-coffee-sand/20 text-coffee-gold transition-transform duration-200 ease-out">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </button>
          
          <div 
            id={`faq-answer-${index}`}
            class="faq-answer grid grid-rows-[0fr] transition-[grid-template-rows] duration-200 ease-out"
            role="region"
            aria-labelledby={`faq-question-${index}`}
          >
            <div class="overflow-hidden">
              <div class="p-6 pt-0 text-coffee-sand/85 leading-relaxed font-light border-t border-coffee-sand/5 mt-2">
                <p set:html={faq.answer}></p>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Contact CTA -->
    <div class="mt-16 text-center glass-card-interactive p-8 rounded-2xl">
      <h3 class="font-display text-2xl font-bold text-coffee-light mb-3">
        {t('faq.cta.title')}
      </h3>
      <p class="text-coffee-muted mb-6 text-sm">
        {t('faq.cta.desc')}
      </p>
      <a href={`${baseUrl}contact`} class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl border border-coffee-gold/50 text-coffee-gold hover:bg-coffee-gold/10 transition-colors text-sm font-semibold tracking-wide">
        {t('faq.cta.button')}
      </a>
    </div>

    <!-- Bottom Ad Placeholder -->
    <div class="mt-16 pt-12 border-t border-coffee-sand/10">
      <AdSlot type="in-article" id="faq-bottom-ad" />
    </div>
  </div>
</Layout>

<script>
  // Simple vanilla JS logic for the accordion with smooth grid-template-rows animation
  document.addEventListener('DOMContentLoaded', () => {
    const faqButtons = document.querySelectorAll('.faq-button');
    
    faqButtons.forEach(button => {
      button.addEventListener('click', () => {
        const isExpanded = button.getAttribute('aria-expanded') === 'true';
        const answerDiv = button.nextElementSibling;
        const icon = button.querySelector('.faq-icon');
        
        // Close all other accordions (optional, but good UX for FAQs)
        faqButtons.forEach(btn => {
          if (btn !== button) {
            btn.setAttribute('aria-expanded', 'false');
            const otherAnswerDiv = btn.nextElementSibling;
            const otherIcon = btn.querySelector('.faq-icon');
            if (otherAnswerDiv) otherAnswerDiv.classList.replace('grid-rows-[1fr]', 'grid-rows-[0fr]');
            if (otherIcon) otherIcon.classList.remove('rotate-180');
          }
        });

        // Toggle current accordion
        if (isExpanded) {
          button.setAttribute('aria-expanded', 'false');
          answerDiv?.classList.replace('grid-rows-[1fr]', 'grid-rows-[0fr]');
          icon?.classList.remove('rotate-180');
        } else {
          button.setAttribute('aria-expanded', 'true');
          answerDiv?.classList.replace('grid-rows-[0fr]', 'grid-rows-[1fr]');
          icon?.classList.add('rotate-180');
        }
      });
    });
  });
</script>
