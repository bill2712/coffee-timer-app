---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import SearchBar from '../../../components/SearchBar.astro';
import { getLanguagePaths } from '../../../i18n/routes';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const isZh = lang === 'zh-TW';

// Surface both practical articles and glossary entries as one searchable knowledge library.
const posts = (await getCollection('blog'))
  .filter((entry) => entry.id.toLowerCase().startsWith(`${lang.toLowerCase()}/`))
  .sort((a, b) => {
    const aGlossary = a.data.tags?.includes('Glossary') ? 1 : 0;
    const bGlossary = b.data.tags?.includes('Glossary') ? 1 : 0;
    return aGlossary - bGlossary || b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
  });

const articleCount = posts.filter((post) => !post.data.tags?.includes('Glossary')).length;
const glossaryCount = posts.length - articleCount;
const copy = isZh ? {
  total: '知識內容', articles: '深度文章', glossary: '咖啡術語',
  all: '全部內容', articleFilter: '只看深度文章', glossaryFilter: '只看咖啡術語',
  showing: `顯示全部 ${posts.length} 篇`, articleBadge: '深度文章', glossaryBadge: '術語解說',
  subtitle: '由研磨、水質、溫度、萃取到風味診斷，每篇內容都提供可操作步驟、適用限制與參考來源，協助你用紀錄而不是猜測改善下一杯。',
  termTag: '咖啡術語'
} : {
  total: 'Knowledge pieces', articles: 'In-depth articles', glossary: 'Coffee terms',
  all: 'All content', articleFilter: 'In-depth articles only', glossaryFilter: 'Coffee terms only',
  showing: `Showing all ${posts.length} pieces`, articleBadge: 'In-depth', glossaryBadge: 'Glossary',
  subtitle: 'From grind, water, and temperature to extraction and flavour diagnosis, each piece gives practical steps, clear limits, and references so you can improve the next brew with records instead of guesswork.',
  termTag: 'Coffee term'
};

function displayTags(tags: string[]) {
  const specificTags = tags.filter((tag) => tag !== 'Glossary');
  return specificTags.length ? specificTags.slice(0, 2) : [copy.termTag];
}

function formatDate(date: Date) {
  return date.toLocaleDateString(lang, {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });
}

export function getStaticPaths() {
  return getLanguagePaths();
}
---

<Layout
  title={t('blog.meta.title')}
  description={t('blog.meta.desc')}
>
  <!-- Header Section -->
  <section class="max-w-4xl mx-auto text-center mb-10 sm:mb-12">
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-coffee-gold/10 border border-coffee-gold/20 text-coffee-gold text-xs font-semibold uppercase tracking-widest mb-6">
      {t('blog.tag')}
    </div>
    
    <h1 class="font-display text-4xl sm:text-5xl font-bold tracking-tight text-coffee-light">
      {t('blog.title')}
    </h1>
    
    <p class="text-sm sm:text-base text-coffee-muted max-w-2xl mx-auto mt-4 leading-relaxed">
      {copy.subtitle}
    </p>

    <dl class="mx-auto mt-7 grid max-w-2xl grid-cols-3 gap-2 sm:gap-3">
      {[[posts.length, copy.total], [articleCount, copy.articles], [glossaryCount, copy.glossary]].map(([value, label]) => (
        <div class="rounded-xl border border-coffee-sand/10 bg-coffee-darker/60 px-2 py-3 sm:rounded-2xl sm:px-4">
          <dd class="font-display text-2xl font-bold text-coffee-gold sm:text-3xl">{value}</dd>
          <dt class="mt-1 text-[10px] font-semibold uppercase tracking-wide text-coffee-muted sm:text-xs">{label}</dt>
        </div>
      ))}
    </dl>
  </section>

  <!-- Search Bar -->
  <SearchBar />

  <section aria-labelledby="knowledge-library-title">
    <div class="mb-6 flex flex-col gap-4 border-b border-coffee-sand/10 pb-5 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 id="knowledge-library-title" class="font-display text-2xl font-bold text-coffee-light">{copy.total}</h2>
        <p id="knowledge-result-count" class="mt-1 text-xs text-coffee-muted" aria-live="polite">{copy.showing}</p>
      </div>
      <div class="flex flex-wrap gap-2" role="group" aria-label={isZh ? '內容類型篩選' : 'Filter by content type'} data-knowledge-filters data-all-label={copy.showing} data-article-label={isZh ? `顯示 ${articleCount} 篇深度文章` : `Showing ${articleCount} in-depth articles`} data-glossary-label={isZh ? `顯示 ${glossaryCount} 篇咖啡術語` : `Showing ${glossaryCount} coffee terms`}>
        {[
          ['all', copy.all],
          ['article', copy.articleFilter],
          ['glossary', copy.glossaryFilter]
        ].map(([value, label], index) => (
          <button type="button" data-knowledge-filter={value} aria-pressed={index === 0 ? 'true' : 'false'} class:list={[
            'min-h-11 rounded-full border px-4 text-xs font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-coffee-gold',
            index === 0 ? 'border-coffee-gold bg-coffee-gold text-coffee-dark' : 'border-coffee-sand/20 text-coffee-sand hover:border-coffee-gold hover:text-coffee-gold'
          ]}>{label}</button>
        ))}
      </div>
    </div>

    <div class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3" data-knowledge-grid>
      {posts.map((post) => (
      <article data-knowledge-card data-kind={post.data.tags?.includes('Glossary') ? 'glossary' : 'article'} class="glass-card-interactive group overflow-hidden rounded-2xl border border-coffee-sand/10 flex flex-col h-full">
        <a href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/${lang}/${post.data.tags?.includes('Glossary') ? 'glossary' : 'blog'}/${post.id.split('/').pop()}`} class="flex flex-col h-full p-5 sm:p-6 justify-between focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-coffee-gold">
          <div class="flex flex-col gap-4">
            <!-- Date & Tags -->
            <div class="flex items-center justify-between gap-3 text-xs text-coffee-muted">
              <span>{formatDate(post.data.pubDate)}</span>
              <span class:list={['rounded-full border px-2 py-1 text-[9px] font-bold uppercase tracking-wider', post.data.tags?.includes('Glossary') ? 'border-coffee-sand/15 bg-coffee-sand/5 text-coffee-sand' : 'border-coffee-gold/25 bg-coffee-gold/10 text-coffee-gold']}>
                {post.data.tags?.includes('Glossary') ? copy.glossaryBadge : copy.articleBadge}
              </span>
            </div>

            <!-- Title & Description -->
            <div>
              <h2 class="font-display text-xl font-bold text-coffee-light group-hover:text-coffee-gold transition-colors leading-snug">
                {post.data.title}
              </h2>
              <p class="text-sm text-coffee-muted line-clamp-3 mt-3 leading-6">
                {post.data.description}
              </p>
            </div>
          </div>

          <!-- Footer of Card -->
          <div class="mt-6 pt-4 border-t border-coffee-sand/10 flex flex-wrap gap-2 items-center justify-between">
            <div class="flex flex-wrap gap-1">
              {displayTags(post.data.tags).map((tag: string) => (
                <span class="text-[10px] px-2 py-0.5 rounded-full bg-coffee-gray border border-coffee-sand/10 text-coffee-sand">
                  #{tag}
                </span>
              ))}
            </div>
            
            <span class="text-xs font-semibold text-coffee-gold flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              {t('blog.readMore')} 
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </span>
          </div>
        </a>
      </article>
    ))}
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filters = document.querySelector<HTMLElement>('[data-knowledge-filters]');
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-knowledge-filter]'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-knowledge-card]'));
    const count = document.getElementById('knowledge-result-count');
    if (!filters || !buttons.length || !cards.length) return;

    buttons.forEach((button) => button.addEventListener('click', () => {
      const selected = button.dataset.knowledgeFilter || 'all';
      buttons.forEach((item) => {
        const active = item === button;
        item.setAttribute('aria-pressed', String(active));
        item.classList.toggle('border-coffee-gold', active);
        item.classList.toggle('bg-coffee-gold', active);
        item.classList.toggle('text-coffee-dark', active);
        item.classList.toggle('border-coffee-sand/20', !active);
        item.classList.toggle('text-coffee-sand', !active);
      });
      cards.forEach((card) => card.classList.toggle('hidden', selected !== 'all' && card.dataset.kind !== selected));
      if (count) {
        count.textContent = selected === 'article'
          ? filters.dataset.articleLabel || ''
          : selected === 'glossary'
            ? filters.dataset.glossaryLabel || ''
            : filters.dataset.allLabel || '';
      }
    }));
  });
</script>
