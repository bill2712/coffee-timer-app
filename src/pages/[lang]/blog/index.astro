---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import SearchBar from '../../../components/SearchBar.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { getLanguagePaths } from '../../../i18n/routes';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Fetch all posts from content collections, sorted by publish date descending
const posts = (await getCollection('blog'))
  .filter((entry) => entry.id.startsWith(`${lang}/`) && !entry.data.tags?.includes('Glossary'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function formatDate(date: Date) {
  return date.toLocaleDateString(lang, {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

export function getStaticPaths() {
  return getLanguagePaths();
}
---

<Layout
  title={t('blog.meta.title')}
  description={t('blog.meta.desc')}
>
  <!-- Header Section -->
  <section class="max-w-3xl mx-auto text-center mb-16">
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-coffee-gold/10 border border-coffee-gold/20 text-coffee-gold text-xs font-semibold uppercase tracking-widest mb-6">
      {t('blog.tag')}
    </div>
    
    <h1 class="font-display text-4xl sm:text-5xl font-bold tracking-tight text-coffee-light">
      {t('blog.title')}
    </h1>
    
    <p class="text-sm sm:text-base text-coffee-muted max-w-xl mx-auto mt-4 leading-relaxed">
      {t('blog.subtitle')}
    </p>
  </section>

  <!-- Search Bar -->
  <SearchBar />

  <!-- Blog Layout with Sidebar -->
  <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
    <!-- Main Content: Blog Posts -->
    <div class="lg:col-span-3 grid grid-cols-1 md:grid-cols-2 gap-8">
      {posts.map((post) => (
      <article class="glass-card-interactive rounded-2xl overflow-hidden flex flex-col h-full">
        <a href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/${lang}/blog/${post.id.split('/').pop()}`} class="flex flex-col h-full p-6 sm:p-8 justify-between">
          <div class="flex flex-col gap-4">
            <!-- Date & Tags -->
            <div class="flex items-center justify-between text-xs text-coffee-muted">
              <span>{formatDate(post.data.pubDate)}</span>
              <span class="text-[10px] font-semibold uppercase tracking-wider text-coffee-sand">{post.data.author}</span>
            </div>

            <!-- Title & Description -->
            <div>
              <h2 class="font-display text-xl font-bold text-coffee-light group-hover:text-coffee-gold transition-colors leading-snug">
                {post.data.title}
              </h2>
              <p class="text-xs text-coffee-muted line-clamp-3 mt-3 leading-relaxed">
                {post.data.description}
              </p>
            </div>
          </div>

          <!-- Footer of Card -->
          <div class="mt-8 pt-4 border-t border-coffee-sand/10 flex flex-wrap gap-1.5 items-center justify-between">
            <div class="flex flex-wrap gap-1">
              {post.data.tags.slice(0, 2).map((tag: string) => (
                <span class="text-[10px] px-2 py-0.5 rounded-full bg-coffee-gray border border-coffee-sand/10 text-coffee-sand">
                  #{tag}
                </span>
              ))}
            </div>
            
            <span class="text-xs font-semibold text-coffee-gold flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              {t('blog.readMore')} 
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </span>
          </div>
        </a>
      </article>
    ))}
    </div>

    <!-- Sidebar AdSense Placeholder -->
    <div class="lg:col-span-1">
      <AdSlot type="sidebar-skyscraper" id="adsense-sidebar" class="sticky top-28" />
    </div>
  </div>
</Layout>
