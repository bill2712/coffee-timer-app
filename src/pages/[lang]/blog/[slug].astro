---
import { SITE_URL } from '../../../config';
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import AdSlot from '../../../components/AdSlot.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { languages } from '../../../i18n/ui';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';
import { editor, hasEditor } from '../../../data/editor';


export async function getStaticPaths() {
  const blogEntries = await getCollection('blog', (entry) => !entry.data.tags?.includes('Glossary'));
  
  const locales = Object.keys(languages);
  return blogEntries.filter(entry => locales.some(locale => entry.id.toLowerCase().startsWith(`${locale.toLowerCase()}/`))).map(entry => {
    const parts = entry.id.split('/');
    // entry.id might be 'zh-tw/filename', find exact matching locale
    const rawLang = parts[0];
    const exactLang = locales.find(l => l.toLowerCase() === rawLang.toLowerCase()) || rawLang;
    const slug = parts.slice(1).join('/').replace(/.mdx?$/, '');
    return {
      params: { lang: exactLang, slug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { Content, headings } = await render(entry);
const isZh = lang === 'zh-TW';
const localeBase = `${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/${lang}`;
const updatedDate = entry.data.updatedDate;
const toc = headings.filter((heading) => heading.depth === 2);

// Related guides: same language, most shared tags first, newest as tie-breaker.
const ownSlug = entry.id.split('/').slice(1).join('/').replace(/\.mdx?$/, '');
const siblings = await getCollection('blog', (other) =>
  other.id.toLowerCase().startsWith(`${lang.toLowerCase()}/`) && !other.data.tags?.includes('Glossary') && other.id !== entry.id
);
const related = siblings
  .map((other) => ({
    other,
    slug: other.id.split('/').slice(1).join('/').replace(/\.mdx?$/, ''),
    shared: other.data.tags.filter((tag) => entry.data.tags.includes(tag)).length
  }))
  .filter((item) => item.slug !== ownSlug)
  .sort((a, b) => b.shared - a.shared || b.other.data.pubDate.valueOf() - a.other.data.pubDate.valueOf())
  .slice(0, 3);

function formatDate(date: Date) {
  return date.toLocaleDateString(lang, {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

// Generate Schema.org BlogPosting JSON-LD for premium Google SEO
const siteParsed = new URL(SITE_URL);
const siteOrigin = siteParsed.origin;
const basePath = siteParsed.pathname === '/' ? '' : siteParsed.pathname;
let currentPath = Astro.url.pathname;
if (!currentPath.startsWith(basePath)) {
  currentPath = basePath + currentPath;
}
const canonicalURL = new URL(currentPath, siteOrigin);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": entry.data.title,
  "description": entry.data.description,
  "datePublished": entry.data.pubDate.toISOString(),
  "dateModified": (entry.data.updatedDate ?? entry.data.pubDate).toISOString(),
  "inLanguage": lang,
  "author": hasEditor
    ? { "@type": "Person", "name": editor.name, "url": `${siteOrigin}${basePath}/${lang}/about/#editor` }
    : { "@type": "Organization", "name": entry.data.author, "url": `${siteOrigin}${basePath}/${lang}/about` },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalURL.toString()
  },
  "publisher": {
    "@type": "Organization",
    "name": "Barista Flow",
    "logo": {
      "@type": "ImageObject",
      "url": `${siteOrigin}${basePath}/icons/icon-512.png`
    }
  }
};
---

<Layout
  title={`${entry.data.title}${t('blog.post.meta.suffix')}`}
  description={entry.data.description}
  article={true}
  jsonld={jsonLd}
>
  <article class="max-w-6xl mx-auto">
    <!-- Breadcrumbs -->
    <Breadcrumbs items={[
      { label: t('blog.breadcrumb'), url: 'blog' },
      { label: entry.data.title }
    ]} />

    <!-- Header info -->
    <header class="mb-10 sm:mb-12">
      <div class="flex flex-wrap gap-2 items-center text-xs text-coffee-sand mb-4">
        <span>{isZh ? '發佈：' : 'Published '}<time datetime={entry.data.pubDate.toISOString().slice(0, 10)}>{formatDate(entry.data.pubDate)}</time></span>
        {updatedDate && (
          <>
            <span class="text-coffee-muted">•</span>
            <span class="text-coffee-gold">{isZh ? '最後更新：' : 'Updated '}<time datetime={updatedDate.toISOString().slice(0, 10)}>{formatDate(updatedDate)}</time></span>
          </>
        )}
        <span class="text-coffee-muted">•</span>
        {hasEditor
          ? <span>{isZh ? '撰寫及審閱：' : 'Written and reviewed by '}<a href={`${localeBase}/about/#editor`} class="text-coffee-gold hover:underline">{editor.name}</a></span>
          : <span>{t('blog.author')}{entry.data.author}</span>}
      </div>

      <h1 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-coffee-light leading-tight">
        {entry.data.title}
      </h1>

      <div class="flex flex-wrap gap-1.5 mt-6">
        {entry.data.tags.map((tag: string) => (
          <span class="text-xs px-3 py-1 rounded-full bg-coffee-gray border border-coffee-sand/15 text-coffee-sand">
            #{tag}
          </span>
        ))}
      </div>
    </header>

    <!-- Main Content Container with Premium Styles -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8 blog-content border-t border-coffee-sand/10 pt-10 text-coffee-light/95 leading-relaxed text-sm sm:text-base">
      
      <div class="lg:col-span-3">
        <!-- Google AdSense Article Inline Banner Placeholder -->
        <AdSlot type="top-leaderboard" id="adsense-article-inline" class="mb-10" />

        {toc.length >= 4 && (
          <nav class="article-toc mb-10 rounded-2xl border border-coffee-sand/10 bg-coffee-darker/60 p-5" aria-label={isZh ? '本文目錄' : 'In this guide'}>
            <p class="text-xs font-bold uppercase tracking-wider text-coffee-gold">{isZh ? '本文目錄' : 'In this guide'}</p>
            <ol>
              {toc.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
            </ol>
          </nav>
        )}

        <article class="prose prose-invert prose-coffee max-w-none mb-12">
          <Content components={{ AdSlot }} />
        </article>

        <!-- Google AdSense Bottom Article Banner Placeholder (Prevents CLS) -->
        <AdSlot type="in-article" id="adsense-article-bottom" class="my-10" />
      </div>

      <aside class="lg:col-span-1">
        <AdSlot type="sidebar-skyscraper" id="adsense-article-sidebar" class="sticky top-28" />
      </aside>
    </div>

    {related.length > 0 && (
      <section class="mt-14 border-t border-coffee-sand/10 pt-10" aria-labelledby="related-title">
        <h2 id="related-title" class="font-display text-2xl font-bold text-coffee-light">{isZh ? '延伸閱讀' : 'Keep learning'}</h2>
        <div class="mt-5 grid gap-4 md:grid-cols-3">
          {related.map(({ other, slug }) => (
            <a href={`${localeBase}/blog/${slug}/`} class="related-card">
              <strong>{other.data.title}</strong>
              <span>{other.data.description}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- CTA & Footer of Post -->
    <div class="mt-16 border-t border-coffee-sand/10 pt-10 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <h4 class="font-display text-lg font-bold text-coffee-light">{t('blog.cta.title')}</h4>
        <p class="text-xs text-coffee-muted mt-1">{t('blog.cta.desc')}</p>
      </div>

      <a
        href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/${lang}/`}
        class="inline-flex items-center gap-2 bg-gradient-to-r from-coffee-accent to-coffee-gold text-coffee-dark font-bold tracking-wide rounded-xl px-6 py-3 shadow-lg hover:from-coffee-gold hover:to-coffee-gold-hover transition-all active:scale-[0.98] cursor-pointer text-sm gold-glow"
      >
        {t('blog.cta.btn')}
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </a>
    </div>
  </article>
</Layout>

<!-- Markdown Specific Custom Styles for Premium Look -->
<style is:global>
  .article-toc ol { margin: .75rem 0 0; padding-left: 1.25rem; list-style: decimal; display: grid; gap: .35rem; font-size: .875rem; }
  .article-toc a { color: rgb(245 242 235 / .82); text-decoration: none; }
  .article-toc a:hover, .article-toc a:focus-visible { color: var(--color-coffee-gold); text-decoration: underline; }
  .related-card { display: grid; gap: .5rem; border: 1px solid rgb(197 168 128 / .14); border-radius: 1rem; background: rgb(28 24 21 / .55); padding: 1.1rem; transition: border-color 160ms ease; }
  .related-card:hover, .related-card:focus-visible { border-color: rgb(197 168 128 / .5); }
  .related-card strong { color: var(--color-coffee-light); font-size: .95rem; line-height: 1.4; }
  .related-card span { color: rgb(197 168 128 / .75); font-size: .8rem; line-height: 1.55; }
  .blog-content {
    /* Headings */
    h2 {
      font-family: var(--font-display);
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--color-coffee-gold);
      margin-top: 2.5rem;
      margin-bottom: 1rem;
      letter-spacing: 0.025em;
    }
    
    @media (min-width: 640px) {
      h2 {
        font-size: 1.75rem;
      }
    }

    h3 {
      font-family: var(--font-display);
      font-size: 1.2rem;
      font-weight: 600;
      color: var(--color-coffee-sand);
      margin-top: 2rem;
      margin-bottom: 0.75rem;
    }

    /* Paragraphs and spacing */
    p {
      margin-bottom: 1.5rem;
      color: rgba(245, 242, 235, 0.85);
      line-height: 1.8;
      font-weight: 300;
    }

    strong {
      color: var(--color-coffee-light);
      font-weight: 600;
    }

    /* Lists */
    ul {
      list-style-type: none;
      padding-left: 0;
      margin-bottom: 1.5rem;
    }

    ul li {
      position: relative;
      padding-left: 1.5rem;
      margin-bottom: 0.5rem;
      color: rgba(245, 242, 235, 0.85);
      font-weight: 300;
    }

    ul li::before {
      content: "•";
      color: var(--color-coffee-gold);
      font-weight: bold;
      position: absolute;
      left: 0.5rem;
      top: 0;
    }

    ol {
      list-style-type: decimal;
      padding-left: 1.25rem;
      margin-bottom: 1.5rem;
      color: rgba(245, 242, 235, 0.85);
    }

    ol li {
      margin-bottom: 0.75rem;
      padding-left: 0.25rem;
      font-weight: 300;
    }

    ol li::marker {
      color: var(--color-coffee-gold);
      font-weight: 600;
    }

    /* Blockquote */
    blockquote {
      border-left: 3px solid var(--color-coffee-gold);
      padding-left: 1.5rem;
      margin: 2rem 0;
      font-style: italic;
      color: var(--color-coffee-sand);
    }

    /* Divider */
    hr {
      border: 0;
      border-top: 1px solid rgba(197, 168, 128, 0.15);
      margin: 3rem 0;
    }

    /* Tables */
    table {
      width: 100%;
      border-collapse: collapse;
      margin: 2rem 0;
      font-size: 0.875rem;
      /* Wide comparison tables scroll inside the article on phones instead of widening the page. */
      display: block;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    th, td {
      min-width: 6.5rem;
    }

    th, td {
      padding: 0.75rem 1rem;
      text-align: left;
      border-bottom: 1px solid rgba(197, 168, 128, 0.15);
    }

    th {
      font-family: var(--font-display);
      color: var(--color-coffee-gold);
      font-weight: 600;
      background-color: rgba(42, 36, 32, 0.4);
    }

    td {
      color: rgba(245, 242, 235, 0.8);
      font-weight: 300;
    }

    tr:hover td {
      color: var(--color-coffee-light);
      background-color: rgba(197, 168, 128, 0.02);
    }
  }
</style>
