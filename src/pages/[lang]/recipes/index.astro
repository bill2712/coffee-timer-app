---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { getLangFromUrl } from '../../../i18n/utils';
import { getLanguagePaths } from '../../../i18n/routes';
import { getStandardRecipes } from '../../../data/standardRecipes';

const lang = getLangFromUrl(Astro.url);
const base = `/${lang}`;
const isZh = lang === 'zh-TW';
const recipes = getStandardRecipes(lang);
const c = isZh ? {
  title: '有來源的咖啡標準配方庫｜V60、AeroPress、French Press、冷萃', desc: '由品牌及烘焙商原始沖煮指引整理的咖啡配方庫，清楚標示來源、適用情境、限制與覆核日期，並連接你的個人沖煮紀錄。', crumb: '標準配方庫',
  h1: '有來源，也能變成你的配方', intro: '每項配方都列出原始來源、器材、步驟、適用情境與限制。本站不假裝已做實物測試；真正的差異來自你套用後留下的味道紀錄、照片與調整心得。',
  transparency: '資料透明度：', transparencyBody: '本頁所有來源於 2026-08-30 覆核。參數按原來源整理；凡屬本站為方便計算而加入的起點，均在配方內另行標明。', all: '全部', powder: '咖啡粉', ratio: '粉水比', temp: '水溫起點', source: '來源', noRecord: '你的實作：尚未有紀錄', view: '查看來源、步驟與套用'
} : {
  title: 'Source-backed coffee recipes | V60, AeroPress, French press, and cold brew', desc: 'Coffee recipes organised from original manufacturer and roaster guides, with sources, equipment, applicability, limits, review dates, and your own brew records.', crumb: 'Standard recipes',
  h1: 'Source-backed starting points you can make your own', intro: 'Each recipe identifies its original source, equipment, steps, use case, and limits. Barista Flow does not invent independent testing; your brew records, photos, and adjustment notes provide the real-world layer.',
  transparency: 'Data transparency:', transparencyBody: 'All sources on this page were reviewed on 2026-08-30. Parameters follow the original source; any Barista Flow calculator value is labelled separately.', all: 'All', powder: 'Coffee', ratio: 'Ratio', temp: 'Starting temp', source: 'Source', noRecord: 'Your tests: no records yet', view: 'View source, steps, and apply'
};

export function getStaticPaths() {
  return getLanguagePaths();
}
---

<Layout
  title={c.title}
  description={c.desc}
>
  <div class="mx-auto max-w-5xl py-6 sm:py-10">
    <div class="flex justify-center"><Breadcrumbs items={[{ label: c.crumb }]} /></div>
    <header class="mx-auto mt-4 max-w-3xl text-center">
      <p class="text-xs font-bold uppercase tracking-[0.22em] text-coffee-gold">Source-backed recipes</p>
      <h1 class="mt-3 font-display text-4xl font-bold tracking-tight text-coffee-light sm:text-5xl">{c.h1}</h1>
      <p class="mx-auto mt-5 max-w-2xl text-sm leading-7 text-coffee-sand/80 sm:text-base">
        {c.intro}
      </p>
    </header>

    <section class="mt-8 rounded-2xl border border-coffee-gold/20 bg-coffee-gold/5 p-4 text-sm leading-7 text-coffee-sand">
      <strong class="text-coffee-gold">{c.transparency}</strong>
      {c.transparencyBody}
    </section>

    <div class="mt-8 flex flex-wrap justify-center gap-2" role="group" aria-label="依沖煮器材篩選">
      {[c.all, 'V60', 'AeroPress', 'French Press', 'Cold Brew'].map((label, index) => (
        <button type="button" data-recipe-filter={index === 0 ? 'all' : label} aria-pressed={index === 0 ? 'true' : 'false'} class:list={[
          'min-h-[44px] rounded-full border px-4 text-sm font-semibold transition',
          index === 0 ? 'border-coffee-gold bg-coffee-gold text-coffee-dark' : 'border-coffee-sand/20 text-coffee-sand hover:border-coffee-gold hover:text-coffee-gold'
        ]}>{label}</button>
      ))}
    </div>

    <section class="mt-8 grid gap-5 md:grid-cols-2" aria-live="polite">
      {recipes.map((recipe) => (
        <article data-recipe-card data-brewer={recipe.brewer} class="flex h-full flex-col rounded-3xl border border-coffee-sand/10 bg-coffee-darker/75 p-6 shadow-lg">
          <div class="flex items-start justify-between gap-4">
            <span class="rounded-full bg-coffee-gold/10 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-coffee-gold">{recipe.brewerLabel}</span>
            <span class="text-xs text-coffee-muted">{recipe.duration}</span>
          </div>
          <h2 class="mt-4 font-display text-2xl font-bold text-coffee-light">{recipe.title}</h2>
          <p class="mt-3 flex-1 text-sm leading-7 text-coffee-sand/80">{recipe.summary}</p>
          <dl class="mt-5 grid grid-cols-3 gap-2 rounded-2xl bg-coffee-dark/55 p-3 text-center">
            <div><dt class="text-[10px] text-coffee-muted">{c.powder}</dt><dd class="mt-1 font-bold text-coffee-light">{recipe.recipe.coffeeWeight} g</dd></div>
            <div><dt class="text-[10px] text-coffee-muted">{c.ratio}</dt><dd class="mt-1 font-bold text-coffee-light">1:{Math.round(recipe.recipe.waterRatio * 10) / 10}</dd></div>
            <div><dt class="text-[10px] text-coffee-muted">{c.temp}</dt><dd class="mt-1 font-bold text-coffee-light">{recipe.recipe.waterTemp}°C</dd></div>
          </dl>
          <p class="mt-4 text-xs leading-6 text-coffee-muted">{c.source}: {recipe.sourceName}</p>
          <p class="mt-2 text-xs font-semibold text-coffee-gold" data-personal-stat={recipe.id}>{c.noRecord}</p>
          <a href={`${base}/recipes/${recipe.slug}`} class="mt-5 inline-flex min-h-[48px] items-center justify-center rounded-xl bg-coffee-gold px-5 text-sm font-bold text-coffee-dark transition hover:bg-coffee-gold-hover">{c.view}</a>
        </article>
      ))}
    </section>
  </div>
</Layout>

<script>
  const filterButtons = Array.from(document.querySelectorAll('[data-recipe-filter]'));
  const cards = Array.from(document.querySelectorAll('[data-recipe-card]'));
  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const selected = button.getAttribute('data-recipe-filter') || 'all';
      filterButtons.forEach((item) => {
        const active = item === button;
        item.setAttribute('aria-pressed', String(active));
        item.classList.toggle('bg-coffee-gold', active);
        item.classList.toggle('text-coffee-dark', active);
        item.classList.toggle('border-coffee-gold', active);
      });
      cards.forEach((card) => {
        if (!(card instanceof HTMLElement)) return;
        card.classList.toggle('hidden', selected !== 'all' && card.dataset.brewer !== selected);
      });
    });
  });

  try {
    const isZhPage = document.documentElement.lang === 'zh-TW';
    const parsed = JSON.parse(localStorage.getItem('barista_flow_logs') || '[]');
    const logs = Array.isArray(parsed) ? parsed : [];
    document.querySelectorAll('[data-personal-stat]').forEach((element) => {
      const id = element.getAttribute('data-personal-stat');
      const matched = logs.filter((log) => log?.recipe?.standardRecipeId === id);
      if (!matched.length) return;
      const scores = matched.map((log) => Number(log?.evaluation?.overall)).filter(Number.isFinite);
      const average = scores.length ? (scores.reduce((sum, score) => sum + score, 0) / scores.length).toFixed(1) : '—';
      element.textContent = isZhPage ? `你的實作：${matched.length} 次・平均 ${average}/5` : `Your tests: ${matched.length} · average ${average}/5`;
    });
  } catch (error) {}
</script>
