---
import { SITE_URL } from '../../../config';
import Layout from '../../../layouts/Layout.astro';
import ParameterForm from '../../../components/ParameterForm.astro';
import Timer from '../../../components/Timer.astro';
import AdSlot from '../../../components/AdSlot.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { getLanguagePaths } from '../../../i18n/routes';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const defaultAeroPressRecipe = {
  beanName: t('tools.default.bean.aeropress'),
  roastLevel: 'medium',
  grindSize: t('tools.default.grind.aeropress'),
  waterTemp: 85,
  coffeeWeight: 15,
  waterRatio: 14
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "AeroPress Recipe Calculator & Timer",
  "applicationCategory": "UtilityApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "url": `${SITE_URL}/`,
  "description": "{t('tools.aeropress.jsonld.desc')}",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};

export function getStaticPaths() {
  return getLanguagePaths();
}
---

<Layout
  title="{t('tools.aeropress.meta.title')}"
  description="{t('tools.aeropress.meta.desc')}"
  jsonld={jsonLd}
>
  <div class="max-w-3xl mx-auto mb-12 text-center">
    <div class="flex justify-center">
      <Breadcrumbs items={[
        { label: t('nav.home'), url: '/' },
        { label: t('tools.aeropress.breadcrumb') }
      ]} />
    </div>
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-coffee-gold/10 border border-coffee-gold/20 text-coffee-gold text-xs font-semibold uppercase tracking-widest mb-4">
      AeroPress Explorer
    </div>
    <h1 class="font-display text-4xl sm:text-5xl font-bold tracking-tight text-coffee-light">
      {t('tools.aeropress.title')}
    </h1>
    <p class="text-coffee-muted mt-4 text-sm sm:text-base max-w-xl mx-auto">
      {t('tools.aeropress.subtitle')}
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-16">
    <div class="lg:col-span-5">
      <ParameterForm defaultRecipe={defaultAeroPressRecipe} ignoreLocalStorage={true} />
    </div>
    
    <div class="lg:col-span-7 sticky top-24">
      <Timer />
    </div>
  </div>

  <div class="max-w-3xl mx-auto blog-content prose prose-invert prose-coffee mt-12 pt-12 border-t border-coffee-sand/10">
    <AdSlot type="top-leaderboard" id="ap-ad-1" class="mb-10" />

    <h2>{t('tools.aeropress.h2_1')}</h2>
    <p>
      {t('tools.aeropress.p1')}
    </p>
    <p>
      {t('tools.aeropress.p2')}
    </p>

    <h2>{t('tools.aeropress.h2_2')}</h2>
    <ol>
      <li>{t('tools.aeropress.li1')}</li>
      <li>{t('tools.aeropress.li2')}</li>
      <li>{t('tools.aeropress.li3')}</li>
    </ol>

    <AdSlot type="in-article" id="ap-ad-2" class="my-10" />

    <h2>{t('tools.aeropress.h2_3')}</h2>
    <h3>{t('tools.aeropress.h3_1')}</h3>
    <p>
      {t('tools.aeropress.p3')}
    </p>
    
    <h3>{t('tools.aeropress.h3_2')}</h3>
    <p>
      {t('tools.aeropress.p4')}
    </p>

    <h3>{t('tools.aeropress.h3_3')}</h3>
    <p>
      {t('tools.aeropress.p5')}
    </p>

    <p>
      {t('tools.aeropress.p6')}
    </p>
  </div>
</Layout>

<style is:global>
  .blog-content h2 { font-family: var(--font-display); font-size: 1.5rem; font-weight: 700; color: var(--color-coffee-gold); margin-top: 2.5rem; margin-bottom: 1rem; }
  .blog-content h3 { font-family: var(--font-display); font-size: 1.2rem; font-weight: 600; color: var(--color-coffee-sand); margin-top: 2rem; margin-bottom: 0.75rem; }
  .blog-content p { margin-bottom: 1.5rem; color: rgba(245, 242, 235, 0.85); line-height: 1.8; font-weight: 300; }
  .blog-content ol, .blog-content ul { margin-bottom: 1.5rem; color: rgba(245, 242, 235, 0.85); padding-left: 1.5rem; }
  .blog-content ol li { margin-bottom: 0.75rem; }
</style>
