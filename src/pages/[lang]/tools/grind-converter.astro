---
import { SITE_URL } from '../../../config';
import Layout from '../../../layouts/Layout.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { getLanguagePaths } from '../../../i18n/routes';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": t('grind.title') + " (Grind Size Converter)",
  "applicationCategory": "UtilityApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "url": `${SITE_URL}/`,
  "description": t("grind.meta.desc"),
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};

export function getStaticPaths() {
  return getLanguagePaths();
}
---

<Layout 
  title={t('grind.meta.title')}
  description={t('grind.meta.desc')}
  jsonld={jsonLd}
>
  <div class="max-w-4xl mx-auto py-8 sm:py-12">
    <div class="text-center mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-coffee-gold/10 border border-coffee-gold/20 text-coffee-gold text-xs font-semibold uppercase tracking-widest mb-4">
        Grinder Calibration Tool
      </div>
      <h1 class="font-display text-3xl sm:text-4xl font-bold tracking-tight text-coffee-light mb-4">
        {t('grind.title')}
      </h1>
      <p class="text-sm text-coffee-muted max-w-2xl mx-auto leading-relaxed">
        {t('grind.subtitle')}
      </p>
    </div>

    <!-- Top Ad Placeholder -->
    <div class="mb-12">
      <AdSlot type="top-leaderboard" id="grind-ad-top" />
    </div>

    <div class="glass-card rounded-3xl p-6 sm:p-10 border border-coffee-sand/10 relative overflow-hidden mb-16">
      <div class="absolute top-0 end-0 w-64 h-64 bg-coffee-gold/5 blur-[100px] rounded-full -z-10 pointer-events-none"></div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
        <!-- Source Grinder -->
        <div class="space-y-6">
          <h3 class="font-display text-xl font-bold text-coffee-sand border-b border-coffee-sand/10 pb-3 flex items-center gap-2">
            <span class="bg-coffee-gold text-coffee-dark w-6 h-6 rounded-full flex items-center justify-center text-sm font-bold">1</span> 
            {t('grind.source.title')}
          </h3>
          
          <div class="flex flex-col gap-2">
            <label for="source-grinder" class="text-xs font-semibold uppercase tracking-wider text-coffee-muted">{t('grind.selectBrand')}</label>
            <select id="source-grinder" class="w-full bg-coffee-darker border border-coffee-sand/20 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-coffee-gold/50 focus:border-coffee-gold transition-colors text-coffee-light cursor-pointer">
              <!-- Populated by JS -->
            </select>
          </div>

          <div class="flex flex-col gap-2">
            <label for="source-value" class="text-xs font-semibold uppercase tracking-wider text-coffee-muted">{t('grind.currentScale')} <span id="source-unit" class="lowercase"></span></label>
            <div class="flex items-center gap-4">
              <input type="range" id="source-slider" class="flex-grow accent-coffee-gold h-2 bg-coffee-darker rounded-lg appearance-none cursor-pointer" />
              <input type="number" id="source-value" class="w-20 bg-coffee-darker border border-coffee-sand/20 rounded-xl px-3 py-2 text-center text-lg font-bold text-coffee-light focus:ring-2 focus:ring-coffee-gold/50" />
            </div>
            <div class="flex justify-between text-[10px] text-coffee-muted font-mono mt-1">
              <span id="source-min">0</span>
              <span id="source-max">50</span>
            </div>
          </div>
        </div>

        <!-- Target Grinder -->
        <div class="space-y-6">
          <h3 class="font-display text-xl font-bold text-coffee-sand border-b border-coffee-sand/10 pb-3 flex items-center gap-2">
            <span class="bg-coffee-gold text-coffee-dark w-6 h-6 rounded-full flex items-center justify-center text-sm font-bold">2</span> 
            {t('grind.target.title')}
          </h3>
          
          <div class="flex flex-col gap-2">
            <label for="target-grinder" class="text-xs font-semibold uppercase tracking-wider text-coffee-muted">{t('grind.selectTarget')}</label>
            <select id="target-grinder" class="w-full bg-coffee-darker border border-coffee-sand/20 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-coffee-gold/50 focus:border-coffee-gold transition-colors text-coffee-light cursor-pointer">
              <!-- Populated by JS -->
            </select>
          </div>

          <div class="flex flex-col items-center justify-center h-[90px] bg-coffee-darker/50 rounded-xl border border-coffee-sand/10 relative">
            <span class="text-xs font-semibold uppercase tracking-wider text-coffee-muted absolute top-2 start-3">{t('grind.result')}</span>
            <div class="flex items-baseline gap-2 mt-2">
              <span id="target-value" class="text-5xl font-display font-bold text-coffee-gold gold-glow drop-shadow-md">--</span>
              <span id="target-unit" class="text-sm font-medium text-coffee-muted"></span>
            </div>
          </div>
        </div>
      </div>

      <!-- Visual Gauge -->
      <div class="mt-12 pt-10 border-t border-coffee-sand/10">
        <div class="flex justify-between items-end mb-4">
          <div>
            <h4 class="text-sm font-bold text-coffee-light">{t('grind.gauge.title')}</h4>
            <p id="gauge-label" class="text-xs text-coffee-gold font-medium mt-1">{t('grind.gauge.select')}</p>
          </div>
        </div>
        
        <div class="relative w-full h-12 bg-coffee-darker rounded-xl border border-coffee-sand/10 overflow-hidden">
          <!-- Background Zones -->
          <div class="absolute inset-0 flex">
            <div class="h-full bg-red-900/20 border-r border-coffee-darker" style="width: 20%;" title={t("grind.tooltip.turkish")}></div>
            <div class="h-full bg-orange-900/20 border-r border-coffee-darker" style="width: 20%;" title={t("grind.tooltip.espresso")}></div>
            <div class="h-full bg-yellow-900/20 border-r border-coffee-darker" style="width: 20%;" title={t("grind.tooltip.aeropress")}></div>
            <div class="h-full bg-green-900/20 border-r border-coffee-darker" style="width: 20%;" title={t("grind.tooltip.frenchpress")}></div>
            <div class="h-full bg-blue-900/20" style="width: 20%;" title={t("grind.tooltip.coldbrew")}></div>
          </div>
          
          <!-- Method Labels -->
          <div class="absolute inset-0 flex text-[9px] sm:text-[10px] font-semibold text-coffee-muted/50 pointer-events-none select-none">
            <div class="flex-1 flex items-center justify-center">{t("grind.label.turkish")}</div>
            <div class="flex-1 flex items-center justify-center">{t("grind.label.espresso")}</div>
            <div class="flex-1 flex items-center justify-center">{t("grind.label.v60")}</div>
            <div class="flex-1 flex items-center justify-center">{t("grind.label.frenchpress")}</div>
            <div class="flex-1 flex items-center justify-center">{t("grind.label.coldbrew")}</div>
          </div>

          <!-- Indicator Pointer -->
          <div id="gauge-pointer" class="absolute top-0 bottom-0 w-1 bg-coffee-gold shadow-[0_0_10px_rgba(197,168,128,0.8)] transition-all duration-300 ease-out z-10" style="left: 0%;"></div>
        </div>
      </div>

      <!-- Action Button -->
      <div class="mt-10 flex justify-center">
        <button
          type="button"
          id="btn-apply-timer"
          class="inline-flex items-center gap-2 bg-gradient-to-r from-coffee-accent to-coffee-gold text-coffee-dark font-bold tracking-wide rounded-xl px-8 py-4 shadow-lg hover:from-coffee-gold hover:to-coffee-gold-hover transition-all active:scale-[0.98] cursor-pointer text-sm sm:text-base gold-glow disabled:opacity-50 disabled:cursor-not-allowed"
        >
          {t('grind.apply')}
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </button>
      </div>
    </div>

    <!-- In-Article Ad Placeholder -->
    <AdSlot type="in-article" id="grind-ad-mid" class="mb-16" />

    <!-- SEO Rich Text Content -->
    <article class="prose prose-invert prose-coffee max-w-none bg-coffee-darker/30 p-8 rounded-3xl border border-coffee-sand/5">
      <h2 class="font-display text-2xl font-bold text-coffee-gold mb-6 border-b border-coffee-sand/10 pb-4">{t("grind.h2_1")}</h2>
      
      <p>
        {t("grind.p1")}
      </p>

      <h3>{t("grind.h3_1")}</h3>
      <p>
        {t("grind.p2")}
      </p>
      <ul>
        <li><span set:html={t("grind.li1")} /></li>
        <li><span set:html={t("grind.li2")} /></li>
        <li><span set:html={t("grind.li3")} /></li>
        <li><span set:html={t("grind.li4")} /></li>
        <li><span set:html={t("grind.li5")} /></li>
      </ul>

      <h3>{t("grind.h3_2")}</h3>
      <p>
        <span set:html={t("grind.p3")} />
      </p>
    </article>
  </div>
</Layout>


<script is:inline define:vars={{ dict: { 
  turkish: t('grind.script.turkish'),
  espresso: t('grind.script.espresso'),
  aeropress: t('grind.script.aeropress'),
  v60: t('grind.script.v60'),
  frenchpress: t('grind.script.frenchpress'),
  coldbrew: t('grind.script.coldbrew')
} }}>
  window.grindDict = dict;
</script>
<script>
  interface MethodRanges {
    espresso: [number, number];
    aeropress: [number, number];
    v60: [number, number];
    frenchPress: [number, number];
    coldBrew: [number, number];
  }

  interface Grinder {
    id: string;
    name: string;
    unit: string;
    min: number;
    max: number;
    step: number;
    ranges: MethodRanges;
  }

  // Grinder Database
  const grinders: Record<string, Grinder> = {
    c40: {
      id: 'c40',
      name: 'Comandante C40',
      unit: 'Clicks',
      min: 0,
      max: 50,
      step: 1,
      ranges: {
        espresso: [8, 15],
        aeropress: [15, 20],
        v60: [20, 30],
        frenchPress: [30, 40],
        coldBrew: [35, 45]
      }
    },
    c2: {
      id: 'c2',
      name: 'Timemore C2/C3',
      unit: 'Clicks',
      min: 0,
      max: 36,
      step: 1,
      ranges: {
        espresso: [10, 14],
        aeropress: [13, 16],
        v60: [16, 24],
        frenchPress: [24, 30],
        coldBrew: [28, 34]
      }
    },
    ode2: {
      id: 'ode2',
      name: 'Fellow Ode Gen 2',
      unit: 'Settings',
      min: 1,
      max: 11,
      step: 0.1,
      ranges: {
        espresso: [1, 2], // Technically Ode isn't for espresso, but extrapolated
        aeropress: [2, 4],
        v60: [4, 8],
        frenchPress: [8, 11],
        coldBrew: [9, 11]
      }
    },
    encore: {
      id: 'encore',
      name: 'Baratza Encore',
      unit: 'Settings',
      min: 0,
      max: 40,
      step: 1,
      ranges: {
        espresso: [4, 9],
        aeropress: [10, 14],
        v60: [15, 22],
        frenchPress: [23, 30],
        coldBrew: [28, 40]
      }
    },
    kalita: {
      id: 'kalita',
      name: 'Kalita Nice Cut',
      unit: 'Settings',
      min: 1,
      max: 8,
      step: 0.5,
      ranges: {
        espresso: [1, 2],
        aeropress: [2.5, 3.5],
        v60: [3.5, 5.5],
        frenchPress: [5.5, 7],
        coldBrew: [6.5, 8]
      }
    }
  };

  const methodsOrder = ['espresso', 'aeropress', 'v60', 'frenchPress', 'coldBrew'] as const;

  // UI Elements
  const sourceSelect = document.getElementById('source-grinder') as HTMLSelectElement;
  const targetSelect = document.getElementById('target-grinder') as HTMLSelectElement;
  const sourceSlider = document.getElementById('source-slider') as HTMLInputElement;
  const sourceInput = document.getElementById('source-value') as HTMLInputElement;
  const targetValueEl = document.getElementById('target-value') as HTMLSpanElement;
  const sourceMinEl = document.getElementById('source-min') as HTMLSpanElement;
  const sourceMaxEl = document.getElementById('source-max') as HTMLSpanElement;
  const sourceUnitEl = document.getElementById('source-unit') as HTMLSpanElement;
  const targetUnitEl = document.getElementById('target-unit') as HTMLSpanElement;
  const gaugePointer = document.getElementById('gauge-pointer') as HTMLDivElement;
  const gaugeLabel = document.getElementById('gauge-label') as HTMLParagraphElement;
  const btnApplyTimer = document.getElementById('btn-apply-timer') as HTMLButtonElement;

  function initSelectors() {
    Object.values(grinders).forEach(g => {
      const opt1 = new Option(g.name, g.id);
      const opt2 = new Option(g.name, g.id);
      sourceSelect.add(opt1);
      targetSelect.add(opt2);
    });
    
    // Set default target to Timemore if possible
    sourceSelect.value = 'c40';
    targetSelect.value = 'c2';
  }

  function updateSourceGrinderUI() {
    const g = grinders[sourceSelect.value];
    sourceSlider.min = g.min.toString();
    sourceSlider.max = g.max.toString();
    sourceSlider.step = g.step.toString();
    
    sourceMinEl.textContent = g.min.toString();
    sourceMaxEl.textContent = g.max.toString();
    sourceUnitEl.textContent = g.unit;

    // Set a default value in the V60 range
    const v60Mid = g.ranges.v60[0] + (g.ranges.v60[1] - g.ranges.v60[0]) / 2;
    // Snap to step
    const snapped = Math.round(v60Mid / g.step) * g.step;
    
    sourceSlider.value = snapped.toString();
    sourceInput.value = snapped.toString();
    
    targetUnitEl.textContent = grinders[targetSelect.value].unit;
    
    calculateConversion();
  }

  function getMethodForValue(val: number, g: Grinder): { method: string, percentage: number } {
    // Determine which range the value falls into, and the percentage within that range.
    // If it's below espresso, extrapolate below 0. If above cold brew, extrapolate above 1.
    
    let currentMethod = 'espresso';
    let p = 0;

    if (val <= g.ranges.espresso[1]) {
      currentMethod = 'espresso';
      p = (val - g.ranges.espresso[0]) / (g.ranges.espresso[1] - g.ranges.espresso[0]);
    } else if (val <= g.ranges.aeropress[1]) {
      currentMethod = 'aeropress';
      p = (val - g.ranges.aeropress[0]) / (g.ranges.aeropress[1] - g.ranges.aeropress[0]);
    } else if (val <= g.ranges.v60[1]) {
      currentMethod = 'v60';
      p = (val - g.ranges.v60[0]) / (g.ranges.v60[1] - g.ranges.v60[0]);
    } else if (val <= g.ranges.frenchPress[1]) {
      currentMethod = 'frenchPress';
      p = (val - g.ranges.frenchPress[0]) / (g.ranges.frenchPress[1] - g.ranges.frenchPress[0]);
    } else {
      currentMethod = 'coldBrew';
      p = (val - g.ranges.coldBrew[0]) / (g.ranges.coldBrew[1] - g.ranges.coldBrew[0]);
    }

    return { method: currentMethod, percentage: p };
  }

  function calculateConversion() {
    const sGrinder = grinders[sourceSelect.value];
    const tGrinder = grinders[targetSelect.value];
    let val = parseFloat(sourceInput.value.replace(',', '.'));

    // Bounds checking
    if (isNaN(val)) val = sGrinder.min;
    if (val < sGrinder.min) val = sGrinder.min;
    if (val > sGrinder.max) val = sGrinder.max;

    targetUnitEl.textContent = tGrinder.unit;

    if (sGrinder.id === tGrinder.id) {
      targetValueEl.textContent = val.toString();
      updateGauge(val, sGrinder);
      return;
    }

    const { method, percentage } = getMethodForValue(val, sGrinder);
    
    // Convert to target
    const targetRange = tGrinder.ranges[method as keyof MethodRanges];
    let targetVal = targetRange[0] + (targetRange[1] - targetRange[0]) * percentage;
    
    // Snap to step
    targetVal = Math.round(targetVal / tGrinder.step) * tGrinder.step;
    
    // Format to 1 decimal if step is a float, else int
    const displayVal = tGrinder.step % 1 !== 0 ? targetVal.toFixed(1) : Math.round(targetVal).toString();
    
    targetValueEl.textContent = displayVal;
    
    updateGauge(val, sGrinder);
  }

  function updateGauge(val: number, g: Grinder) {
    // Map value to absolute 0-100% position on the visual gauge.
    // Gauge zones: 0-20% (Turk/ExFine), 20-40% (Espresso), 40-60% (V60), 60-80% (French), 80-100% (Cold Brew)
    
    let position = 0;
    let label = '';
    
    const { method, percentage } = getMethodForValue(val, g);
    // Clamp percentage for gauge aesthetics
    const cp = Math.max(-0.2, Math.min(1.2, percentage));

    switch(method) {
      case 'espresso':
        if (cp < 0) { position = 10 + (cp * 10); label = window.grindDict.turkish; }
        else { position = 20 + (cp * 20); label = window.grindDict.espresso; }
        break;
      case 'aeropress':
        // aero press bridges espresso and v60
        position = 40 + (cp * 10);
        label = window.grindDict.aeropress;
        break;
      case 'v60':
        position = 50 + (cp * 10);
        label = window.grindDict.v60;
        break;
      case 'frenchPress':
        position = 60 + (cp * 20);
        label = window.grindDict.frenchpress;
        break;
      case 'coldBrew':
        position = 80 + (cp * 20);
        label = window.grindDict.coldbrew;
        break;
    }

    // Hard bounds for CSS
    position = Math.max(0, Math.min(100, position));
    gaugePointer.style.left = `${position}%`;
    gaugeLabel.textContent = label;
  }

  function applyToTimer() {
    const tGrinder = grinders[targetSelect.value];
    const tValue = targetValueEl.textContent;
    const recipeString = `${tGrinder.name} ${tGrinder.unit === 'Clicks' ? '#' : ''}${tValue}`;

    // Read existing or create new
    let savedStr = localStorage.getItem('barista_flow_recipe');
    let recipe = savedStr ? JSON.parse(savedStr) : {};
    
    recipe.grindSize = recipeString;
    localStorage.setItem('barista_flow_recipe', JSON.stringify(recipe));

    // Redirect to home timer
    const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
    window.location.href = baseUrl;
  }

  // Bind Events
  document.addEventListener('DOMContentLoaded', () => {
    initSelectors();
    updateSourceGrinderUI();

    sourceSelect.addEventListener('change', updateSourceGrinderUI);
    targetSelect.addEventListener('change', calculateConversion);

    sourceSlider.addEventListener('input', (e) => {
      sourceInput.value = (e.target as HTMLInputElement).value;
      calculateConversion();
    });

    sourceInput.addEventListener('input', (e) => {
      sourceSlider.value = (e.target as HTMLInputElement).value;
      calculateConversion();
    });

    btnApplyTimer.addEventListener('click', applyToTimer);
  });
</script>
