---
import { SITE_URL } from '../../../config';
import Layout from '../../../layouts/Layout.astro';
import ParameterForm from '../../../components/ParameterForm.astro';
import Timer from '../../../components/Timer.astro';
import AdSlot from '../../../components/AdSlot.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { getLanguagePaths } from '../../../i18n/routes';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const defaultFrenchPressRecipe = {
  beanName: t('tools.default.bean.frenchpress'),
  roastLevel: 'dark',
  grindSize: t('tools.default.grind.frenchpress'),
  waterTemp: 90,
  coffeeWeight: 30,
  waterRatio: 12
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "French Press Coffee Calculator & Ratio Assistant",
  "applicationCategory": "UtilityApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "url": `${SITE_URL}/`,
  "description": t('tools.frenchpress.jsonld.desc'),
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};

export function getStaticPaths() {
  return getLanguagePaths();
}
---

<Layout
  title={t('tools.frenchpress.meta.title')}
  description={t('tools.frenchpress.meta.desc')}
  jsonld={jsonLd}
>
  <div class="max-w-3xl mx-auto mb-12 text-center">
    <div class="flex justify-center">
      <Breadcrumbs items={[
        { label: t('nav.home'), url: '/' },
        { label: t('tools.frenchpress.title') }
      ]} />
    </div>
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-coffee-gold/10 border border-coffee-gold/20 text-coffee-gold text-xs font-semibold uppercase tracking-widest mb-4">
      French Press Master
    </div>
    <h1 class="font-display text-4xl sm:text-5xl font-bold tracking-tight text-coffee-light">
      {t('tools.frenchpress.title')}
    </h1>
    <p class="text-coffee-muted mt-4 text-sm sm:text-base max-w-xl mx-auto">
      {t('tools.frenchpress.subtitle')}
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-16">
    <div class="lg:col-span-5">
      <ParameterForm defaultRecipe={defaultFrenchPressRecipe} ignoreLocalStorage={true} />
    </div>
    
    <div class="lg:col-span-7 sticky top-24">
      <Timer />
    </div>
  </div>

  <div class="max-w-3xl mx-auto blog-content prose prose-invert prose-coffee mt-12 pt-12 border-t border-coffee-sand/10">
    <AdSlot type="top-leaderboard" id="fp-ad-1" class="mb-10" />

    <h2>{t('tools.frenchpress.h2_1')}</h2>
    <p>
      {t('tools.frenchpress.p1')}
    </p>
    <p>
      {t('tools.frenchpress.p2')}
    </p>

    <h2>{t('tools.frenchpress.h2_2')}</h2>
    <ol>
      <li>{t('tools.frenchpress.li1')}</li>
      <li>{t('tools.frenchpress.li2')}</li>
      <li>{t('tools.frenchpress.li3')}</li>
    </ol>

    <AdSlot type="in-article" id="fp-ad-2" class="my-10" />

    <h2>{t('tools.frenchpress.h2_3')}</h2>
    <h3>{t('tools.frenchpress.h3_1')}</h3>
    <p>
      {t('tools.frenchpress.p3')}
    </p>
    
    <h3>{t('tools.frenchpress.h3_2')}</h3>
    <p>
      {t('tools.frenchpress.p4')}
    </p>

    <h3>{t('tools.frenchpress.h3_3')}</h3>
    <p>
      {t('tools.frenchpress.p5')}
    </p>

    <p>
      {t('tools.frenchpress.p6')}
    </p>
  </div>
</Layout>

<style is:global>
  .blog-content h2 { font-family: var(--font-display); font-size: 1.5rem; font-weight: 700; color: var(--color-coffee-gold); margin-top: 2.5rem; margin-bottom: 1rem; }
  .blog-content h3 { font-family: var(--font-display); font-size: 1.2rem; font-weight: 600; color: var(--color-coffee-sand); margin-top: 2rem; margin-bottom: 0.75rem; }
  .blog-content p { margin-bottom: 1.5rem; color: rgba(245, 242, 235, 0.85); line-height: 1.8; font-weight: 300; }
  .blog-content ol, .blog-content ul { margin-bottom: 1.5rem; color: rgba(245, 242, 235, 0.85); padding-left: 1.5rem; }
  .blog-content ol li { margin-bottom: 0.75rem; }
</style>
