---
import { SITE_URL } from '../../../config';
import Layout from '../../../layouts/Layout.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { getLanguagePaths } from '../../../i18n/routes';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const dictBean = {
  'tools.bean.script.fresh.title': t('tools.bean.script.fresh.title'),
  'tools.bean.script.fresh.desc': t('tools.bean.script.fresh.desc'),
  'tools.bean.script.fresh.advice': t('tools.bean.script.fresh.advice'),
  'tools.bean.script.peak.title': t('tools.bean.script.peak.title'),
  'tools.bean.script.peak.desc': t('tools.bean.script.peak.desc'),
  'tools.bean.script.peak.advice': t('tools.bean.script.peak.advice'),
  'tools.bean.script.mature.title': t('tools.bean.script.mature.title'),
  'tools.bean.script.mature.desc': t('tools.bean.script.mature.desc'),
  'tools.bean.script.mature.advice': t('tools.bean.script.mature.advice'),
  'tools.bean.script.stale.title': t('tools.bean.script.stale.title'),
  'tools.bean.script.stale.desc': t('tools.bean.script.stale.desc'),
  'tools.bean.script.stale.advice': t('tools.bean.script.stale.advice'),
};

// FAQ Structured Data for SEO Rich Snippets
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": t("tools.bean.faq.1.q"),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t("tools.bean.faq.1.a")
      }
    },
    {
      "@type": "Question",
      "name": t("tools.bean.faq.2.q"),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t("tools.bean.faq.2.a")
      }
    },
    {
      "@type": "Question",
      "name": "{t('tools.bean.h3_3')}",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": t("tools.bean.faq.3.a")
      }
    }
  ]
};

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": t("tools.bean.jsonld.name"),
  "description": t("tools.bean.jsonld.desc"),
  "applicationCategory": "Utility",
  "operatingSystem": "Web",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};

export function getStaticPaths() {
  return getLanguagePaths();
}
---

<Layout 
  title={t("tools.bean.meta.title")}
  description={t("tools.bean.meta.desc")}
  jsonld={[pageSchema, faqSchema]}
>
  <div class="max-w-4xl mx-auto py-8 sm:py-12 transition-all duration-500">
    
    <div class="text-center mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-coffee-gold/10 border border-coffee-gold/20 text-coffee-gold text-xs font-semibold uppercase tracking-widest mb-4">
        Freshness Tracker
      </div>
      <h1 class="font-display text-3xl sm:text-4xl font-bold tracking-tight text-coffee-light mb-4">
        {t("tools.bean.title")}
      </h1>
      <p class="text-sm text-coffee-muted max-w-2xl mx-auto leading-relaxed">
        {t("tools.bean.subtitle")}
      </p>
    </div>

    <!-- Top Leaderboard Ad -->
    <div class="mb-12">
      <AdSlot type="top-leaderboard" id="bean-fresh-top-ad" />
    </div>

    <div class="glass-card rounded-3xl p-6 sm:p-10 border border-coffee-sand/10 relative overflow-hidden mb-16">
      <div class="absolute top-0 start-0 w-full h-2 bg-coffee-darker" id="status-top-bar"></div>
      <div class="absolute top-0 end-0 w-64 h-64 bg-coffee-gold/5 blur-[100px] rounded-full -z-10 pointer-events-none" id="status-glow"></div>

      <!-- INPUT PANEL -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10 border-b border-coffee-sand/10 pb-10">
        <div class="flex flex-col gap-2">
          <label for="roast-date" class="text-xs font-semibold uppercase tracking-wider text-coffee-muted">{t('tools.bean.label.date')}</label>
          <div class="relative">
            <input type="date" id="roast-date" class="w-full bg-coffee-darker border border-coffee-sand/20 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-coffee-gold/50 focus:border-coffee-gold transition-colors text-coffee-light cursor-pointer" />
          </div>
        </div>

        <div class="flex flex-col gap-2">
          <label for="roast-level" class="text-xs font-semibold uppercase tracking-wider text-coffee-muted">{t("tools.bean.label.level")}</label>
          <select id="roast-level" class="w-full bg-coffee-darker border border-coffee-sand/20 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-coffee-gold/50 focus:border-coffee-gold transition-colors text-coffee-light cursor-pointer">
            <option value="light">{t("tools.bean.opt.light")}</option>
            <option value="medium" selected>{t("tools.bean.opt.medium")}</option>
            <option value="dark">{t("tools.bean.opt.dark")}</option>
          </select>
        </div>
      </div>

      <!-- OUTPUT PANEL -->
      <div id="result-panel" class="hidden animate-fade-in-up">
        
        <!-- Status Header -->
        <div class="flex flex-col md:flex-row items-center justify-between gap-6 mb-10">
          <div>
            <p class="text-xs font-semibold tracking-widest text-coffee-muted uppercase mb-1">{t("tools.bean.status.passed")}</p>
            <div class="flex items-baseline gap-2">
              <span id="days-elapsed" class="text-5xl md:text-6xl font-display font-black text-coffee-light drop-shadow-md tabular-nums">7</span>
              <span class="text-xl font-medium text-coffee-muted">{t("tools.bean.status.days")}</span>
            </div>
          </div>

          <div class="flex-1 max-w-sm w-full bg-coffee-darker/60 rounded-2xl p-5 border border-coffee-sand/10 shadow-inner">
            <p class="text-xs font-semibold tracking-widest text-coffee-muted uppercase mb-2">{t("tools.bean.status.current")}</p>
            <h2 id="status-title" class="text-2xl font-bold text-coffee-gold mb-2">{t("tools.bean.status.golden")}</h2>
            <p id="status-desc" class="text-sm text-coffee-light/80 leading-relaxed">
              {t("tools.bean.status.golden.desc")}
            </p>
          </div>
        </div>

        <!-- Visual Timeline -->
        <div class="mb-10">
          <h3 class="text-xs font-semibold tracking-widest text-coffee-muted uppercase mb-6 text-center">{t("tools.bean.graph.title")}</h3>
          
          <div class="relative w-full h-8 bg-coffee-darker rounded-full border border-coffee-sand/10 overflow-hidden mb-2 shadow-inner">
            <!-- Zones -->
            <div class="absolute inset-0 flex h-full">
              <div id="zone-fresh" class="h-full bg-blue-900/40 border-r border-coffee-darker relative group" style="width: 15%;">
                <div class="opacity-0 group-hover:opacity-100 absolute bottom-full mb-2 start-1/2 -translate-x-1/2 rtl:translate-x-1/2 whitespace-nowrap bg-coffee-dark text-coffee-light text-[10px] px-2 py-1 rounded">{t("tools.bean.graph.phase1")}</div>
              </div>
              <div id="zone-peak" class="h-full bg-coffee-gold/40 border-r border-coffee-darker relative group" style="width: 35%;">
                <div class="opacity-0 group-hover:opacity-100 absolute bottom-full mb-2 start-1/2 -translate-x-1/2 rtl:translate-x-1/2 whitespace-nowrap bg-coffee-dark text-coffee-light text-[10px] px-2 py-1 rounded">{t("tools.bean.status.golden")}</div>
              </div>
              <div id="zone-matured" class="h-full bg-orange-900/40 border-r border-coffee-darker relative group" style="width: 25%;">
                <div class="opacity-0 group-hover:opacity-100 absolute bottom-full mb-2 start-1/2 -translate-x-1/2 rtl:translate-x-1/2 whitespace-nowrap bg-coffee-dark text-coffee-light text-[10px] px-2 py-1 rounded">{t("tools.bean.graph.phase3")}</div>
              </div>
              <div id="zone-stale" class="h-full bg-red-900/20 relative group flex-1">
                <div class="opacity-0 group-hover:opacity-100 absolute bottom-full mb-2 start-1/2 -translate-x-1/2 rtl:translate-x-1/2 whitespace-nowrap bg-coffee-dark text-coffee-light text-[10px] px-2 py-1 rounded">{t("tools.bean.graph.phase4")}</div>
              </div>
            </div>

            <!-- Current Marker -->
            <div id="timeline-marker" class="absolute top-0 bottom-0 w-1.5 bg-white shadow-[0_0_10px_rgba(255,255,255,0.8)] z-10 transition-all duration-700 ease-out" style="left: 0%;">
              <div class="absolute -top-6 start-1/2 -translate-x-1/2 rtl:translate-x-1/2">
                <span class="bg-white text-black text-[9px] font-bold px-1.5 py-0.5 rounded shadow-lg whitespace-nowrap">TODAY</span>
              </div>
            </div>
          </div>

          <div class="flex justify-between text-[10px] font-mono text-coffee-muted/50 px-2">
            <span>Day 0</span>
            <span>Day 15</span>
            <span>Day 30</span>
            <span>Day 45+</span>
          </div>
        </div>

        <!-- Actionable Advice -->
        <div class="bg-coffee-dark border border-coffee-gold/20 rounded-2xl p-6 relative">
          <div class="absolute -top-3 start-6 bg-coffee-dark px-2 text-xs font-bold text-coffee-gold uppercase tracking-widest">
            {t("tools.bean.advice.title")}
          </div>
          <p id="action-advice" class="text-sm text-coffee-light/90 leading-relaxed mt-2">
            <!-- Injected via JS -->
          </p>
        </div>

      </div>

      <!-- Empty State -->
      <div id="empty-state" class="text-center py-12 opacity-100 transition-opacity">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-coffee-sand/20 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <p class="text-coffee-muted text-sm">{t("tools.bean.empty.prompt")}</p>
      </div>
    </div>

    <!-- In-Article Ad Placement -->
    <AdSlot type="in-article" id="bean-fresh-mid-ad" class="mb-16" />

    <!-- FAQ Accordion -->
    <div class="mt-8 mb-16">
      <h2 class="font-display text-2xl font-bold text-coffee-gold mb-8 text-center border-b border-coffee-sand/10 pb-4">{t("tools.bean.faq.title")}</h2>
      
      <div class="space-y-4">
        <!-- FAQ 1 -->
        <details class="group bg-coffee-darker/60 border border-coffee-sand/10 rounded-2xl overflow-hidden [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex items-center justify-between cursor-pointer p-6 font-medium text-coffee-light hover:text-coffee-gold transition-colors">
            {t("tools.bean.faq.1.q")}
            <span class="transition duration-300 group-open:-rotate-180">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <div class="px-6 pb-6 text-sm text-coffee-muted leading-relaxed">
            {t("tools.bean.faq.1.a_text")}
          </div>
        </details>

        <!-- FAQ 2 -->
        <details class="group bg-coffee-darker/60 border border-coffee-sand/10 rounded-2xl overflow-hidden [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex items-center justify-between cursor-pointer p-6 font-medium text-coffee-light hover:text-coffee-gold transition-colors">
            {t("tools.bean.faq.2.q")}
            <span class="transition duration-300 group-open:-rotate-180">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <div class="px-6 pb-6 text-sm text-coffee-muted leading-relaxed">
            {t('tools.bean.p5')}
          </div>
        </details>

        <!-- FAQ 3 -->
        <details class="group bg-coffee-darker/60 border border-coffee-sand/10 rounded-2xl overflow-hidden [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex items-center justify-between cursor-pointer p-6 font-medium text-coffee-light hover:text-coffee-gold transition-colors">
            {t("tools.bean.faq.3.q")}
            <span class="transition duration-300 group-open:-rotate-180">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <div class="px-6 pb-6 text-sm text-coffee-muted leading-relaxed">
            {t('tools.bean.p6')}
          </div>
        </details>
      </div>
    </div>

  </div>
</Layout>

<style>
  /* Custom Details Animation fallback */
  details > div {
    animation: slideDown 0.3s ease-out;
  }
  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script is:inline define:vars={{ dictBean }}>
  window.dictBean = dictBean;
</script>
<script>
  // Elements
  const roastDateInput = document.getElementById('roast-date') as HTMLInputElement;
  const roastLevelSelect = document.getElementById('roast-level') as HTMLSelectElement;
  
  const emptyState = document.getElementById('empty-state') as HTMLDivElement;
  const resultPanel = document.getElementById('result-panel') as HTMLDivElement;
  
  const daysElapsedEl = document.getElementById('days-elapsed') as HTMLSpanElement;
  const statusTitle = document.getElementById('status-title') as HTMLHeadingElement;
  const statusDesc = document.getElementById('status-desc') as HTMLParagraphElement;
  const actionAdvice = document.getElementById('action-advice') as HTMLParagraphElement;
  
  const timelineMarker = document.getElementById('timeline-marker') as HTMLDivElement;
  const topBar = document.getElementById('status-top-bar') as HTMLDivElement;
  const glow = document.getElementById('status-glow') as HTMLDivElement;
  
  const zoneFresh = document.getElementById('zone-fresh') as HTMLDivElement;
  const zonePeak = document.getElementById('zone-peak') as HTMLDivElement;
  const zoneMatured = document.getElementById('zone-matured') as HTMLDivElement;

  // Set max date to today
  const todayStr = new Date().toISOString().split('T')[0];
  roastDateInput.max = todayStr;

  function calculateFreshness() {
    if (!roastDateInput.value) {
      resultPanel.classList.add('hidden');
      emptyState.classList.remove('hidden');
      return;
    }

    const roastDate = new Date(roastDateInput.value);
    const today = new Date();
    
    // Calculate difference in days
    const diffTime = Math.abs(today.getTime() - roastDate.getTime());
    const daysElapsed = Math.floor(diffTime / (1000 * 60 * 60 * 24));
    
    daysElapsedEl.textContent = daysElapsed.toString();

    // Logic Rules based on Roast Level
    const roastLvl = roastLevelSelect.value;
    
    // Baseline: Light Roast needs more time to degas, Dark Roast degasses very fast.
    let boundaries = {
      freshEnd: 4,      // 0-4 days
      peakEnd: 18,      // 5-18 days
      matureEnd: 35,    // 19-35 days
    };

    if (roastLvl === 'light') {
      boundaries = { freshEnd: 7, peakEnd: 24, matureEnd: 45 };
    } else if (roastLvl === 'dark') {
      boundaries = { freshEnd: 2, peakEnd: 10, matureEnd: 21 };
    }

    // Update Visual Timeline Zones proportionally (Mapping 0 to 45 days max scale for the UI)
    // 45 days is our absolute 100% width reference for the bar.
    const maxDays = 45;
    
    const wFresh = (boundaries.freshEnd / maxDays) * 100;
    const wPeak = ((boundaries.peakEnd - boundaries.freshEnd) / maxDays) * 100;
    const wMatured = ((boundaries.matureEnd - boundaries.peakEnd) / maxDays) * 100;
    
    zoneFresh.style.width = `${Math.min(100, wFresh)}%`;
    zonePeak.style.width = `${Math.min(100, wPeak)}%`;
    zoneMatured.style.width = `${Math.min(100, wMatured)}%`;

    // Calculate Marker Position
    let markerPercent = (daysElapsed / maxDays) * 100;
    markerPercent = Math.max(0, Math.min(100, markerPercent)); // Clamp between 0-100%
    timelineMarker.style.left = `${markerPercent}%`;

    // Determine Status Text and Styling
    let title = "";
    let desc = "";
    let advice = "";
    let colorClass = ""; // For top bar and glow

    if (daysElapsed <= boundaries.freshEnd) {
      title = window.dictBean['tools.bean.script.fresh.title'];
      desc = window.dictBean['tools.bean.script.fresh.desc'];
      advice = window.dictBean['tools.bean.script.fresh.advice'];
      colorClass = "bg-blue-500";
    } else if (daysElapsed <= boundaries.peakEnd) {
      title = window.dictBean['tools.bean.script.peak.title'];
      desc = window.dictBean['tools.bean.script.peak.desc'];
      advice = window.dictBean['tools.bean.script.peak.advice'];
      colorClass = "bg-coffee-gold";
    } else if (daysElapsed <= boundaries.matureEnd) {
      title = window.dictBean['tools.bean.script.mature.title'];
      desc = window.dictBean['tools.bean.script.mature.desc'];
      advice = window.dictBean['tools.bean.script.mature.advice'];
      colorClass = "bg-orange-600";
    } else {
      title = window.dictBean['tools.bean.script.stale.title'];
      desc = window.dictBean['tools.bean.script.stale.desc'];
      advice = window.dictBean['tools.bean.script.stale.advice'];
      colorClass = "bg-red-600";
    }

    statusTitle.textContent = title;
    statusDesc.textContent = desc;
    
    // Simple markdown parsing for advice
    advice = advice.replace(/\*\*(.*?)\*\*/g, '<strong class="text-coffee-gold">$1</strong>');
    actionAdvice.innerHTML = advice;

    // Apply color themes
    topBar.className = `absolute top-0 start-0 w-full h-2 transition-colors duration-500 ${colorClass}`;
    glow.className = `absolute top-0 end-0 w-64 h-64 blur-[100px] rounded-full -z-10 pointer-events-none transition-colors duration-500 ${colorClass.replace('bg-', 'bg-').concat('/10')}`;

    // Show Results
    emptyState.classList.add('hidden');
    resultPanel.classList.remove('hidden');
  }

  roastDateInput.addEventListener('change', calculateFreshness);
  roastLevelSelect.addEventListener('change', calculateFreshness);

</script>
