---
import Layout from '../../layouts/Layout.astro';
import { getLanguagePaths } from '../../i18n/routes';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

export function getStaticPaths() {
  return getLanguagePaths();
}
---

<Layout
  title="{t('privacy.meta.title')}"
  description="{t('privacy.meta.desc')}"
>
  <div class="max-w-3xl mx-auto py-8 sm:py-12">
    <div class="mb-10 text-center">
      <h1 class="font-display text-3xl sm:text-4xl font-bold tracking-tight text-coffee-light mb-4">{t('privacy.title')}</h1>
      <p class="text-sm text-coffee-muted">{t('privacy.date')}</p>
    </div>

    <div class="glass-card rounded-2xl p-6 sm:p-10 prose prose-invert prose-coffee max-w-none">
      <p>
        {t('privacy.p1')}
      </p>

      <h2>{t('privacy.s1.title')}</h2>
      <p>
        {t('privacy.s1.p1')}
      </p>

      <h2>{t('privacy.s2.title')}</h2>
      <p>
        {t('privacy.s2.p1')}
      </p>

      <h3>{t('privacy.s2.sub')}</h3>
      <p>
        {t('privacy.s2.p2')}
      </p>
      <ul>
        <li>{t('privacy.s2.l1')}</li>
        <li>{t('privacy.s2.l2')}</li>
        <li>{t('privacy.s2.l3')}</li>
      </ul>

      <h2>{t('privacy.s3.title')}</h2>
      <p>
        {t('privacy.s3.p1')}
      </p>
      <ul>
        <li>{t('privacy.s3.l1')}</li>
        <li>{t('privacy.s3.l2')}</li>
      </ul>

      <h2>{t('privacy.s4.title')}</h2>
      <p>
        {t('privacy.s4.p1')}
      </p>

      <h2>{t('privacy.s5.title')}</h2>
      <p>
        {t('privacy.s5.p1')}
      </p>

      <h2>{t('privacy.s6.title')}</h2>
      <p>
        {t('privacy.s6.p1')}
      </p>
    </div>
  </div>
</Layout>
