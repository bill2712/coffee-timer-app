---
import Layout from '../../layouts/Layout.astro';
import { getLanguagePaths } from '../../i18n/routes';
import { getLangFromUrl } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const isZh = lang === 'zh-TW';

// Section bodies are trusted, static HTML written here (they contain links).
const link = (href: string, label: string) => `<a href="${href}" target="_blank" rel="noopener noreferrer" class="font-semibold text-coffee-gold underline underline-offset-4">${label}</a>`;
const internal = (path: string, label: string) => `<a href="/${lang}/${path}" class="font-semibold text-coffee-gold underline underline-offset-4">${label}</a>`;
const ADS_SETTINGS = 'https://adssettings.google.com/';
const PARTNER_SITES = 'https://policies.google.com/technologies/partner-sites';
const ABOUT_ADS = 'https://www.aboutads.info/choices/';
const YOUR_ONLINE_CHOICES = 'https://www.youronlinechoices.eu/';

const copy = isZh ? {
  title: '私隱政策',
  description: 'Barista Flow 的本機儲存（包括咖啡因計算器）、Google AdSense Cookie、第三方廣告、第三方請求及使用者控制說明。',
  updated: '更新日期：2026 年 10 月 31 日',
  intro: '本政策說明當你使用 Barista Flow 時，哪些資料會留在瀏覽器、哪些第三方資源可能收到一般網絡請求或設置 Cookie，以及你可以如何控制或刪除資料。',
  sections: [
    ['1. 不設帳戶，也不收集表單資料', '網站不提供註冊或登入，也沒有表單把資料送到伺服器。你主動寄來的電郵只會用於回覆你的查詢；問題回報亦可連到 GitHub，你在 GitHub 提交的內容受 GitHub 自身的條款與私隱政策規管。請勿在公開 Issues 張貼個人或敏感資料。'],
    ['2. 只在本機儲存的資料（localStorage）', `咖啡配方、沖煮紀錄、靜音設定、語言偏好和 PWA 提示狀態使用瀏覽器 localStorage 儲存在你的裝置。${internal('caffeine-calculator/', '咖啡因計算器')}的飲品紀錄（飲品、咖啡因毫克數、時間）、設定（睡覺時間、半衰期、上限、時間格式）及「支持我們」提示的關閉時間，同樣只儲存在 localStorage。${internal('focus/', '專注沖煮')}的專注紀錄（開始及結束時間、時長、模式、中斷次數及你自行填寫的任務名稱）、進行中的專注、連續日數及設定（包括環境聲音和音量）亦只儲存在 localStorage；你可以在統計頁匯出、匯入或清除。這些資料可能與健康有關，因此我們刻意不把它們上傳、不作分析，也不與任何人分享。你可以在計算器按「清除我的資料」，或清除本網站的瀏覽資料，隨時刪除。`],
    ['3. 分享連結與分享圖片', '當你主動使用「分享配方」時，咖啡豆名稱和沖煮參數會寫入網址查詢字串。咖啡因計算器的分享圖片完全在你的裝置上以瀏覽器繪製，只有在你選擇下載或透過系統分享功能傳送時才會離開裝置；圖片只包含總量、估算值和最後一杯時間。'],
    ['4. 通知、聲音與螢幕喚醒', '只有在你於專注沖煮開啟「通知我」時，網站才會向瀏覽器要求通知權限；通知由你的瀏覽器在本機顯示，內容只包括專注或休息已結束，我們不會使用推送伺服器，也不會收集通知訂閱資料。你隨時可在設定或瀏覽器中撤銷權限。環境聲音由 Web Audio API 即時生成，不會下載音訊檔案。專注期間，網站可能透過 Screen Wake Lock API 要求保持螢幕開啟，專注結束即會釋放。'],
    ['5. 第三方網絡請求', '頁面會從 Google Fonts 下載字型。除非你在私隱選擇中拒絕廣告 Cookie，頁面亦會在載入後於背景載入 Google AdSense 程式碼。Ko-fi 及 GitHub 只會在你點擊相關連結後才收到請求。這些供應商可能收到 IP 位址、瀏覽器類型、請求時間和來源頁等標準技術資料。請參閱相應供應商的私隱政策。'],
    ['6. Google AdSense 與廣告 Cookie', `本網站使用（或準備使用）Google AdSense 顯示廣告。Google 等第三方供應商會使用 Cookie，根據使用者過往瀏覽本網站或其他網站的紀錄投放廣告。Google 使用廣告 Cookie，令 Google 及其合作夥伴能根據使用者瀏覽本網站及／或互聯網上其他網站的情況投放廣告。你可以前往 ${link(ADS_SETTINGS, 'Google 廣告設定')} 停用個人化廣告，亦可前往 ${link(ABOUT_ADS, 'aboutads.info')} 或 ${link(YOUR_ONLINE_CHOICES, 'Your Online Choices')} 停用其他第三方供應商的個人化廣告 Cookie。了解 Google 如何使用資料，請參閱 ${link(PARTNER_SITES, 'Google 如何使用合作夥伴網站的資料')}。`],
    ['7. 第三方廣告與目前狀態', '廣告由 Google 及其認證的第三方廣告供應商提供，並會清楚標示為「廣告」；廣告內容不會影響計算器結果或編輯內容，我們不會把你的咖啡因紀錄或任何本機資料提供給廣告商。專注進行期間絕不顯示廣告。網站在審核期間不顯示廣告單元。首次瀏覽時會顯示私隱選擇：選擇「拒絕廣告 Cookie」後，網站不會再載入 AdSense 程式碼；未作選擇前，只會要求非個人化廣告；選擇「接受」後才可能提供個人化廣告。你可隨時在頁尾「Cookie 設定」更改。啟用廣告前，我們亦會在適用地區（例如歐洲經濟區、英國及瑞士）配置 Google 認證的同意管理平台。網站目前沒有載入 Google Analytics。'],
    ['8. 支持連結', '「請我飲杯咖啡」按鈕會開啟 Ko-fi 或 Buy Me a Coffee 等外部網站。我們不會收到你的付款資料；你在這些網站提供的資料受其私隱政策規管。'],
    ['9. 保安與資料保留', '網站是靜態頁面，沒有 Barista Flow 使用者資料庫。咖啡因計算器只保留最近約 72 小時、仍會影響估算的飲品紀錄，較舊的紀錄會在你下次開啟頁面時自動刪除。公開原始碼及修正紀錄可供檢視；安全問題應使用 GitHub 的私密漏洞回報。'],
    ['10. 聯絡', `如對本政策有疑問，請電郵 hello@coffeetimer.online，或使用${internal('contact', '聯絡與回報問題')}頁面的公開或私密回報渠道。`]
  ]
} : {
  title: 'Privacy policy',
  description: 'How Barista Flow handles local storage (including the caffeine calculator), Google AdSense cookies, third-party advertising, external requests and your controls.',
  updated: 'Updated: 31 October 2026',
  intro: 'This policy explains what stays in your browser when you use Barista Flow, which external services may receive ordinary network requests or set cookies, and how you can control or delete data.',
  sections: [
    ['1. No accounts or submitted form data', 'The site has no registration or login and no form that sends data to a server. Emails you choose to send are used only to reply to you. Issue reporting can also link to GitHub, where anything you submit is governed by GitHub’s terms and privacy policy. Do not post personal or sensitive information in public issues.'],
    ['2. Data stored only on your device (localStorage)', `Coffee recipes, brew logs, mute state, language preference and PWA prompt state use browser localStorage on your device. The ${internal('caffeine-calculator/', 'caffeine calculator')} stores your drink log (drink, milligrams of caffeine, time), your settings (bedtime, half-life, thresholds, time format) and when you dismissed the support card in localStorage too. ${internal('focus/', 'Brew Focus')} stores your focus sessions (start and end time, length, mode, interruptions and any task label you type), an in-progress session, your streak and your settings (including ambient sound and volume) in localStorage as well; export, import or clear them on its stats page. Because this information can relate to your health, we deliberately never upload, analyse or share it. Delete it at any time with “Clear my data” in the calculator or by clearing this site’s browsing data.`],
    ['3. Shared links and share images', 'When you choose “share recipe”, the bean name and brew parameters are placed in the URL query string. Caffeine share images are drawn entirely in your browser and only leave your device if you choose to download them or send them with your device’s share feature; they contain only totals, estimates and your last-call time.'],
    ['4. Notifications, sound and screen wake', 'Notification permission is requested only when you switch on “Notify me” in Brew Focus. Notifications are shown locally by your browser and only say that a focus block or break has ended; there is no push server and no notification subscription data is collected. You can revoke the permission at any time in the setting or your browser. Ambient sounds are generated live with the Web Audio API — no audio files are downloaded. During a session the site may use the Screen Wake Lock API to keep your screen on; the lock is released when the session ends.'],
    ['5. Third-party network requests', 'Pages download fonts from Google Fonts. Unless you decline ad cookies in the privacy choice, the Google AdSense script is also loaded in the background after the page has loaded. Ko-fi and GitHub only receive a request when you follow a link to them. These providers may receive standard technical request data such as IP address, browser type, request time and referring page. Consult each provider’s privacy policy.'],
    ['6. Google AdSense and advertising cookies', `This site uses (or is preparing to use) Google AdSense to show ads. Third-party vendors, including Google, use cookies to serve ads based on a user’s prior visits to this website or other websites. Google’s use of advertising cookies enables it and its partners to serve ads to users based on their visit to this site and/or other sites on the Internet. You may opt out of personalised advertising by visiting ${link(ADS_SETTINGS, 'Google Ads Settings')}. You can also opt out of some third-party vendors’ use of cookies for personalised advertising at ${link(ABOUT_ADS, 'aboutads.info')} or ${link(YOUR_ONLINE_CHOICES, 'Your Online Choices')}. To learn more, see ${link(PARTNER_SITES, 'how Google uses information from sites that use its services')}.`],
    ['7. Third-party advertising and current status', 'Ads are provided by Google and certified third-party ad vendors and are clearly labelled “Advertisement”. Advertising never influences calculator results or editorial content, and we never give advertisers your caffeine log or any other locally stored data. Ads are never shown during a running focus session. Ad units are not displayed while the site is under review. A privacy choice appears on your first visit: after “Decline ad cookies”, the site stops loading AdSense code; before you choose, only non-personalised ads may be requested; personalised ads are possible only after “Accept”. Change your choice at any time with “Cookie settings” in the footer. Before ads are enabled, a Google-certified consent management platform will also be configured where required (for example in the EEA, the UK and Switzerland). The site does not currently load Google Analytics.'],
    ['8. Support links', '“Buy me a coffee” buttons open external sites such as Ko-fi or Buy Me a Coffee. We never receive your payment details; anything you provide there is governed by that site’s privacy policy.'],
    ['9. Security and retention', 'This is a static site with no Barista Flow user database. The caffeine calculator keeps only the last ~72 hours of drinks that can still affect its estimate; older entries are deleted automatically the next time you open it. Source and fix history are public for review. Security concerns should use GitHub private vulnerability reporting, not a public issue.'],
    ['10. Contact', `For questions about this policy, email hello@coffeetimer.online or use the public or private channels on the ${internal('contact', 'contact and issue reporting')} page.`]
  ]
};

export function getStaticPaths() {
  return getLanguagePaths();
}
---

<Layout title={`${copy.title} | Barista Flow`} description={copy.description}>
  <article class="max-w-3xl mx-auto py-10 sm:py-16">
    <header class="mb-12">
      <h1 class="font-display text-4xl sm:text-5xl font-bold text-coffee-light mb-4">{copy.title}</h1>
      <p class="text-xs text-coffee-muted mb-6">{copy.updated}</p>
      <p class="text-coffee-sand/90 leading-7">{copy.intro}</p>
    </header>

    <div class="space-y-5">
      {copy.sections.map(([heading, body]) => (
        <section class="glass-card rounded-3xl border border-coffee-sand/10 p-7 sm:p-8">
          <h2 class="font-display text-xl font-bold text-coffee-light mb-3">{heading}</h2>
          <p class="text-sm text-coffee-sand/85 leading-7" set:html={body} />
        </section>
      ))}
    </div>
  </article>
</Layout>
