---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getLanguagePaths } from '../../i18n/routes';
import { getLangFromUrl } from '../../i18n/utils';

export function getStaticPaths() { return getLanguagePaths(); }

const lang = getLangFromUrl(Astro.url);
const isZh = lang === 'zh-TW';
const base = `${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/${lang}`;
const c = isZh ? {
  title: '首五杯新手訓練 | Barista Flow', desc: '用五杯咖啡逐步學會比例、研磨、注水流速、水溫及 A/B 比較；每杯只集中一個變數。', crumb: '首五杯訓練',
  eyebrow: '循序學習', h1: '用五杯咖啡，建立自己的沖煮方法', intro: '不用一次學完整個知識庫。每杯只處理一個新概念，完成味道記錄後才解鎖下一杯。',
  progress: '訓練進度', complete: '已完成', current: '現在進行', locked: '完成上一杯後解鎖', start: '開始這杯', repeat: '再次練習', continue: '繼續未完成的一杯', records: '查看訓練紀錄', reset: '重新開始五杯訓練', resetConfirm: '確定清除五杯訓練進度？沖煮紀錄不會刪除。',
  lessons: [
    ['建立基準杯', '只使用 15g、1:15、92°C 的可靠起點，完成第一份味道記錄。', '學會把配方和感受記下來。'],
    ['只改研磨一格', '其他參數沿用上一杯，只把研磨改一小格，觀察流速與酸苦變化。', '學會單一變項測試。'],
    ['追蹤實際注水', '每次到達目標水量便按一下，讓計時器按實際節奏調整後續提示。', '學會分辨預定與實際操作。'],
    ['只改水溫 2°C', '沿用上一杯配方，只改水溫 2°C，觀察香氣、酸質和苦感。', '學會用水溫作小幅修正。'],
    ['完成第一次 A/B', '再沖一杯並比較兩個版本，把較好的版本儲存為個人配方。', '完成屬於你的第一個可重現配方。']
  ]
} : {
  title: 'First Five Brews | Barista Flow', desc: 'Learn ratio, grind, pour timing, temperature, and A/B comparison over five focused brews, changing one variable at a time.', crumb: 'First Five Brews',
  eyebrow: 'Guided learning', h1: 'Build your own method in five brews', intro: 'You do not need to learn the whole library at once. Each brew introduces one concept, and the next unlocks after you save the taste result.',
  progress: 'Course progress', complete: 'Completed', current: 'Current brew', locked: 'Complete the previous brew to unlock', start: 'Start this brew', repeat: 'Practise again', continue: 'Continue the current brew', records: 'View training records', reset: 'Restart the five-brew course', resetConfirm: 'Clear course progress? Your brew records will not be deleted.',
  lessons: [
    ['Create a baseline', 'Use the reliable 15g, 1:15, 92°C starting point and save your first taste record.', 'Learn to connect a recipe with what you taste.'],
    ['Move the grind one step', 'Keep every other parameter and move the grind by one small step. Watch flow and flavour.', 'Learn a one-variable test.'],
    ['Track the real pour', 'Tap whenever you reach each target weight, so later prompts adapt to your actual pace.', 'Learn the difference between planned and actual technique.'],
    ['Change only 2°C', 'Keep the previous recipe and move water temperature by 2°C. Observe aroma, acidity, and bitterness.', 'Learn a small temperature correction.'],
    ['Complete your first A/B', 'Brew once more, compare two versions, and save the better one as a personal recipe.', 'Finish your first reproducible personal recipe.']
  ]
};
---

<Layout title={c.title} description={c.desc}>
  <div class="mx-auto max-w-5xl py-8 sm:py-12">
    <div class="flex justify-center"><Breadcrumbs items={[{ label: c.crumb }]} /></div>
    <header class="mx-auto mt-5 max-w-3xl text-center">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-coffee-gold">{c.eyebrow}</p>
      <h1 class="mt-3 text-balance font-display text-4xl font-bold leading-tight text-coffee-light sm:text-5xl">{c.h1}</h1>
      <p class="mx-auto mt-4 max-w-2xl text-pretty text-base leading-7 text-coffee-sand/80">{c.intro}</p>
    </header>

    <section class="mx-auto mt-10 max-w-3xl rounded-2xl border border-coffee-gold/25 bg-coffee-gold/5 p-5" aria-labelledby="course-progress-title">
      <div class="flex items-end justify-between gap-4">
        <div><p id="course-progress-title" class="text-xs font-bold uppercase tracking-wider text-coffee-gold">{c.progress}</p><p id="course-progress-copy" class="mt-1 text-sm text-coffee-sand" aria-live="polite">0 / 5</p></div>
        <span id="course-percent" class="font-display text-3xl font-bold text-coffee-light">0%</span>
      </div>
      <div class="mt-4 h-2 overflow-hidden rounded-full bg-coffee-darker"><div id="course-progress-bar" class="h-full w-0 rounded-full bg-coffee-gold transition-[width] duration-500"></div></div>
      <div class="mt-5 flex flex-col gap-3 sm:flex-row">
        <button id="btn-course-continue" type="button" class="min-h-[48px] flex-1 rounded-xl bg-coffee-gold px-5 text-sm font-bold text-coffee-dark hover:bg-coffee-gold-hover">{c.continue}</button>
        <a href={`${base}/history`} class="inline-flex min-h-[48px] flex-1 items-center justify-center rounded-xl border border-coffee-sand/20 px-5 text-sm font-semibold text-coffee-sand hover:text-coffee-light">{c.records}</a>
      </div>
    </section>

    <ol class="mx-auto mt-8 grid max-w-3xl gap-4">
      {c.lessons.map((lesson, index) => (
        <li class="lesson-card rounded-2xl border border-coffee-sand/12 bg-coffee-darker/55 p-5 transition-colors" data-lesson={index + 1}>
          <div class="flex gap-4">
            <span class="lesson-number flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-coffee-sand/20 bg-coffee-dark font-bold text-coffee-sand">{index + 1}</span>
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center justify-between gap-2"><h2 class="font-display text-xl font-bold text-coffee-light">{lesson[0]}</h2><span class="lesson-status text-[10px] font-bold uppercase tracking-wider text-coffee-muted">{c.locked}</span></div>
              <p class="mt-2 text-sm leading-6 text-coffee-sand/80">{lesson[1]}</p>
              <p class="mt-3 rounded-lg border border-coffee-sand/10 bg-coffee-dark/50 px-3 py-2 text-xs leading-5 text-coffee-muted">{lesson[2]}</p>
              <button type="button" class="lesson-start mt-4 hidden min-h-[46px] w-full rounded-xl border border-coffee-gold/35 px-4 text-sm font-bold text-coffee-gold hover:bg-coffee-gold/10 disabled:cursor-not-allowed disabled:opacity-40" data-start-lesson={index + 1}>{c.start}</button>
            </div>
          </div>
        </li>
      ))}
    </ol>

    <div class="mx-auto mt-8 max-w-3xl text-center"><button id="btn-reset-course" type="button" class="min-h-[44px] px-4 text-xs font-semibold text-coffee-muted underline decoration-coffee-sand/30 underline-offset-4 hover:text-coffee-light">{c.reset}</button></div>
  </div>
</Layout>

<script is:inline define:vars={{ pageCopy: { complete: c.complete, current: c.current, locked: c.locked, start: c.start, repeat: c.repeat, resetConfirm: c.resetConfirm }, homeUrl: `${base}/`, grinderUrl: `${base}/tools/grinder-calibration?training=2` }}>
  document.addEventListener('DOMContentLoaded', () => {
    const COURSE_KEY = 'barista_flow_training_v1';
    const ACTIVE_KEY = 'barista_flow_active_lesson_v1';
    const PROFILE_KEY = 'barista_flow_grinder_profile_v1';
    const readJson = (key, fallback) => { try { return JSON.parse(localStorage.getItem(key) || '') || fallback; } catch (error) { return fallback; } };
    const logs = readJson('barista_flow_logs', []);
    const stored = readJson(COURSE_KEY, {});
    const derived = Array.isArray(logs) ? logs.map((log) => Number(log?.trainingLesson)).filter((value) => value >= 1 && value <= 5) : [];
    const completed = Array.from(new Set([...(Array.isArray(stored.completed) ? stored.completed : []), ...derived])).filter((value) => value >= 1 && value <= 5).sort();
    const firstIncomplete = [1, 2, 3, 4, 5].find((lesson) => !completed.includes(lesson)) || 5;
    const progress = { version: 1, completed, activeCup: firstIncomplete, startedAt: stored.startedAt || new Date().toISOString(), updatedAt: new Date().toISOString() };
    try { localStorage.setItem(COURSE_KEY, JSON.stringify(progress)); } catch (error) {}

    const updateUi = () => {
      const count = completed.length;
      document.getElementById('course-progress-copy').textContent = `${count} / 5`;
      document.getElementById('course-percent').textContent = `${count * 20}%`;
      document.getElementById('course-progress-bar').style.width = `${count * 20}%`;
      document.querySelectorAll('.lesson-card').forEach((card) => {
        const lesson = Number(card.dataset.lesson);
        const done = completed.includes(lesson);
        const current = lesson === firstIncomplete;
        const available = done || current;
        const status = card.querySelector('.lesson-status');
        const button = card.querySelector('.lesson-start');
        const number = card.querySelector('.lesson-number');
        card.classList.toggle('border-green-400/30', done);
        card.classList.toggle('border-coffee-gold/45', current && !done);
        card.classList.toggle('opacity-55', !available);
        number?.classList.toggle('bg-green-400', done);
        number?.classList.toggle('text-coffee-dark', done);
        if (status) { status.textContent = done ? pageCopy.complete : current ? pageCopy.current : pageCopy.locked; status.className = `lesson-status text-[10px] font-bold uppercase tracking-wider ${done ? 'text-green-300' : current ? 'text-coffee-gold' : 'text-coffee-muted'}`; }
        if (button) { button.classList.toggle('hidden', !available); button.disabled = !available; button.textContent = done ? pageCopy.repeat : pageCopy.start; }
      });
    };

    const startLesson = (lesson) => {
      const recent = Array.isArray(logs) ? logs.find((log) => log?.recipe) : null;
      const baseRecipe = recent?.recipe ? { ...recent.recipe } : { beanName: document.documentElement.lang === 'zh-TW' ? '五杯訓練豆' : 'Five-brew training coffee', roastLevel: 'medium', grindSize: document.documentElement.lang === 'zh-TW' ? '中細研磨' : 'Medium-fine', waterTemp: 92, coffeeWeight: 15, waterRatio: 15, totalWater: 225 };
      const profile = readJson(PROFILE_KEY, null);
      const active = { version: 1, lesson, startedAt: new Date().toISOString() };
      try { localStorage.setItem(ACTIVE_KEY, JSON.stringify(active)); } catch (error) {}
      if (lesson === 1) Object.assign(baseRecipe, { grindSize: document.documentElement.lang === 'zh-TW' ? '中細研磨' : 'Medium-fine', waterTemp: 92, coffeeWeight: 15, waterRatio: 15, totalWater: 225 });
      if (lesson === 2 && (!profile || !Number.isFinite(Number(profile.currentSetting)))) {
        window.location.href = grinderUrl;
        return;
      }
      if (lesson === 2 && profile && Number.isFinite(Number(profile.currentSetting))) {
        const direction = profile.finerDirection === 'higher' ? 1 : -1;
        const unclamped = Number(profile.currentSetting) + direction * (Number(profile.increment) || 1);
        const minSetting = Number.isFinite(Number(profile.minSetting)) ? Number(profile.minSetting) : 0;
        const maxSetting = Number.isFinite(Number(profile.maxSetting)) ? Number(profile.maxSetting) : 100;
        const next = Math.min(maxSetting, Math.max(minSetting, unclamped));
        baseRecipe.grindSize = `${String(profile.model || 'Grinder').slice(0, 40)} · ${Math.round(next * 100) / 100}`;
        profile.currentSetting = next;
        profile.recommendedSetting = next;
        profile.updatedAt = new Date().toISOString();
        try { localStorage.setItem(PROFILE_KEY, JSON.stringify(profile)); } catch (error) {}
      }
      if (lesson === 4) baseRecipe.waterTemp = Number(baseRecipe.waterTemp) >= 94 ? Number(baseRecipe.waterTemp) - 2 : Number(baseRecipe.waterTemp) + 2;
      baseRecipe.totalWater = Math.round(Number(baseRecipe.coffeeWeight || 15) * Number(baseRecipe.waterRatio || 15));
      const params = new URLSearchParams({ lesson: String(lesson), bean: String(baseRecipe.beanName || ''), roast: String(baseRecipe.roastLevel || 'medium'), grind: String(baseRecipe.grindSize || ''), t: String(baseRecipe.waterTemp || 92), w: String(baseRecipe.coffeeWeight || 15), r: String(baseRecipe.waterRatio || 15) });
      window.location.href = `${homeUrl}?${params.toString()}#brew-start`;
    };

    document.querySelectorAll('[data-start-lesson]').forEach((button) => button.addEventListener('click', () => startLesson(Number(button.dataset.startLesson))));
    document.getElementById('btn-course-continue')?.addEventListener('click', () => startLesson(firstIncomplete));
    document.getElementById('btn-reset-course')?.addEventListener('click', () => { if (!window.confirm(pageCopy.resetConfirm)) return; try { localStorage.removeItem(COURSE_KEY); localStorage.removeItem(ACTIVE_KEY); } catch (error) {} window.location.reload(); });
    updateUi();
  });
</script>
