---
import Layout from '../../layouts/Layout.astro';
import { getLanguagePaths } from '../../i18n/routes';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

export function getStaticPaths() {
  return getLanguagePaths();
}
---

<Layout
  title="{t('contact.meta.title')}"
  description="{t('contact.meta.desc')}"
>
  <div class="max-w-3xl mx-auto py-8 sm:py-12">
    <div class="mb-10 text-center">
      <h1 class="font-display text-3xl sm:text-4xl font-bold tracking-tight text-coffee-light mb-4">{t('contact.title')}</h1>
      <p class="text-sm text-coffee-muted">{t('contact.subtitle')}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-5 gap-8">
      
      <!-- Contact Info -->
      <div class="md:col-span-2 flex flex-col gap-6">
        <div class="glass-card rounded-2xl p-6">
          <h3 class="font-display text-lg font-bold text-coffee-gold mb-2">{t('contact.business.title')}</h3>
          <p class="text-sm text-coffee-muted leading-relaxed mb-4">
            {t('contact.business.desc')}
          </p>
          <a href="mailto:business@baristaflow.com" class="text-sm font-semibold text-coffee-sand hover:text-coffee-light transition-colors flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            business@baristaflow.com
          </a>
        </div>

        <div class="glass-card rounded-2xl p-6">
          <h3 class="font-display text-lg font-bold text-coffee-gold mb-2">{t('contact.support.title')}</h3>
          <p class="text-sm text-coffee-muted leading-relaxed mb-4">
            {t('contact.support.desc')}
          </p>
          <a href="mailto:support@baristaflow.com" class="text-sm font-semibold text-coffee-sand hover:text-coffee-light transition-colors flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
            </svg>
            support@baristaflow.com
          </a>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="md:col-span-3 glass-card rounded-2xl p-6 sm:p-8">
        <form id="contact-form" class="space-y-5" onsubmit="alert(t('contact.form.alert')); this.reset(); return false;">
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div class="flex flex-col gap-1.5">
              <label for="name" class="text-xs font-semibold uppercase tracking-wider text-coffee-sand">{t('contact.form.name')}</label>
              <input
                type="text"
                id="name"
                required
                placeholder={t('contact.form.namePlaceholder')}
                class="w-full bg-coffee-darker border border-coffee-sand/15 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-coffee-gold transition-colors text-coffee-light"
              />
            </div>
            
            <div class="flex flex-col gap-1.5">
              <label for="email" class="text-xs font-semibold uppercase tracking-wider text-coffee-sand">{t('contact.form.email')}</label>
              <input
                type="email"
                id="email"
                required
                placeholder={t('contact.form.emailPlaceholder')}
                class="w-full bg-coffee-darker border border-coffee-sand/15 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-coffee-gold transition-colors text-coffee-light"
              />
            </div>
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="subject" class="text-xs font-semibold uppercase tracking-wider text-coffee-sand">{t('contact.form.subject')}</label>
            <select
              id="subject"
              class="w-full bg-coffee-darker border border-coffee-sand/15 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-coffee-gold transition-colors text-coffee-light appearance-none cursor-pointer"
            >
              <option value="feedback">{t('contact.form.opt.feedback')}</option>
              <option value="bug">{t('contact.form.opt.bug')}</option>
              <option value="business">{t('contact.form.opt.business')}</option>
              <option value="other">{t('contact.form.opt.other')}</option>
            </select>
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="message" class="text-xs font-semibold uppercase tracking-wider text-coffee-sand">{t('contact.form.message')}</label>
            <textarea
              id="message"
              required
              rows="5"
              placeholder={t('contact.form.messagePlaceholder')}
              class="w-full bg-coffee-darker border border-coffee-sand/15 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-coffee-gold transition-colors text-coffee-light resize-none custom-scrollbar"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full bg-gradient-to-r from-coffee-accent to-coffee-gold hover:from-coffee-gold hover:to-coffee-gold-hover text-coffee-dark font-semibold tracking-wide rounded-lg py-3 shadow-lg transition-all duration-300 transform active:scale-[0.98] cursor-pointer text-sm"
          >
            {t('contact.form.submit')}
          </button>
        </form>
      </div>

    </div>
  </div>
</Layout>

<style>
  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: rgba(42, 36, 32, 0.5);
    border-radius: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(197, 168, 128, 0.3);
    border-radius: 4px;
  }
</style>
