---
import Layout from '../../layouts/Layout.astro';
import { getLanguagePaths } from '../../i18n/routes';
import { getLangFromUrl } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const isZh = lang === 'zh-TW';
const copy = isZh ? {
  title: '聯絡與回報問題',
  description: '透過公開的 GitHub 專案回報 Barista Flow 錯誤、提出功能建議或檢視修正進度。',
  intro: '這是一個免費、開源的瀏覽器工具。為避免展示一個實際不會送出的表單，我們把問題回報集中到公開的 GitHub 專案，讓每個回報都有可追蹤的處理紀錄。',
  bugTitle: '回報功能錯誤',
  bugBody: '請寫下使用的裝置、瀏覽器、操作步驟，以及你預期和實際看到的結果。請勿公開張貼個人資料、密碼或任何敏感資訊。',
  bugButton: '建立問題回報',
  securityTitle: '私下回報安全漏洞',
  securityBody: '安全漏洞不應張貼在公開 Issues。請使用 GitHub 的私密漏洞回報，只有專案維護者能看到內容。',
  securityButton: '私密回報漏洞',
  codeTitle: '查看原始碼與修正紀錄',
  codeBody: '所有網站程式、版本紀錄和已知問題都可以公開檢視。你可以先搜尋是否已有相同問題，再新增回報。',
  codeButton: '前往 GitHub 專案',
  response: '回報通常會在 GitHub 上回覆；處理時間會依問題複雜度而異。'
} : {
  title: 'Contact and issue reporting',
  description: 'Report Barista Flow bugs, request features, or review fixes through the public GitHub project.',
  intro: 'Barista Flow is a free, open-source browser tool. Instead of presenting a form that does not actually send, we route reports to the public GitHub project so every issue has a traceable status.',
  bugTitle: 'Report a functional bug',
  bugBody: 'Include your device, browser, steps to reproduce, and the expected and actual result. Do not post personal information, passwords, or other sensitive data publicly.',
  bugButton: 'Create an issue',
  securityTitle: 'Report a vulnerability privately',
  securityBody: 'Do not post security vulnerabilities in public issues. Use GitHub private vulnerability reporting so only the project maintainers can read the report.',
  securityButton: 'Send a private report',
  codeTitle: 'Review source and fixes',
  codeBody: 'The site source, version history, and known issues are public. Search for an existing report before opening a new one.',
  codeButton: 'Open the GitHub project',
  response: 'Replies are normally posted on GitHub; timing depends on the complexity of the issue.'
};

export function getStaticPaths() {
  return getLanguagePaths();
}
---

<Layout title={`${copy.title} | Barista Flow`} description={copy.description}>
  <article class="max-w-4xl mx-auto py-10 sm:py-16">
    <header class="max-w-2xl mb-10 sm:mb-14">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-coffee-gold mb-4">Barista Flow</p>
      <h1 class="font-display text-4xl sm:text-5xl font-bold text-coffee-light mb-5">{copy.title}</h1>
      <p class="text-coffee-sand/90 leading-relaxed">{copy.intro}</p>
    </header>

    <div class="grid md:grid-cols-2 gap-6">
      <section class="glass-card rounded-3xl border border-coffee-sand/10 p-7 sm:p-8">
        <h2 class="font-display text-2xl font-bold text-coffee-light mb-4">{copy.bugTitle}</h2>
        <p class="text-sm text-coffee-sand/80 leading-relaxed mb-7">{copy.bugBody}</p>
        <a
          href="https://github.com/bill2712/coffee-timer-app/issues/new/choose"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-xl bg-coffee-gold px-5 py-3 text-sm font-bold text-coffee-dark hover:bg-coffee-gold-hover transition-colors"
        >
          {copy.bugButton}<span aria-hidden="true" class="ms-2">↗</span>
        </a>
      </section>

      <section class="glass-card rounded-3xl border border-coffee-sand/10 p-7 sm:p-8">
        <h2 class="font-display text-2xl font-bold text-coffee-light mb-4">{copy.securityTitle}</h2>
        <p class="text-sm text-coffee-sand/80 leading-relaxed mb-7">{copy.securityBody}</p>
        <a
          href="https://github.com/bill2712/coffee-timer-app/security/advisories/new"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-xl border border-red-300/50 px-5 py-3 text-sm font-bold text-red-200 hover:bg-red-300/10 transition-colors"
        >
          {copy.securityButton}<span aria-hidden="true" class="ms-2">↗</span>
        </a>
      </section>

      <section class="glass-card rounded-3xl border border-coffee-sand/10 p-7 sm:p-8 md:col-span-2">
        <h2 class="font-display text-2xl font-bold text-coffee-light mb-4">{copy.codeTitle}</h2>
        <p class="text-sm text-coffee-sand/80 leading-relaxed mb-7">{copy.codeBody}</p>
        <a
          href="https://github.com/bill2712/coffee-timer-app"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-xl border border-coffee-gold/50 px-5 py-3 text-sm font-bold text-coffee-gold hover:bg-coffee-gold/10 transition-colors"
        >
          {copy.codeButton}<span aria-hidden="true" class="ms-2">↗</span>
        </a>
      </section>
    </div>

    <p class="mt-8 text-xs text-coffee-muted">{copy.response}</p>
  </article>
</Layout>
