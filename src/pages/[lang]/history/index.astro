---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { getLanguagePaths } from '../../../i18n/routes';

export function getStaticPaths() {
  return getLanguagePaths();
}
---

<Layout 
  title="我的沖煮紀錄 | Barista Flow"
  description="檢視您所有的咖啡沖煮紀錄與風味品鑑，打造專屬您的咖啡日誌。"
>
  <div class="max-w-4xl mx-auto py-12">
    <!-- Breadcrumb -->
    <div class="flex justify-center">
      <Breadcrumbs items={[
        { label: '首頁', url: '/' },
        { label: '我的沖煮紀錄' }
      ]} />
    </div>

    <!-- Header & Actions -->
    <header class="text-center mb-12 relative mt-4 flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="text-start">
        <h1 class="font-display text-3xl sm:text-4xl font-bold tracking-tight text-coffee-light mb-2">
          沖煮<span class="text-transparent bg-clip-text bg-gradient-to-r from-coffee-gold to-coffee-sand">日誌</span>
        </h1>
        <p class="text-sm text-coffee-sand/80 font-light">
          記錄每次萃取的風味細節，尋找您的完美金杯。
        </p>
      </div>
      
      <div class="flex gap-4">
        <button id="btn-export-csv" class="hidden px-5 py-2.5 rounded-xl border border-coffee-gold/40 text-coffee-gold hover:bg-coffee-gold/10 transition-colors text-sm font-semibold tracking-wide items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          匯出 CSV
        </button>
      </div>
    </header>

    <!-- History Grid Container -->
    <div id="history-container" class="grid grid-cols-1 md:grid-cols-2 gap-6 relative min-h-[300px]">
      <!-- Loading Skeleton (Optional) -->
      <div id="history-loading" class="col-span-1 md:col-span-2 flex justify-center items-center absolute inset-0 text-coffee-sand/50">
        <svg class="animate-spin h-8 w-8" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
      </div>
      
      <!-- Empty State -->
      <div id="history-empty" class="col-span-1 md:col-span-2 hidden flex-col items-center justify-center py-20 text-center backdrop-blur-md bg-coffee-darker/60 rounded-3xl border border-coffee-sand/10 shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-coffee-sand/30 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
        </svg>
        <h3 class="text-xl font-bold text-coffee-light mb-2">目前沒有沖煮紀錄</h3>
        <p class="text-sm text-coffee-sand/80 max-w-md mx-auto mb-8 leading-relaxed">
          完成一次咖啡沖煮並填寫風味品鑑後，您的日誌將會顯示在這裡。
        </p>
        <a href={`${import.meta.env.BASE_URL}/`} class="inline-flex items-center gap-2 px-8 py-3 rounded-xl bg-gradient-to-r from-coffee-gold to-coffee-sand text-coffee-dark hover:from-coffee-gold-hover hover:to-coffee-gold shadow-lg shadow-coffee-gold/20 hover:-translate-y-0.5 active:scale-95 transition-all duration-300 text-sm font-bold tracking-wide">
          開始沖煮
        </a>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Setup data interfaces
  interface LogEntry {
    id: string;
    date: string;
    recipe: {
      beanName: string;
      roastLevel: string;
      coffeeWeight: number;
      totalWater: number;
    };
    evaluation: {
      acidity: number;
      bitterness: number;
      body: number;
      notes: string;
    };
  }

  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('history-container');
    const loading = document.getElementById('history-loading');
    const emptyState = document.getElementById('history-empty');
    const btnExport = document.getElementById('btn-export-csv');

    let logs: LogEntry[] = [];

    // Load data from localStorage
    try {
      const stored = localStorage.getItem('barista_flow_logs');
      if (stored) {
        logs = JSON.parse(stored);
      }
    } catch (e) {
      console.error('Failed to parse history logs', e);
    }

    loading?.remove();

    if (logs.length === 0) {
      emptyState?.classList.remove('hidden');
      emptyState?.classList.add('flex');
    } else {
      if (btnExport) {
        btnExport.classList.remove('hidden');
        btnExport.classList.add('inline-flex');
      }
      renderLogs(logs);
    }

    // Attach export handler
    if (btnExport) {
      btnExport.addEventListener('click', () => {
        exportToCSV(logs);
      });
    }

    // Render function
    function renderLogs(logData: LogEntry[]) {
      if (!container) return;
      
      // Clear existing cards
      const cards = container.querySelectorAll('.log-card');
      cards.forEach(c => c.remove());

      logData.forEach(log => {
        const d = new Date(log.date);
        const dateStr = d.toLocaleDateString('zh-TW', { month: 'short', day: 'numeric', hour: '2-digit', minute:'2-digit' });
        const ratio = Math.round(log.recipe.totalWater / log.recipe.coffeeWeight);

        const card = document.createElement('div');
        card.className = 'log-card backdrop-blur-md bg-coffee-darker/60 p-6 rounded-3xl border border-coffee-sand/10 hover:shadow-lg hover:border-coffee-gold/30 hover:-translate-y-1 transition-all duration-300 relative group';
        
        card.innerHTML = `
          <button class="absolute top-4 end-4 p-2 text-coffee-sand/50 hover:text-red-500 opacity-0 group-hover:opacity-100 transition-all duration-200 delete-btn" data-id="${log.id}" title="刪除紀錄">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
          </button>
          
          <div class="mb-4 pe-8">
            <span class="text-[10px] text-coffee-muted mb-1 block">${dateStr}</span>
            <h3 class="font-display font-bold text-lg text-coffee-light truncate">${log.recipe.beanName || '未知咖啡豆'}</h3>
            <p class="text-xs text-coffee-sand/80 mt-1">${log.recipe.coffeeWeight}g 粉 | 1:${ratio} | ${log.recipe.totalWater}g 水</p>
          </div>

          <div class="space-y-3 mb-4">
            <!-- Metric: Acidity -->
            <div class="flex items-center gap-3">
              <span class="text-xs text-coffee-muted w-10">酸度</span>
              <div class="flex-1 flex gap-1">${renderDots(log.evaluation.acidity)}</div>
            </div>
            <!-- Metric: Bitterness -->
            <div class="flex items-center gap-3">
              <span class="text-xs text-coffee-muted w-10">苦度</span>
              <div class="flex-1 flex gap-1">${renderDots(log.evaluation.bitterness)}</div>
            </div>
            <!-- Metric: Body -->
            <div class="flex items-center gap-3">
              <span class="text-xs text-coffee-muted w-10">醇厚</span>
              <div class="flex-1 flex gap-1">${renderDots(log.evaluation.body)}</div>
            </div>
          </div>

          ${log.evaluation.notes ? `
          <div class="mt-4 pt-4 border-t border-coffee-sand/10">
            <p class="text-xs text-coffee-sand/80 italic line-clamp-2">"${log.evaluation.notes}"</p>
          </div>` : ''}
        `;

        container.appendChild(card);
      });

      // Attach delete listeners
      document.querySelectorAll('.delete-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const btnEl = e.currentTarget as HTMLButtonElement;
          const id = btnEl.getAttribute('data-id');
          if (id) deleteLog(id);
        });
      });
    }

    function renderDots(value: number) {
      let html = '';
      for (let i = 1; i <= 5; i++) {
        const bg = i <= value ? 'bg-coffee-gold' : 'bg-coffee-dark';
        html += `<span class="w-3 h-3 rounded-full ${bg} border border-coffee-sand/10"></span>`;
      }
      return html;
    }

    function deleteLog(id: string) {
      if (!confirm('確定要刪除這筆紀錄嗎？')) return;
      
      logs = logs.filter(log => log.id !== id);
      localStorage.setItem('barista_flow_logs', JSON.stringify(logs));
      
      if (logs.length === 0) {
        if(emptyState) {
          emptyState.classList.remove('hidden');
          emptyState.classList.add('flex');
        }
        if(btnExport) {
          btnExport.classList.add('hidden');
          btnExport.classList.remove('inline-flex');
        }
        document.querySelectorAll('.log-card').forEach(c => c.remove());
      } else {
        renderLogs(logs);
      }
    }

    function exportToCSV(logData: LogEntry[]) {
      if (logData.length === 0) return;

      const headers = ['Date', 'Bean Name', 'Coffee Weight (g)', 'Total Water (g)', 'Acidity (1-5)', 'Bitterness (1-5)', 'Body (1-5)', 'Notes'];
      const rows = logData.map(log => [
        log.date,
        `"${log.recipe.beanName.replace(/"/g, '""')}"`,
        log.recipe.coffeeWeight,
        log.recipe.totalWater,
        log.evaluation.acidity,
        log.evaluation.bitterness,
        log.evaluation.body,
        `"${log.evaluation.notes.replace(/"/g, '""')}"`
      ]);

      const csvContent = [headers.join(','), ...rows.map(r => r.join(','))].join('\n');
      
      // Add BOM for UTF-8 Excel compatibility
      const blob = new Blob(['\uFEFF' + csvContent], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      
      const link = document.createElement('a');
      link.setAttribute('href', url);
      link.setAttribute('download', `barista-flow-logs-${new Date().toISOString().split('T')[0]}.csv`);
      link.style.visibility = 'hidden';
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }
  });
</script>
