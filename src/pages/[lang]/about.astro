---
import Layout from '../../layouts/Layout.astro';
import { getLanguagePaths } from '../../i18n/routes';
import { getLangFromUrl } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const isZh = lang === 'zh-TW';
const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;
const copy = isZh ? {
  title: '關於 Barista Flow',
  description: '了解 Barista Flow 的用途、編輯原則、資料處理方式及開源維護紀錄。',
  lead: 'Barista Flow 是一個免費、開源的咖啡沖煮輔助工具，把粉水比、注水目標和計時提示放在同一個畫面。它提供可重複的起點，但不把任何單一配方說成唯一答案。',
  purposeTitle: '我們解決甚麼問題',
  purpose: '沖煮時同時看秤、記水量和數秒很容易分心。這個工具把使用者輸入的粉量與比例換算成總水量，再把時間和累積注水目標顯示在計時器中。所有建議都可以修改，最終仍應按咖啡豆、器材、水質和個人口味調整。',
  editorialTitle: '內容與編輯原則',
  editorial: '教學內容以可驗證、可實作為原則：清楚標示假設、提供來源、區分業界參考值與個人偏好，並保留公開版本紀錄。未完成人工校對的翻譯不會發布或加入 Sitemap。',
  privacyTitle: '資料與私隱',
  privacy: '配方、喜好與沖煮紀錄只儲存在你的瀏覽器 localStorage，不會上傳到 Barista Flow 伺服器。分享連結只包含你主動加入的沖煮參數；請勿把個人資料填進咖啡豆名稱或筆記。',
  fundingTitle: '營運與廣告披露',
  funding: '網站目前不顯示廣告。未來如獲准加入 AdSense，廣告會清楚標示，且不會改變工具的計算結果或編輯內容。核心計時器與計算工具會維持免費。',
  openTitle: '公開維護',
  openBody: '原始碼、版本紀錄、已知問題與修正均公開在 GitHub。若發現錯誤，可以查看處理狀態或提交可重現的回報。',
  methodButton: '查看計算方法與來源',
  repoButton: '查看公開原始碼',
  reviewed: '最後人工檢閱：2026 年 8 月 30 日'
} : {
  title: 'About Barista Flow',
  description: 'Learn what Barista Flow does, how its content is reviewed, how data is handled, and how the open-source project is maintained.',
  lead: 'Barista Flow is a free, open-source coffee brewing companion that puts ratio calculation, pour targets, and timing cues on one screen. It offers a repeatable starting point without claiming that one recipe is the only correct answer.',
  purposeTitle: 'The problem we solve',
  purpose: 'Watching a scale, remembering water targets, and counting seconds at the same time is distracting. The tool converts your dose and ratio into total water, then shows timing and cumulative pour targets. Every recommendation is adjustable and should be tuned for the coffee, equipment, water, and your taste.',
  editorialTitle: 'Content and editorial principles',
  editorial: 'Guidance is written to be verifiable and practical: assumptions are stated, sources are linked, industry reference points are separated from preference, and version history stays public. Translations are not published or added to the sitemap until they receive a human review.',
  privacyTitle: 'Data and privacy',
  privacy: 'Recipes, preferences, and brew logs stay in your browser localStorage and are not uploaded to a Barista Flow server. Shared links contain only the brew parameters you choose to add. Do not enter personal information in bean names or notes.',
  fundingTitle: 'Funding and advertising disclosure',
  funding: 'The site currently displays no ads. If AdSense is approved later, ads will be clearly identified and will not influence calculations or editorial content. The core timer and calculators will remain free.',
  openTitle: 'Public maintenance',
  openBody: 'Source code, version history, known issues, and fixes are public on GitHub. You can review the status or submit a reproducible report when something is wrong.',
  methodButton: 'Read methodology and sources',
  repoButton: 'View the public source',
  reviewed: 'Last human review: 30 August 2026'
};

const sections = [
  [copy.purposeTitle, copy.purpose],
  [copy.editorialTitle, copy.editorial],
  [copy.privacyTitle, copy.privacy],
  [copy.fundingTitle, copy.funding],
  [copy.openTitle, copy.openBody]
];

export function getStaticPaths() {
  return getLanguagePaths();
}
---

<Layout title={`${copy.title} | Barista Flow`} description={copy.description}>
  <article class="max-w-4xl mx-auto py-10 sm:py-16">
    <header class="max-w-3xl mb-12">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-coffee-gold mb-4">Open-source coffee tools</p>
      <h1 class="font-display text-4xl sm:text-5xl font-bold text-coffee-light mb-6">{copy.title}</h1>
      <p class="text-lg text-coffee-sand/90 leading-relaxed">{copy.lead}</p>
      <p class="text-xs text-coffee-muted mt-4">{copy.reviewed}</p>
    </header>

    <div class="grid gap-5">
      {sections.map(([heading, body], index) => (
        <section class="glass-card rounded-3xl border border-coffee-sand/10 p-7 sm:p-9">
          <div class="flex items-start gap-4">
            <span class="mt-1 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-coffee-gold/10 text-sm font-bold text-coffee-gold">{index + 1}</span>
            <div>
              <h2 class="font-display text-2xl font-bold text-coffee-light mb-3">{heading}</h2>
              <p class="text-sm sm:text-base text-coffee-sand/85 leading-7">{body}</p>
            </div>
          </div>
        </section>
      ))}
    </div>

    <div class="mt-10 flex flex-col sm:flex-row gap-4">
      <a href={`${base}/${lang}/methodology`.replace(/\/+/g, '/')} class="inline-flex justify-center rounded-xl bg-coffee-gold px-6 py-3 text-sm font-bold text-coffee-dark hover:bg-coffee-gold-hover transition-colors">
        {copy.methodButton}
      </a>
      <a href="https://github.com/bill2712/coffee-timer-app" target="_blank" rel="noopener noreferrer" class="inline-flex justify-center rounded-xl border border-coffee-gold/50 px-6 py-3 text-sm font-bold text-coffee-gold hover:bg-coffee-gold/10 transition-colors">
        {copy.repoButton}<span aria-hidden="true" class="ms-2">↗</span>
      </a>
    </div>
  </article>
</Layout>
