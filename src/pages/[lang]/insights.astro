---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getLanguagePaths } from '../../i18n/routes';
import { getLangFromUrl } from '../../i18n/utils';

export function getStaticPaths() { return getLanguagePaths(); }
const lang = getLangFromUrl(Astro.url);
const isZh = lang === 'zh-TW';
const base = `${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/${lang}`;
const c = isZh ? {
  title: '個人沖煮數據洞察 | Barista Flow', desc: '累積至少五杯沖煮紀錄後，從自己的高評分樣本找出常見成功比例、水溫、研磨與時間範圍。', crumb: '個人數據洞察', eyebrow: '由你的味道紀錄計算', h1: '找出你最常沖成功的參數範圍', intro: '達到 5 杯後才開始分析。洞察只描述你目前的紀錄，不把相關性寫成咖啡定律。', filter: '分析範圍', all: '全部咖啡豆', progress: '洞察累積進度', need: '還需要 {count} 杯完整味道紀錄', ready: '已有 {count} 杯可分析紀錄', stable: '已有 10 杯以上，結果通常比初期更穩定。', ratio: '常見成功比例', temp: '成功水溫範圍', grind: '最常出現研磨', time: '成功時間範圍', success: '高評分比例', sample: '分析樣本', highRated: '以總評 4–5 分紀錄為高評分樣本。', fallback: '高評分紀錄不足，因此暫用目前最高評分的幾杯作早期方向。', apply: '套用最佳起點到下一杯', best: '目前最佳單杯', recent: '採用的高評分樣本', noData: '尚未有可分析的完整沖煮紀錄。先完成沖煮並儲存味道評分。', method: '計算方法', methodBody: '至少需要 5 杯。比例與研磨顯示高評分樣本中最常出現的值；水溫及時間顯示該批樣本的最低至最高範圍。不同咖啡豆、器材及味覺偏好會改變結果。', beans: '管理咖啡豆護照', records: '查看全部沖煮紀錄', cups: '杯', overall: '總評'
} : {
  title: 'Personal Brewing Insights | Barista Flow', desc: 'After at least five brew logs, identify the ratio, temperature, grind, and time range most often present in your highly rated results.', crumb: 'Personal insights', eyebrow: 'Calculated from your taste logs', h1: 'Find the parameters that most often work for you', intro: 'Analysis starts after five brews. These insights describe your records; they are not universal coffee laws.', filter: 'Analysis scope', all: 'All beans', progress: 'Insight progress', need: '{count} more complete brew logs needed', ready: '{count} brew logs available', stable: 'You have 10 or more brews, so the pattern is usually more stable than an early estimate.', ratio: 'Common successful ratio', temp: 'Successful temperature range', grind: 'Most frequent grind', time: 'Successful time range', success: 'Highly rated share', sample: 'Analysis sample', highRated: 'Records rated 4–5 overall are treated as highly rated.', fallback: 'There are not enough highly rated records, so this early estimate uses your current top-rated brews.', apply: 'Apply the best starting point', best: 'Current best single brew', recent: 'Highly rated records used', noData: 'There are no complete brew logs to analyse yet. Finish a brew and save a taste score first.', method: 'How this is calculated', methodBody: 'At least five brews are required. Ratio and grind show the most frequent value among the selected high-rated records; temperature and time show their minimum-to-maximum range. Different beans, brewers, and taste preferences can change the result.', beans: 'Manage bean passports', records: 'View all brew records', cups: 'brews', overall: 'Overall'
};
---

<Layout title={c.title} description={c.desc}>
  <div class="mx-auto max-w-5xl py-8 sm:py-12">
    <div class="flex justify-center"><Breadcrumbs items={[{ label: c.crumb }]} /></div>
    <header class="mx-auto mt-5 max-w-3xl text-center"><p class="text-xs font-bold uppercase tracking-[0.2em] text-blue-300">{c.eyebrow}</p><h1 class="mt-3 text-balance font-display text-4xl font-bold leading-tight text-coffee-light sm:text-5xl">{c.h1}</h1><p class="mx-auto mt-4 max-w-2xl text-base leading-7 text-coffee-sand/80">{c.intro}</p></header>

    <section class="mx-auto mt-10 max-w-3xl rounded-2xl border border-coffee-sand/12 bg-coffee-darker/60 p-5 sm:p-6" aria-labelledby="insight-progress-title">
      <div class="grid gap-5 sm:grid-cols-[minmax(0,1fr)_minmax(220px,0.65fr)] sm:items-end"><div><p id="insight-progress-title" class="text-xs font-bold uppercase tracking-wider text-coffee-gold">{c.progress}</p><p id="insight-progress-copy" class="mt-2 font-display text-2xl font-bold text-coffee-light">0 / 5</p><p id="insight-progress-detail" class="mt-1 text-xs leading-5 text-coffee-muted"></p></div><label class="grid min-w-0 gap-2 text-xs font-semibold text-coffee-sand"><span>{c.filter}</span><select id="insight-filter" class="min-h-[48px] w-full min-w-0 rounded-xl border border-coffee-sand/20 bg-coffee-dark px-3 text-sm text-coffee-light outline-none focus:border-coffee-gold"><option value="">{c.all}</option></select></label></div>
      <div class="mt-4 h-2 overflow-hidden rounded-full bg-coffee-dark"><div id="insight-progress-bar" class="h-full w-0 rounded-full bg-blue-300 transition-[width] duration-500"></div></div>
    </section>

    <section id="insight-empty" class="mx-auto mt-6 max-w-3xl rounded-2xl border border-dashed border-coffee-sand/20 p-8 text-center text-sm leading-7 text-coffee-muted">{c.noData}</section>

    <section id="insight-results" class="mt-8 hidden" aria-live="polite">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <article class="insight-card"><p>{c.ratio}</p><strong id="insight-ratio">—</strong></article>
        <article class="insight-card"><p>{c.temp}</p><strong id="insight-temp">—</strong></article>
        <article class="insight-card"><p>{c.grind}</p><strong id="insight-grind" class="break-words text-xl">—</strong></article>
        <article class="insight-card"><p>{c.time}</p><strong id="insight-time">—</strong></article>
      </div>

      <div class="mt-6 grid gap-6 lg:grid-cols-2">
        <article class="rounded-2xl border border-green-400/20 bg-green-400/5 p-5 sm:p-6"><div class="flex flex-wrap items-start justify-between gap-3"><div><p class="text-[10px] font-bold uppercase tracking-wider text-green-300">{c.best}</p><h2 id="best-bean" class="mt-1 font-display text-2xl font-bold text-coffee-light"></h2></div><span id="success-rate" class="rounded-full border border-green-400/25 px-3 py-1 text-xs font-bold text-green-300"></span></div><p id="best-recipe" class="mt-4 text-sm leading-7 text-coffee-sand"></p><button id="btn-apply-insight" type="button" class="mt-5 min-h-[50px] w-full rounded-xl bg-green-300 px-5 text-sm font-bold text-coffee-dark hover:bg-green-200">{c.apply}</button></article>
        <article class="rounded-2xl border border-coffee-sand/12 bg-coffee-darker/60 p-5 sm:p-6"><p class="text-[10px] font-bold uppercase tracking-wider text-coffee-gold">{c.recent}</p><div id="insight-samples" class="mt-4 grid gap-3"></div></article>
      </div>
      <p id="insight-sample-note" class="mt-5 rounded-xl border border-blue-400/15 bg-blue-400/5 p-4 text-xs leading-6 text-blue-200"></p>
    </section>

    <section class="mt-8 rounded-2xl border border-coffee-sand/10 bg-coffee-dark/40 p-5 sm:p-6"><h2 class="font-display text-xl font-bold text-coffee-light">{c.method}</h2><p class="mt-3 text-sm leading-7 text-coffee-muted">{c.methodBody}</p><div class="mt-5 flex flex-col gap-3 sm:flex-row"><a href={`${base}/beans`} class="inline-flex min-h-[46px] flex-1 items-center justify-center rounded-xl border border-coffee-gold/30 px-4 text-sm font-bold text-coffee-gold hover:bg-coffee-gold/10">{c.beans}</a><a href={`${base}/history`} class="inline-flex min-h-[46px] flex-1 items-center justify-center rounded-xl border border-coffee-sand/20 px-4 text-sm font-semibold text-coffee-sand hover:text-coffee-light">{c.records}</a></div></section>
  </div>
</Layout>

<style>
  .insight-card { min-width: 0; border: 1px solid rgb(147 197 253 / .2); border-radius: .75rem; background: rgb(147 197 253 / .05); padding: 1.25rem; }
  .insight-card p { color: rgb(197 168 128 / .7); font-size: .6875rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .insight-card strong { display: block; margin-top: .65rem; color: #f5f2eb; font-family: var(--font-display); font-size: 1.75rem; line-height: 1.15; }
</style>

<script is:inline define:vars={{ pageCopy: c, homeUrl: `${base}/` }}>
  document.addEventListener('DOMContentLoaded', () => {
    const readArray = (key) => { try { const parsed=JSON.parse(localStorage.getItem(key)||'[]'); return Array.isArray(parsed)?parsed:[]; } catch(error){ return []; } };
    const beans=readArray('barista_flow_beans_v1').filter((bean)=>/^\d{1,20}$/.test(String(bean?.id||''))&&String(bean?.name||'').trim());
    const allLogs=readArray('barista_flow_logs').filter((log)=>/^\d{1,20}$/.test(String(log?.id||''))&&log?.recipe&&log?.evaluation&&Number.isFinite(Number(log.recipe.waterRatio))&&Number.isFinite(Number(log.recipe.waterTemp))&&Number.isFinite(Number(log.brewTimeSeconds))&&Number.isFinite(Number(log.evaluation.overall))).slice(0,200);
    const filter=document.getElementById('insight-filter'); const results=document.getElementById('insight-results'); const empty=document.getElementById('insight-empty'); let activeBest=null;
    beans.forEach((bean)=>{ const option=document.createElement('option'); option.value=String(bean.id); option.textContent=[String(bean.name).slice(0,80),String(bean.origin||'').slice(0,80)].filter(Boolean).join(' · '); filter.appendChild(option); });
    const requested=new URLSearchParams(location.search).get('bean'); if(/^\d{1,20}$/.test(requested||'')&&beans.some((bean)=>String(bean.id)===requested)) filter.value=requested;
    const fmtDuration=(seconds)=>{const value=Math.max(0,Math.round(Number(seconds)||0));return `${Math.floor(value/60)}:${String(value%60).padStart(2,'0')}`;};
    const mode=(values)=>{const counts=new Map();values.forEach((value)=>counts.set(String(value),(counts.get(String(value))||0)+1));return [...counts.entries()].sort((a,b)=>b[1]-a[1])[0]?.[0]||'—';};
    const range=(values,suffix='')=>{const nums=values.map(Number).filter(Number.isFinite).sort((a,b)=>a-b);if(!nums.length)return '—';const min=nums[0],max=nums[nums.length-1];return min===max?`${min}${suffix}`:`${min}${suffix}–${max}${suffix}`;};
    const setText=(id,value)=>{const el=document.getElementById(id);if(el)el.textContent=String(value);};
    const render=()=>{
      const selected=String(filter.value||''); const selectedBean=beans.find((bean)=>String(bean.id)===selected); const logs=selected?allLogs.filter((log)=>String(log.recipe.beanPassportId||'')===selected||(!log.recipe.beanPassportId&&selectedBean&&String(log.recipe.beanName||'').trim().toLocaleLowerCase()===String(selectedBean.name).trim().toLocaleLowerCase())):allLogs; const count=logs.length; const ready=count>=5; const needed=Math.max(0,5-count); const percent=Math.min(100,(count/5)*100);
      setText('insight-progress-copy',`${Math.min(count,5)} / 5`); setText('insight-progress-detail',ready?pageCopy.ready.replace('{count}',String(count))+(count>=10?` ${pageCopy.stable}`:''):pageCopy.need.replace('{count}',String(needed))); document.getElementById('insight-progress-bar').style.width=`${percent}%`; empty.classList.toggle('hidden',ready); results.classList.toggle('hidden',!ready); if(!ready){ empty.textContent=count?pageCopy.need.replace('{count}',String(needed)):pageCopy.noData; activeBest=null; return; }
      let samples=logs.filter((log)=>Number(log.evaluation.overall)>=4); let fallback=false; if(samples.length<2){fallback=true;samples=[...logs].sort((a,b)=>Number(b.evaluation.overall)-Number(a.evaluation.overall)||new Date(b.date).valueOf()-new Date(a.date).valueOf()).slice(0,Math.max(2,Math.ceil(logs.length*.3)));}
      const ratios=samples.map((log)=>Math.round(Number(log.recipe.waterRatio)*10)/10);const temps=samples.map((log)=>Math.round(Number(log.recipe.waterTemp)));const grinds=samples.map((log)=>String(log.recipe.grindSize||'').trim()).filter(Boolean);const times=samples.map((log)=>Math.round(Number(log.brewTimeSeconds)));
      setText('insight-ratio',`1:${mode(ratios)}`);setText('insight-temp',range(temps,'°C'));setText('insight-grind',mode(grinds));const timeNums=times.sort((a,b)=>a-b);setText('insight-time',timeNums[0]===timeNums[timeNums.length-1]?fmtDuration(timeNums[0]):`${fmtDuration(timeNums[0])}–${fmtDuration(timeNums[timeNums.length-1])}`);
      activeBest=[...samples].sort((a,b)=>Number(b.evaluation.overall)-Number(a.evaluation.overall)||(b.evaluation.issue==='balanced'?1:0)-(a.evaluation.issue==='balanced'?1:0)||new Date(b.date).valueOf()-new Date(a.date).valueOf())[0]; const beanName=String(activeBest?.recipe?.beanName||'—').slice(0,80);setText('best-bean',beanName);setText('best-recipe',`1:${Number(activeBest.recipe.waterRatio)} · ${Number(activeBest.recipe.waterTemp)}°C · ${String(activeBest.recipe.grindSize||'—').slice(0,80)} · ${fmtDuration(activeBest.brewTimeSeconds)} · ${pageCopy.overall} ${Number(activeBest.evaluation.overall)}/5`);setText('success-rate',`${pageCopy.success}: ${Math.round((logs.filter((log)=>Number(log.evaluation.overall)>=4).length/logs.length)*100)}%`);setText('insight-sample-note',`${pageCopy.sample}: ${samples.length}/${logs.length} ${pageCopy.cups}. ${fallback?pageCopy.fallback:pageCopy.highRated}`);
      const sampleList=document.getElementById('insight-samples');sampleList.replaceChildren();samples.slice(0,4).forEach((log)=>{const row=document.createElement('div');row.className='flex items-center justify-between gap-3 rounded-xl border border-coffee-sand/10 bg-coffee-dark/55 p-3';const left=document.createElement('div');left.className='min-w-0';const name=document.createElement('p');name.className='truncate text-sm font-semibold text-coffee-light';name.textContent=String(log.recipe.beanName||'').slice(0,80);const recipe=document.createElement('p');recipe.className='mt-1 text-[11px] text-coffee-muted';recipe.textContent=`1:${Number(log.recipe.waterRatio)} · ${Number(log.recipe.waterTemp)}°C · ${fmtDuration(log.brewTimeSeconds)}`;left.append(name,recipe);const score=document.createElement('strong');score.className='shrink-0 text-sm text-coffee-gold';score.textContent=`${Number(log.evaluation.overall)}/5`;row.append(left,score);sampleList.appendChild(row);});
    };
    filter.addEventListener('change',render);document.getElementById('btn-apply-insight')?.addEventListener('click',()=>{if(!activeBest)return;try{localStorage.setItem('barista_flow_recipe',JSON.stringify(activeBest.recipe));}catch(error){}const r=activeBest.recipe;const params=new URLSearchParams({bean:String(r.beanName||''),roast:String(r.roastLevel||'medium'),grind:String(r.grindSize||''),t:String(r.waterTemp||92),w:String(r.coffeeWeight||15),r:String(r.waterRatio||15)});if(/^\d{1,20}$/.test(String(r.beanPassportId||'')))params.set('passport',String(r.beanPassportId));window.location.href=`${homeUrl}?${params.toString()}#brew-start`;});render();
  });
</script>
